   18:     def __init__(self, manager: EventManager):
   19:         self.manager = manager
   20:         self._instance_ids: dict[str, str] = {}
   21: 
   22:     def begin(self, event_id: str, *, data: dict[str, Any] | None = None) -> EventInstance:
   23:         current = self.instance_for(event_id)
   24:         if current is not None and current.status in (
   25:             EventStatus.ACTIVE, EventStatus.SUSPENDED, EventStatus.WAITING
   26:         ):
   27:             raise RuntimeError("EVENT_ALREADY_ACTIVE")
   28:         self._instance_ids.pop(event_id, None)
   29:         instance = self.manager.begin(event_id, data=data)
   30:         self._instance_ids[event_id] = instance.instance_id
   31:         return instance
   32: 
   33:     def instance_for(self, event_id: str) -> EventInstance | None:
   34:         instance_id = self._instance_ids.get(event_id)
   35:         if instance_id is None:
   36:             return None
   37:         instance = self.manager.instances.get(instance_id)
   38:         if instance is None:
   39:             self._instance_ids.pop(event_id, None)
   40:         return instance
   41: 
   42:     def finish(
   43:         self,
   44:         event_id: str,
   45:         *,
   46:         cancelled: bool = False,
   47:         reason: str | None = None,
   48:     ) -> EventInstance | None:
   49:         instance_id = self._instance_ids.get(event_id)
   50:         if instance_id is None:
   51:             return None
   52:         instance = self.manager.finish(instance_id, cancelled=cancelled, reason=reason)
   53:         self._instance_ids.pop(event_id, None)
   54:         return instance
   55: 
   56:     def is_tracked(self, event_id: str) -> bool:
