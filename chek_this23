   10:     def __init__(self, catalog: EventCatalog, *, arbiter: ResourceArbiter | None = None, clock=None):
   11:         self.catalog = catalog
   12:         self.arbiter = arbiter or ResourceArbiter()
   13:         self.clock = clock or time.monotonic
   14:         self.instances: dict[str, EventInstance] = {}
   15:         self.last_block_reason: dict[str, str] = {}
   16: 
   17:     def _claims_for(self, definition):
   18:         exclusive = set(definition.exclusive_resources)
   19:         resource_names = set(definition.resources) | exclusive
   20:         for resource in sorted(resource_names):
   21:             mode = ResourceMode.EXCLUSIVE if resource in exclusive else ResourceMode.SHARED
   22:             yield ResourceClaim(definition.event_id, resource, mode, interruptible=definition.interruptible)
   23: 
   24:     def can_start(self, event_id: str) -> tuple[bool, str | None]:
   25:         definition = self.catalog.get(event_id)
   26:         if definition is None:
   27:             return False, "UNKNOWN_EVENT_ID"
   28:         if not self.catalog.is_enabled(event_id):
   29:             return False, "EVENT_DISABLED"
   30:         active_statuses = (EventStatus.ACTIVE, EventStatus.SUSPENDED, EventStatus.WAITING)
   31:         if any(item.event_id == event_id and item.status in active_statuses for item in self.instances.values()):
   32:             return False, "EVENT_ALREADY_ACTIVE"
   33:         for claim in self._claims_for(definition):
   34:             allowed, reason = self.arbiter.can_acquire(claim)
   35:             if not allowed:
   36:                 return False, reason or "RESOURCE_CONFLICT"
   37:         return True, None
   38: 
   39:     def begin(self, event_id: str, data: dict | None = None) -> EventInstance:
   40:         allowed, reason = self.can_start(event_id)
   41:         if not allowed:
   42:             self.last_block_reason[event_id] = reason or "BLOCKED"
   43:             raise RuntimeError(self.last_block_reason[event_id])
   44:         definition = self.catalog.get(event_id)
   45:         assert definition is not None
   46:         acquired = []
   47:         for claim in self._claims_for(definition):
   48:             ok, claim_reason = self.arbiter.acquire(claim)
   49:             if not ok:
   50:                 for resource in acquired:
   51:                     self.arbiter.release(event_id, resource)
   52:                 self.last_block_reason[event_id] = claim_reason or "RESOURCE_CONFLICT"
   53:                 raise RuntimeError(self.last_block_reason[event_id])
   54:             acquired.append(claim.resource)
   55:         instance = EventInstance(
   56:             instance_id=f"{event_id}:{uuid.uuid4().hex[:12]}", event_id=event_id,
   57:             status=EventStatus.ACTIVE, started_at=self.clock(), data=dict(data or {}),
   58:         )
   59:         self.instances[instance.instance_id] = instance
   60:         self.last_block_reason.pop(event_id, None)
   61:         return instance
   62: 
   63:     def finish(self, instance_id: str, *, cancelled: bool = False, failed: bool = False, reason: str | None = None) -> EventInstance:
   64:         instance = self.instances[instance_id]
   65:         if instance.status not in (EventStatus.ACTIVE, EventStatus.SUSPENDED, EventStatus.WAITING):
   66:             return instance
   67:         if failed:
   68:             instance.status = EventStatus.FAILED
   69:         elif cancelled:
   70:             instance.status = EventStatus.CANCELLED
   71:         else:
   72:             instance.status = EventStatus.COMPLETED
   73:         instance.finished_at = self.clock()
   74:         instance.failure_reason = reason
   75:         self.arbiter.release_all(instance.event_id)
   76:         return instance
   77: 
   78:     def active(self) -> tuple[EventInstance, ...]:
   79:         return tuple(i for i in self.instances.values() if i.status == EventStatus.ACTIVE)

