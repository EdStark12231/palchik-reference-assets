   18: @dataclass(frozen=True)
   19: class ResourceClaim:
   20:     event_id: str
   21:     resource: str
   22:     mode: ResourceMode = ResourceMode.EXCLUSIVE
   23:     priority: int = 0
   24:     interruptible: bool = True
