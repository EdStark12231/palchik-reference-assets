   26: class ResourceArbiter:
   27:     """Tracks resource ownership. Non-exclusive claims coexist; exclusive claims do not."""
   28:     def __init__(self):
   29:         self._claims: dict[str, dict[str, ResourceClaim]] = {}
   30: 
   31:     def can_acquire(self, claim: ResourceClaim) -> tuple[bool, str | None]:
   32:         owners = self._claims.get(claim.resource, {})
   33:         for owner_id, current in owners.items():
   34:             if owner_id == claim.event_id:
   35:                 continue
   36:             if current.mode == ResourceMode.EXCLUSIVE or claim.mode == ResourceMode.EXCLUSIVE:
   37:                 return False, f"RESOURCE_{claim.resource.upper()}_OCCUPIED"
   38:         return True, None
   39: 
   40:     def acquire(self, claim: ResourceClaim) -> tuple[bool, str | None]:
   41:         allowed, reason = self.can_acquire(claim)
   42:         if not allowed:
   43:             return False, reason
   44:         self._claims.setdefault(claim.resource, {})[claim.event_id] = claim
   45:         return True, None
   46: 
   47:     def release(self, event_id: str, resource: str | None = None) -> None:
   48:         resources = (resource,) if resource is not None else tuple(self._claims)
   49:         for key in resources:
   50:             owners = self._claims.get(key)
   51:             if owners is None:
   52:                 continue
   53:             owners.pop(event_id, None)
   54:             if not owners:
   55:                 self._claims.pop(key, None)
   56: 
   57:     def release_all(self, event_id: str) -> None:
   58:         self.release(event_id)
   59: 
   60:     def owners(self, resource: str) -> tuple[str, ...]:
   61:         return tuple(self._claims.get(resource, {}))

