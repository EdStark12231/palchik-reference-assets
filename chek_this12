        self.title_font = game_view.word_shock_title_font or game_view.font_main
        self.button_font = (game_view.font_main or game_view.word_shock_input_font
                            or pygame.font.SysFont("Arial", 20, bold=True))
        self.small_font = (game_view.font_sub or game_view.word_shock_small_font
                           or pygame.font.SysFont("Arial", 16, bold=True))
