        self.dialog_small = pygame.font.SysFont("Arial", 15, bold=True)
        self._dialog_ok_rect = None

    @staticmethod
    def _center_text(surface, font, text, color, center, alpha=255):
        rendered = font.render(text, True, color)
        if alpha < 255:
            rendered.set_alpha(max(0, min(255, int(alpha))))
        surface.blit(rendered, rendered.get_rect(center=center))

    def _fit_game_font(self, text, max_width):
        font = self.title_font
        if font is None:
            return pygame.font.SysFont("Arial", 28, bold=True)
        if font.size(text)[0] <= max_width:
            return font
        path = getattr(self.game_view, "font_asset_path", None)
        if path:
            base_size = 48
            size = max(20, int(base_size * max_width / max(1, font.size(text)[0])))
            try:
                return pygame.font.Font(path, size)
            except (OSError, pygame.error):
                pass
        return font

    def _draw_game_background(self, surface, wallpaper_index):
        self.game_view.draw_event_background(surface, wallpaper_index)

