        )
        self.assertEqual(forgiven["penalty_amount"], 0)
        self.assertEqual(ledger.violation_count, 1)
        self.assertEqual(ledger.forgiveness_count, 1)
        self.assertEqual(ledger.punishment_count, 0)

        punished = ledger.resolve_violation(
            "phase_1", "punished-1", "PUNISHMENT", current_balance=1000
        )
        self.assertEqual(punished["penalty_percent"], 5)
        self.assertEqual(punished["penalty_amount"], 50)

    def test_same_occurrence_cannot_apply_penalty_twice(self):
        ledger = EVT003PenaltyLedger()
        first = ledger.resolve_violation(
            "phase_0", "unique-instance", "PUNISHMENT", current_balance=1000
        )
        duplicate = ledger.resolve_violation(
            "phase_0", "unique-instance", "PUNISHMENT", current_balance=first["balance_after"]
        )
        self.assertFalse(first["already_resolved"])
