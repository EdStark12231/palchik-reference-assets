        self.assertTrue(session.register_accepted_click(True))
        session.mark_completed()
        self.assertFalse(session.register_accepted_click(True))
        session.begin_click_cycle()
        self.assertFalse(session.register_accepted_click(True))
        self.assertFalse(session.register_accepted_click(True))
        self.assertFalse(session.prompt_pending)

    def test_new_game_resets_prompt_session_but_not_persistent_collection_state(self):
