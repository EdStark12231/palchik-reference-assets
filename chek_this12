import json
import tempfile
import unittest
from pathlib import Path
from unittest.mock import patch

from save_manager import SaveManager


class SecretAccessPersistenceTests(unittest.TestCase):
    def test_collection_state_round_trip_preserves_other_save_data(self):
        with tempfile.TemporaryDirectory() as temp_dir:
            save_path = Path(temp_dir) / "save_data.json"
            original = {
                "score": 12345,
                "lang": "RU",
                "total_clicks": 678,
                "secret_code": [14, 17, 23],
                "event_states": {"EVT_003_PLEASE_DONT_TOUCH": {"attempts": 2}},
            }
            save_path.write_text(json.dumps(original), encoding="utf-8")

            with patch.object(SaveManager, "SAVE_FILE", str(save_path)):
                progress = {"sweet_roll": {"found": True, "completed": False}}
                SaveManager.save_event_collection_state(unlocked=True, progress=progress)
                loaded = SaveManager.load_event_collection_state()
                self.assertTrue(loaded["unlocked"])
                self.assertEqual(loaded["progress"], progress)

                # Ordinary game saves must retain collection and EVT_003 data.
                SaveManager.save_game_data(score=12346, lang="RU", total_clicks=679)
                final_data = json.loads(save_path.read_text(encoding="utf-8"))

            self.assertEqual(final_data["score"], 12346)
            self.assertEqual(final_data["total_clicks"], 679)
            self.assertEqual(final_data["secret_code"], [14, 17, 23])
            self.assertEqual(final_data["event_states"], original["event_states"])
            self.assertTrue(final_data["event_collection_unlocked"])
            self.assertEqual(final_data["event_collection_progress"], progress)

    def test_resetting_unlock_does_not_erase_collection_progress(self):
        with tempfile.TemporaryDirectory() as temp_dir:
            save_path = Path(temp_dir) / "save_data.json"
            progress = {"sweet_roll": {"found": True, "completed": True}}
            with patch.object(SaveManager, "SAVE_FILE", str(save_path)):
                SaveManager.save_event_collection_state(unlocked=True, progress=progress)
                SaveManager.save_event_collection_state(unlocked=False)
                loaded = SaveManager.load_event_collection_state()
            self.assertFalse(loaded["unlocked"])
            self.assertEqual(loaded["progress"], progress)


if __name__ == "__main__":
    unittest.main()

