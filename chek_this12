"""EVT_003 runtime controller; lifecycle is owned by PALCHIK EventManager."""
from __future__ import annotations

import json
import time
from pathlib import Path

from events.contracts import EventStatus
from events.evt003_penalties import EVENT_ID, VALID_PHASES, EVT003PenaltyLedger


class EVT003RuntimeError(RuntimeError):
    pass


class EVT003Runtime:
    EVENT_ID = EVENT_ID
    VALID_PHASES = tuple(sorted(VALID_PHASES))
    DURATION_SECONDS = 30.0

    def __init__(self, event_manager, game_logic, *, project_root=None, clock=None):
        self.event_manager = event_manager
        self.game_logic = game_logic
        self.clock = clock or time.monotonic
        self.project_root = Path(project_root) if project_root else Path(__file__).resolve().parent.parent
        self.notifications = self._load_notifications()
        # Sandbox history lives only in memory and is never merged into player saves.
        self._sandbox_ledger = EVT003PenaltyLedger()
        config = self.event_manager.catalog.configuration(self.EVENT_ID) or {}
        params = config.get("parameters", {})
        self.duration_seconds = float(params.get("duration_seconds", self.DURATION_SECONDS))
        self.typewriter_interval = max(0.01, float(params.get("typewriter_interval", 0.065)))
        self.random_delay_min_seconds = max(0.0, float(params.get("random_delay_min_seconds", 35.0)))
        self.random_delay_max_seconds = max(
            self.random_delay_min_seconds,
            float(params.get("random_delay_max_seconds", 85.0)),
        )
        if self.duration_seconds <= 0:
            raise EVT003RuntimeError("EVT_003 duration must be positive")

    def _load_notifications(self):
        path = self.project_root / "config" / "events" / "evt_003_notifications.json"
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise EVT003RuntimeError(f"Cannot load EVT_003 notifications: {exc}") from exc
        for phase in self.VALID_PHASES:
            group = payload.get(phase) if isinstance(payload, dict) else None
            if not isinstance(group, dict) or any(
                not isinstance(group.get(kind), str) or not group[kind].strip()
                for kind in ("FIRST_NOTICE", "FORGIVENESS", "PUNISHMENT")
            ):
                raise EVT003RuntimeError(f"Incomplete EVT_003 notification set: {phase}")
        return payload

    @property
    def ledger(self):
        return self.game_logic.evt003_penalty_ledger

    def can_start(self, phase=None, *, sandbox=False):
        phase = str(phase or self.game_logic.get_phase()).strip().lower()
        if phase not in self.VALID_PHASES:
            return False, "INVALID_PHASE"
        # Sandbox deliberately skips only the permanent once-per-phase ledger.
        if not sandbox and self.ledger.has_attempted_phase(phase):
            return False, "ALREADY_OCCURRED_THIS_PHASE"
        return self.event_manager.can_start(self.EVENT_ID)

    def start(self, phase=None, *, sandbox=False):
        phase = str(phase or self.game_logic.get_phase()).strip().lower()
        allowed, reason = self.can_start(phase, sandbox=sandbox)
        if not allowed:
            raise EVT003RuntimeError(reason or "EVENT_BLOCKED")
        instance = self.event_manager.begin(self.EVENT_ID, {
            "phase": phase,
            "duration_seconds": self.duration_seconds,
            "violated": False,
            "sandbox": bool(sandbox),
        })
        if sandbox:
            return instance
        try:
            self.game_logic.reserve_evt003_attempt(phase, instance.instance_id)
        except Exception:
            self.event_manager.finish(
                instance.instance_id, cancelled=True,
                reason="ATTEMPT_RESERVATION_FAILED",
            )
            raise
        return instance

    def reset_sandbox_history(self):
        """Clear only volatile test history; never touches player data on disk."""
        self._sandbox_ledger = EVT003PenaltyLedger()

    def _active(self, instance_id):
        instance = self.event_manager.instances.get(instance_id)
        if (instance is None or instance.event_id != self.EVENT_ID
                or instance.status != EventStatus.ACTIVE):
            raise EVT003RuntimeError("EVT_003 instance is not active")
        return instance

    def update(self, instance_id):
        instance = self._active(instance_id)
        elapsed = max(0.0, self.clock() - float(instance.started_at or 0.0))
        if elapsed < self.duration_seconds:
            return None
        phase = instance.data["phase"]
        try:
            if instance.data.get("sandbox"):
                saved = self._sandbox_ledger.record_compliance(phase, instance.instance_id)
            else:
                saved = self.game_logic.record_evt003_compliance(phase, instance.instance_id)
        except Exception:
            self.event_manager.finish(
                instance.instance_id, cancelled=True, reason="COMPLIANCE_SAVE_FAILED"
            )
            raise
        self.event_manager.finish(instance.instance_id, reason="COMPLIANCE")
        return {
            "outcome": "COMPLIANCE", "phase": phase,
            "instance_id": instance.instance_id,
            "recorded": bool(saved.get("recorded")),
        }

    def _select_decision(self, ledger=None):
        """Forgiveness requires a proven clean check after the latest violation.

        The first violation is punished. A later violation is forgiven only if
        the player completed at least one clean EVT_003 check after the previous
        violation. Forgiveness remains in history and never resets the penalty
        ladder; without an intervening compliance the next violation is punished.
        """
        history = (ledger or self.ledger).to_dict().get("history", [])
        last_violation_index = -1
        for index, item in enumerate(history):
            if item.get("outcome") == "VIOLATION":
                last_violation_index = index
        if last_violation_index < 0:
            return "PUNISHMENT"
        clean_after = any(
            item.get("outcome") == "COMPLIANCE"
            for item in history[last_violation_index + 1:]
        )
        return "FORGIVENESS" if clean_after else "PUNISHMENT"

    def register_click(self, instance_id):
        instance = self._active(instance_id)
        phase = instance.data["phase"]
        sandbox = bool(instance.data.get("sandbox"))
        ledger = self._sandbox_ledger if sandbox else self.ledger
        first_violation = ledger.violation_count == 0
        decision = self._select_decision(ledger)
        notice_type = (
            "FORGIVENESS" if decision == "FORGIVENESS"
            else "FIRST_NOTICE" if first_violation
            else "PUNISHMENT"
        )
        notification_text = self.notifications[phase][notice_type]
        pending_notice = {
            "text": notification_text,
            "title": "СИСТЕМНОЕ НАРУШЕНИЕ",
            "phase": phase,
            "notification_type": notice_type,
        }
        try:
            if sandbox:
                result = ledger.resolve_violation(
                    phase, instance.instance_id, decision,
                    current_balance=int(self.game_logic.score),
                )
            else:
                result = self.game_logic.resolve_evt003_violation(
                    phase, instance.instance_id, decision,
                    pending_notification=pending_notice if decision == "PUNISHMENT" else None,
                )
        except Exception:
            self.event_manager.finish(
                instance.instance_id, cancelled=True, reason="VIOLATION_SAVE_FAILED"
            )
            raise
        self.event_manager.finish(instance.instance_id, reason="VIOLATION")
        return {
            "outcome": "VIOLATION", "decision": decision,
            "phase": phase, "instance_id": instance.instance_id,
            "notification_type": notice_type,
            "notification_text": notification_text,
            "penalty_number": result.get("penalty_number"),
            "penalty_percent": result.get("penalty_percent", 0),
            "penalty_amount": result.get("penalty_amount", 0),
            "balance_before": result.get("balance_before"),
            "balance_after": result.get("balance_after"),
            "return_to_menu": decision == "PUNISHMENT",
            "continue_game": decision == "FORGIVENESS",
            "sandbox": sandbox,
        }

    def cancel(self, instance_id, reason="CANCELLED"):
        instance = self._active(instance_id)
        return self.event_manager.finish(
            instance.instance_id, cancelled=True, reason=reason
        )

