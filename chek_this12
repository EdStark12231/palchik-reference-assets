from events.manager import EventManager

ROOT = Path(__file__).resolve().parents[2]


class SandboxLogic:
    def __init__(self):
        self.score = 1234
        self.phase = "phase_2"
        self.evt003_penalty_ledger = EVT003PenaltyLedger()
        self.pending_notification = None

    def get_phase(self):
        return self.phase

    def reserve_evt003_attempt(self, phase, occurrence_id):
        return self.evt003_penalty_ledger.reserve_attempt(phase, occurrence_id)

    def record_evt003_compliance(self, phase, occurrence_id):
        return self.evt003_penalty_ledger.record_compliance(phase, occurrence_id)

    def resolve_evt003_violation(self, phase, occurrence_id, decision, *, pending_notification=None):
        result = self.evt003_penalty_ledger.resolve_violation(
            phase, occurrence_id, decision, current_balance=self.score
        )
        if pending_notification is not None:
            self.pending_notification = dict(pending_notification)
        if not result["already_resolved"] and decision == "PUNISHMENT":
            self.score = result["balance_after"]
        return result


class EVT003SandboxTests(unittest.TestCase):
    def setUp(self):
        self.now = 50.0
        self.logic = SandboxLogic()
        self.catalog = load_default_catalog(ROOT)
        self.manager = EventManager(self.catalog, clock=lambda: self.now)
        self.runtime = EVT003Runtime(
            self.manager, self.logic, project_root=ROOT, clock=lambda: self.now
        )
        self.real_snapshot = self.logic.evt003_penalty_ledger.to_dict()
        self.score_snapshot = self.logic.score

    def test_phase_zero_sandbox_ignores_real_attempt_but_real_run_stays_blocked(self):
        self.logic.reserve_evt003_attempt("phase_0", "real-phase-zero")
        player_state_after_real_reservation = self.logic.evt003_penalty_ledger.to_dict()
        self.assertEqual(
            self.runtime.can_start("phase_0"), (False, "ALREADY_OCCURRED_THIS_PHASE")
        )
        self.assertTrue(self.runtime.can_start("phase_0", sandbox=True)[0])
        instance = self.runtime.start("phase_0", sandbox=True)
        self.assertEqual(instance.data["phase"], "phase_0")
        self.assertTrue(instance.data["sandbox"])
        self.runtime.cancel(instance.instance_id, "TEST_CLEANUP")
        self.assertEqual(self.logic.evt003_penalty_ledger.to_dict(), player_state_after_real_reservation)

    def test_sandbox_compliance_does_not_change_player_ledger_or_balance(self):
        instance = self.runtime.start("phase_0", sandbox=True)
        self.now += self.runtime.duration_seconds
        result = self.runtime.update(instance.instance_id)
        self.assertEqual(result["outcome"], "COMPLIANCE")
        self.assertEqual(self.logic.score, self.score_snapshot)
        self.assertEqual(self.logic.evt003_penalty_ledger.to_dict(), self.real_snapshot)
        self.assertEqual(self.runtime._sandbox_ledger.compliance_count, 1)

    def test_sandbox_violation_uses_its_own_decision_history_without_player_penalty(self):
        instance = self.runtime.start("phase_0", sandbox=True)
