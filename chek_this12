SHA256: 1f2a265054b82840e63424aa61a849bfb4320ba72259cdca1e949d84ac32d92e
import unittest
from pathlib import Path

from events.catalog import load_default_catalog
from events.contracts import EventStatus
from events.effects import EffectRegistry, EventEffect
from events.manager import EventManager
from events.resources import ResourceArbiter, ResourceClaim, ResourceMode
from events.signals import EventSignal, SignalSource

ROOT = Path(__file__).resolve().parents[2]

class EventArchitectureTests(unittest.TestCase):
    def test_default_catalog_has_existing_events_valid_configs_and_classification(self):
        catalog = load_default_catalog(ROOT)
        self.assertEqual(
            {item.event_id for item in catalog.all(enabled_only=True)},
            {"EVT_001_ROACH_ATTACK", "EVT_002_WORD_SHOCK", "EVT_003_PLEASE_DONT_TOUCH"},
        )
        self.assertEqual(catalog.get("EVT_001_ROACH_ATTACK").source.value, "ACTION")
        self.assertEqual(catalog.get("EVT_001_ROACH_ATTACK").subcategories, ("ACTION_02",))
        self.assertEqual(catalog.get("EVT_002_WORD_SHOCK").subcategories, ("ACTION_01",))

    def test_json_enabled_flag_controls_catalog_visibility(self):
        catalog = load_default_catalog(ROOT)
        self.assertTrue(catalog.is_enabled("EVT_001_ROACH_ATTACK"))
        self.assertTrue(catalog.configuration("EVT_001_ROACH_ATTACK")["enabled"])

    def test_exclusive_resource_rejects_second_owner(self):
        arbiter = ResourceArbiter()
        first = ResourceClaim("EVT_A", "keyboard", ResourceMode.EXCLUSIVE)
        second = ResourceClaim("EVT_B", "keyboard", ResourceMode.EXCLUSIVE)
        self.assertEqual(arbiter.acquire(first), (True, None))
        ok, reason = arbiter.acquire(second)
        self.assertFalse(ok)
        self.assertEqual(reason, "RESOURCE_KEYBOARD_OCCUPIED")
        arbiter.release_all("EVT_A")
        self.assertEqual(arbiter.acquire(second), (True, None))

    def test_manager_lifecycle_reserves_all_declared_resources_and_releases_them(self):
        catalog = load_default_catalog(ROOT)
        manager = EventManager(catalog, clock=lambda: 10.0)
        instance = manager.begin("EVT_002_WORD_SHOCK")
        self.assertEqual(instance.status, EventStatus.ACTIVE)
        self.assertEqual(manager.arbiter.owners("keyboard_text_input"), ("EVT_002_WORD_SHOCK",))
        self.assertEqual(manager.arbiter.owners("event_timer"), ("EVT_002_WORD_SHOCK",))
        manager.finish(instance.instance_id)
        self.assertEqual(instance.status, EventStatus.COMPLETED)
        self.assertEqual(manager.arbiter.owners("keyboard_text_input"), ())
        self.assertEqual(manager.arbiter.owners("event_timer"), ())

    def test_same_event_cannot_start_twice(self):
        catalog = load_default_catalog(ROOT)
        manager = EventManager(catalog)
        instance = manager.begin("EVT_001_ROACH_ATTACK")
        self.assertEqual(manager.can_start("EVT_001_ROACH_ATTACK"), (False, "EVENT_ALREADY_ACTIVE"))
        with self.assertRaisesRegex(RuntimeError, "EVENT_ALREADY_ACTIVE"):
            manager.begin("EVT_001_ROACH_ATTACK")
        manager.finish(instance.instance_id)

    def test_event_conflict_uses_all_declared_resources(self):
        catalog = load_default_catalog(ROOT)
        manager = EventManager(catalog)
        roach = manager.begin("EVT_001_ROACH_ATTACK")
        allowed, reason = manager.can_start("EVT_002_WORD_SHOCK")
        self.assertFalse(allowed)
        self.assertEqual(reason, "RESOURCE_EVENT_OVERLAY_OCCUPIED")
        manager.finish(roach.instance_id)
        self.assertTrue(manager.can_start("EVT_002_WORD_SHOCK")[0])

    def test_shared_resource_allows_multiple_owners(self):
        arbiter = ResourceArbiter()
