        self.assertEqual(first_result["decision"], "PUNISHMENT")

        clean = self.runtime.start("phase_0", sandbox=True)
        self.now += self.runtime.duration_seconds
        self.runtime.update(clean.instance_id)

        second = self.runtime.start("phase_0", sandbox=True)
        second_result = self.runtime.register_click(second.instance_id)
        self.assertEqual(second_result["decision"], "FORGIVENESS")
        self.assertTrue(second_result["continue_game"])
        self.assertFalse(second_result["return_to_menu"])
        self.assertEqual(self.logic.score, self.score_snapshot)
        self.assertEqual(self.logic.evt003_penalty_ledger.to_dict(), self.real_snapshot)

    def test_sandbox_still_obeys_event_manager_resource_arbitration(self):
        other = self.manager.begin("EVT_001_ROACH_ATTACK")
        allowed, reason = self.runtime.can_start("phase_0", sandbox=True)
        self.assertFalse(allowed)
        self.assertTrue(reason)
        self.manager.finish(other.instance_id, cancelled=True, reason="TEST_CLEANUP")
        self.assertTrue(self.runtime.can_start("phase_0", sandbox=True)[0])

    def test_sandbox_reset_clears_only_ephemeral_history(self):
        instance = self.runtime.start("phase_0", sandbox=True)
