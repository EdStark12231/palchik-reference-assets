"""Effects live independently from the event instance that created them."""
from __future__ import annotations
from dataclasses import dataclass, field
from typing import Any

@dataclass
class EventEffect:
    effect_id: str
    source_event_id: str
    target: str
    operation: str
    value: Any
    scope: str = "SESSION"
    expires_at: float | None = None
    completion_condition: str | None = None
    metadata: dict[str, Any] = field(default_factory=dict)

class EffectRegistry:
    def __init__(self):
        self._effects: dict[str, EventEffect] = {}

    def add(self, effect: EventEffect) -> None:
        if effect.effect_id in self._effects:
            raise ValueError(f"Duplicate effect ID: {effect.effect_id}")
        self._effects[effect.effect_id] = effect

    def get(self, effect_id: str) -> EventEffect | None:
        return self._effects.get(effect_id)

    def active_for(self, target: str) -> tuple[EventEffect, ...]:
        return tuple(e for e in self._effects.values() if e.target == target)

    def remove(self, effect_id: str) -> EventEffect | None:
        return self._effects.pop(effect_id, None)

    def expire(self, now: float) -> tuple[EventEffect, ...]:
        expired = [key for key, effect in self._effects.items() if effect.expires_at is not None and now >= effect.expires_at]
        return tuple(self._effects.pop(key) for key in expired)

    def clear_scope(self, scope: str) -> tuple[EventEffect, ...]:
        keys = [key for key, effect in self._effects.items() if effect.scope == scope]
        return tuple(self._effects.pop(key) for key in keys)

