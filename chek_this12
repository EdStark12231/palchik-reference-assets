        self.runtime.reset_sandbox_history()
        self.assertEqual(self.runtime._sandbox_ledger.violation_count, 0)
        self.assertEqual(self.logic.evt003_penalty_ledger.to_dict(), self.real_snapshot)
        self.assertEqual(self.logic.score, self.score_snapshot)

    def test_sandbox_can_be_repeated_in_phase_zero(self):
        first = self.runtime.start("phase_0", sandbox=True)
        self.runtime.cancel(first.instance_id, "TEST_CLEANUP")
        second = self.runtime.start("phase_0", sandbox=True)
        self.assertEqual(second.data["phase"], "phase_0")
        self.runtime.cancel(second.instance_id, "TEST_CLEANUP")


if __name__ == "__main__":
    unittest.main()

