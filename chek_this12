class EventCollectionIconLayoutTests(unittest.TestCase):
    def test_new_icon_never_covers_existing_bottom_right_controls(self):
        width, height = 1920, 1080
        sector = width // 4
        wallpaper = (int(sector * 3 + sector * 0.6), height - 64, 40, 40)
        archive = (width - 110, height - 60, 40, 40)
        status_hud = (width - 520, height - 62, 520, 62)
