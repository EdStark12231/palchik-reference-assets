        x, y, w, h = chosen
        for ox, oy, ow, oh in (wallpaper, archive, status_hud):
            overlaps = x < ox + ow and x + w > ox and y < oy + oh and y + h > oy
            self.assertFalse(overlaps, f"new icon {chosen} overlaps existing rect {(ox, oy, ow, oh)}")

