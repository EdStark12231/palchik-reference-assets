@dataclass
class Animation:
    frames: list[pygame.Surface]
    fps: float
    loop: bool = True

    @property
    def duration(self) -> float:
        return len(self.frames) / max(self.fps, 0.001)

    def frame(self, elapsed: float) -> pygame.Surface:
        if not self.frames:
            raise RuntimeError("Animation has no frames")
        index = int(max(0.0, elapsed) * self.fps)
        if self.loop:
            index %= len(self.frames)
        else:
            index = min(index, len(self.frames) - 1)
        return self.frames[index]

    def finished(self, elapsed: float) -> bool:
        return not self.loop and elapsed >= self.duration


@dataclass
class Particle:
    pos: pygame.Vector2
    vel: pygame.Vector2
    color: tuple[int, int, int]
    life: float
    max_life: float
    size: int = 3
    gravity: float = 0.0
    drag: float = 0.0
    kind: str = "pixel"

    def update(self, dt: float) -> None:
        self.life -= dt
        if self.gravity:
            self.vel.y += self.gravity * dt
        if self.drag:
            self.vel *= max(0.0, 1.0 - self.drag * dt)
        self.pos += self.vel * dt

    @property
    def alive(self) -> bool:
        return self.life > 0.0


