        self, surface, visible_text, elapsed, wallpaper_index=0,
        *, remaining_seconds=None, duration_seconds=30.0,
    ):
        self._draw_game_background(surface, wallpaper_index)
        width, height = surface.get_size()
        title_font = self._fit_game_font(visible_text or "PLEASE DON'T TOUCH ANYTHING", width - 80)
        if visible_text:
            self._center_text(
                surface, title_font, visible_text, (245, 248, 255),
                (width // 2, int(height * 0.23)),
