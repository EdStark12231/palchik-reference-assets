import logging
import tempfile
import unittest
from pathlib import Path

from events import diagnostics


class AdminDiagnosticsTests(unittest.TestCase):
    def test_legacy_scene_and_audio_failures_use_shared_logging(self):
        root = Path(__file__).resolve().parents[2]
        scene = (root / "game_scene.py").read_text(encoding="utf-8-sig")
        audio = (root / "audio_system.py").read_text(encoding="utf-8-sig")
        self.assertIn('_LOGGER = logging.getLogger("PALCHIK.game_scene")', scene)
        self.assertIn('_LOGGER.exception("Ошибка загрузки изображения архива:', scene)
        self.assertIn('_LOGGER = logging.getLogger("PALCHIK.audio")', audio)
        self.assertIn('exc_info=sys.exc_info()[0] is not None', audio)
        self.assertNotIn('print(f"[AUDIO] {message}")', audio)

    def test_exception_is_written_with_traceback_and_exposed_to_admin_buffer(self):
        with tempfile.TemporaryDirectory() as temporary:
            root = logging.getLogger()
            old_level = root.level
            old_handlers = list(root.handlers)
            try:
                for handler in list(root.handlers):
                    if getattr(handler, "_palchik_owned", False):
                        root.removeHandler(handler)
                        handler.close()
                diagnostics._CONFIGURED_PATH = None
                logger, path = diagnostics.configure_app_logging(temporary)
                try:
                    raise RuntimeError("diagnostic-test-marker")
                except RuntimeError as exc:
                    diagnostics.log_exception(logger, "UNIT_TEST_CONTEXT", exc)
                for handler in root.handlers:
                    handler.flush()
                payload = path.read_text(encoding="utf-8")
                self.assertIn("UNIT_TEST_CONTEXT", payload)
                self.assertIn("RuntimeError: diagnostic-test-marker", payload)
                self.assertIn("Traceback (most recent call last)", payload)
                entries = diagnostics.get_recent_log_entries(10, minimum_level="ERROR")
                matching = [item for item in entries if item["message"].find("UNIT_TEST_CONTEXT") >= 0]
                self.assertTrue(matching)
                self.assertIn("RuntimeError: diagnostic-test-marker", matching[-1]["traceback"])
            finally:
                for handler in list(root.handlers):
                    if getattr(handler, "_palchik_owned", False):
                        root.removeHandler(handler)
                        handler.close()
                root.setLevel(old_level)
                diagnostics._CONFIGURED_PATH = None


if __name__ == "__main__":
    unittest.main()

