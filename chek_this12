import json
import ast
import unittest
from pathlib import Path

from events.catalog import load_default_catalog
from events.contracts import EventStatus
from events.legacy_lifecycle import LegacyEventLifecycle
from events.manager import EventManager

ROOT = Path(__file__).resolve().parents[2]
EVENT_ID = "EVT_002_WORD_SHOCK"


class WordShockMigrationTests(unittest.TestCase):
    def setUp(self):
        self.catalog = load_default_catalog(ROOT)
        self.manager = EventManager(self.catalog, clock=lambda: 10.0)
        self.bridge = LegacyEventLifecycle(self.manager)

    def test_word_shock_config_contains_runtime_timing(self):
        config = self.catalog.configuration(EVENT_ID)
        params = config["parameters"]
        self.assertEqual(params["duration_min_seconds"], 120)
        self.assertEqual(params["duration_max_seconds"], 180)
        self.assertEqual(params["confirmation_after_seconds"], 30)
        self.assertEqual(params["wrong_answer_extension_seconds"], 60)
        self.assertTrue(config["enabled"])

    def test_word_shock_lifecycle_reserves_required_resources(self):
        instance = self.bridge.begin(EVENT_ID, data={"phase_at_start": "phase_0"})
        self.assertEqual(instance.status, EventStatus.ACTIVE)
        self.assertEqual(self.manager.arbiter.owners("keyboard_text_input"), (EVENT_ID,))
        self.assertEqual(self.manager.arbiter.owners("main_gameplay"), (EVENT_ID,))
        self.assertEqual(self.manager.arbiter.owners("event_overlay"), (EVENT_ID,))
        self.assertEqual(self.manager.arbiter.owners("event_timer"), (EVENT_ID,))

    def test_word_shock_blocks_roach_attack_while_exclusive_overlay_is_owned(self):
        instance = self.bridge.begin(EVENT_ID)
        allowed, reason = self.manager.can_start("EVT_001_ROACH_ATTACK")
        self.assertFalse(allowed)
        self.assertEqual(reason, "RESOURCE_EVENT_OVERLAY_OCCUPIED")
        self.bridge.finish(EVENT_ID, cancelled=True, reason="TEST")
        self.assertTrue(self.manager.can_start("EVT_001_ROACH_ATTACK")[0])

    def test_application_routes_all_word_shock_terminal_paths_through_lifecycle(self):
        source = (ROOT / "main.py").read_text(encoding="utf-8")
        tree = ast.parse(source)
        methods = {
            node.name: node for cls in tree.body if isinstance(cls, ast.ClassDef)
            for node in cls.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
        }
        required = {
            "_start_word_shock", "_cancel_managed_word_shock",
            "_sync_managed_word_shock", "_submit_word_shock_answer",
            "_admin_stop_event", "_admin_reset_event", "_admin_inspect_event",
            "_admin_set_phase", "_admin_start_new_game", "_begin_game_session",
            "_update_game",
        }
        self.assertTrue(required.issubset(methods))
        start_dump = ast.dump(methods["_start_word_shock"])
        self.assertIn("_begin_managed_event", start_dump)
        self.assertIn("duration_min_seconds", start_dump)
        self.assertIn("confirmation_after_seconds", start_dump)
        self.assertIn("wrong_answer_extension_seconds", start_dump)
        for method_name in ("_cancel_managed_word_shock", "_sync_managed_word_shock"):
            self.assertIn("_finish_managed_event", ast.dump(methods[method_name]))
        self.assertIn("_sync_managed_word_shock", ast.dump(methods["_update_game"]))

    def test_game_logic_timing_is_configurable_without_changing_defaults(self):
        source = (ROOT / "game_logic.py").read_text(encoding="utf-8")
        tree = ast.parse(source)
        cls = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "GameLogic")
        methods = {node.name: node for node in cls.body if isinstance(node, ast.FunctionDef)}
        start = ast.dump(methods["start_word_shock"])
        update = ast.dump(methods["update_word_shock"])
        submit = ast.dump(methods["submit_word_shock_answer"])
        self.assertIn("confirmation_after_seconds", start)
        self.assertIn("wrong_answer_extension_seconds", start)
        self.assertIn("word_shock_confirmation_after_seconds", update)
        self.assertIn("word_shock_wrong_answer_extension_seconds", submit)


if __name__ == "__main__":
    unittest.main()

