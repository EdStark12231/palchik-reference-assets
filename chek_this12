            result = ledger.resolve_violation(
                "phase_0",
                f"punishment-{index}",
                "PUNISHMENT",
                current_balance=balance,
            )
            self.assertEqual(result["penalty_percent"], rate)
            self.assertEqual(result["penalty_amount"], amount)
            self.assertEqual(result["balance_after"], after)
            balance = after

        self.assertTrue(ledger.full_balance_penalty_used)

