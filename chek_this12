import unittest
from pathlib import Path

from events.catalog import load_default_catalog
from events.contracts import EventStatus
from events.evt003_penalties import EVT003PenaltyLedger, EVENT_ID
from events.evt003_runtime import EVT003Runtime
from events.manager import EventManager

ROOT = Path(__file__).resolve().parents[2]


class FakeLogic:
    def __init__(self):
        self.score = 1000
        self.phase = "phase_0"
        self.evt003_penalty_ledger = EVT003PenaltyLedger()
        self.pending_notification = None

    def get_phase(self):
        return self.phase

    def reserve_evt003_attempt(self, phase, occurrence_id):
        return self.evt003_penalty_ledger.reserve_attempt(phase, occurrence_id)

    def record_evt003_compliance(self, phase, occurrence_id):
        return self.evt003_penalty_ledger.record_compliance(phase, occurrence_id)

    def resolve_evt003_violation(self, phase, occurrence_id, decision, *, pending_notification=None):
        result = self.evt003_penalty_ledger.resolve_violation(
            phase, occurrence_id, decision, current_balance=self.score
        )
        if pending_notification is not None:
            self.pending_notification = dict(pending_notification)
        if not result["already_resolved"] and decision == "PUNISHMENT":
            self.score = result["balance_after"]
        return result


class EVT003RuntimeTests(unittest.TestCase):
    def setUp(self):
        self.now = 100.0
        self.logic = FakeLogic()
        self.catalog = load_default_catalog(ROOT)
        self.manager = EventManager(self.catalog, clock=lambda: self.now)
        self.runtime = EVT003Runtime(self.manager, self.logic, project_root=ROOT,
                                     clock=lambda: self.now)

    def test_catalog_registers_event_through_existing_architecture(self):
        definition = self.catalog.get(EVENT_ID)
        self.assertIsNotNone(definition)
        self.assertEqual(definition.source.value, "RANDOM")
        self.assertIn("mouse_input", definition.exclusive_resources)

    def test_evt003_cannot_overlap_existing_managed_gameplay_event(self):
        roach = self.manager.begin("EVT_001_ROACH_ATTACK")
        allowed, reason = self.runtime.can_start("phase_0")
        self.assertFalse(allowed)
        self.assertIsNotNone(reason)
        self.manager.finish(roach.instance_id, cancelled=True, reason="TEST")
        self.assertTrue(self.runtime.can_start("phase_0")[0])

    def test_compliance_after_thirty_seconds_releases_resources(self):
        instance = self.runtime.start("phase_0")
        self.now += 29.9
        self.assertIsNone(self.runtime.update(instance.instance_id))
        self.now += 0.1
        result = self.runtime.update(instance.instance_id)
        self.assertEqual(result["outcome"], "COMPLIANCE")
        self.assertEqual(self.manager.instances[instance.instance_id].status, EventStatus.COMPLETED)
