                footer_surface = pygame.font.SysFont("Arial", 8, bold=False).render(footer_text, True, footer_color)
            layer.blit(footer_surface, footer_surface.get_rect(center=(panel_w // 2, footer_y)))

        scaled = pygame.transform.scale(layer, (draw_w, draw_h))
