    def apply_glitch(self, text, intensity):
        if not self.effects_enabled:
            return text
        if intensity <= 0 or not text:
            return text
        result = list(text)
        for i in range(len(result)):
            if result[i].isalpha() and random.random() < intensity:
                choice = random.randint(0, 2)
                if choice == 0:
                    garbage = random.choice("@#$%&*§?")
                    result[i] = garbage
                elif choice == 1 and i < len(result)-1 and result[i+1].isalpha():
                    result[i], result[i+1] = result[i+1], result[i]
        return "".join(result)

