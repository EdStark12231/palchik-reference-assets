# Оптимизированный шейдер: уменьшено количество итераций noise с 8 до 5
FRAGMENT_SHADER = """
#version 330

in vec2 v_text;
uniform sampler2D u_texture;
uniform vec2 u_resolution;
uniform float u_time;
uniform float u_effects_enabled;
uniform float u_channel_switch;
uniform float u_channel_time;
out vec4 f_color;

const float PI = 3.14159265;

vec3 tex2D(sampler2D tex, vec2 p)
{
    vec3 col = texture(tex, p).rgb;
    if (0.5 < abs(p.x - 0.5))
        col = vec3(0.1);
    return col;
}

float hash(vec2 v)
{
    return fract(sin(dot(v, vec2(89.44, 19.36))) * 22189.22);
}

float iHash(vec2 v, vec2 r)
{
    vec2 v_r = v * r;
    vec2 fl = floor(v_r);
    vec2 fr = fract(v_r);
    float h00 = hash((fl + vec2(0.0, 0.0)) / r);
    float h10 = hash((fl + vec2(1.0, 0.0)) / r);
    float h01 = hash((fl + vec2(0.0, 1.0)) / r);
    float h11 = hash((fl + vec2(1.0, 1.0)) / r);
    vec2 ip = smoothstep(vec2(0.0), vec2(1.0), fr);
    return (h00 * (1.0 - ip.x) + h10 * ip.x) * (1.0 - ip.y) + (h01 * (1.0 - ip.x) + h11 * ip.x) * ip.y;
}

float noise(vec2 v)
{
    float sum = 0.0;
    // Уменьшено с 9 до 5 итераций для производительности
    for (int i = 1; i < 6; i++)
    {
        float fi = float(i);
        sum += iHash(v + vec2(fi), vec2(2.0 * pow(2.0, fi))) / pow(2.0, fi);
    }
    return sum;
}

void main()
{
    vec2 uv = v_text;
    if (u_channel_switch > 0.5) {
        float progress = clamp(u_channel_time / 1.2, 0.0, 1.0);
        float frame = floor(u_channel_time * 30.0);
        vec2 pixel = floor(uv * u_resolution);
        float row = floor(pixel.y / 2.0);
        float row_noise = hash(vec2(row, frame + 17.0));
        vec3 transition_color;

        // Brief colored analog interference: dense RGB noise and rolling bands.
        if (progress < 0.27) {
            float jitter = (hash(vec2(row, frame + 3.0)) - 0.5) * 0.055;
            vec2 noisy_uv = clamp(uv + vec2(jitter, 0.0), vec2(0.0), vec2(1.0));
            vec2 noisy_pixel = floor(noisy_uv * u_resolution);
            float n_r = hash(noisy_pixel + vec2(frame * 13.0, 2.0));
            float n_g = hash(noisy_pixel + vec2(5.0, frame * 17.0));
            float n_b = hash(noisy_pixel + vec2(frame * 23.0, 11.0));
            vec3 rgb_noise = vec3(n_r, n_g, n_b);
            float wave = noisy_uv.y * 78.0 + noisy_uv.x * 18.0 + frame * 0.34;
            vec3 color_bands = vec3(
                0.5 + 0.5 * sin(wave),
                0.5 + 0.5 * sin(wave + 2.094),
                0.5 + 0.5 * sin(wave + 4.188)
            );
            float roll = 0.5 + 0.5 * sin(noisy_uv.y * 31.0 - frame * 0.52);
            transition_color = mix(rgb_noise, color_bands, 0.58);
            transition_color *= mix(0.34, 1.18, roll);
        }
        // Hard white flash with fragmented horizontal signal tearing on the right.
        else if (progress < 0.53) {
            float tear_band = step(0.63, row_noise);
            float tear_start = 0.34 + 0.54 * hash(vec2(row, frame + 29.0));
            float fragment = step(tear_start, uv.x) * tear_band;
            float dash = step(0.52, hash(vec2(floor(pixel.x / 4.0), row + frame * 3.0)));
            float dark_shard = fragment * dash;
            float red_shard = dark_shard * step(0.91, hash(vec2(row, frame + 7.0)));
            float cyan_shard = dark_shard * step(0.94, hash(vec2(row, frame + 19.0)));
            transition_color = vec3(0.985);
            transition_color = mix(transition_color, vec3(0.012), dark_shard * 0.96);
            transition_color = mix(transition_color, vec3(0.88, 0.025, 0.07), red_shard * 0.92);
            transition_color = mix(transition_color, vec3(0.02, 0.62, 0.88), cyan_shard * 0.9);
            float white_speck = step(0.996, hash(pixel + vec2(frame * 41.0, frame * 7.0)));
            transition_color = mix(transition_color, vec3(1.0), white_speck);
        }
        // Dense black-and-white television snow with occasional horizontal dropouts.
        else {
            float grain = hash(pixel + vec2(frame * 37.0, frame * 19.0));
            float fine_grain = hash(floor(pixel * 0.5) + vec2(frame * 11.0, frame * 7.0));
            float static_value = mix(step(0.5, grain), step(0.5, fine_grain), 0.16);
            float dropout = step(0.986, hash(vec2(row, frame + 5.0)));
            float dark_band = step(0.992, hash(vec2(row * 0.5, frame + 13.0)));
            static_value *= 1.0 - dropout * 0.78;
            static_value = mix(static_value, 0.025, dark_band * 0.9);
            transition_color = vec3(static_value);
        }

        // Isolated black cuts separate the signal fragments, not a long fade.
        if (frame == 9.0 || frame == 19.0 || frame == 28.0) {
            transition_color = vec3(0.0);
        }

        vec3 source_color = texture(u_texture, uv).rgb;
        float noise_mix = smoothstep(0.0, 0.018, progress);
        f_color = vec4(mix(source_color, transition_color, noise_mix), 1.0);
        return;
    }
    if (u_effects_enabled < 0.5) {
        f_color = texture(u_texture, uv);
        return;
    }
    vec2 uvn = uv;
    float time = u_time;
    vec2 resolution = u_resolution;

    uvn.x += (noise(vec2(uvn.y, time)) - 0.5) * 0.005;
    uvn.x += (noise(vec2(uvn.y * 100.0, time * 10.0)) - 0.5) * 0.006;

    float tcPhase = clamp((sin(uvn.y * 8.0 - time * PI * 1.2) - 0.92) * noise(vec2(time)), 0.0, 0.01) * 10.0;
    float tcNoise = max(noise(vec2(uvn.y * 100.0, time * 10.0)) - 0.5, 0.0);
    uvn.x = uvn.x - tcNoise * tcPhase;

    float snPhase = smoothstep(0.03, 0.0, uvn.y);
    uvn.y += snPhase * 0.3;
    uvn.x += snPhase * ((noise(vec2(uv.y * 100.0, time * 10.0)) - 0.5) * 0.2);

    vec3 col = tex2D(u_texture, uvn);
    col *= 1.0 - tcPhase;
    col = mix(col, col.yzx, snPhase);

    // Уменьшено количество итераций хроматической аберрации с 7 до 4
    for (float x = -3.0; x < 2.0; x += 1.0)
    {
        col.rgb += vec3(
            tex2D(u_texture, uvn + vec2(x - 0.0, 0.0) * 4.5e-3).r,
            tex2D(u_texture, uvn + vec2(x - 2.0, 0.0) * 4.5e-3).g,
            tex2D(u_texture, uvn + vec2(x - 4.0, 0.0) * 4.5e-3).b
        ) * 0.1;
    }
    col *= 0.6;

    col *= 1.0 + clamp(noise(vec2(0.0, uv.y + time * 0.2)) * 0.6 - 0.25, 0.0, 0.1);

    float scanline = sin(uv.y * resolution.y * 1.5) * 0.03;
    col -= vec3(scanline);

    f_color = vec4(col, 1.0);
}
"""


