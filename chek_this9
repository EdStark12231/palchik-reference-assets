    def _open_admin_log_file(self):
        self.log_file_path.parent.mkdir(parents=True, exist_ok=True)
        self.log_file_path.touch(exist_ok=True)
        try:
            if os.name == "nt":
                os.startfile(str(self.log_file_path))
            else:
                subprocess.Popen(["xdg-open", str(self.log_file_path)])
        except Exception as exc:
            self._log_exception("ADMIN_LOG_OPEN", exc)
            self._show_notification("Не удалось открыть файл журнала. См. путь в панели.", duration=2500)

    def _start_evt004_audio(self):
        """Start EVT004's configured music through pygame.mixer.music."""
        self.audio_box.stop_music()
        music_path = self.evt004_audio_config.get("music")
        if not music_path:
            self.app_logger.warning("EVT_004 has no music path in its event config")
            return False
        started = self.audio_box.play_event_music(music_path, volume=0.30, label="evt004")
        if not started:
            self.app_logger.warning("EVT_004 theme could not be started: %s", music_path)
        return started

    def _route_evt004_audio_events(self, events):
        """Route runtime state transitions to dedicated EVT004 sound channels."""
        sound_paths = self.evt004_audio_config.get("events", {})
        for event_key in events:
            if event_key == "wing_flap_loop_stop":
                self.audio_box.stop_evt004_sfx("wing_flap_loop")
                self._evt004_wing_loop_active = False
                continue
            loop = event_key == "wing_flap_loop_start"
            sound_key = "wing_flap_loop" if loop else event_key
            sound_path = sound_paths.get(sound_key)
            if not sound_path:
                self.app_logger.warning("EVT_004 audio key missing from config: %s", sound_key)
                continue
            self.audio_box.play_evt004_sfx(
                sound_path, event_key=sound_key, loop=loop,
                volume=0.42 if loop else 0.78,
            )
            if loop:
                self._evt004_wing_loop_active = True

    def _stop_evt004_audio(self):
        """Stop only audio owned by EVT004."""
        self.audio_box.stop_evt004_audio()
        self.audio_box.stop_event_music(label="evt004")
        self._evt004_wing_loop_active = False

    def _initialize_evt004_instance(self, instance):
        """Build and start EVT004; release EventManager claims if setup fails."""
        self.evt004_instance_id = instance.instance_id
        self.evt004_started_at = time.monotonic()
        try:
            surface_size = (self.game_view.width, self.game_view.height)
            self.evt004_presentation = AdventureRoadPresentation(self.game_view)
            self.evt004_runtime = self.evt004_presentation.build_runtime(
                surface_size, Path(__file__).resolve().parent, dragon_hp=8,
            )
            self.evt004_runtime.start()
            self._start_evt004_audio()
            self._route_evt004_audio_events(self.evt004_runtime.drain_audio_events())
            return True
        except Exception:
            self.app_logger.exception("EVT_004 initialization failed")
            self._stop_evt004_audio()
            try:
                self.event_manager.finish(
                    instance.instance_id, cancelled=True, reason="INITIALIZATION_FAILED",
                )
            except Exception:
                self.app_logger.exception("EVT_004 failed to release startup resources")
            self.evt004_runtime = None
            self.evt004_presentation = None
            self.evt004_instance_id = None
            self.evt004_started_at = 0.0
            self._show_notification("EVT_004: ОШИБКА ЗАПУСКА · СМ. ЖУРНАЛ", duration=2500)
            return False

