                actual_rect.x + int(local_rect.x * hit_scale_x),
                actual_rect.y + int(local_rect.y * hit_scale_y),
                max(1, int(local_rect.width * hit_scale_x)),
                max(1, int(local_rect.height * hit_scale_y)),
