        )
        surf.blit(progress, (win.x + 22, win.bottom - 43))

        self.intro_slide_button_rect = None
        if self.intro_slide_char_index >= len(self.intro_slide_full_text):
            button_w, button_h = 174, 42
            button = pygame.Rect(win.right - button_w - 22, win.bottom - 54, button_w, button_h)
