    def _handle_menu_events(self, event):
        if event.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode((event.w, event.h), pygame.FULLSCREEN | pygame.DOUBLEBUF | pygame.OPENGL)
            self._setup_menu_hitboxes()
            self.game_view.width, self.game_view.height = event.w, event.h
            self.game_view.recalculate_layout()
        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            self.menu_cursor.trigger_click_animation()
            if self.settings_box.is_open:
                self._handle_settings_click(event.pos)
            else:
                self.menu_cursor.handle_click(event.pos, event.pos)

    def _handle_settings_click(self, pos):
        for name, rect in self.settings_box.hitboxes.items():
            if rect.collidepoint(pos):
                if name.startswith("lang_"):
                    code = name.split("_")[1]
                    self.current_lang = code
                    self.game_logic.current_lang = code
                    SaveManager.save_game_data(self.game_logic.score, code, self.game_logic.total_clicks, self.game_logic.wallpaper_index)
                    self.settings_box.close_dialog()
                elif name == "vol_minus":
                    self.audio_box.set_volume(self.audio_box._volume - 0.1)
                elif name == "vol_plus":
                    self.audio_box.set_volume(self.audio_box._volume + 0.1)
                elif name == "toggle_vibration":
                    self.settings_box.vibration = not self.settings_box.vibration
                elif name == "toggle_audio_acc":
                    self.settings_box.accessibility_audio = not self.settings_box.accessibility_audio
                    self.audio_box.accessibility_audio = self.settings_box.accessibility_audio
                elif name == "toggle_visual_acc":
                    self.settings_box.accessibility_visual = not self.settings_box.accessibility_visual
                elif name == "btn_close":
                    self.settings_box.close_dialog()
                return

    def _cancel_archive_pin(self):
        logic = self.game_logic
        logic.code_window_open = False
        logic.input_buffer = [None, None, None]
        logic.current_cell_index = 0
        logic.current_cell_buffer = ""
        logic.system_response_text = ""
        logic.failed_attempts_count = 0
        logic.auto_close_timer = 0.0
        self.code_init_active = False
        self.game_view.code_window_dirty = True

    def _submit_archive_pin(self):
        logic = self.game_logic
        if self.code_init_active:
            return
        if logic.current_cell_buffer or any(value is None for value in logic.input_buffer):
            logic.system_response_text = "Введите все три части PIN-кода."
            self.game_view.code_window_dirty = True
            return

        if logic.input_buffer == logic.secret_code:
            logic.lore_icon_visible = False
            logic.input_buffer = [None, None, None]
            logic.current_cell_index = 0
            logic.current_cell_buffer = ""
            logic.failed_attempts_count = 0
            logic.auto_close_timer = 0.0
            SaveManager.save_game_data(
                logic.score,
                self.current_lang,
                logic.total_clicks,
                logic.wallpaper_index,
                self.player_name,
                logic.system_os_user,
            )
            self._start_code_init_sequence()
            return

        logic.failed_attempts_count += 1
        logic.input_buffer = [None, None, None]
        logic.current_cell_index = 0
        logic.current_cell_buffer = ""
        if logic.failed_attempts_count >= 3:
            logic.system_response_text = "Ошибка доступа"
            logic.auto_close_timer = 2.0
        else:
            logic.system_response_text = "Ошибка доступа. Код неверен."
        self.game_view.code_window_dirty = True

    def _start_code_init_sequence(self):
        self.code_init_active = True
        self.code_init_step = 0
        self.code_init_text = "Инициализация проверки системы.. Пожалуйста, подождите"
        self.code_init_display = ""
        self.code_init_word_index = 0
        self.code_init_timer = 0.0
        self.code_init_phase_timer = 0.0
        self.code_init_word_count = 0
        self.code_init_current_word = 0
        self.game_logic.system_response_text = ""
        self.game_view.code_window_dirty = True

    def _update_code_init(self, dt):
        if not self.code_init_active:
            return
        
        if self.code_init_step == 0:
            if self.code_init_word_count == 0:
                words = self.code_init_text.split()
                self.code_init_word_count = len(words)
                self.code_init_current_word = 0
                self.code_init_display = ""
            
            self.code_init_timer += dt
            if self.code_init_timer >= 0.4:
                self.code_init_timer = 0.0
                if self.code_init_current_word < self.code_init_word_count:
                    words = self.code_init_text.split()
                    if self.code_init_display:
                        self.code_init_display += " " + words[self.code_init_current_word]
                    else:
                        self.code_init_display = words[self.code_init_current_word]
                    self.code_init_current_word += 1
                    self.game_logic.system_response_text = self.code_init_display
                    self.game_view.code_window_dirty = True
                else:
                    self.code_init_step = 1
                    self.code_init_phase_timer = 0.0
                    self.code_init_timer = 0.0
                    self.code_init_current_word = 0
                    self.code_init_display = ""
        
        elif self.code_init_step == 1:
            self.code_init_phase_timer += dt
            if self.code_init_phase_timer >= 2.5:
                self.code_init_text = "Инициализация завершена. Сектор памяти восстановлен."
                self.code_init_step = 2
                self.code_init_timer = 0.0
                self.code_init_current_word = 0
                self.code_init_display = ""
                self.code_init_phase_timer = 0.0
                self.code_init_word_count = 0
                self.game_view.code_window_dirty = True
        
        elif self.code_init_step == 2:
            if self.code_init_word_count == 0:
                words = self.code_init_text.split()
                self.code_init_word_count = len(words)
                self.code_init_current_word = 0
                self.code_init_display = ""
            
            self.code_init_timer += dt
            if self.code_init_timer >= 0.4:
                self.code_init_timer = 0.0
                if self.code_init_current_word < self.code_init_word_count:
                    words = self.code_init_text.split()
                    if self.code_init_display:
                        self.code_init_display += " " + words[self.code_init_current_word]
                    else:
                        self.code_init_display = words[self.code_init_current_word]
                    self.code_init_current_word += 1
                    self.game_logic.system_response_text = self.code_init_display
                    self.game_view.code_window_dirty = True
                else:
                    self.code_init_step = 3
                    self.code_init_phase_timer = 0.0
                    self.code_init_timer = 0.0
        
        elif self.code_init_step == 3:
            self.code_init_phase_timer += dt
            if self.code_init_phase_timer >= 1.5:
                self.game_logic.code_window_open = False
                self.code_init_active = False
                self.game_logic.system_response_text = ""
                self.game_logic.input_buffer = [None, None, None]
                self.game_logic.current_cell_index = 0
                self.game_logic.current_cell_buffer = ""
                self.channel_switch_active = True
                self.channel_switch_start_ms = pygame.time.get_ticks()
                self.audio_box.play_channel_switch()

    def _update_hidden_system(self, dt):
        logic = self.game_logic
        if getattr(logic, "auto_close_timer", 0.0) > 0:
            logic.auto_close_timer -= dt
            if logic.auto_close_timer <= 0:
                logic.code_window_open = False
                logic.secret_code = [14, 17, 23]
                random.shuffle(logic.secret_code)
                logic.failed_attempts_count = 0
                logic.input_buffer = [None, None, None]
                logic.current_cell_index = 0
                logic.current_cell_buffer = ""
                logic.system_response_text = ""
                SaveManager.save_game_data(
                    logic.score,
                    self.current_lang,
                    logic.total_clicks,
                    logic.wallpaper_index,
                    self.player_name,
                    getattr(logic, "system_os_user", "")
                )

    def _evt003_schedule_phase(self, phase):
        self.evt003_scheduled_phase = str(phase)
        self.evt003_next_check_at = time.monotonic() + random.uniform(
            self.evt003_runtime.random_delay_min_seconds,
            self.evt003_runtime.random_delay_max_seconds,
        )

    def _evt003_begin_gameplay_entry(self):
        # Sandbox punishment follows the same visible menu -> next-entry dialog
        # flow as a real event, but its notice stays volatile and never enters saves.
        sandbox_pending = getattr(self, "evt003_sandbox_pending_notice", None)
        if isinstance(sandbox_pending, dict) and sandbox_pending.get("text"):
            self.evt003_dialog_payload = dict(sandbox_pending)
            self.evt003_state = "PENDING_NOTICE"
            self.evt003_is_sandbox = True
        else:
            pending = getattr(self.game_logic, "evt003_pending_notification", None)
            if isinstance(pending, dict) and pending.get("text"):
                self.evt003_dialog_payload = dict(pending)
                self.evt003_state = "PENDING_NOTICE"
            else:
                self.evt003_state = None
                self.evt003_dialog_payload = None
            self.evt003_is_sandbox = False
        self.evt003_instance_id = None
        self._evt003_schedule_phase(self.game_logic.get_phase())

    def _maybe_start_evt003(self):
        if self.current_screen != "game" or self.crash_stage != 0:
            return
        if self.intro_slides_active or self.name_entry_active or self.admin_panel_open or self.channel_switch_active:
            return
        phase = self.game_logic.get_phase()
        now = time.monotonic()
        if phase != self.evt003_scheduled_phase:
            self._evt003_schedule_phase(phase)
        if now < self.evt003_next_check_at:
            return
        logic = self.game_logic
        blocked = (
            logic.word_shock_active or logic.roach_attack_active
            or logic.minigame_active or logic.timer_active or logic.sprite_active
            or logic.chase_planet_active or logic.fade_screen_active
            or logic.code_window_open or logic.lore_window_open
            or logic.lore_text_viewer_open or logic.lore_image_viewer_open
            or self.settings_box.is_open
        )
        if blocked:
            self.evt003_next_check_at = now + 4.0
            return
        allowed, reason = self.evt003_runtime.can_start(phase)
        if not allowed:
            if reason == "ALREADY_OCCURRED_THIS_PHASE":
                self.evt003_next_check_at = float("inf")
            else:
                self.evt003_next_check_at = now + 5.0
            return
        try:
            instance = self.evt003_runtime.start(phase)
        except Exception as exc:
            self._log_exception("EVT003_RANDOM_START", exc)
            self.evt003_next_check_at = now + 8.0
            return
        self.evt003_instance_id = instance.instance_id
        self.evt003_started_at = float(instance.started_at or now)
        self.evt003_typewriter_count = 0
        self.evt003_typewriter.reset(
            "PLEASE DON'T TOUCH ANYTHING", started_at=self.evt003_started_at,
            interval=self.evt003_typewriter_interval,
        )
        self.evt003_is_sandbox = False
        self.evt003_state = "RUNNING"

    def _evt003_violation(self):
        if self.evt003_state != "RUNNING" or not self.evt003_instance_id:
            return
        try:
            result = self.evt003_runtime.register_click(self.evt003_instance_id)
        except Exception as exc:
            self._log_exception("EVT003_VIOLATION_RESOLUTION", exc)
            # Fail closed: do not route this click into ordinary gameplay.
            self.evt003_state = "GAME_OVER"
            self.evt003_gameover_started_at = time.monotonic()
            self.audio_box.play_evt003_failure()
            return
        self.evt003_instance_id = None
        self.evt003_dialog_payload = {
            "text": result["notification_text"],
            "title": "СИСТЕМНОЕ ПРЕДУПРЕЖДЕНИЕ" if result["decision"] == "FORGIVENESS" else "СИСТЕМНОЕ НАРУШЕНИЕ",
            "phase": result["phase"],
            "notification_type": result["notification_type"],
        }
        if result.get("sandbox") and result["decision"] == "PUNISHMENT":
            # The real runtime persists its notice in GameLogic. Sandbox must
            # mirror the presentation without touching persistent player data.
            self.evt003_sandbox_pending_notice = dict(self.evt003_dialog_payload)
        if result["decision"] == "FORGIVENESS":
            self.evt003_state = "FORGIVENESS_DIALOG"
            self.audio_box.play_evt003_reprimand()
        else:
            self.evt003_state = "GAME_OVER"
            self.evt003_gameover_started_at = time.monotonic()
            self.audio_box.play_evt003_failure()

    def _evt003_acknowledge_dialog(self):
        state = self.evt003_state
        if state == "PENDING_NOTICE":
            if self.evt003_is_sandbox:
                self.evt003_sandbox_pending_notice = None
            else:
                self.game_logic.consume_evt003_pending_notification()
        was_sandbox = self.evt003_is_sandbox
        self.evt003_state = None
        self.evt003_instance_id = None
        self.evt003_dialog_payload = None
        self.evt003_ok_rect = None
        self.evt003_is_sandbox = False
        if was_sandbox:
            self._evt003_schedule_phase(self.game_logic.get_phase())
        self.audio_box.play_click()

    def _evt003_cancel_sandbox(self):
        instance_id = self.evt003_instance_id
        try:
            if instance_id:
                self.evt003_runtime.cancel(instance_id, reason="ADMIN_SANDBOX_ESCAPE")
        except Exception as exc:
            self._log_exception("EVT003_SANDBOX_CANCEL", exc)
        self.evt003_instance_id = None
        self.evt003_state = None
        self.evt003_dialog_payload = None
        self.evt003_ok_rect = None
        self.evt003_typewriter_count = 0
        self.evt003_is_sandbox = False
        self._evt003_schedule_phase(self.game_logic.get_phase())
        self._show_notification("EVT_003 SANDBOX: тест отменён; сохранения не изменены.", duration=2200)

    def _handle_evt003_event(self, event):
        """Exclusive input path while the check, animation or Win95 dialog is active."""
        if event.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode(
                (event.w, event.h), pygame.FULLSCREEN | pygame.DOUBLEBUF | pygame.OPENGL
            )
            self._setup_menu_hitboxes()
            self.game_view.width, self.game_view.height = event.w, event.h
            self.game_view.recalculate_layout()
            return
        if self.evt003_is_sandbox and event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
            self._evt003_cancel_sandbox()
            return
        if self.evt003_state == "RUNNING":
            if event.type in (pygame.MOUSEBUTTONDOWN, pygame.MOUSEWHEEL):
                # At/after the 30-second deadline the check has already succeeded;
                # do not turn a late event-queue delivery into a false violation.
                if time.monotonic() - self.evt003_started_at >= self.evt003_runtime.duration_seconds:
                    self._update_evt003()
                else:
                    self._evt003_violation()
            return
        if self.evt003_state in ("FORGIVENESS_DIALOG", "PENDING_NOTICE"):
            acknowledge = event.type == pygame.KEYDOWN and event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE)
            if event.type == pygame.MOUSEBUTTONDOWN and self.evt003_ok_rect:
                win_w, win_h = self.screen.get_size()
                tex_w, tex_h = self.screen_texture.size
                pos = (
                    int(event.pos[0] * tex_w / max(1, win_w)),
                    int(event.pos[1] * tex_h / max(1, win_h)),
                )
                acknowledge = self.evt003_ok_rect.collidepoint(pos)
            if acknowledge:
                self._evt003_acknowledge_dialog()
            return
        # The punishment animation is intentionally non-interactive.
        return

    def _update_evt003(self):
        now = time.monotonic()
        if self.evt003_state == "RUNNING":
            elapsed = max(0.0, now - self.evt003_started_at)
            newly_revealed = self.evt003_typewriter.advance(now)
            self.evt003_typewriter_count = self.evt003_typewriter.visible_count
            for _ in range(newly_revealed):
                self.audio_box.play_typewriter_tick()
            try:
                outcome = self.evt003_runtime.update(self.evt003_instance_id)
            except Exception as exc:
                self._log_exception("EVT003_COMPLIANCE_SAVE", exc)
                was_sandbox = self.evt003_is_sandbox
                try:
                    self.evt003_runtime.cancel(self.evt003_instance_id, reason="PRESENTATION_RECOVERY")
                except Exception:
                    pass
                self.evt003_instance_id = None
                self.evt003_state = None
                self.evt003_is_sandbox = False
                self._show_notification("EVT_003: ошибка. Подробности: F2 → ЖУРНАЛ.", duration=3500)
                if was_sandbox:
                    self._evt003_schedule_phase(self.game_logic.get_phase())
                return
            if outcome is not None:
                was_sandbox = self.evt003_is_sandbox
                self.evt003_instance_id = None
                self.evt003_state = None
                self.evt003_typewriter_count = 0
                self.audio_box.play_evt003_success()
                if was_sandbox:
                    self.evt003_is_sandbox = False
                    self._evt003_schedule_phase(self.game_logic.get_phase())
                    self._show_notification("SANDBOX: COMPLIANCE · баланс и история не изменены.", duration=2600)
                else:
                    self.evt003_next_check_at = float("inf")
            return
        if self.evt003_state == "GAME_OVER":
            progress = (now - self.evt003_gameover_started_at) / 2.35
            if progress >= 1.0:
                was_sandbox = self.evt003_is_sandbox
                self.evt003_state = None
                self.evt003_dialog_payload = None
                self.evt003_instance_id = None
                self.evt003_is_sandbox = False
                if was_sandbox:
                    # Sandbox isolates persistent balance/history, not the visible game-over flow.
                    self._evt003_schedule_phase(self.game_logic.get_phase())
                    self.admin_panel_open = False
                self.current_screen = "menu"
                self.audio_box.play_menu_music()
            return

    def _update_game(self):
        if self.evt004_result_state is not None:
            self._update_evt004_result_screen()
            return
        if self.event_collection_open or self.secret_input_open:
            return
        if self.evt004_runtime is not None:
            self._update_evt004(self.clock.get_time() / 1000.0)
            # EVT004 has an exclusive main_gameplay claim; do not tick normal gameplay underneath it.
            return
        if self.evt003_state is not None:
            self._update_evt003()
            return
        self._maybe_start_evt003()
        if self.evt003_state is not None:
            return
        if self.game_logic.word_shock_active or self.event_lifecycle.is_tracked("EVT_002_WORD_SHOCK"):
            self._sync_managed_word_shock()
        if self.game_logic.word_shock_active:
            word_shock_update = self.game_logic.update_word_shock()
            if word_shock_update == "MODAL_OPEN":
                pygame.key.start_text_input()
            elif word_shock_update == "EXPIRED":
                pygame.key.stop_text_input()
                self._sync_managed_word_shock()
            return
        now = pygame.time.get_ticks()
        dt = self.clock.get_time() / 1000.0
        self._update_hidden_system(dt)
        self._update_code_init(dt)
        
        # Отслеживаем завершение погони, чтобы проиграть звук ухода планеты
        # только при истечении таймера, а не после успешного захвата.
        chase_was_active = self.game_logic.sprite_active
        chase_timer_was_active = self.game_logic.timer_active

        # Оптимизация: GameLogic.update() вызываем с dt для возможности throttling
        self.game_logic.update()
        self._sync_managed_roach_attack()
        sequence_update = self.game_logic.update_roach_sequence()
        if sequence_update == "ROACH_TRIGGER":
            self._start_roach_attack()
        _roach_mode_blocked = (
            self.game_logic.minigame_active
            or self.game_logic.timer_active
            or self.game_logic.sprite_active
            or self.game_logic.chase_planet_active
            or self.game_logic.fade_screen_active
            or self.game_logic.clicks_in_cycle >= 10
        )
        if self.game_logic.roach_attack_active and not _roach_mode_blocked:
            _roach_forbidden = self.game_view.rect_target.inflate(170, 150)
            _win_w, _win_h = self.screen.get_size()
            _tex_w, _tex_h = self.screen_texture.size
            _mouse = pygame.mouse.get_pos()
            _cursor_tex = (
                int(_mouse[0] * (_tex_w / max(1, _win_w))),
                int(_mouse[1] * (_tex_h / max(1, _win_h))),
            )
            self.game_logic.update_roaches(
                dt, self.game_view.width, self.game_view.height,
                _roach_forbidden, cursor_pos=_cursor_tex,
            )
        self._sync_roach_audio()

        if (
            chase_was_active
            and chase_timer_was_active
            and not self.game_logic.sprite_active
            and self.game_logic.fade_screen_active
        ):
            self.audio_box.play_chase_planet("escape")

        self.game_view.update_animations()
        
        # Оптимизация CPU: обновляем уведомления и horror-фразы не каждый кадр, а раз в ~200 мс
        if now - getattr(self, '_last_notification_update', 0) >= 200:
            self._last_notification_update = now
            
            if self.game_logic.clicks_in_cycle >= 10 and not self.game_logic.minigame_active and not self.game_logic.timer_active and not self.game_logic.fade_screen_active:
                now_ms = int(time.monotonic() * 1000)
                if self.game_logic.notification_timer <= now_ms or self.game_logic.notification_text in ("", TRANSLATIONS[self.current_lang]["hint"]):
                    text_source = TRANSLATIONS[self.current_lang]
                    
                    phase_key = self.game_logic.get_phase()
                    
                    if phase_key in ["phase_0", "phase_1"]:
                        phrases_pool = text_source["phrases"]
                    else:
                        phrases_pool = text_source["horror_phrases"]
                        
                    self.game_logic.set_notification(random.choice(phrases_pool), duration=5000)
            
            # Update personalized horror phrases based on phase
            if self.game_logic.is_horror_phase() and self.game_logic.player_name:
                phase_idx = self.game_logic.get_phase_index()
                phase_num = min(4, max(0, phase_idx - 1))
                
                if phase_num >= 2:
                    personalized = self.game_logic.get_personalized_horror_phrase(self.current_lang, phase_num)
                    if personalized and random.random() < 0.3:
                        self.game_logic.set_notification(personalized, duration=7000)

        if now - self.game_last_blink_time >= 500:
            self.game_blink_visible = not self.game_blink_visible
            self.game_last_blink_time = now
        else:
            self.game_blink_visible = True
        if self.final_phase_triggered and self.game_logic.is_final_phase():
            keep = self.game_view.update_typewriter(self.game_logic.total_clicks)
            self.typed_phrase = self.game_view.display_phrase
            if not keep and not self.game_logic.timer_active:
                self.game_logic.timer_active = False
                self.crash_stage = 1
                self.fake_crash_start = now
        else:
            self.game_view.update_typewriter(self.game_logic.total_clicks)
            self.typed_phrase = self.game_view.display_phrase

        if self.easter_egg_timer and now > self.easter_egg_timer:
            self.easter_egg_phrase = ""
            self.easter_egg_timer = 0
        if self.game_logic.sprite_active and not self.game_logic.minigame_active:
            win_w, win_h = self.screen.get_size()
            tex_w, tex_h = self.screen_texture.size
            mouse_pos = pygame.mouse.get_pos()
            mouse_tex_x = int(mouse_pos[0] * (tex_w / win_w))
            mouse_tex_y = int(mouse_pos[1] * (tex_h / win_h))

            _chase_planets = getattr(self.game_logic, "chase_planets", [])

            if _chase_planets:
                for _planet in _chase_planets:
                    _center_x = _planet["x"] + 22
                    _center_y = _planet["y"] + 22
                    _dx = _center_x - mouse_tex_x
                    _dy = _center_y - mouse_tex_y
                    _dist = math.hypot(_dx, _dy)

                    if 0 < _dist < 110:
                        _planet["x"] += (
                            (_dx / _dist) * self.game_logic.sprite_speed
                            + random.uniform(-1.5, 1.5)
                        )
                        _planet["y"] += (
                            (_dy / _dist) * self.game_logic.sprite_speed
                            + random.uniform(-1.5, 1.5)
                        )

                    _planet["x"] = max(
                        40, min(self.game_view.width - 84, _planet["x"])
                    )
                    _planet["y"] = max(
                        40, min(self.game_view.height - 84, _planet["y"])
                    )

                _first_planet = _chase_planets[0]
                self.game_logic.sprite_x = _first_planet["x"]
                self.game_logic.sprite_y = _first_planet["y"]
            else:
                # Совместимость с прежним одиночным режимом.
                _center_x = self.game_logic.sprite_x + 22
                _center_y = self.game_logic.sprite_y + 22
                _dx = _center_x - mouse_tex_x
                _dy = _center_y - mouse_tex_y
                _dist = math.hypot(_dx, _dy)

                if 0 < _dist < 110:
                    self.game_logic.sprite_x += (
                        (_dx / _dist) * self.game_logic.sprite_speed
                        + random.uniform(-1.5, 1.5)
                    )
                    self.game_logic.sprite_y += (
                        (_dy / _dist) * self.game_logic.sprite_speed
                        + random.uniform(-1.5, 1.5)
                    )

                    self.game_logic.sprite_x = max(
                        40, min(self.game_view.width - 84, self.game_logic.sprite_x)
                    )
                    self.game_logic.sprite_y = max(
                        40, min(self.game_view.height - 84, self.game_logic.sprite_y)
                    )

        if self.game_logic.fade_screen_active:
            current_ms = int(time.monotonic() * 1000)
            if current_ms - self.game_logic.fade_start_time >= self.game_logic.fade_duration:
                self.game_logic.fade_screen_active = False
                self.game_logic.chase_planet_active = False
                self.game_logic.clicks_in_cycle = 0
                self.game_logic.set_notification(TRANSLATIONS[self.current_lang]["hint"], duration=5000)
                self.game_logic.notification_color = (255, 255, 255)

        # If the second main-button press also started an exclusive legacy
        # event, defer the secret prompt until that event releases its gameplay lock.
        if (
            not self.secret_input_open
            and self.secret_prompt_session.prompt_pending
            and not self.game_logic.roach_attack_active
            and not self.game_logic.minigame_active
            and not self.game_logic.timer_active
            and not self.game_logic.sprite_active
            and not self.game_logic.chase_planet_active
            and not self.game_logic.fade_screen_active
            and not self.game_logic.code_window_open
            and not self.game_logic.lore_window_open
        ):
            self._open_secret_input()

        # Subtitle system update
        self._update_subtitles()

    def _load_subtitle_phrases(self, phase):
        """Загружает все фразы для указанной фазы из всех категорий (микс) для текущего языка."""
        lang_code = self.current_lang.lower()
        echoes_dir = os.path.join("assets", "echoes", lang_code)
        
        phase_map = {
            "phase_0": "phase_0.txt",
            "phase_1": "phase_1.txt",
            "phase_2": "phase_2.txt",
            "phase_3": "phase_3.txt",
            "phase_4": "phase_4.txt",
            "final": "final.txt"
        }
        filename = phase_map.get(phase)
        if not filename:
            return []
        
        if not os.path.isdir(echoes_dir):
            return []
        
        all_phrases = []
        for category in os.listdir(echoes_dir):
            category_path = os.path.join(echoes_dir, category)
            if not os.path.isdir(category_path):
                continue
            filepath = os.path.join(category_path, filename)
            if os.path.exists(filepath):
                try:
                    with open(filepath, "r", encoding="utf-8") as f:
                        lines = [line.strip() for line in f if line.strip()]
                        all_phrases.extend(lines)
                except Exception:
                    self.app_logger.exception("Ошибка загрузки субтитров: %s", filepath)
        
        return all_phrases

    def _update_subtitles(self):
        """Обновляет состояние субтитров."""
        if self.current_screen != "game" or self.settings_box.is_open:
            return
            
        dt = self.clock.get_time() / 1000.0
        phase = self.game_logic.get_phase()
        
        if self.subtitle_state == "idle":
            self.subtitle_next_idle_timer += dt
            if self.subtitle_next_idle_timer >= random.uniform(3.0, 8.0):
                phrases = self._load_subtitle_phrases(phase)
                if not phrases:
                    from localization import TRANSLATIONS
                    lang_code = self.current_lang if self.current_lang in TRANSLATIONS else "RU"
                    phrases = TRANSLATIONS[lang_code].get("subtitles", {}).get(phase, [])
                    if not phrases and lang_code != "RU":
                        phrases = TRANSLATIONS["RU"].get("subtitles", {}).get(phase, [])
                if not phrases:
                    phrases = ["..."]
                self.subtitle_full_text = random.choice(phrases)
                self.subtitle_displayed_text = ""
                self.subtitle_state = "typewriter"
                self.subtitle_state_timer = 0.0
                self.subtitle_typewriter_timer = 0.0
                self.subtitle_alpha = 255
                self.subtitle_next_idle_timer = 0.0

        elif self.subtitle_state == "typewriter":
            self.subtitle_typewriter_timer += dt
            if self.subtitle_typewriter_timer >= self.subtitle_typewriter_speed:
                self.subtitle_typewriter_timer = 0.0
                if len(self.subtitle_displayed_text) < len(self.subtitle_full_text):
                    self.subtitle_displayed_text = self.subtitle_full_text[:len(self.subtitle_displayed_text) + 1]
                else:
                    self.subtitle_state = "waiting_click"

        elif self.subtitle_state == "waiting_click":
            # Ждём клика игрока; субтитр скрывается по клику в _handle_game_events
            pass

    def _draw_subtitles(self, surface, font):
        """Рисует субтитры в нижней части экрана. (оптимизировано)"""
        if not self.subtitle_displayed_text or self.subtitle_alpha <= 0:
            return
        
        w, h = surface.get_size()
        bar_height = 80
        bar_y = h - int(h * 0.10) - bar_height // 2
        max_text_width = int(w * 0.80)
        
        # Кэшированный шрифт для измерения
        font_key = ("Arial", 24, True, False)
        fnt = text_cache.get_font_object("Arial", 24, bold=True)
        
        display_text = self.subtitle_displayed_text
        words = display_text.split()
        lines = []
        current_line = []
        
        # Однопроходный перенос строк: измеряем ширину через get_surface (кэшируется)
        for word in words:
            test_line = " ".join(current_line + [word])
            test_surf = text_cache.get_surface(test_line, "Arial", 24, (200, 200, 200), bold=True)
            if test_surf.get_width() <= max_text_width:
                current_line.append(word)
            else:
                if current_line:
                    lines.append(" ".join(current_line))
                current_line = [word]
        if current_line:
            lines.append(" ".join(current_line))
        
        line_height = 28
        total_height = len(lines) * line_height
        
        bg_padding_x = 20
        bg_padding_y = 10
        bg_width = max_text_width + bg_padding_x * 2
        bg_height = total_height + bg_padding_y * 2
        bg_x = (w - bg_width) // 2
        bg_y = bar_y - bg_padding_y
        
        # Фон — только если есть строки
        if lines:
            bg_surf = pygame.Surface((bg_width, bg_height), pygame.SRCALPHA)
            bg_surf.fill((0, 0, 0, int(153 * self.subtitle_alpha / 255)))
            surface.blit(bg_surf, (bg_x, bg_y))
            
            text_start_y = bg_y + bg_padding_y
            for idx, line in enumerate(lines):
                text_y = text_start_y + idx * line_height
                line_surf = text_cache.get_surface(line, "Arial", 24, (255, 255, 255), bold=True)
                line_surf.set_alpha(self.subtitle_alpha)
                text_x = (w - line_surf.get_width()) // 2
                surface.blit(line_surf, (text_x, text_y))
        
        self.subtitle_rect = pygame.Rect(bg_x, bg_y, bg_width, bg_height)

    def _draw_name_entry_to_texture(self):
        w, h = self.screen_texture.size
        surf = pygame.Surface((w, h))
        if self.name_input_scene:
            self.name_input_scene.update()
            self.name_input_scene.draw(surf)
        self._draw_admin_panel(surf)
        self.menu_cursor.draw(surf)
        self.screen_texture.write(pygame.image.tobytes(surf, 'RGBA', True))

    def run(self):
        while self.running:
            # Cursor animations must advance in every scene, not only the menu.
            self.menu_cursor.update()
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    self.running = False
                    pygame.quit()
                    sys.exit()
                if (
                    self.current_screen == "game"
                    and self.evt004_result_state is not None
                ):
                    self._handle_evt004_result_event(event)
                    continue
                if self.current_screen == "game" and self.evt003_state is not None:
                    self._handle_evt003_event(event)
                    continue
                if self.current_screen == "game" and self.game_logic.word_shock_active:
                    if event.type == pygame.KEYDOWN and event.key == pygame.K_F2:
                        self.admin_panel_open = not self.admin_panel_open
                        continue
                    if self.admin_panel_open:
                        if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                            self.admin_panel_open = False
                        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                            self._handle_admin_panel_event(event)
                        elif event.type == pygame.VIDEORESIZE:
                            self._handle_game_events(event)
                        continue
                    self._handle_game_events(event)
                    continue
                if event.type == pygame.KEYDOWN and event.key == pygame.K_F2:
                    panel_available = (
                        self.current_screen == "menu"
                        or (
                            self.current_screen == "game"
                            and not self.channel_switch_active
                            and (self.intro_slides_active or self.name_entry_active or self.crash_stage == 0)
                        )
                    )
                    if panel_available:
                        self.admin_panel_open = not self.admin_panel_open
                    continue
                if self.admin_panel_open:
                    if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                        self.admin_panel_open = False
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        self._handle_admin_panel_event(event)
                    continue
                if self.current_screen == "game" and self.channel_switch_active:
                    continue
                if self.current_screen == "menu":
                    self._handle_menu_events(event)
                elif self.current_screen == "game":
                    if self.intro_slides_active:
                        self._handle_intro_slide_events(event)
                    elif self.name_entry_active:
                        self._handle_name_entry_events(event)
                    elif self.crash_stage == 0:
                        self._handle_game_events(event)
                elif self.current_screen == "intro":
                    if event.type == pygame.KEYDOWN and event.key == pygame.K_SPACE:
                        if self.video:
                            self.video.release()
                        self.current_screen = "menu"
                        self.audio_box.play_menu_music()
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        if self.video:
                            self.video.release()
                        self.current_screen = "menu"
                        self.audio_box.play_menu_music()

            if self.current_screen == "intro" and self.video is not None:
                ret, frame = self.video.read()
                if ret:
                    frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                    f_h, f_w, _ = frame.shape
                    video_surf = pygame.image.frombuffer(frame.tobytes(), (f_w, f_h), "RGB")
                    w, h = self.screen.get_size()
                    scaled = pygame.transform.scale(video_surf, (w, h))
                    self.screen_texture.write(pygame.image.tostring(scaled, 'RGBA', True))
                else:
                    self.video.release()
                    self.current_screen = "menu"
                    self.audio_box.play_menu_music()
                self.ctx.clear(0.0, 0.0, 0.0, 1.0)
                self.screen_texture.use(0)
                self.program['u_texture'] = 0
                self.program['u_effects_enabled'] = 1.0 if self.effects_enabled else 0.0
                self.program['u_channel_switch'] = 0.0
                self.program['u_channel_time'] = 0.0
                w, h = self.screen.get_size()
                self.program['u_resolution'] = (float(w), float(h))
                self.program['u_time'] = (pygame.time.get_ticks() / 1000.0) * 0.5
                self.vao.render(moderngl.TRIANGLE_STRIP)
                pygame.display.flip()
                self.clock.tick(30)
                continue

            if self.current_screen == "menu":
                self._update_menu()
                self._draw_menu_to_texture()
            elif self.current_screen == "game":
                if self.channel_switch_active:
                    elapsed_ms = pygame.time.get_ticks() - self.channel_switch_start_ms
                    if elapsed_ms >= self.channel_switch_duration_ms:
                        self.channel_switch_active = False
                        self.game_logic.lore_icon_visible = True
                        self._update_game()
                        self._draw_game_to_texture()
                elif self.intro_slides_active:
                    self._update_intro_slides()
                    self._draw_intro_slides_to_texture()
                elif self.name_entry_active:
                    self._draw_name_entry_to_texture()
                elif self.crash_stage == 0:
                    if not self.admin_panel_open:
                        self._update_game()
                    self._draw_game_to_texture()
                elif self.crash_stage == 1:
                    if self.fake_crash_start == 0:
                        self.fake_crash_start = pygame.time.get_ticks()
                    elapsed = pygame.time.get_ticks() - self.fake_crash_start
                    if elapsed < 5000:
                        crash_surf = self._draw_fake_crash()
                        self.screen_texture.write(pygame.image.tostring(crash_surf, 'RGBA', True))
                    else:
                        self.running = False
                        pygame.quit()
                        sys.exit()
                else:
                    self._draw_game_to_texture()

            if self.current_screen == "menu":
                mouse_pos = pygame.mouse.get_pos()
                # The start action intentionally covers most of the screen; it
                # remains clickable, but should not make the cursor a hand
                # over the whole background. The small menu controls do.
                self.menu_cursor.handle_mouse_movement(
                    mouse_pos, exclude_names={"start"}
                )
            elif self.current_screen == "game" and self.crash_stage == 0 and not self.channel_switch_active:
                mouse_pos = pygame.mouse.get_pos()
                hovering = bool(self.admin_panel_open or self.intro_slides_active)
                if self.intro_slides_active and self.intro_slide_button_rect:
                    tex_w, tex_h = self.screen_texture.size
                    screen_w, screen_h = self.screen.get_size()
                    mouse_pos = pygame.mouse.get_pos()
                    slide_pos = (int(mouse_pos[0] * tex_w / max(1, screen_w)), int(mouse_pos[1] * tex_h / max(1, screen_h)))
                    hovering = hovering or self.intro_slide_button_rect.collidepoint(slide_pos)
                if self.admin_panel_open:
                    pass
                elif self.intro_slides_active:
                    pass
                elif self.name_entry_active and self.name_input_scene:
                    tex_w, tex_h = self.screen_texture.size
                    screen_w, screen_h = self.screen.get_size()
                    name_pos = (
                        int(mouse_pos[0] * (tex_w / max(1, screen_w))),
                        int(mouse_pos[1] * (tex_h / max(1, screen_h))),
                    )
                    self.name_input_scene.get_hover(name_pos)
                    hovering = any((
                        self.name_input_scene.hover_cell is not None,
                        self.name_input_scene.hover_node is not None,
                        self.name_input_scene.hover_lang is not None,
                    ))
                elif self.settings_box.is_open:
                    hovering = any(
                        rect.collidepoint(mouse_pos)
                        for rect in self.settings_box.hitboxes.values()
                    )
                else:
                    if self.game_view.rect_back.collidepoint(mouse_pos):
                        hovering = True
                    if self.event_collection_icon_rect and self.event_collection_icon_rect.collidepoint(mouse_pos):
                        hovering = True
                    if not self.game_logic.timer_active and self.game_logic.clicks_in_cycle < 10:
                        if self.game_view.rect_target.collidepoint(mouse_pos):
                            hovering = True
                    if self.game_logic.clicks_in_cycle >= 10 and not self.game_logic.timer_active:
                        if self.game_logic.score >= self.game_logic.upgrade_cost:
                            if self.game_view.rect_instant_wash.collidepoint(mouse_pos):
                                hovering = True
                            elif self.game_view.rect_free_wash_btn.collidepoint(mouse_pos):
                                hovering = True
                        else:
                            if self.game_view.rect_free_wash_btn.collidepoint(mouse_pos):
                                hovering = True
                self.menu_cursor.set_hover_state(hovering)

            self.ctx.clear(0.0, 0.0, 0.0, 1.0)
            self.screen_texture.use(0)
            self.program['u_texture'] = 0
            self.program['u_effects_enabled'] = 1.0 if self.effects_enabled else 0.0
            channel_elapsed = (pygame.time.get_ticks() - self.channel_switch_start_ms) / 1000.0
            self.program['u_channel_switch'] = 1.0 if self.channel_switch_active else 0.0
            self.program['u_channel_time'] = channel_elapsed if self.channel_switch_active else 0.0
            w, h = self.screen.get_size()
            self.program['u_resolution'] = (float(w), float(h))
            self.program['u_time'] = (pygame.time.get_ticks() / 1000.0) * 0.5
            self.vao.render(moderngl.TRIANGLE_STRIP)
            pygame.display.flip()
            
            fps = self.clock.get_fps()
            dt = self.clock.get_time() / 1000.0
            self.profiler.tick(fps, dt)
            
            self.clock.tick(60)

if __name__ == "__main__":
    app = Application()
    app.run()
