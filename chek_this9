    def _update_intro_slides(self):
        if not self.intro_slides_active or self.admin_panel_open:
            return
        dt = max(0.0, min(self.clock.get_time() / 1000.0, 0.15))
        self.intro_slide_typewriter_accum += dt
        interval = 0.028
        count = int(self.intro_slide_typewriter_accum / interval)
        if count <= 0:
            return
        self.intro_slide_typewriter_accum -= count * interval
        self.intro_slide_char_index = min(
            len(self.intro_slide_full_text), self.intro_slide_char_index + count
        )
        self.intro_slide_display_text = self.intro_slide_full_text[:self.intro_slide_char_index]

    def _advance_intro_slide(self):
        if not self.intro_slides_active:
            return
        if self.intro_slide_char_index < len(self.intro_slide_full_text):
            return
        if self.intro_slide_index + 1 >= len(self._get_intro_slides()):
            self._begin_game_session(reset_progress=True)
            return
        self.intro_slide_index += 1
        self._load_intro_slide()

    def _wrap_intro_text(self, text, font, max_width):
        result = []
        for paragraph in text.split("\n"):
            if not paragraph:
                result.append("")
                continue
            words = paragraph.split()
            line = ""
            for word in words:
                candidate = word if not line else line + " " + word
                if font.size(candidate)[0] <= max_width or not line:
                    line = candidate
                else:
                    result.append(line)
                    line = word
            if line:
                result.append(line)
        return result

