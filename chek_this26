    dialogue_elapsed = 0.0

    dialogue = []
    dialogue_next_stage = None

    white_elapsed = 0.0
    shake_line_index = 0

    room_elapsed = 0.0

    inspection_pause_elapsed = 0.0
    greeting_laugh_elapsed = 0.0
    greeting_return_elapsed = 0.0

    player_name = ""
    greeting_index = 0
    selected_class = 0
    selected_class_data = None

    current_emotion = "base"

    # --------------------------------------------------------
    # Состояние кухни
    # --------------------------------------------------------

    kitchen_player_x = float(KITCHEN_PLAYER_FOOT[0])
    kitchen_player_y = float(KITCHEN_PLAYER_FOOT[1])

    kitchen_move_target = None
    kitchen_target_action = None
    kitchen_target_item_id = None

    kitchen_carried_item = None

    kitchen_requested_item_id = None
    kitchen_requested_items = set()
    kitchen_delivered_requested_items = set()
    kitchen_delivery_counts = {}

    kitchen_notice = ""
    kitchen_notice_timer = 0.0

    # Диалоги кухни отделены от вступительной системы диалогов.
    kitchen_dialogue_lines = []
    kitchen_dialogue_index = 0
    kitchen_dialogue_elapsed = 0.0
    kitchen_dialogue_next_action = None

    running = True

    # --------------------------------------------------------
    # Единая последовательность вступительных диалогов
    # --------------------------------------------------------

    def set_dialogue(lines, next_stage):
        nonlocal dialogue
        nonlocal dialogue_index
        nonlocal dialogue_elapsed
        nonlocal dialogue_next_stage

        dialogue = lines
        dialogue_index = 0
        dialogue_elapsed = 0.0
        dialogue_next_stage = next_stage

    def current_line():
        if not dialogue:
            return None

        if dialogue_index < 0 or dialogue_index >= len(dialogue):
            return None

        return dialogue[dialogue_index]

    # --------------------------------------------------------
    # Отдельная система диалогов кухни
    # --------------------------------------------------------

    def start_kitchen_dialogue(lines, next_action):
        nonlocal stage
        nonlocal kitchen_dialogue_lines
        nonlocal kitchen_dialogue_index
        nonlocal kitchen_dialogue_elapsed
        nonlocal kitchen_dialogue_next_action

        kitchen_dialogue_lines = lines
        kitchen_dialogue_index = 0
        kitchen_dialogue_elapsed = 0.0
        kitchen_dialogue_next_action = next_action
        stage = "kitchen_dialogue"

    def current_kitchen_line():
        if not kitchen_dialogue_lines:
            return None

        if not (
            0 <= kitchen_dialogue_index
            < len(kitchen_dialogue_lines)
        ):
            return None

        return kitchen_dialogue_lines[kitchen_dialogue_index]

    def advance_kitchen_dialogue():
        nonlocal stage
        nonlocal kitchen_dialogue_index
        nonlocal kitchen_dialogue_elapsed
        nonlocal kitchen_dialogue_lines
        nonlocal kitchen_dialogue_next_action

        line = current_kitchen_line()

        if line is None:
            stage = "kitchen_scene"
            return

        # Первое нажатие завершает печать текущей реплики.
        if visible_character_count(
            line["text"],
            kitchen_dialogue_elapsed
        ) < len(line["text"]):
            kitchen_dialogue_elapsed = (
                text_duration(line["text"]) + 1.0
            )
            return

        # Следующее нажатие переводит к следующей реплике.
        kitchen_dialogue_index += 1
        kitchen_dialogue_elapsed = 0.0

        next_line = current_kitchen_line()

        if next_line is not None:
            return

        next_action = kitchen_dialogue_next_action
        kitchen_dialogue_lines = []
        kitchen_dialogue_index = 0
        kitchen_dialogue_elapsed = 0.0
        kitchen_dialogue_next_action = None

        if next_action == "next_request":
            begin_kitchen_next_request_dialogue()
        else:
            stage = "kitchen_scene"

    # --------------------------------------------------------
    # Сценарий кухни: запросы и реакции Динары
    # --------------------------------------------------------

    def make_kitchen_dialogue_lines(texts, emotion="base"):
        return [
            {
                "speaker": "Динара",
                "text": text,
                "emotion": emotion,
            }
            for text in texts
        ]

    def add_kitchen_dough_if_unlocked():
        required_requests_done = set(KITCHEN_DOUGH_UNLOCK_AFTER).issubset(
            kitchen_requested_items
        )
        if not required_requests_done:
            return

        if "dough" in kitchen_delivered_requested_items:
            return

        if (
            kitchen_carried_item is not None
            and kitchen_carried_item.get("id") == "dough"
        ):
            return

        if any(item["id"] == "dough" for item in kitchen_items):
            return

        # Не создаём тесто, пока для него не добавлены реальные
        # координаты в KITCHEN_ITEM_LAYOUT и спрайт в набор ресурсов.
        dough_items = build_kitchen_items(
            kitchen_item_sprites,
            include_dough=True
        )
        dough_item = next(
            (item for item in dough_items if item["id"] == "dough"),
            None
        )
        if dough_item is not None:
            kitchen_items.append(dough_item)
            print("[EVT005] Тесто появилось на кухне.")

    def get_kitchen_wrong_reaction(
        item_id,
        wrong_count,
        requested_item_id
    ):
        item_name = KITCHEN_ITEM_DISPLAY_TEXT.get(item_id, item_id)
        requested_name = KITCHEN_REQUEST_TEXT.get(
            requested_item_id,
            "нужный предмет"
        )
        needed_form = KITCHEN_NEEDED_FORM.get(
            requested_item_id,
            f"нужен {requested_name}"
        )

        if wrong_count == 1:
            reaction_stage = "first"
        elif wrong_count == 2:
            reaction_stage = "repeat_1"
        else:
            reaction_stage = "repeat_2"

        reaction_data = KITCHEN_UTENSIL_REACTIONS.get(item_id)
        if reaction_data is None:
            reaction_data = KITCHEN_EXTRA_ITEM_REACTIONS.get(item_id)

        templates = reaction_data.get(reaction_stage) if reaction_data else None
        if not templates:
            templates = KITCHEN_UNIVERSAL_REMINDER

        return [
            line.format(
                requested=requested_name,
                item=item_name,
                needed=needed_form,
            )
            for line in templates
        ]

    def begin_kitchen_intro_dialogue():
        start_kitchen_dialogue(
            [
                {
                    "speaker": "Динара",
                    "text": "Чтож, начнём...",
                    "emotion": "smile",
                }
            ],
            "next_request"
        )

    def begin_kitchen_next_request_dialogue():
        nonlocal kitchen_requested_item_id
        nonlocal stage

        add_kitchen_dough_if_unlocked()

        available_item_ids = {
            item["id"]
            for item in kitchen_items
        }

        remaining_items = [
            item_id
            for item_id in KITCHEN_REQUESTABLE_ITEMS
            if (
                item_id in available_item_ids
                and item_id not in kitchen_requested_items
            )
        ]

        if not remaining_items:
            kitchen_requested_item_id = None
            stage = "kitchen_scene"

            missing_items = [
                item_id
                for item_id in KITCHEN_REQUESTABLE_ITEMS
                if (
                    item_id not in available_item_ids
                    and item_id not in kitchen_requested_items
                    and item_id not in kitchen_delivered_requested_items
                )
            ]
            if missing_items:
                print(
                    "[EVT005][ASSETS] Запросы приостановлены: на сцене "
                    "пока нет спрайтов следующих предметов: "
                    + ", ".join(missing_items)
                )
            else:
                print(
                    "[EVT005] Все доступные для текущей раскладки "
                    "предметы уже запрошены. Автоматическое завершение "
                    "готовки не запускается."
                )
            return

        kitchen_requested_item_id = random.choice(remaining_items)
        kitchen_requested_items.add(kitchen_requested_item_id)
        add_kitchen_dough_if_unlocked()

        requested_name = KITCHEN_REQUEST_TEXT[kitchen_requested_item_id]
        start_kitchen_dialogue(
            [
                {
                    "speaker": "Динара",
                    "text": f"Для начала мне понадобится.. {requested_name}",
                    "emotion": "вопрос",
                }
            ],
            "scene"
        )

    def begin_kitchen_item_delivery():
        nonlocal kitchen_carried_item
        nonlocal kitchen_requested_item_id
        nonlocal kitchen_notice
        nonlocal kitchen_notice_timer
        nonlocal kitchen_move_target
        nonlocal kitchen_target_action
        nonlocal kitchen_target_item_id

        delivered_item = kitchen_carried_item
        if delivered_item is None:
            return

        item_id = delivered_item["id"]

        kitchen_carried_item = None
        kitchen_move_target = None
        kitchen_target_action = None
        kitchen_target_item_id = None
        kitchen_notice = ""
        kitchen_notice_timer = 0.0

        if item_id == kitchen_requested_item_id:
            reaction = KITCHEN_CORRECT_REACTIONS.get(item_id)
            if reaction is None:
                kitchen_items.append(delivered_item)
                print(
                    "[EVT005][DIALOGUE] Нет сценарной реакции для "
                    f"правильного предмета: {item_id}"
                )
                return

            kitchen_delivered_requested_items.add(item_id)
            kitchen_requested_item_id = None
            start_kitchen_dialogue(
                make_kitchen_dialogue_lines([reaction], "base"),
                "next_request"
            )
            return

        # Неправильный предмет возвращается на сцену.
        kitchen_items.append(delivered_item)

        wrong_count = kitchen_delivery_counts.get(item_id, 0) + 1
        kitchen_delivery_counts[item_id] = wrong_count

        reaction_lines = get_kitchen_wrong_reaction(
            item_id,
            wrong_count,
