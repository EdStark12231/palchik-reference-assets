    def advance_dialogue():
        nonlocal dialogue_index
        nonlocal dialogue_elapsed
        nonlocal stage
        nonlocal current_emotion
        nonlocal inspection_pause_elapsed

        line = current_line()

        if line is None:
            return

        # Первое нажатие после начала печати:
        # показать всю текущую реплику.
        if visible_character_count(
            line["text"],
            dialogue_elapsed
        ) < len(line["text"]):

            dialogue_elapsed = text_duration(line["text"]) + 1.0
            return

        # Следующее нажатие — следующая реплика.
        dialogue_index += 1
        dialogue_elapsed = 0.0

        next_line = current_line()

        if next_line is not None:
            current_emotion = next_line.get(
                "emotion",
                current_emotion
            )
            return

        stage = dialogue_next_stage

        if stage == "name_input":
            pygame.key.start_text_input()

        elif stage == "inspection_pause":
            inspection_pause_elapsed = 0.0
            current_emotion = "base"

        elif stage == "kitchen_intro":
            begin_kitchen_intro_dialogue()

    # --------------------------------------------------------
    # Общий обработчик продолжения
    # --------------------------------------------------------

    def advance_action():
        nonlocal narrator_index
        nonlocal dialogue_elapsed
        nonlocal shake_line_index
        nonlocal white_elapsed

        if stage in (
            "narrator_intro_pause",
            "inspection_pause",
            "greeting_laugh",
            "greeting_return",
            "kitchen_scene",
        ):
            return

        if stage == "kitchen_dialogue":
            advance_kitchen_dialogue()
            return

        if stage == "narrator":
            text = NARRATOR_LINES[narrator_index]

            if visible_character_count(
                text,
                dialogue_elapsed
            ) < len(text):
                dialogue_elapsed = text_duration(text) + 1.0
                return

            narrator_index += 1
            dialogue_elapsed = 0.0

            if narrator_index >= len(NARRATOR_LINES):
                begin_white_shake()

            return

        if stage == "white_shake":
            text = WAKE_LINES[shake_line_index]

            if visible_character_count(
                text,
                white_elapsed
            ) < len(text):
                white_elapsed = text_duration(text) + 1.0
                return

            shake_line_index += 1
            white_elapsed = 0.0

            if shake_line_index >= len(WAKE_LINES):
                begin_room()

            return

        if stage in (
            "dinara_dialogue",
            "name_introduction",
            "after_greeting",
            "class_dialogue",
            "class_confirmed",
        ):
            advance_dialogue()

