        PANEL_NAME_COLOR
    )

    name_x = PANEL_X + 28
    name_y = PANEL_Y + 9

    name_bg = pygame.Rect(
        name_x - 10,
        name_y - 3,
        name_surface.get_width() + 28,
        name_surface.get_height() + 8
    )

    pygame.draw.rect(
        surface,
        (25, 31, 48),
        name_bg,
        border_radius=3
    )

    pygame.draw.rect(
        surface,
        PANEL_OUTER_BORDER,
        name_bg,
        width=1,
        border_radius=3
    )

    surface.blit(name_surface, (name_x, name_y))

    if show_full:
        visible = message
    else:
        count = visible_character_count(message, elapsed)
        visible = message[:count]

    draw_wrapped_text(
        surface,
        message_font,
        visible,
        PANEL_TEXT_COLOR,
        PANEL_X + 30,
        PANEL_Y + 57,
        PANEL_WIDTH - 85,
        line_gap=2
    )

    complete = len(visible) >= len(message)

    if allow_continue and complete:
        pulse = 0.5 + 0.5 * math.sin(elapsed * 4.0)
        arrow_alpha = int(120 + pulse * 135)

        arrow = pygame.Surface((18, 12), pygame.SRCALPHA)

        pygame.draw.polygon(
            arrow,
            (245, 225, 175, arrow_alpha),
            [(2, 2), (16, 2), (9, 10)]
        )

        surface.blit(
            arrow,
            (
                PANEL_X + PANEL_WIDTH - 38,
                PANEL_Y + PANEL_HEIGHT - 25
            )
        )

    return complete


