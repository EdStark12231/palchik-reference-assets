    def _draw_event_collection_window(self, surface):
        width, height = surface.get_size()
        now = time.monotonic()
        opening_t = min(1.0, max(0.0, (now - self.event_collection_opened_at) / 0.30))
        opening_ease = 1.0 - (1.0 - opening_t) ** 3
        closing_t = 0.0
        if self.event_collection_closing:
            closing_t = min(1.0, max(0.0, (now - self.event_collection_closing_started_at) / 0.22))
        visibility = opening_ease * (1.0 - closing_t)
        if self.event_collection_closing and closing_t >= 1.0:
            self.event_collection_open = False
            self.event_collection_closing = False
            self.event_collection_window_rect = None
            self.event_collection_close_rect = None
            return

        shade = pygame.Surface((width, height), pygame.SRCALPHA)
        shade.fill((0, 0, 0, int(118 * visibility)))
