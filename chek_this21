            elif action == "secret_force_open":
                self._open_secret_input(force=True)
                self.admin_panel_open = False
                self._show_notification("ТЕСТ: ПОЛЕ СЕКРЕТНОГО ВВОДА", duration=1500)
            elif action == "secret_test_success":
                self._open_secret_input(force=True)
                self.admin_panel_open = False
                self._submit_secret_input(SECRET_ACCESS_CODE)
            elif action == "secret_test_failure":
                self._open_secret_input(force=True)
                self.admin_panel_open = False
                self._submit_secret_input("000000")
            elif action == "secret_clear_input":
                self.secret_input_open = False
