    def _handle_game_events(self, event):
        if (self.evt004_runtime is not None and self.evt004_runtime.running
                and event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE):
            self._finish_evt004(cancelled=True, reason="PLAYER_CANCELLED")
            return
        if self.game_logic.word_shock_active and event.type != pygame.VIDEORESIZE:
            self._handle_word_shock_input(event)
            return
        if self.secret_input_open and event.type != pygame.VIDEORESIZE:
            if event.type == pygame.KEYDOWN:
                self._handle_secret_input_key(event)
            elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                screen_w, screen_h = self.screen.get_size()
                tex_w, tex_h = self.screen_texture.size
                mouse_pos = (
                    int(event.pos[0] * tex_w / max(1, screen_w)),
                    int(event.pos[1] * tex_h / max(1, screen_h)),
                )
                close_rect = getattr(self, "secret_input_close_rect", None)
                cancel_rect = getattr(self, "secret_input_cancel_rect", None)
                ok_rect = getattr(self, "secret_input_ok_rect", None)
                if close_rect and close_rect.collidepoint(mouse_pos):
                    self._cancel_secret_input()
                elif cancel_rect and cancel_rect.collidepoint(mouse_pos):
                    self._cancel_secret_input()
                elif ok_rect and ok_rect.collidepoint(mouse_pos):
                    self._confirm_secret_input()
            return
        if self.event_collection_open and event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                self._close_event_collection()
            return
        if event.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode((event.w, event.h), pygame.FULLSCREEN | pygame.DOUBLEBUF | pygame.OPENGL)
            self._setup_menu_hitboxes()
            self.game_view.width, self.game_view.height = event.w, event.h
            self.game_view.recalculate_layout()
        elif event.type == pygame.MOUSEBUTTONUP and event.button == 1:
            self.game_logic.timer_scale = 1.0
            self.game_view.lore_window_dragging = False
            self.game_view.lore_scroll_dragging = False
        elif event.type == pygame.MOUSEWHEEL and getattr(self.game_logic, "lore_window_open", False):
            if not getattr(self.game_logic, "lore_text_viewer_open", False) and not getattr(self.game_logic, "lore_image_viewer_open", False):
                screen_w, screen_h = self.screen.get_size()
                tex_w, tex_h = self.screen_texture.size
                mouse_pos = pygame.mouse.get_pos()
                pos = (int(mouse_pos[0] * (tex_w / screen_w)), int(mouse_pos[1] * (tex_h / screen_h)))
                if self.game_view.handle_lore_wheel(self.game_logic, pos, event.y):
                    return
        elif event.type == pygame.MOUSEMOTION:
            if self.game_view.lore_window_dragging:
                tex_w, tex_h = self.screen_texture.size
                screen_w, screen_h = self.screen.get_size()
                mouse_tex_x = int(event.pos[0] * (tex_w / screen_w))
                mouse_tex_y = int(event.pos[1] * (tex_h / screen_h))
                
                win_w = int(tex_w * 0.65)
                win_h = int(tex_h * 0.55)
                base_x = (tex_w - win_w) // 2
                base_y = (tex_h - win_h) // 2
                
                new_x = mouse_tex_x - self.game_view.lore_drag_start_x
                new_y = mouse_tex_y - self.game_view.lore_drag_start_y
                self.game_view.lore_window_offset_x = new_x - base_x
                self.game_view.lore_window_offset_y = new_y - base_y
                
                self.game_view.lore_window_offset_x = max(-base_x, min(tex_w - win_w - base_x, self.game_view.lore_window_offset_x))
                self.game_view.lore_window_offset_y = max(-base_y, min(tex_h - win_h - base_y, self.game_view.lore_window_offset_y))
