            word_shock_update = self.game_logic.update_word_shock()
            if word_shock_update == "MODAL_OPEN":
                pygame.key.start_text_input()
            elif word_shock_update == "EXPIRED":
                pygame.key.stop_text_input()
                self._sync_managed_word_shock()
