from pathlib import Path
from typing import Iterable

import pygame

from . import adventure_road_dragon as dragon_core

EVENT_ID = "EVT_004_ADVENTURE_ROAD"
COLLECTION_ID = "road_of_adventures"
TRIGGER_CODE = "111111"


@dataclass(frozen=True)
class TargetSpec:
    key: str
    label: str
