"""Single source of truth for registered event metadata and configuration."""
from __future__ import annotations
import json
from pathlib import Path
from typing import Iterable, Mapping, Any
from .contracts import EventDefinition, EventSource

class EventCatalogError(ValueError):
    pass

class EventCatalog:
    def __init__(self, definitions: Iterable[EventDefinition], config_root: str | Path):
        self._definitions: dict[str, EventDefinition] = {}
        self._configs: dict[str, dict[str, Any]] = {}
        self.config_root = Path(config_root)
        for definition in definitions:
            if not definition.event_id or definition.event_id in self._definitions:
                raise EventCatalogError(f"Empty or duplicate event ID: {definition.event_id!r}")
            self._definitions[definition.event_id] = definition
        self.validate_configs()

    def get(self, event_id: str) -> EventDefinition | None:
        return self._definitions.get(event_id)

    def configuration(self, event_id: str) -> Mapping[str, Any] | None:
        payload = self._configs.get(event_id)
        return payload.copy() if payload is not None else None

    def is_enabled(self, event_id: str) -> bool:
        definition = self.get(event_id)
        config = self._configs.get(event_id)
        return bool(definition and definition.enabled and config and config.get("enabled", True))

    def all(self, *, enabled_only: bool = False) -> tuple[EventDefinition, ...]:
        values = tuple(self._definitions.values())
        return tuple(item for item in values if self.is_enabled(item.event_id)) if enabled_only else values

    def validate_configs(self) -> None:
        for definition in self._definitions.values():
            path = self.config_root / definition.config_file
            if not path.is_file():
                raise EventCatalogError(f"Missing config for {definition.event_id}: {path}")
            try:
                payload = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as exc:
                raise EventCatalogError(f"Invalid JSON for {definition.event_id}: {exc}") from exc
            if not isinstance(payload, dict):
                raise EventCatalogError(f"Config root must be an object for {definition.event_id}")
            if payload.get("event_id") != definition.event_id:
                raise EventCatalogError(f"Config ID mismatch for {definition.event_id}")
            if not isinstance(payload.get("enabled", True), bool):
                raise EventCatalogError(f"enabled must be boolean for {definition.event_id}")
            if not isinstance(payload.get("parameters", {}), dict):
                raise EventCatalogError(f"parameters must be an object for {definition.event_id}")
            if payload.get("source") != definition.source.value:
                raise EventCatalogError(f"Source mismatch for {definition.event_id}")
            configured_subcategories = payload.get("subcategories", [])
            if not isinstance(configured_subcategories, list) or not all(isinstance(x, str) for x in configured_subcategories):
                raise EventCatalogError(f"subcategories must be a string array for {definition.event_id}")
            if tuple(configured_subcategories) != definition.subcategories:
                raise EventCatalogError(f"Subcategory mismatch for {definition.event_id}")
            valid = {f"{definition.source.value}_{number:02d}" for number in range(1, 7)}
            if any(item not in valid for item in configured_subcategories):
                raise EventCatalogError(f"Invalid subcategory for {definition.event_id}: {configured_subcategories}")
            self._configs[definition.event_id] = payload

