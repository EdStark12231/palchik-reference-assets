def draw_shaken_frame(screen, frame, elapsed):
    """
    Смещается готовый кадр целиком:
    фон, диалоговая панель, текст и все остальные элементы.
    """

    offset_x = round(
        math.sin(elapsed * SHAKE_SPEED_X) * SHAKE_INTENSITY
    )

    offset_y = round(
        math.cos(elapsed * SHAKE_SPEED_Y) * SHAKE_INTENSITY
    )

    canvas = pygame.Surface(
        (
            WIDTH + SHAKE_MARGIN * 2,
            HEIGHT + SHAKE_MARGIN * 2
        )
    )

    canvas.fill(WHITE)
    canvas.blit(frame, (SHAKE_MARGIN, SHAKE_MARGIN))

    screen.fill(WHITE)

    screen.blit(
        canvas,
        (
            -SHAKE_MARGIN + offset_x,
            -SHAKE_MARGIN + offset_y
        )
    )


