# ============================================================
# EVT_005 — ПЕРВАЯ БОЕВАЯ СИСТЕМА (тестовый баланс V0.1)
# ============================================================

class EVT005BattleEngine:
    """Пошаговый движок первой тестовой схватки: Воин + Динара vs 2 гоблина.

    Все числа в BATTLE_BALANCE являются тестовыми стартовыми значениями,
    а не окончательно утверждённым балансом.
    """

    BATTLE_BALANCE = {
        "player": {
            "hp": 120, "stamina": 100, "strength": 12,
            "agility": 10, "toughness": 10,
        },
        "dinara": {
            "hp": 100, "attack": 10, "agility": 11, "toughness": 8,
        },
        "goblin": {
            "hp": 55, "strength": 8, "agility": 12, "toughness": 2,
        },
        "basic_attack_stamina": 10,
        "circle_attack_stamina": 30,
        "sword_block_stamina": 15,
        "berserk_stamina": 35,
        "stamina_regen_per_time": 0.012,
        "basic_recovery": 780.0,
        "circle_recovery": 1080.0,
        "block_recovery": 650.0,
        "berserk_recovery": 900.0,
        "goblin_attack_recovery": 850.0,
        "goblin_net_recovery": 1180.0,
        "goblin_inspire_recovery": 1050.0,
        "dinara_attack_recovery": 800.0,
        "dinara_defend_recovery": 700.0,
        "bleed_damage": 3,
        "bleed_turns": 3,
        "bleed_chance": 0.25,
        "net_stun_turns": 2,
        "inspire_immunity_turns": 3,
        "net_multi_target_chance": 0.25,
        "potion_heal_percent": 0.35,
        "berserk_damage_bonus": 0.30,
        "berserk_crit_chance_bonus": 0.20,
        "berserk_crit_multiplier_bonus": 0.60,
        "berserk_attack_charges": 2,
        "dinara_heal_threshold": 0.35,
        "dinara_guard_threshold": 0.28,
    }

    def __init__(self, player_name="Воин", player_stats=None, dinara_stats=None,
                 player_skills=None, dinara_skills=None):
        import random as _random
        self.random = _random.Random()
        self.balance = dict(self.BATTLE_BALANCE)
        player_stats = dict(player_stats or {})
        dinara_stats = dict(dinara_stats or {})
        player_skills = dict(player_skills or {})
        dinara_skills = dict(dinara_skills or {})
        self.clock = 0.0
        self.current_actor_id = None
        self.result = None
        self.potion_count = 1
        self.log = []
        self.last_event = None
        self.last_action_event = None
        self.extra_turn_pending = False
        self.actors = {
            "player": self._actor(
                "player", player_name, "ally", "warrior",
                player_stats.get("Здоровье", self.balance["player"]["hp"]),
                player_stats.get("Выносливость", self.balance["player"]["stamina"]),
                player_stats.get("Сила", self.balance["player"]["strength"]),
                player_stats.get("Ловкость", self.balance["player"]["agility"]),
                player_stats.get("Стойкость", self.balance["player"]["toughness"]),
                5.0, 1.5,
            ),
            "dinara": self._actor(
                "dinara", "Динара", "ally", "dinara",
                dinara_stats.get("Здоровье", self.balance["dinara"]["hp"]), 0,
                dinara_stats.get("Сила", self.balance["dinara"]["attack"]),
                dinara_stats.get("Ловкость", self.balance["dinara"]["agility"]),
                dinara_stats.get("Стойкость", self.balance["dinara"]["toughness"]),
                5.0, 1.5,
            ),
            "goblin_1": self._actor(
                "goblin_1", "Гоблин 1", "enemy", "goblin",
                self.balance["goblin"]["hp"], 0,
                self.balance["goblin"]["strength"],
                self.balance["goblin"]["agility"],
                self.balance["goblin"]["toughness"],
                4.0, 1.5,
            ),
            "goblin_2": self._actor(
                "goblin_2", "Гоблин 2", "enemy", "goblin",
                self.balance["goblin"]["hp"], 0,
                self.balance["goblin"]["strength"],
                self.balance["goblin"]["agility"],
                self.balance["goblin"]["toughness"],
                4.0, 1.5,
            ),
        }
        self.actors["player"]["skill_ranks"] = player_skills
        self.actors["dinara"]["skill_ranks"] = dinara_skills
        # Первый момент готовности зависит от скорости каждого бойца.
        for actor in self.actors.values():
            actor["ready_at"] = 1000.0 / max(1.0, actor["agility"])

    @staticmethod
    def _actor(actor_id, name, team, role, max_hp, max_stamina,
               strength, agility, toughness, base_attack, crit_multiplier):
        return {
            "id": actor_id, "name": name, "team": team, "role": role,
            "max_hp": int(max_hp), "hp": int(max_hp),
            "max_stamina": int(max_stamina), "stamina": int(max_stamina),
            "strength": float(strength), "agility": float(agility),
            "toughness": float(toughness), "base_attack": float(base_attack),
            "crit_chance": 0.08, "crit_multiplier": float(crit_multiplier),
            "ready_at": 0.0, "alive": True,
            "bleed_turns": 0, "stun_turns": 0,
            "stun_immunity_turns": 0,
            "physical_guard": 0.0, "magic_guard": 0.0,
            "berserk_attacks_left": 0,
            "damage_buff": 0.0, "crit_chance_buff": 0.0,
            "crit_multiplier_buff": 0.0,
        }

    def alive(self, actor_id):
        actor = self.actors[actor_id]
        return actor["alive"] and actor["hp"] > 0

    def living(self, team=None):
        return [
            actor_id for actor_id, actor in self.actors.items()
            if actor["alive"] and actor["hp"] > 0
            and (team is None or actor["team"] == team)
        ]

    def check_result(self):
        if not self.alive("player"):
            self.result = "defeat"
        elif not self.living("enemy"):
            self.result = "victory"
        return self.result

    def get_actor(self, actor_id=None):
        actor_id = actor_id or self.current_actor_id
        return self.actors.get(actor_id) if actor_id else None

    def initiative_order(self):
        living = self.living()
        return sorted(living, key=lambda aid: (self.actors[aid]["ready_at"], aid))

    def _advance_clock(self, target_time):
        delta = max(0.0, target_time - self.clock)
        if delta:
            for actor_id in ("player",):
                actor = self.actors[actor_id]
                if actor["alive"]:
                    actor["stamina"] = min(
                        actor["max_stamina"],
                        actor["stamina"] + delta * self.balance["stamina_regen_per_time"],
                    )
        self.clock = max(self.clock, target_time)

    def _damage(self, attacker_id, target_id, raw_damage, damage_type="physical",
                can_crit=True):
        if not self.alive(target_id):
            return {"damage": 0, "dodged": False, "critical": False}
        attacker = self.actors[attacker_id]
        target = self.actors[target_id]
        dodged = False
        critical = False
        damage = max(1.0, float(raw_damage))

        if damage_type == "physical":
            dodge_chance = min(0.28, max(0.0, target["agility"] * 0.006))
            if self.random.random() < dodge_chance:
                dodged = True
                self.last_event = {"kind": "dodge", "target": target_id}
                return {"damage": 0, "dodged": True, "critical": False}

            if can_crit:
                crit_chance = min(
                    0.75,
                    attacker["crit_chance"] + attacker["crit_chance_buff"],
                )
                if self.random.random() < crit_chance:
                    critical = True
                    damage *= (
                        attacker["crit_multiplier"]
                        + attacker["crit_multiplier_buff"]
                    )

            # Стойкость защищает только от прямого физического урона.
            mitigation = min(0.50, target["toughness"] * 0.015)
            damage *= (1.0 - mitigation)
            if target["physical_guard"] > 0.0:
                damage *= (1.0 - target["physical_guard"])
        elif damage_type == "magic":
            if target["magic_guard"] > 0.0:
                damage *= (1.0 - target["magic_guard"])

        dealt = max(1, int(round(damage)))
        target["hp"] = max(0, target["hp"] - dealt)
        if target["hp"] <= 0:
            target["alive"] = False
        self.last_event = {
            "kind": "damage", "attacker": attacker_id,
            "target": target_id, "damage": dealt,
            "critical": critical, "damage_type": damage_type,
        }
        self.check_result()
        return {"damage": dealt, "dodged": dodged, "critical": critical}

    def _physical_attack_value(self, attacker_id, coefficient=1.0, skill_key=None):
        attacker = self.actors[attacker_id]
        raw = (attacker["base_attack"] + attacker["strength"] * 0.85) * coefficient
        ranks = attacker.get("skill_ranks", {})
        if attacker_id == "player":
            skill_key = skill_key or "Базовая атака мечом"
            rank = int(ranks.get(skill_key, 1))
            rank_bonus = 0.10 if skill_key == "Базовая атака мечом" else 0.075
            raw *= (1.0 + max(0, rank - 1) * rank_bonus)
        elif attacker_id == "dinara":
            rank = int(ranks.get("Атака скалкой", 1))
            raw *= (1.0 + max(0, rank - 1) * 0.10)
        if attacker["berserk_attacks_left"] > 0:
            raw *= (1.0 + attacker["damage_buff"])
        return raw

    def _consume_stamina(self, actor_id, cost):
        actor = self.actors[actor_id]
        if actor["stamina"] < cost:
            return False
        actor["stamina"] = max(0.0, actor["stamina"] - cost)
        return True

    def _apply_bleed(self, target_id):
        target = self.actors[target_id]
        if self.alive(target_id):
            target["bleed_turns"] = max(
                target["bleed_turns"], self.balance["bleed_turns"]
            )

    def _apply_stun(self, target_id, turns):
        target = self.actors[target_id]
        if not self.alive(target_id) or target["stun_immunity_turns"] > 0:
            return False
        target["stun_turns"] = max(target["stun_turns"], int(turns))
        return True

    def _finish_action(self, actor_id, recovery, extra_turn=False):
        actor = self.actors[actor_id]
        if actor["stun_immunity_turns"] > 0:
            actor["stun_immunity_turns"] -= 1
        if actor["berserk_attacks_left"] > 0 and actor_id != "player":
            actor["berserk_attacks_left"] -= 1
        actor["ready_at"] = self.clock + (1.0 if extra_turn else recovery * 10.0 / max(1.0, actor["agility"]))
        self.current_actor_id = None
        if self.result is None:
            self.advance_to_next_turn()

    def advance_to_next_turn(self):
        if self.check_result() is not None:
            self.current_actor_id = None
            return None
        safety = 0
        while safety < 32:
            safety += 1
            order = self.initiative_order()
            if not order:
                break
            actor_id = order[0]
            actor = self.actors[actor_id]
            self._advance_clock(actor["ready_at"])
            actor["physical_guard"] = 0.0
            actor["magic_guard"] = 0.0

            # Кровотечение наносит периодический урон без учёта защиты.
            if actor["bleed_turns"] > 0:
                bleed = self.balance["bleed_damage"]
                actor["hp"] = max(0, actor["hp"] - bleed)
                actor["bleed_turns"] -= 1
                self.last_event = {"kind": "bleed", "target": actor_id, "damage": bleed}
                if actor["hp"] <= 0:
                    actor["alive"] = False
                if self.check_result() is not None:
                    self.current_actor_id = None
                    return None
                if not actor["alive"]:
                    continue

            # Оглушённый участник пропускает свой ход и получает новую задержку.
            if actor["stun_turns"] > 0:
                actor["stun_turns"] -= 1
                self.last_event = {"kind": "stunned", "target": actor_id}
                actor["ready_at"] = self.clock + 520.0 * 10.0 / max(1.0, actor["agility"])
                if actor["stun_immunity_turns"] > 0:
                    actor["stun_immunity_turns"] -= 1
                continue

            self.current_actor_id = actor_id
            self.last_event = {"kind": "turn", "actor": actor_id}
            return actor_id
        self.current_actor_id = None
        self.result = self.check_result() or "draw"
        return None

    def player_attack(self, target_id):
        actor_id = "player"
        if self.current_actor_id != actor_id or not self.alive(target_id) or self.actors[target_id]["team"] != "enemy":
            return False
        actor = self.actors[actor_id]
        cost = self.balance["basic_attack_stamina"]
        exhausted_attack = actor["stamina"] < cost
        if exhausted_attack:
            # При нехватке ресурса базовая атака остаётся доступной,
            # наносит ровно 1 урон и не сжигает остаток Stamina.
            # Удар истощения не может стать критическим.
            damage = 1
        else:
            actor["stamina"] -= cost
            damage = self._physical_attack_value(actor_id, skill_key="Базовая атака мечом")
        result = self._damage(
            actor_id, target_id, damage, can_crit=not exhausted_attack
        )
        self.last_action_event = {
            "kind": "attack", "attacker": actor_id, "target": target_id,
            "damage": result["damage"], "critical": result["critical"],
            "dodged": result["dodged"],
        }
        if actor["berserk_attacks_left"] > 0:
            actor["berserk_attacks_left"] -= 1
            if actor["berserk_attacks_left"] == 0:
                actor["damage_buff"] = 0.0
                actor["crit_chance_buff"] = 0.0
                actor["crit_multiplier_buff"] = 0.0
        self._finish_action(actor_id, self.balance["basic_recovery"])
        return True

    def player_circle_attack(self):
        actor_id = "player"
        cost = self.balance["circle_attack_stamina"]
        if self.current_actor_id != actor_id or self.actors[actor_id]["stamina"] < cost:
            return False
        self.actors[actor_id]["stamina"] -= cost
        targets = self.living("enemy")
        damage_results = []
        for target_id in targets:
            if self.result:
                break
            circle_rank = int(self.actors[actor_id].get("skill_ranks", {}).get("Круговая атака", 1))
            circle_coefficient = min(0.85, 0.65 + max(0, circle_rank - 1) * 0.05)
            result = self._damage(actor_id, target_id, self._physical_attack_value(actor_id, circle_coefficient, "Круговая атака"))
            damage_results.append({"target": target_id, "damage": result["damage"], "critical": result["critical"], "dodged": result["dodged"]})
        self.last_action_event = {"kind": "aoe", "attacker": actor_id, "hits": damage_results}
        if self.actors[actor_id]["berserk_attacks_left"] > 0:
            self.actors[actor_id]["berserk_attacks_left"] -= 1
            if self.actors[actor_id]["berserk_attacks_left"] == 0:
                self.actors[actor_id]["damage_buff"] = 0.0
                self.actors[actor_id]["crit_chance_buff"] = 0.0
                self.actors[actor_id]["crit_multiplier_buff"] = 0.0
        self._finish_action(actor_id, self.balance["circle_recovery"])
        return True

    def player_sword_block(self):
        actor_id = "player"
        cost = self.balance["sword_block_stamina"]
        if self.current_actor_id != actor_id or self.actors[actor_id]["stamina"] < cost:
            return False
        actor = self.actors[actor_id]
        actor["stamina"] -= cost
        block_rank = int(actor.get("skill_ranks", {}).get("Блок мечом", 1))
        block_value = min(0.85, 0.70 + max(0, block_rank - 1) * 0.05)
        actor["physical_guard"] = block_value
        self.last_action_event = {"kind": "block", "actor": actor_id, "physical_guard": block_value}
        self._finish_action(actor_id, self.balance["block_recovery"])
        return True

    def player_berserk(self):
        actor_id = "player"
        actor = self.actors[actor_id]
        if self.current_actor_id != actor_id:
            return False
        if actor["hp"] > actor["max_hp"] * 0.25:
            return False
        cost = self.balance["berserk_stamina"]
        if actor["stamina"] < cost:
            return False
        actor["stamina"] -= cost
        berserk_rank = int(actor.get("skill_ranks", {}).get("Берсерк", 1))
        rank_bonus = max(0, berserk_rank - 1)
        actor["damage_buff"] = min(0.60, self.balance["berserk_damage_bonus"] + rank_bonus * 0.05)
        actor["crit_chance_buff"] = min(0.50, self.balance["berserk_crit_chance_bonus"] + rank_bonus * 0.05)
        actor["crit_multiplier_buff"] = self.balance["berserk_crit_multiplier_bonus"] + rank_bonus * 0.15
        actor["berserk_attacks_left"] = self.balance["berserk_attack_charges"]
        self.last_action_event = {"kind": "berserk", "actor": actor_id}
        self._finish_action(actor_id, self.balance["berserk_recovery"], extra_turn=True)
        return True

    def use_potion(self, target_id):
        actor_id = self.current_actor_id
        if actor_id not in ("player", "dinara") or self.potion_count <= 0:
            return False
        if not self.alive(target_id) or self.actors[target_id]["team"] != "ally":
            return False
        target = self.actors[target_id]
        amount = max(1, int(round(target["max_hp"] * self.balance["potion_heal_percent"])))
        healed = min(amount, target["max_hp"] - target["hp"])
        if healed <= 0:
            return False
        target["hp"] += healed
        self.potion_count -= 1
        self.last_event = {"kind": "heal", "target": target_id, "amount": healed}
        self.last_action_event = {"kind": "heal", "actor": actor_id, "target": target_id, "amount": healed}
        recovery = self.balance["basic_recovery"] if actor_id == "player" else self.balance["dinara_attack_recovery"]
        self._finish_action(actor_id, recovery)
        return True

    def player_defend(self):
        actor_id = self.current_actor_id
        if actor_id not in ("player", "dinara"):
            return False
        actor = self.actors[actor_id]
        actor["physical_guard"] = 0.45
        self.last_action_event = {"kind": "defend", "actor": actor_id, "physical_guard": 0.45}
        if actor_id == "player":
            if actor["stamina"] >= 8:
                actor["stamina"] -= 8
            recovery = self.balance["block_recovery"]
        else:
            recovery = self.balance["dinara_defend_recovery"]
        self._finish_action(actor_id, recovery)
        return True

    def dinara_ai_action(self):
        actor_id = "dinara"
        if self.current_actor_id != actor_id or not self.alive(actor_id):
            return False
        living_allies = self.living("ally")
        if self.potion_count > 0:
            candidates = [
                aid for aid in living_allies
                if self.actors[aid]["hp"] / self.actors[aid]["max_hp"] <= self.balance["dinara_heal_threshold"]
            ]
            if candidates:
                target = min(candidates, key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"])
                self.log.append(f"Динара использует лечебное зелье на {self.actors[target]['name']}.")
                return self.use_potion(target)
        actor = self.actors[actor_id]
        if actor["hp"] / actor["max_hp"] <= self.balance["dinara_guard_threshold"]:
            self.log.append("Динара занимает защитную позицию.")
            return self.player_defend()
        targets = self.living("enemy")
        if not targets:
            self.result = "victory"
            return True
        # Выбирает противника по сочетанию оставшегося HP и небольшой случайности.
        target = min(
            targets,
            key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"] + self.random.random() * 0.15,
        )
        result = self._damage(actor_id, target, self._physical_attack_value(actor_id))
        self.last_action_event = {
            "kind": "attack", "attacker": actor_id, "target": target,
            "damage": result["damage"], "critical": result["critical"],
            "dodged": result["dodged"],
        }
        self.log.append(f"Динара атакует {self.actors[target]['name']} скалкой.")
        self._finish_action(actor_id, self.balance["dinara_attack_recovery"])
        return True

    def goblin_ai_action(self, actor_id):
        actor = self.actors[actor_id]
        if self.current_actor_id != actor_id or not self.alive(actor_id):
            return False
        targets = self.living("ally")
        if not targets:
            self.result = "defeat"
            return True

        # Воодушевление: защита от стана применяется к себе или союзнику.
        # В тестовом бою с Воином и Динарой угрозы стана со стороны союзников нет,
        # поэтому AI не тратит действие впустую. Механика готова для будущих классов.
        enemy_has_stun = any(
            self.actors[aid]["role"] in ("rogue", "paladin")
            for aid in targets
        )
        self_or_ally = [
            aid for aid in self.living("enemy")
            if self.actors[aid]["stun_immunity_turns"] <= 0
        ]
        recently_stunned = any(self.actors[aid]["stun_turns"] > 0 for aid in self.living("enemy"))
        wounded_goblin = any(
            self.actors[aid]["hp"] / self.actors[aid]["max_hp"] <= 0.55
            for aid in self.living("enemy")
        )
        if self_or_ally and (enemy_has_stun or recently_stunned or wounded_goblin) and self.random.random() < 0.25:
            chosen = min(
                self_or_ally,
                key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"] + self.random.random() * 0.1,
            )
            # Если гоблин усиливает себя, компенсируем уменьшение счётчика
            # в _finish_action: эффект должен начаться после применения.
            duration = self.balance["inspire_immunity_turns"]
            self.actors[chosen]["stun_immunity_turns"] = duration + (1 if chosen == actor_id else 0)
            self.last_action_event = {"kind": "inspire", "actor": actor_id, "target": chosen}
            self.log.append(f"{actor['name']} использует «Воодушевление» на {self.actors[chosen]['name']}.")
            self._finish_action(actor_id, self.balance["goblin_inspire_recovery"])
            return True

        valid_net_targets = [
            aid for aid in targets
            if self.actors[aid]["stun_immunity_turns"] <= 0
            and self.actors[aid]["stun_turns"] <= 0
        ]
        use_net = bool(valid_net_targets) and self.random.random() < 0.30
        if use_net:
            multi = len(valid_net_targets) > 1 and self.random.random() < self.balance["net_multi_target_chance"]
            selected = valid_net_targets if multi else [
                min(valid_net_targets, key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"] + self.random.random() * 0.2)
            ]
            landed = []
            for target_id in selected:
                if self._apply_stun(target_id, self.balance["net_stun_turns"]):
                    landed.append(target_id)
            if landed:
                names = ", ".join(self.actors[aid]["name"] for aid in landed)
                self.last_action_event = {"kind": "net", "actor": actor_id, "targets": landed}
                self.log.append(f"{actor['name']} использует «Лови их!» — сеть накрывает: {names}.")
                self._finish_action(actor_id, self.balance["goblin_net_recovery"])
                return True

        target_id = min(
            targets,
            key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"] + self.random.random() * 0.20,
        )
        result = self._damage(
            actor_id, target_id, self._physical_attack_value(actor_id),
            damage_type="physical",
        )
        bleed_applied = False
        if result["damage"] and self.random.random() < self.balance["bleed_chance"]:
            self._apply_bleed(target_id)
            bleed_applied = True
            self.log.append(f"{actor['name']} накладывает кровотечение на {self.actors[target_id]['name']}.")
        self.last_action_event = {
            "kind": "attack", "attacker": actor_id, "target": target_id,
            "damage": result["damage"], "critical": result["critical"],
            "dodged": result["dodged"], "bleed": bleed_applied,
        }
        self.log.append(f"{actor['name']} атакует {self.actors[target_id]['name']} ржавым тесаком.")
        self._finish_action(actor_id, self.balance["goblin_attack_recovery"])
        return True

    def resolve_current_ai(self):
        actor_id = self.current_actor_id
        if actor_id == "dinara":
            return self.dinara_ai_action()
        if actor_id in ("goblin_1", "goblin_2"):
            return self.goblin_ai_action(actor_id)
        return False

    def summary(self):
        return {
            actor_id: {
                "name": actor["name"], "hp": actor["hp"],
                "max_hp": actor["max_hp"], "stamina": actor["stamina"],
                "max_stamina": actor["max_stamina"], "alive": actor["alive"],
                "bleed_turns": actor["bleed_turns"],
                "stun_turns": actor["stun_turns"],
                "stun_immunity_turns": actor["stun_immunity_turns"],
                "ready_at": actor["ready_at"],
            }
            for actor_id, actor in self.actors.items()
        }


def _evt005_hit_test_enemy(mouse_pos, enemy_hitboxes):
    """Return the living enemy under the cursor using shared screen hitboxes."""
    mouse_x, mouse_y = mouse_pos
    for enemy_id, (left, top, right, bottom) in enemy_hitboxes:
        if left <= mouse_x < right and top <= mouse_y < bottom:
            return enemy_id
    return None


def _evt005_battle_self_test():
    """Быстрый тест логики движка без запуска Pygame и загрузки ресурсов."""
    engine = EVT005BattleEngine("Тестовый воин")
    assert engine.potion_count == 1
    assert len(engine.living("enemy")) == 2
    assert len(engine.living("ally")) == 2
    assert engine.actors["player"]["max_stamina"] == 100

    # Проверяем: Динара может выбыть, а бой продолжается.
    engine.actors["dinara"]["hp"] = 0
    engine.actors["dinara"]["alive"] = False
    assert engine.check_result() is None
    assert engine.alive("player")

    # Проверяем: гибель героя немедленно означает поражение.
    engine.actors["player"]["hp"] = 0
    engine.actors["player"]["alive"] = False
    assert engine.check_result() == "defeat"

    # Проверяем: кровотечение обходит защиту и снимает ровно тик урона.
    engine = EVT005BattleEngine("Тестовый воин")
    goblin = engine.actors["goblin_1"]
    goblin["bleed_turns"] = 1
    goblin["toughness"] = 100.0
    goblin["physical_guard"] = 0.95
    before = goblin["hp"]
    goblin["ready_at"] = 1.0
    # Подвинем союзников позже, чтобы гоблин стал ближайшим участником.
    engine.actors["player"]["ready_at"] = 9000.0
    engine.actors["dinara"]["ready_at"] = 9000.0
    engine.actors["goblin_2"]["ready_at"] = 9000.0
    actor_id = engine.advance_to_next_turn()
    assert actor_id == "goblin_1"
    assert goblin["hp"] == before - engine.balance["bleed_damage"]

    # Проверяем: нулевая выносливость даёт базовой атаке ровно 1 урон,
    # не тратя ресурс и не блокируя возможность действия.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.current_actor_id = "player"
    engine.actors["player"]["stamina"] = 0
    for other_id in ("dinara", "goblin_1", "goblin_2"):
        engine.actors[other_id]["ready_at"] = engine.clock
    engine.actors["goblin_1"]["agility"] = 0
    target_before = engine.actors["goblin_1"]["hp"]
    assert engine.player_attack("goblin_1")
    assert engine.actors["goblin_1"]["hp"] == target_before - 1
    assert engine.last_action_event["damage"] == 1
    assert not engine.last_action_event["critical"]
    assert engine.actors["player"]["stamina"] == 0

    # При частичном запасе ниже цены атаки остаток не сгорает:
    # герой наносит 1 урон и продолжает восстанавливать ресурс со временем.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.current_actor_id = "player"
    engine.actors["player"]["stamina"] = 5
    for other_id in ("dinara", "goblin_1", "goblin_2"):
        engine.actors[other_id]["ready_at"] = engine.clock
    engine.actors["goblin_1"]["agility"] = 0
    target_before = engine.actors["goblin_1"]["hp"]
    assert engine.player_attack("goblin_1")
    assert engine.actors["goblin_1"]["hp"] == target_before - 1
    assert engine.last_action_event["damage"] == 1
    assert not engine.last_action_event["critical"]
    assert engine.actors["player"]["stamina"] == 5

    # Hover and left-click target selection share the same sprite hitboxes.
    enemy_hitboxes = [
        ("goblin_1", (610, 190, 765, 405)),
        ("goblin_2", (775, 190, 930, 405)),
    ]
    assert _evt005_hit_test_enemy((690, 300), enemy_hitboxes) == "goblin_1"
    assert _evt005_hit_test_enemy((850, 300), enemy_hitboxes) == "goblin_2"
    assert _evt005_hit_test_enemy((770, 300), enemy_hitboxes) is None

    # Берсерк недоступен выше 25% HP и открывает дополнительный ход ниже порога.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.current_actor_id = "player"
    assert not engine.player_berserk()
    engine.actors["player"]["hp"] = 30
    engine.current_actor_id = "player"
    assert engine.player_berserk()
    assert engine.actors["player"]["berserk_attacks_left"] == 2
    assert engine.current_actor_id == "player"

    # Динара может потратить общее зелье на союзника; лечение процентное.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.current_actor_id = "dinara"
    engine.actors["player"]["hp"] = 60
    assert engine.use_potion("player")
    assert engine.actors["player"]["hp"] == 102
    assert engine.potion_count == 0

    # Иммунитет от «Воодушевления» не теряет ход в момент применения.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.random.seed(4)
    engine.current_actor_id = "goblin_1"
    engine.actors["goblin_1"]["hp"] = 20
    engine.actors["goblin_1"]["ready_at"] = engine.clock
    engine.actors["goblin_2"]["ready_at"] = 9000
    engine.actors["player"]["ready_at"] = 9000
    engine.actors["dinara"]["ready_at"] = 9000
    # Форсируем условие и выбор наиболее раненого гоблина.
    engine.random.random = lambda: 0.0
    assert engine.goblin_ai_action("goblin_1")
    assert engine.actors["goblin_1"]["stun_immunity_turns"] == 3
    assert not engine._apply_stun("goblin_1", 2)

    return True


def main():
