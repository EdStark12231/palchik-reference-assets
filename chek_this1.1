def load_kitchen_item_sprites():
    sheet_1 = load_image(KITCHEN_ITEMS_PATH_1)
    sheet_2 = load_image(KITCHEN_ITEMS_PATH_2)

    expected_sizes = {
        "props1": (2352, 3520),
        "props2": (2576, 3216),
    }

    if sheet_1.get_size() != expected_sizes["props1"]:
        raise ValueError(
            f"Unexpected first item sheet size: {sheet_1.get_size()}"
        )

    if sheet_2.get_size() != expected_sizes["props2"]:
        raise ValueError(
            f"Unexpected second item sheet size: {sheet_2.get_size()}"
        )

    sheets = {
        "props1": (sheet_1, 4, 6),
        "props2": (sheet_2, 4, 5),
    }

    result = {}

    for (
        item_id,
        name,
        description,
        sheet_key,
        column,
        row,
        position
    ) in KITCHEN_ITEM_LAYOUT:

        sheet, columns, rows = sheets[sheet_key]

        x1 = round(column * sheet.get_width() / columns)
        x2 = round((column + 1) * sheet.get_width() / columns)
        y1 = round(row * sheet.get_height() / rows)
        y2 = round((row + 1) * sheet.get_height() / rows)

        cell = sheet.subsurface(
            pygame.Rect(x1, y1, x2 - x1, y2 - y1)
        ).copy()

        # Handle a pure black background if a sheet has no transparency.
        corners = [
            cell.get_at((0, 0)),
            cell.get_at((cell.get_width() - 1, 0)),
            cell.get_at((0, cell.get_height() - 1)),
            cell.get_at((cell.get_width() - 1, cell.get_height() - 1)),
        ]

        if all(
            color.a >= 250 and max(color.r, color.g, color.b) <= 8
            for color in corners
        ):
            cell.set_colorkey((0, 0, 0))
            transparent = pygame.Surface(
                cell.get_size(),
                pygame.SRCALPHA
            )
            transparent.blit(cell, (0, 0))
            cell = transparent

        bounds = cell.get_bounding_rect()

        if bounds.width <= 0 or bounds.height <= 0:
            raise ValueError(f"Empty sprite cell for item: {item_id}")

        sprite = cell.subsurface(bounds).copy()
        result[item_id] = fit_image(
            sprite,
            *KITCHEN_ITEM_MAX_SIZE
        )

    return result


def build_kitchen_items(sprites, include_dough=False):
    items = []

    for (
        item_id,
        name,
        description,
        sheet_key,
        column,
        row,
        position
    ) in KITCHEN_ITEM_LAYOUT:
        if item_id == "dough" and not include_dough:
            continue

        image = sprites.get(item_id)
        if image is None:
            continue

        items.append({
            "id": item_id,
            "name": name,
            "description": description,
            "image": image,
            "position": position,
            "approach": (
                float(position[0]),
                KITCHEN_ITEM_APPROACH_Y
            ),
            "rect": image.get_rect(center=position),
        })

    return items


def load_dinara():
    emotions = {}

    for emotion, filename in EMOTIONS.items():
        path = SWEETY_DIR / filename

        if not path.is_file():
            print(f"[ПРЕДУПРЕЖДЕНИЕ] Нет эмоции: {path}")
            continue

        image = crop_transparent_bounds(load_image(path))

        new_width = max(
            1,
            round(
                image.get_width()
                * SPRITE_HEIGHT
                / image.get_height()
            )
        )

        emotions[emotion] = pygame.transform.smoothscale(
            image,
            (new_width, SPRITE_HEIGHT)
        )

    if "base" not in emotions:
        raise FileNotFoundError(
            "Не найден обязательный спрайт Sweety/base.png"
        )

    return emotions


def load_class_images():
    result = []

    for item in CLASSES:
        path = CHAR_DIR / item["file"]

        if not path.is_file():
            print(f"[ПРЕДУПРЕЖДЕНИЕ] Нет спрайта класса: {path}")
            result.append(None)
            continue

        image = load_image(path)
        result.append(fit_image(image, 190, 205))

    return result

def load_goblin_base():
    """Загрузить и обрезать базовое изображение гоблина."""
    if not GOBLIN_PATH.is_file():
        raise FileNotFoundError(
            f"Не найден спрайт гоблина: {GOBLIN_PATH}"
        )

    source = load_image(GOBLIN_PATH)

    if source.get_size() != GOBLIN_SOURCE_SIZE:
        raise ValueError(
            "Неожиданный размер Goblin Base.png: "
            f"{source.get_size()}, ожидался {GOBLIN_SOURCE_SIZE}."
        )

    crop_rect = pygame.Rect(GOBLIN_CROP_RECT)

    if not source.get_rect().contains(crop_rect):
        raise ValueError(
            "Область обрезки гоблина выходит за границы изображения."
        )

    character = source.subsurface(crop_rect).copy()
    visible_bounds = character.get_bounding_rect()

    if visible_bounds.width <= 0 or visible_bounds.height <= 0:
        raise ValueError(
            "В области Goblin Base.png не найден персонаж."
        )

    character = character.subsurface(visible_bounds).copy()

    return fit_image(character, *GOBLIN_DISPLAY_MAX_SIZE)

