def draw_eye_reveal(surface, elapsed):
    progress = ease_in_out(
        (elapsed - EYE_REVEAL_START) / EYE_REVEAL_DURATION
    )

    if progress >= 1.0:
        return

    darkness = int(225 * (1.0 - progress))

    overlay = pygame.Surface(
        (WIDTH, HEIGHT),
        pygame.SRCALPHA
    )

    overlay.fill((0, 0, 0, darkness))

    opening_width = int(80 + 1100 * progress)
    opening_height = int(25 + 700 * progress)

    opening = pygame.Rect(
        0,
        0,
        opening_width,
        opening_height
    )

    opening.center = (WIDTH // 2, HEIGHT // 2)

    pygame.draw.ellipse(
        overlay,
        (0, 0, 0, 0),
        opening
    )

    surface.blit(overlay, (0, 0))


