    def choose_story_option(index):
        nonlocal story_index, story_nodes, story_choice_index, story_elapsed
        if stage != "story_dialogue" or not story_nodes:
            return
        if not (0 <= story_index < len(story_nodes)):
            return
        node = story_nodes[story_index]
        if node.get("kind") != "choice":
            return
        options = node.get("options", [])
        if not (0 <= index < len(options)):
            return
        branch = options[index].get("branch", [])
        story_nodes[story_index + 1:story_index + 1] = list(branch)
        story_index += 1
        story_elapsed = 0.0
        story_choice_index = 0

    def advance_story_sequence():
        nonlocal story_index, story_elapsed, stage, story_emotion
        if not story_nodes or story_index >= len(story_nodes):
            return
        node = story_nodes[story_index]
        kind = node.get("kind")
        if kind == "choice":
            return
        if kind == "event":
            if node.get("action") == "show_goblins":
                nonlocal battle_story_goblins_visible
                battle_story_goblins_visible = True
            story_index += 1
            story_elapsed = 0.0
            return
        if kind == "pause":
            duration = node.get("duration", 0.75)
            if story_elapsed < duration:
                story_elapsed = duration
                return
            story_index += 1
            story_elapsed = 0.0
            return
        message = node.get("text", "")
        if visible_character_count(message, story_elapsed) < len(message):
            story_elapsed = text_duration(message) + 0.5
            return
        if node.get("emotion_after"):
            story_emotion = node["emotion_after"]
        story_index += 1
        story_elapsed = 0.0
        if story_index >= len(story_nodes):
            action = story_next_action
            if action == "start_battle":
                start_battle()
            elif action == "victory_return":
                finish_victory_sequence()
            elif action == "defeat_choices":
                stage = "defeat_choices"
            else:
                stage = "kitchen_scene"

