        nonlocal story_nodes, story_index, story_elapsed, story_next_action
        nonlocal story_choice_index, story_emotion
        nonlocal battle_story_goblins_visible, battle_story_bodies_visible

        # Never restart an active battle or bypass the scripted defeat choice.
        if stage in ("battle", "defeat_choices"):
            return False

        if not fast_travel_active:
            fast_travel_restore_state = (
                player_name, selected_class, selected_class_data
            )

        warrior_index = next(
            index for index, class_data in enumerate(CLASSES)
            if class_data["name"] == "ВОИН"
        )
        player_name = "тапок"
        selected_class = warrior_index
        selected_class_data = CLASSES[warrior_index]

        # Clear any unfinished dialogue/choice so the battle opens cleanly.
