    def handle_battle_command(command_index):
        nonlocal battle_ui_mode, battle_selected_command, battle_message, battle_message_timer
        nonlocal battle_selected_target, battle_selected_target_timer
        if battle_engine is None or battle_engine.current_actor_id != "player":
            return
        if battle_ui_mode == "commands":
            if command_index == 0:
                battle_ui_mode = "target"
                battle_selected_target_index = 0
            elif command_index == 1:
                battle_ui_mode = "skills"
                battle_selected_command = 0
            elif command_index == 2:
                battle_ui_mode = "items"
                battle_selected_command = 0
            elif command_index == 3:
                if battle_engine.player_sword_block():
                    battle_ui_mode = "commands"
                    battle_selected_command = 0
                    battle_message = "Блок мечом: физический урон снижен."
                    battle_message_timer = 1.2
                else:
                    battle_message = "Недостаточно выносливости для блока мечом."
                    battle_message_timer = 1.2
        elif battle_ui_mode == "skills":
            if command_index == 0:
                if battle_engine.player_circle_attack():
                    battle_ui_mode = "commands"
                    battle_selected_command = 0
                    battle_message = "Воин выполняет круговую атаку!"
                    battle_message_timer = 1.2
                else:
                    battle_message = "Недостаточно выносливости."
                    battle_message_timer = 1.2
            elif command_index == 1:
                if battle_engine.player_berserk():
                    battle_ui_mode = "commands"
                    battle_selected_command = 0
                    battle_message = "БЕРСЕРК! Урон и критические показатели усилены."
                    battle_message_timer = 1.5
                else:
                    battle_message = "Берсерк доступен при HP не выше 25% и достаточной Stamina."
                    battle_message_timer = 1.5
            elif command_index == 2:
                battle_ui_mode = "commands"
                battle_selected_command = 0
        elif battle_ui_mode == "target":
            enemy_ids = battle_engine.living("enemy")
            if command_index < len(enemy_ids):
                target_id = enemy_ids[command_index]
                # Keep the chosen target visibly marked while the hit feedback is shown.
                battle_selected_target = target_id
                battle_selected_target_timer = 1.4
                battle_engine.player_attack(target_id)
                battle_ui_mode = "commands"
                battle_selected_command = 0
                event = battle_engine.last_action_event or {}
                if event.get("dodged"):
                    battle_message = f"{battle_engine.actors[target_id]['name']} уклоняется!"
                elif battle_engine.actors[target_id]["alive"]:
                    battle_message = random.choice(GOBLIN_HIT_LINES) + f" ({event.get('damage', 0)} урона)"
                else:
                    battle_message = "Гоблин повержен!"
                battle_message_timer = 1.4
            else:
                battle_ui_mode = "commands"
                battle_selected_command = 0
        elif battle_ui_mode == "items":
            if command_index == 0:
                target_id = "player"
            elif command_index == 1:
                target_id = "dinara"
            else:
                battle_ui_mode = "commands"
                battle_selected_command = 0
                return
            if battle_engine.use_potion(target_id):
                battle_ui_mode = "commands"
                battle_selected_command = 0
                event = battle_engine.last_action_event or {}
                battle_message = f"Восстановлено {event.get('amount', 0)} HP."
                battle_message_timer = 1.2
            else:
                battle_message = "Зелье недоступно или цель не нуждается в лечении."
                battle_message_timer = 1.2
        if battle_engine.result:
            finish_battle(battle_engine.result)

