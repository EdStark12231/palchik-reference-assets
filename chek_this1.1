                color = (220, 65, 75) if i < filled else (85, 85, 92)
                hx = rect.x + 18 + i * 19
                hy = rect.y + 29
                pygame.draw.circle(surface, color, (hx - 2, hy - 2), 3)
                pygame.draw.circle(surface, color, (hx + 2, hy - 2), 3)
                pygame.draw.polygon(surface, color, [(hx - 5, hy - 1), (hx + 5, hy - 1), (hx, hy + 5)])
