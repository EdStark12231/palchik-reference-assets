    # --------------------------------------------------------
    # Главный цикл
    # --------------------------------------------------------

    debug_stage = None

    while running:
        dt = min(clock.tick(FPS) / 1000.0, 0.05)

        # ----------------------------------------------------
        # Автоматические временные стадии
        # ----------------------------------------------------

        if stage == "narrator_intro_pause":
            narrator_intro_elapsed += dt

            if narrator_intro_elapsed >= INTRO_PAUSE_DURATION:
                stage = "narrator"
                dialogue_elapsed = 0.0

        elif stage == "narrator":
            dialogue_elapsed += dt

        elif stage == "white_shake":
            white_elapsed += dt

        elif stage == "room_reveal":
            room_elapsed += dt

            # Движение и протирание глаз идут одновременно.
            if room_elapsed >= max(
                MOVEMENT_DURATION,
                EYE_REVEAL_START + EYE_REVEAL_DURATION
            ):
                begin_dinara_dialogue()

        elif stage == "inspection_pause":
            inspection_pause_elapsed += dt

            if inspection_pause_elapsed >= INSPECTION_PAUSE_DURATION:
                begin_after_inspection_pause()

        elif stage == "greeting_laugh":
            greeting_laugh_elapsed += dt

            if greeting_laugh_elapsed >= GREETING_LAUGH_DURATION:
                stage = "greeting_return"
                greeting_return_elapsed = 0.0
                current_emotion = "base"

        elif stage == "greeting_return":
            greeting_return_elapsed += dt

            if greeting_return_elapsed >= GREETING_RETURN_DURATION:
                begin_class_dialogue()

        elif stage in (
            "dinara_dialogue",
            "name_introduction",
            "after_greeting",
            "class_dialogue",
            "class_confirmed",
        ):
            dialogue_elapsed += dt

        elif stage == "kitchen_dialogue":
            kitchen_dialogue_elapsed += dt

        elif stage == "story_dialogue":
            story_elapsed += dt

        elif stage == "battle":
            if battle_message_timer > 0.0:
                battle_message_timer = max(0.0, battle_message_timer - dt)
            if battle_selected_target_timer > 0.0:
                battle_selected_target_timer = max(0.0, battle_selected_target_timer - dt)
                if battle_selected_target_timer <= 0.0:
                    battle_selected_target = None
            current = battle_engine.current_actor_id if battle_engine else None
            if current in ("dinara", "goblin_1", "goblin_2"):
                battle_ai_elapsed += dt
                if battle_ai_elapsed >= 0.55:
                    battle_ai_elapsed = 0.0
                    actor_before = current
                    battle_engine.resolve_current_ai()
                    battle_turn_owner = battle_engine.current_actor_id
                    action_event = battle_engine.last_action_event or {}
                    battle_message = ""
                    if actor_before in ("goblin_1", "goblin_2"):
                        if action_event.get("kind") == "attack":
                            battle_message = random.choice(GOBLIN_ATTACK_LINES)
                        elif action_event.get("kind") == "net":
                            battle_message = "Лови их! Сеть летит в цель!"
                        elif action_event.get("kind") == "inspire":
                            battle_message = "Воодушевление! Гоблин защищён от стана."
                    elif actor_before == "dinara":
                        if action_event.get("kind") == "attack":
                            battle_message = "Динара атакует скалкой!"
                        elif action_event.get("kind") == "heal":
                            battle_message = f"Динара использовала зелье: +{action_event.get('amount', 0)} HP."
                        elif action_event.get("kind") == "defend":
                            battle_message = "Динара прикрывается."
                    if not battle_message:
                        battle_message = "Противник завершил действие."
                    battle_message_timer = 1.2
                    if battle_engine.result:
                        finish_battle(battle_engine.result)

        # Уведомления Level Up исчезают сами, очки остаются доступными.
        for notification_id in levelup_notifications:
            levelup_notifications[notification_id] = max(0.0, levelup_notifications[notification_id] - dt)

        # ----------------------------------------------------
        # События
        # ----------------------------------------------------

        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                running = False

            elif event.type == pygame.KEYDOWN:

                if event.key == pygame.K_F2:
                    # F2 is a test shortcut only; normal story keeps the player's chosen name.
                    fast_travel_to_battle()
                    continue

                if event.key == pygame.K_ESCAPE and stage == "character_profile":
                    stage = profile_return_stage
                    continue

                if event.key == pygame.K_ESCAPE:
                    running = False
                    continue

                # Ввод имени имеет приоритет над горячими клавишами.
                if stage == "name_input":

                    if event.key == pygame.K_BACKSPACE:
                        player_name = player_name[:-1]

                    elif event.key == pygame.K_RETURN:
                        cleaned = player_name.strip()

                        if cleaned:
                            player_name = cleaned
                            pygame.key.stop_text_input()
                            begin_name_introduction()

                    continue

                # Перезапуск доступен вне ввода имени, кроме меню поражения.
                if event.key == pygame.K_r and stage not in ("defeat_choices",):
                    reset_scene()
                    pygame.key.stop_text_input()
                    continue

                if event.key == pygame.K_SPACE:
                    advance_action()
                    continue

                if stage == "character_profile":
                    if event.key in (pygame.K_ESCAPE, pygame.K_BACKSPACE, pygame.K_RETURN):
                        stage = profile_return_stage
                    continue

                if stage == "story_dialogue":
                    if story_nodes and story_index < len(story_nodes) and story_nodes[story_index].get("kind") == "choice":
                        if event.key in (pygame.K_UP, pygame.K_LEFT):
                            story_choice_index = (story_choice_index - 1) % len(story_nodes[story_index]["options"])
                        elif event.key in (pygame.K_DOWN, pygame.K_RIGHT):
                            story_choice_index = (story_choice_index + 1) % len(story_nodes[story_index]["options"])
                        elif event.key in (pygame.K_RETURN, pygame.K_1, pygame.K_2, pygame.K_3):
                            chosen = event.key - pygame.K_1 if event.key in (pygame.K_1, pygame.K_2, pygame.K_3) else story_choice_index
                            choose_story_option(chosen)
                    else:
                        advance_story_sequence()
                    continue

                if stage == "battle":
                    if battle_engine and battle_engine.current_actor_id == "player":
                        if event.key in (pygame.K_1, pygame.K_2, pygame.K_3, pygame.K_4):
                            handle_battle_command(event.key - pygame.K_1)
                        elif event.key == pygame.K_BACKSPACE:
                            battle_ui_mode = "commands"
                            battle_selected_command = 0
                        elif event.key in (pygame.K_LEFT, pygame.K_UP, pygame.K_RIGHT, pygame.K_DOWN):
                            if battle_ui_mode == "commands":
                                maximum = 3
                            elif battle_ui_mode == "skills":
                                maximum = 2
                            elif battle_ui_mode == "items":
                                maximum = 2
                            else:
                                maximum = max(0, len(battle_engine.living("enemy")) - 1)
                            if event.key in (pygame.K_LEFT, pygame.K_UP):
                                battle_selected_command = (battle_selected_command - 1) % (maximum + 1)
                            else:
                                battle_selected_command = (battle_selected_command + 1) % (maximum + 1)
                        elif event.key == pygame.K_RETURN:
                            handle_battle_command(battle_selected_command)
                    continue

                if stage == "battle_class_notice":
                    if event.key in (pygame.K_RETURN, pygame.K_SPACE):
                        reset_scene()
                    continue

                if stage == "defeat_choices":
                    if event.key in (pygame.K_LEFT, pygame.K_UP, pygame.K_1):
                        battle_selected_command = 0
                    elif event.key in (pygame.K_RIGHT, pygame.K_DOWN, pygame.K_2):
                        battle_selected_command = 1
                    elif event.key == pygame.K_RETURN:
                        if battle_selected_command == 0:
                            running = False
                        else:
                            return_to_event_checkpoint()
                    continue

                # Выбор приветствия.
                if stage == "greeting":

                    if event.key in (
                        pygame.K_LEFT,
                        pygame.K_UP
                    ):
                        greeting_index = (
                            greeting_index - 1
                        ) % len(GREETING_CHOICES)

                    elif event.key in (
                        pygame.K_RIGHT,
                        pygame.K_DOWN
                    ):
                        greeting_index = (
                            greeting_index + 1
                        ) % len(GREETING_CHOICES)

                    elif event.key in (
                        pygame.K_1,
                        pygame.K_2,
                        pygame.K_3
                    ):
                        greeting_index = event.key - pygame.K_1
                        begin_greeting_response(greeting_index)

                    elif event.key == pygame.K_RETURN:
                        begin_greeting_response(greeting_index)

                    continue

                # Выбор класса.
                if stage == "class_select":

                    if event.key in (
                        pygame.K_LEFT,
                        pygame.K_UP
                    ):
                        selected_class = (
                            selected_class - 1
                        ) % len(CLASSES)

                    elif event.key in (
                        pygame.K_RIGHT,
                        pygame.K_DOWN
                    ):
                        selected_class = (
                            selected_class + 1
                        ) % len(CLASSES)

                    elif event.key in (
                        pygame.K_1,
                        pygame.K_2,
                        pygame.K_3,
                        pygame.K_4
                    ):
                        selected_class = event.key - pygame.K_1

                    elif event.key == pygame.K_RETURN:
                        confirm_class()

                    continue

                # В кухне ручное движение отменяет автоподход.
                if stage == "kitchen_scene" and event.key in (
                    pygame.K_LEFT,
                    pygame.K_RIGHT,
                    pygame.K_UP,
                    pygame.K_DOWN,
                    pygame.K_a,
                    pygame.K_d,
                    pygame.K_w,
                    pygame.K_s,
                ):
                    kitchen_move_target = None
                    kitchen_target_action = None
                    kitchen_target_item_id = None

            elif event.type == pygame.TEXTINPUT:

                if stage == "name_input":
                    candidate = player_name + event.text

                    if len(candidate) <= 18:
                        if all(
                            character.isprintable()
                            for character in event.text
                        ):
                            player_name = candidate

            elif event.type == pygame.MOUSEBUTTONDOWN:

                if event.button != 1:
                    continue

                # Кухонный диалог имеет отдельный обработчик.
                if stage == "kitchen_dialogue":
                    advance_kitchen_dialogue()
                    continue

                if stage == "greeting":

                    for index in range(len(GREETING_CHOICES)):
                        rect = pygame.Rect(
                            180,
                            170 + index * 65,
                            600,
                            55
                        )

                        if rect.collidepoint(event.pos):
                            begin_greeting_response(index)
                            break

                    continue

                if stage == "class_select":

                    for index, (x, y) in enumerate(CLASS_POSITIONS):
                        rect = pygame.Rect(x, y, 440, 220)

                        if rect.collidepoint(event.pos):
                            if selected_class == index:
                                confirm_class()
                            else:
                                selected_class = index
                            break

                    continue

                if stage == "name_input":
                    continue

                if stage == "character_profile":
                    panel = pygame.Rect(78, 48, 804, 444)
                    if pygame.Rect(panel.right - 112, panel.y + 20, 88, 36).collidepoint(event.pos):
                        stage = profile_return_stage
                    elif pygame.Rect(panel.x + 24, panel.y + 132, 220, 38).collidepoint(event.pos):
                        profile_tab = "stats"
                    elif pygame.Rect(panel.x + 254, panel.y + 132, 220, 38).collidepoint(event.pos):
                        profile_tab = "skills"
                    else:
                        current_rows = profile_stat_rows(profile_character) if profile_tab == "stats" else profile_skill_rows(profile_character)
                        for profile_i in range(len(current_rows)):
                            plus_rect = profile_plus_rect(profile_i)
                            plus_rect.y = panel.y + 184 + profile_i * 48
                            if plus_rect.collidepoint(event.pos):
                                apply_profile_upgrade(profile_i)
                                break
                    continue

                if stage == "story_dialogue":
                    if story_nodes and story_index < len(story_nodes) and story_nodes[story_index].get("kind") == "choice":
                        for choice_i in range(len(story_nodes[story_index]["options"])):
                            rect = pygame.Rect(115, 185 + choice_i * 58, 730, 48)
                            if rect.collidepoint(event.pos):
                                choose_story_option(choice_i)
                                break
                    else:
                        advance_story_sequence()
                    continue

                if stage == "battle":
                    if battle_engine and battle_engine.current_actor_id == "player":
                        if battle_ui_mode == "commands":
                            for command_i in range(4):
                                rect = pygame.Rect(12 + command_i * 212, HEIGHT - 70, 205, 55)
                                if rect.collidepoint(event.pos):
                                    handle_battle_command(command_i)
                                    break
                        elif battle_ui_mode == "skills":
                            for skill_i in range(3):
                                rect = pygame.Rect(12 + skill_i * 207, HEIGHT - 70, 200, 55)
                                if rect.collidepoint(event.pos):
                                    handle_battle_command(skill_i)
                                    break
                        elif battle_ui_mode == "target":
                            # First try the visible enemy sprite itself. The same hitboxes
                            # drive both hover highlighting and left-click target selection.
                            enemy_slots = ((690, 390), (845, 390))
                            living_enemy_ids = battle_engine.living("enemy")
                            enemy_hitboxes = []
                            for enemy_index, enemy_id in enumerate(("goblin_1", "goblin_2")):
                                if enemy_id not in living_enemy_ids:
                                    continue
                                sprite_rect = goblin_base_image.get_rect(midbottom=enemy_slots[enemy_index])
                                hit_rect = sprite_rect.inflate(10, 10)
                                enemy_hitboxes.append((
                                    enemy_id,
                                    (hit_rect.left, hit_rect.top, hit_rect.right, hit_rect.bottom),
                                ))
                            clicked_target_id = _evt005_hit_test_enemy(event.pos, enemy_hitboxes)
                            if clicked_target_id is not None:
                                handle_battle_command(living_enemy_ids.index(clicked_target_id))
                            else:
                                # Keep the on-screen target rows as an alternative click area.
                                for target_i, target_id in enumerate(living_enemy_ids):
                                    rect = pygame.Rect(650, 330 + target_i * 65, 260, 58)
                                    if rect.collidepoint(event.pos):
                                        handle_battle_command(target_i)
                                        break
                            if pygame.Rect(12, HEIGHT - 70, 205, 55).collidepoint(event.pos):
                                handle_battle_command(2)
                        elif battle_ui_mode == "items":
                            for item_i in range(3):
                                rect = pygame.Rect(12 + item_i * 207, HEIGHT - 70, 200, 55)
                                if rect.collidepoint(event.pos):
                                    handle_battle_command(item_i)
                                    break
                    continue

                if stage == "defeat_choices":
                    if pygame.Rect(135, 300, 320, 60).collidepoint(event.pos):
                        running = False
                    elif pygame.Rect(505, 300, 320, 60).collidepoint(event.pos):
                        return_to_event_checkpoint()
                    continue

                if stage == "battle_class_notice":
                    reset_scene()
                    continue

                # ------------------------------------------------
                # Взаимодействия кухни
                # ------------------------------------------------

                if stage == "kitchen_scene":
                    player_profile_rect = pygame.Rect(WIDTH - 112, 12, 46, 46)
                    dinara_profile_rect = pygame.Rect(WIDTH - 58, 12, 46, 46)
                    if player_profile_rect.collidepoint(event.pos):
                        profile_character = "player"
                        profile_tab = "stats"
                        profile_return_stage = stage
                        stage = "character_profile"
                        continue
                    if dinara_profile_rect.collidepoint(event.pos):
                        profile_character = "dinara"
                        profile_tab = "stats"
                        profile_return_stage = stage
                        stage = "character_profile"
                        continue

                    dinara_hit_rect = kitchen_dinara_image.get_rect(
                        midbottom=KITCHEN_DINARA_FOOT
                    ).inflate(28, 24)

                    clicked_dinara = dinara_hit_rect.collidepoint(
                        event.pos
                    )

                    # Когда игрок несёт предмет, разрешена только
                    # передача Динаре. Другие клики не меняют маршрут.
                    if kitchen_carried_item is not None:

                        if clicked_dinara:
                            kitchen_move_target = (
                                KITCHEN_DINARA_APPROACH
                            )
                            kitchen_target_action = "deliver"
                            kitchen_target_item_id = None
                        else:
                            kitchen_notice = (
                                "Сначала передай предмет Динаре."
                            )
                            kitchen_notice_timer = 1.8

                        continue

                    # Без предмета клик по Динаре ничего не делает.
                    if clicked_dinara:
                        continue

                    if kitchen_requested_item_id is None:
                        kitchen_notice = "Сейчас Динара не просит новый предмет."
                        kitchen_notice_timer = 1.8
                        continue

                    clicked_item = None

                    for item in reversed(kitchen_items):
                        hit_rect = item["rect"].inflate(14, 14)

                        if hit_rect.collidepoint(event.pos):
                            clicked_item = item
                            break

                    if clicked_item is not None:
                        kitchen_move_target = clicked_item["approach"]
                        kitchen_target_action = "pickup"
                        kitchen_target_item_id = clicked_item["id"]

                    else:
                        # Клик по свободному месту отменяет автоподход.
                        kitchen_move_target = None
                        kitchen_target_action = None
                        kitchen_target_item_id = None

                    continue

                advance_action()

        # ----------------------------------------------------
        # Kitchen free-roam movement
        # ----------------------------------------------------

        if stage == "kitchen_scene":

            keys = pygame.key.get_pressed()

            move_x = (
                int(keys[pygame.K_RIGHT] or keys[pygame.K_d])
                - int(keys[pygame.K_LEFT] or keys[pygame.K_a])
            )

            move_y = (
                int(keys[pygame.K_DOWN] or keys[pygame.K_s])
                - int(keys[pygame.K_UP] or keys[pygame.K_w])
            )

            if move_x or move_y:
                # Ручное движение отменяет автоподход.
                kitchen_move_target = None
                kitchen_target_action = None
                kitchen_target_item_id = None

                magnitude = math.hypot(move_x, move_y)
                step = KITCHEN_PLAYER_SPEED * dt / magnitude

                kitchen_player_x += move_x * step
                kitchen_player_y += move_y * step

                kitchen_player_x = clamp(
                    kitchen_player_x,
                    *KITCHEN_PLAYER_X_BOUNDS
                )
                kitchen_player_y = clamp(
                    kitchen_player_y,
                    *KITCHEN_PLAYER_Y_BOUNDS
                )

            elif kitchen_move_target is not None:
                target_x, target_y = kitchen_move_target

                dx = target_x - kitchen_player_x
                dy = target_y - kitchen_player_y
                distance = math.hypot(dx, dy)

                if distance <= KITCHEN_ITEM_ARRIVAL_RADIUS:
                    # Персонаж действительно дошёл до точки.
                    kitchen_player_x = target_x
                    kitchen_player_y = target_y

                    if kitchen_target_action == "pickup":
                        target_item = next(
                            (
                                item for item in kitchen_items
                                if item["id"] == kitchen_target_item_id
                            ),
                            None
                        )

                        if (
                            target_item is not None
                            and kitchen_carried_item is None
                        ):
                            approach_x, approach_y = target_item["approach"]

                            actual_distance = math.hypot(
                                kitchen_player_x - approach_x,
                                kitchen_player_y - approach_y
                            )

                            if (
                                actual_distance
                                <= KITCHEN_ITEM_INTERACTION_RADIUS
                            ):
                                # Предмет исчезает из мира только
                                # после достижения точки подбора.
                                kitchen_items.remove(target_item)
                                kitchen_carried_item = target_item

                                kitchen_notice = (
                                    "Подобрано: " + target_item["name"]
                                )
                                kitchen_notice_timer = 1.8

                    elif kitchen_target_action == "deliver":
                        if kitchen_carried_item is not None:
                            # Передача происходит только после того,
                            # как персонаж дошёл до Динары.
                            begin_kitchen_item_delivery()

                    kitchen_move_target = None
                    kitchen_target_action = None
                    kitchen_target_item_id = None

                elif distance > 0.0:
                    step = min(KITCHEN_ITEM_SPEED * dt, distance)

                    kitchen_player_x += dx / distance * step
                    kitchen_player_y += dy / distance * step

                    kitchen_player_x = clamp(
                        kitchen_player_x,
                        *KITCHEN_PLAYER_X_BOUNDS
                    )
                    kitchen_player_y = clamp(
                        kitchen_player_y,
                        *KITCHEN_PLAYER_Y_BOUNDS
                    )

            if kitchen_notice_timer > 0.0:
                kitchen_notice_timer = max(
                    0.0,
                    kitchen_notice_timer - dt
                )

        # ----------------------------------------------------
        # Отладочная информация о смене стадий
        # ----------------------------------------------------

        if stage != debug_stage:
            debug_stage = stage

            print(
                f"[STAGE] {stage!r} | "
                f"room_size={room.get_size()} | "
                f"room_pixel={room.get_at((10, 10))}"
            )

        # ----------------------------------------------------
        # Отрисовка
        # ----------------------------------------------------

        frame = pygame.Surface((WIDTH, HEIGHT))
        frame.fill(BLACK)

        # ----------------------------------------------------
        # Начальная пауза перед рассказчиком
        # ----------------------------------------------------

        if stage == "narrator_intro_pause":
            frame.fill(BLACK)

        # ----------------------------------------------------
        # Рассказчик
        # ----------------------------------------------------

        elif stage == "narrator":

            frame.fill(BLACK)

            message = NARRATOR_LINES[narrator_index]

            draw_dialogue_panel(
                frame,
                speaker_font,
                message_font,
                "Рассказчик",
                message,
                dialogue_elapsed
            )

        # ----------------------------------------------------
        # Белый экран и тряска
        # ----------------------------------------------------

        elif stage == "white_shake":

            frame.fill(WHITE)

            message = WAKE_LINES[shake_line_index]

            draw_dialogue_panel(
                frame,
                speaker_font,
                message_font,
                "Игрок",
                message,
                white_elapsed,
                show_full=False
            )

        # ----------------------------------------------------
        # Комната и пробуждение
        # ----------------------------------------------------

        elif stage == "room_reveal":

            frame.blit(room, (0, 0))

            movement_progress = ease_in_out(
                room_elapsed / MOVEMENT_DURATION
            )

            x = START_X + (
                END_X - START_X
            ) * movement_progress

            y = START_Y + (
                END_Y - START_Y
            ) * movement_progress

            # Сначала силуэт.
            draw_character(
                frame,
                silhouette,
                x,
                y
            )

            # Цветное изображение постепенно проявляется
            # одновременно с эффектом пробуждения.
            reveal_elapsed = max(
                0.0,
                room_elapsed - EYE_REVEAL_START
            )

            reveal_progress = ease_in_out(
                reveal_elapsed / EYE_REVEAL_DURATION
            )

            draw_character(
                frame,
                neutral,
                x,
                y,
                alpha=int(255 * reveal_progress)
            )

            draw_eye_reveal(frame, room_elapsed)

        # ----------------------------------------------------
        # Пауза после «Да...»
        # ----------------------------------------------------

        elif stage == "inspection_pause":

            frame.blit(room, (0, 0))

            draw_character(
                frame,
                neutral,
                END_X,
                END_Y
            )

        # ----------------------------------------------------
        # Молчаливый смех Динары
        # ----------------------------------------------------

        elif stage == "greeting_laugh":

            frame.blit(room, (0, 0))

            draw_character(
                frame,
                emotions.get("Счастье", neutral),
                END_X,
                END_Y
            )

        # ----------------------------------------------------
        # Динара возвращается к обычному выражению лица
        # ----------------------------------------------------

        elif stage == "greeting_return":

            frame.blit(room, (0, 0))

            draw_character(
                frame,
                neutral,
                END_X,
                END_Y
            )

        # ----------------------------------------------------
        # Сцены с Динарой, включая последние реплики класса
        # ----------------------------------------------------

        elif stage in (
            "dinara_dialogue",
            "name_input",
            "name_introduction",
            "greeting",
            "after_greeting",
            "class_dialogue",
            "class_confirmed",
        ):

            frame.blit(room, (0, 0))

            if stage == "name_input":
                emotion_image = emotions.get(
                    "вопрос",
                    neutral
                )

            elif stage == "greeting":
                emotion_image = emotions.get(
                    "smile",
                    neutral
                )

            else:
                line = current_line()

                emotion_name = (
                    line.get("emotion", current_emotion)
                    if line else current_emotion
                )

                emotion_image = emotions.get(
                    emotion_name,
                    neutral
                )

            draw_character(
                frame,
                emotion_image,
                END_X,
                END_Y
            )

            # Ввод имени.
            if stage == "name_input":

                draw_dialogue_panel(
                    frame,
                    speaker_font,
                    message_font,
                    "Игрок",
                    "Меня зовут...",
                    99999.0,
                    allow_continue=False,
                    show_full=True
                )

                input_rect = pygame.Rect(
                    190, 230, 580, 65
                )

                pygame.draw.rect(
                    frame,
                    (15, 20, 34),
                    input_rect,
                    border_radius=6
                )

                pygame.draw.rect(
                    frame,
                    GOLD,
                    input_rect,
                    width=2,
                    border_radius=6
                )

                name_text = player_name

                if int(pygame.time.get_ticks() / 500) % 2 == 0:
                    name_text += "|"

                draw_centered_text(
                    frame,
                    message_font,
                    name_text,
                    TEXT_COLOR,
                    input_rect.center
                )

                draw_centered_text(
                    frame,
                    small_font,
                    "Введи имя и нажми ENTER",
                    MUTED_COLOR,
                    (WIDTH // 2, 315)
                )

            # Выбор приветствия.
            elif stage == "greeting":

                draw_dialogue_panel(
                    frame,
                    speaker_font,
                    message_font,
                    "Динара",
                    "Ну что, как тебе моё имя?",
                    99999.0,
                    show_full=True
                )

                draw_greeting_choices(
                    frame,
                    small_font,
                    greeting_index
                )

            # Обычные диалоги, включая class_confirmed.
            else:

                line = current_line()

                if line is not None:

                    draw_dialogue_panel(
                        frame,
                        speaker_font,
                        message_font,
                        line["speaker"],
                        line["text"],
                        dialogue_elapsed
                    )

        # ----------------------------------------------------
        # Экран развития выбранного персонажа
        # ----------------------------------------------------

        elif stage == "character_profile":
            draw_character_profile(frame)

        # ----------------------------------------------------
        # Сюжетный диалог перед первым боем и постбоевые сцены
        # ----------------------------------------------------

        elif stage == "story_dialogue":
            frame.blit(kitchen_room, (0, 0))
            player_image = kitchen_class_images[selected_class]
            draw_ground_character(frame, player_image, 205, 390)
            draw_ground_character(frame, kitchen_dinara_image, 405, 390)
            if levelup_notifications["player"] > 0.0:
                level_surface = tooltip_font.render("LVL UP +1", True, GOLD)
                frame.blit(level_surface, level_surface.get_rect(center=(205, 175)))
            if levelup_notifications["dinara"] > 0.0:
                level_surface = tooltip_font.render("LVL UP +1", True, GOLD)
                frame.blit(level_surface, level_surface.get_rect(center=(405, 175)))

            if battle_story_goblins_visible or battle_story_bodies_visible:
                goblin_positions = ((700, 430), (850, 430))
                for index, goblin in enumerate(goblin_combatants):
                    if battle_story_bodies_visible:
                        body = pygame.transform.rotate(goblin["image"], 90)
                        rect = body.get_rect(midbottom=goblin_positions[index])
                        frame.blit(body, rect)
                    elif index < 2:
                        draw_ground_character(frame, goblin["image"], *goblin_positions[index])

            if story_nodes and story_index < len(story_nodes):
                node = story_nodes[story_index]
                if node.get("kind") == "line":
                    speaker = node.get("speaker", "Рассказчик")
                    message = node.get("text", "")
                    draw_dialogue_panel(
                        frame, speaker_font, message_font,
                        speaker, message, story_elapsed,
                    )
                    emotion_name = node.get("emotion", story_emotion)
                    if speaker == "Динара":
                        emotion_image = emotions.get(emotion_name, neutral)
                        portrait = fit_image(emotion_image, 82, 82)
                        frame.blit(portrait, (835, 294))
                elif node.get("kind") == "choice":
                    happy_image = emotions.get(story_emotion, neutral)
                    happy_portrait = fit_image(happy_image, 82, 82)
                    frame.blit(happy_portrait, (835, 294))
                    draw_dialogue_panel(
                        frame, speaker_font, message_font,
                        node.get("speaker", "Игрок"), node.get("text", "Выберите ответ"),
                        99999.0, show_full=True,
                    )
                    for choice_i, option in enumerate(node.get("options", [])):
                        rect = pygame.Rect(115, 185 + choice_i * 58, 730, 48)
                        selected = choice_i == story_choice_index
                        pygame.draw.rect(frame, (80, 68, 45) if selected else (30, 39, 55), rect, border_radius=5)
                        pygame.draw.rect(frame, GOLD if selected else PANEL_INNER_BORDER, rect, 2 if selected else 1, border_radius=5)
                        label = small_font.render(f"{choice_i + 1}. {option['label']}", True, TEXT_COLOR)
                        frame.blit(label, label.get_rect(midleft=(rect.x + 12, rect.centery)))
                elif node.get("kind") == "pause":
                    pass

        # ----------------------------------------------------
        # Первая тестовая боевая сцена
        # ----------------------------------------------------

        elif stage == "battle":
            frame.blit(kitchen_room, (0, 0))
            # Тёмная подложка поверх кухни усиливает читаемость боевого HUD.
            shade = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            shade.fill((5, 8, 16, 72))
            frame.blit(shade, (0, 0))
            if battle_engine is not None:
                player_actor = battle_engine.actors["player"]
                dinara_actor = battle_engine.actors["dinara"]
                draw_ground_character(frame, kitchen_class_images[selected_class], 190, 390)
                draw_ground_character(frame, kitchen_dinara_image, 375, 390)
                enemy_slots = ((690, 390), (845, 390))
                # Build hitboxes from the actual on-screen goblin sprites.
                # Hover preview works whenever the player can act, not only over target-list rows.
                mouse_pos = pygame.mouse.get_pos()
                enemy_hitboxes = []
                for enemy_index, enemy_id in enumerate(("goblin_1", "goblin_2")):
                    if not battle_engine.actors[enemy_id]["alive"]:
                        continue
                    sprite_rect = goblin_base_image.get_rect(midbottom=enemy_slots[enemy_index])
                    hit_rect = sprite_rect.inflate(10, 10)
                    enemy_hitboxes.append((
                        enemy_id,
                        (hit_rect.left, hit_rect.top, hit_rect.right, hit_rect.bottom),
                    ))
                hovered_target_id = (
                    _evt005_hit_test_enemy(mouse_pos, enemy_hitboxes)
                    if battle_engine.current_actor_id == "player"
                    else None
                )

                for enemy_index, enemy_id in enumerate(("goblin_1", "goblin_2")):
                    enemy = battle_engine.actors[enemy_id]
                    enemy_rect = goblin_base_image.get_rect(midbottom=enemy_slots[enemy_index])
                    target_is_highlighted = (
                        enemy_id == battle_selected_target and battle_selected_target_timer > 0.0
                    ) or enemy_id == hovered_target_id

                    # A soft ground aura plus a double outline makes the selected target obvious.
                    if target_is_highlighted:
                        aura = pygame.Surface((enemy_rect.width + 58, 48), pygame.SRCALPHA)
                        pulse = 0.5 + 0.5 * math.sin(pygame.time.get_ticks() / 115.0)
                        aura_alpha = int(45 + pulse * 45)
                        pygame.draw.ellipse(
                            aura,
                            (255, 198, 92, aura_alpha),
                            aura.get_rect().inflate(-4, -8),
                        )
                        pygame.draw.ellipse(
                            aura,
                            (255, 225, 160, min(220, aura_alpha + 80)),
                            aura.get_rect().inflate(-12, 0),
                            2,
                        )
                        frame.blit(
                            aura,
                            (enemy_rect.centerx - aura.get_width() // 2, enemy_rect.bottom - 43),
                        )

                    if enemy["alive"]:
                        draw_ground_character(frame, goblin_base_image, *enemy_slots[enemy_index])


                draw_battle_hud(frame)
                if battle_ui_mode == "target":
                    for target_i, target_id in enumerate(battle_engine.living("enemy")):
                        rect = pygame.Rect(650, 330 + target_i * 65, 260, 58)
                        pygame.draw.rect(frame, (18, 24, 37), rect, border_radius=4)
                        panel_hovered = rect.collidepoint(pygame.mouse.get_pos())
                        pygame.draw.rect(
                            frame,
                            GOLD if panel_hovered else PANEL_INNER_BORDER,
                            rect,
                            2 if panel_hovered else 1,
                            border_radius=4,
                        )
                        label = small_font.render(f"{target_i + 1}. {battle_engine.actors[target_id]['name']} — выбрать цель", True, TEXT_COLOR)
                        frame.blit(label, label.get_rect(center=rect.center))
                if battle_ui_mode == "skills":
                    note = small_font.render("Круговая атака / Берсерк (доступен при HP ≤ 25%) / Назад", True, GOLD)
                    frame.blit(note, (18, HEIGHT - 94))
                elif battle_ui_mode == "items":
                    note = small_font.render("Выберите союзника для лечебного зелья", True, GOLD)
                    frame.blit(note, (18, HEIGHT - 94))
                actor_id = battle_engine.current_actor_id
                if actor_id:
                    turn_name = battle_engine.actors[actor_id]["name"]
                    turn_surface = small_font.render(f"Ход: {turn_name}", True, GOLD)
                    frame.blit(turn_surface, (WIDTH // 2 - turn_surface.get_width() // 2, 250))

        elif stage == "battle_class_notice":
            frame.blit(kitchen_room, (0, 0))
            draw_ground_character(frame, kitchen_class_images[selected_class], 205, 390)
            draw_ground_character(frame, kitchen_dinara_image, 405, 390)
            draw_dialogue_panel(
                frame, speaker_font, message_font, "Система",
                battle_message, 99999.0, show_full=True,
            )
            draw_centered_text(frame, small_font, "ENTER / ЛКМ — перезапустить событие и выбрать ВОИНА", GOLD, (WIDTH // 2, 330))

        elif stage == "defeat_choices":
            frame.fill((10, 12, 20))
            draw_centered_text(frame, title_font, "ПОРАЖЕНИЕ", (220, 80, 85), (WIDTH // 2, 105))
            draw_wrapped_text(frame, message_font, "Ваше приключение здесь заканчивается. Вы можете покинуть событие или вернуться к чекпоинту.", TEXT_COLOR, 110, 165, 740, 5)
            options = [(135, "Выйти из события"), (505, "Вернуться к чекпоинту")]
            for index, (x, label) in enumerate(options):
                rect = pygame.Rect(x, 300, 320, 60)
                selected = index == battle_selected_command
                pygame.draw.rect(frame, (65, 42, 48) if selected else (31, 39, 54), rect, border_radius=6)
                pygame.draw.rect(frame, GOLD if selected else PANEL_INNER_BORDER, rect, 2, border_radius=6)
                draw_centered_text(frame, small_font, label, TEXT_COLOR, rect.center)

        # ----------------------------------------------------
        # Выбор класса
        # ----------------------------------------------------

        elif stage == "class_select":

            draw_class_selection(
                frame,
                title_font,
                small_font,
                class_images,
                selected_class
            )

        # ----------------------------------------------------
        # Кухня: свободное перемещение и диалоги
        # ----------------------------------------------------

        elif stage in ("kitchen_scene", "kitchen_dialogue"):

            frame.blit(kitchen_room, (0, 0))

            mouse_pos = pygame.mouse.get_pos()
            hovered_item = None

            # ------------------------------------------------
            # Предметы мира
            # ------------------------------------------------

            for item in kitchen_items:
                item_rect = item["image"].get_rect(
                    center=item["position"]
                )

                # rect в объекте хранит исходную точку предмета.
                # Предметы не перемещаются при переносе игроком.
                item["rect"] = item_rect

                frame.blit(item["image"], item_rect)

                if item_rect.inflate(10, 10).collidepoint(mouse_pos):
                    hovered_item = item

            # ------------------------------------------------
            # Персонажи с сортировкой по глубине
            # ------------------------------------------------

            player_image = kitchen_class_images[selected_class]

            player_foot_x = round(kitchen_player_x)
            player_foot_y = round(kitchen_player_y)

            dinara_foot_y = KITCHEN_DINARA_FOOT[1]

            if player_foot_y < dinara_foot_y:
                draw_ground_character(
                    frame,
                    player_image,
                    player_foot_x,
                    player_foot_y
                )

                draw_ground_character(
                    frame,
                    kitchen_dinara_image,
                    *KITCHEN_DINARA_FOOT
                )

            else:
                draw_ground_character(
                    frame,
                    kitchen_dinara_image,
                    *KITCHEN_DINARA_FOOT
                )

                draw_ground_character(
                    frame,
                    player_image,
                    player_foot_x,
                    player_foot_y
                )

            # ------------------------------------------------
            # Предмет в руках персонажа
            # ------------------------------------------------

            if kitchen_carried_item is not None:
                carried_image = kitchen_carried_item["image"]

                carried_rect = carried_image.get_rect(
                    center=(
                        player_foot_x + 27,
                        player_foot_y - 112
                    )
                )

                # Рисуется поверх персонажа, чтобы предмет
                # оставался заметным во время движения.
                frame.blit(carried_image, carried_rect)

            # ------------------------------------------------
            # Маркер точки назначения
            # ------------------------------------------------

            if kitchen_move_target is not None:
                marker = (
                    round(kitchen_move_target[0]),
                    round(kitchen_move_target[1])
                )

                pygame.draw.circle(
                    frame,
                    GOLD,
                    marker,
                    12,
                    2
                )

                pygame.draw.circle(
                    frame,
                    GOLD,
                    marker,
                    3
                )

            # ------------------------------------------------
            # HUD текущего запроса
            # ------------------------------------------------

            hud_rect = pygame.Rect(14, 14, 365, 42)

            pygame.draw.rect(
                frame,
                (15, 20, 34),
                hud_rect,
                border_radius=5
            )

            pygame.draw.rect(
                frame,
                PANEL_OUTER_BORDER,
                hud_rect,
                width=1,
                border_radius=5
            )

            if kitchen_requested_item_id is not None:
                requested_text = (
                    "Динара просит: "
                    + KITCHEN_REQUEST_TEXT[kitchen_requested_item_id]
                )
            else:
                requested_text = "Ожидаются остальные предметы кухни."

            requested_surface = small_font.render(
                requested_text,
                True,
                GOLD
            )

            frame.blit(
                requested_surface,
                (
                    hud_rect.x + 11,
                    hud_rect.centery - requested_surface.get_height() // 2
                )
            )

            # ------------------------------------------------
            # Подсказка по управлению
            # ------------------------------------------------

            if kitchen_carried_item is not None:
                controls_text = (
                    "ЛКМ по Динаре — подойти и передать предмет"
                )
            else:
                controls_text = (
                    "ЛКМ по предмету — подойти и подобрать"
                )

            controls_surface = tooltip_font.render(
                controls_text,
                True,
                MUTED_COLOR
            )

            controls_panel = controls_surface.get_rect(
                midbottom=(WIDTH // 2, HEIGHT - 10)
            ).inflate(18, 10)

            pygame.draw.rect(
                frame,
                (15, 20, 34),
                controls_panel,
                border_radius=4
            )

            pygame.draw.rect(
                frame,
                PANEL_INNER_BORDER,
                controls_panel,
                width=1,
                border_radius=4
            )

            frame.blit(
                controls_surface,
                controls_surface.get_rect(
                    center=controls_panel.center
                )
            )

            # ------------------------------------------------
            # Подсказка предмета при наведении
            # ------------------------------------------------

            if hovered_item is not None:

                highlight = hovered_item["rect"].inflate(10, 10)

                pygame.draw.rect(
                    frame,
                    GOLD,
                    highlight,
                    2,
                    border_radius=5
                )

                tooltip_width = 238
                tooltip_height = 83

                tooltip_x = clamp(
                    mouse_pos[0] + 15,
                    8,
                    WIDTH - tooltip_width - 8
                )

                tooltip_y = clamp(
                    mouse_pos[1] + 15,
                    8,
                    HEIGHT - tooltip_height - 8
                )

                tooltip_rect = pygame.Rect(
                    tooltip_x,
                    tooltip_y,
                    tooltip_width,
                    tooltip_height
                )

                pygame.draw.rect(
                    frame,
                    (15, 20, 34),
                    tooltip_rect,
                    border_radius=5
                )

                pygame.draw.rect(
                    frame,
                    PANEL_OUTER_BORDER,
                    tooltip_rect,
                    width=1,
                    border_radius=5
                )

                title_surface = small_font.render(
                    hovered_item["name"],
                    True,
                    GOLD
                )

                frame.blit(
                    title_surface,
                    (tooltip_x + 9, tooltip_y + 6)
                )

                description_lines = wrap_text(
                    tooltip_font,
                    hovered_item["description"],
                    tooltip_width - 18
                )[:2]

                description_y = tooltip_y + 29

                for description_line in description_lines:
                    description_surface = tooltip_font.render(
                        description_line,
                        True,
                        TEXT_COLOR
                    )

                    frame.blit(
                        description_surface,
                        (tooltip_x + 9, description_y)
                    )

                    description_y += (
                        description_surface.get_height() + 1
                    )

                if kitchen_carried_item is not None:
                    hint_text = "Сначала передай предмет Динаре"
                else:
                    hint_text = "ЛКМ — подойти и подобрать"

                hint_surface = tooltip_font.render(
                    hint_text,
                    True,
                    MUTED_COLOR
                )

                frame.blit(
                    hint_surface,
                    (
                        tooltip_x + 9,
                        tooltip_y + tooltip_height - 18
                    )
                )

            # ------------------------------------------------
            # Короткие уведомления
            # ------------------------------------------------

            # Мини-портреты открывают экран характеристик и способностей.
            draw_profile_shortcuts(frame)

            # LVL UP +1 кратко появляется непосредственно над персонажем.
            if levelup_notifications["player"] > 0.0:
                note_surface = tooltip_font.render("LVL UP +1", True, GOLD)
                note_rect = note_surface.get_rect(center=(player_foot_x, max(72, player_foot_y - 225)))
                frame.blit(note_surface, note_rect)
            if levelup_notifications["dinara"] > 0.0:
                note_surface = tooltip_font.render("LVL UP +1", True, GOLD)
                note_rect = note_surface.get_rect(center=(KITCHEN_DINARA_FOOT[0], KITCHEN_DINARA_FOOT[1] - 185))
                frame.blit(note_surface, note_rect)

            if (
                kitchen_notice_timer > 0.0
                and kitchen_notice
                and stage == "kitchen_scene"
            ):
                notice_surface = small_font.render(
                    kitchen_notice,
                    True,
                    GOLD
                )

                notice_rect = notice_surface.get_rect(
                    midtop=(WIDTH // 2, 65)
                )

                notice_panel = notice_rect.inflate(22, 12)

                pygame.draw.rect(
                    frame,
                    (15, 20, 34),
                    notice_panel,
                    border_radius=5
                )

                pygame.draw.rect(
                    frame,
                    PANEL_OUTER_BORDER,
                    notice_panel,
                    width=1,
                    border_radius=5
                )

                frame.blit(
                    notice_surface,
                    notice_rect
                )

            # ------------------------------------------------
            # Диалоговая панель поверх кухни
            # ------------------------------------------------

            if stage == "kitchen_dialogue":
                line = current_kitchen_line()

                if line is not None:
                    draw_dialogue_panel(
                        frame,
                        speaker_font,
                        message_font,
                        line["speaker"],
                        line["text"],
                        kitchen_dialogue_elapsed
                    )

        # ----------------------------------------------------
        # Вывод кадра
        # ----------------------------------------------------

        if stage == "white_shake":
            draw_shaken_frame(
                screen,
                frame,
                white_elapsed
            )
        else:
            screen.blit(frame, (0, 0))

        pygame.display.flip()

    pygame.key.stop_text_input()
    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    if "--combat-self-test" in sys.argv:
        _evt005_battle_self_test()
        print("EVT005 combat self-test: OK")
        raise SystemExit(0)
    main()
