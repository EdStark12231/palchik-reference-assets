    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    pygame.display.set_caption(
        "PALCHIK — EVT_005: Найди сладкий рулет"
    )

    clock = pygame.time.Clock()

    speaker_font = load_font(19)
    message_font = load_font(22)
    small_font = load_font(17)
    tooltip_font = load_font(14)
    title_font = load_font(25)

    for path in (
        ROOM_PATH,
        KITCHEN_PATH,
        CHIBI_PATH,
        KITCHEN_ITEMS_PATH_1,
        KITCHEN_ITEMS_PATH_2,
        FONT_PATH,
        GOBLIN_PATH,
    ):
        if not path.is_file():
            raise FileNotFoundError(f"Не найден ресурс: {path}")

    room = load_room()
    kitchen_room = load_kitchen_room()
    kitchen_item_sprites = load_kitchen_item_sprites()
    emotions = load_dinara()
    class_images = load_class_images()
    goblin_base_image = load_goblin_base()

    neutral = emotions["base"]
    silhouette = make_silhouette(neutral)

    chibi_dinara_source = load_image(CHIBI_PATH)
    kitchen_dinara_image = fit_image(
        chibi_dinara_source,
