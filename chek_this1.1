# ============================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ============================================================

def clamp(value, minimum, maximum):
    return max(minimum, min(maximum, value))


def ease_in_out(value):
    value = clamp(value, 0.0, 1.0)
    return value * value * (3.0 - 2.0 * value)


def load_font(size):
    if FONT_PATH.is_file():
        try:
            font = pygame.font.Font(str(FONT_PATH), size)

            test = font.metrics(
                "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
                "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
            )

            if test and all(item is not None for item in test):
                return font

            print("[ВНИМАНИЕ] Шрифт не полностью поддерживает кириллицу.")

        except pygame.error:
            pass

    return pygame.font.SysFont("arial", size)


def load_image(path):
    if not path.is_file():
        raise FileNotFoundError(f"Не найден ресурс: {path}")

    return pygame.image.load(str(path)).convert_alpha()


def fit_image(image, max_width, max_height):
    scale = min(
        max_width / image.get_width(),
        max_height / image.get_height()
    )

    size = (
        max(1, round(image.get_width() * scale)),
        max(1, round(image.get_height() * scale))
    )

    return pygame.transform.smoothscale(image, size)


def crop_transparent_bounds(image):
    bounds = image.get_bounding_rect()

    if bounds.width <= 0 or bounds.height <= 0:
        raise ValueError("В изображении отсутствует видимая область.")

    return image.subsurface(bounds).copy()


def make_silhouette(image):
    silhouette = image.copy()
    silhouette.fill(
        (12, 16, 30, 255),
        special_flags=pygame.BLEND_RGBA_MULT
    )
    return silhouette


def wrap_text(font, text, max_width):
    words = text.split()
    lines = []
    current = ""

    for word in words:
        candidate = word if not current else current + " " + word

        if font.size(candidate)[0] <= max_width:
            current = candidate
        else:
            if current:
                lines.append(current)
            current = word

    if current:
        lines.append(current)

    return lines


def draw_centered_text(surface, font, text, color, center):
    rendered = font.render(text, True, color)
    surface.blit(rendered, rendered.get_rect(center=center))


# ============================================================
# ЕДИНАЯ СИСТЕМА ПЕЧАТИ
# ============================================================

def text_duration(text):
    duration = 0.0

    for character in text:
        duration += LETTER_INTERVAL

        if character in ".,!?…:;":
            duration += PUNCTUATION_PAUSE

    return duration


def visible_character_count(text, elapsed):
    timer = max(0.0, elapsed)
    count = 0

    for character in text:
        delay = LETTER_INTERVAL

        if character in ".,!?…:;":
            delay += PUNCTUATION_PAUSE

        if timer < delay:
            break

        timer -= delay
        count += 1

    return count


def draw_wrapped_text(
    surface,
    font,
    text,
    color,
    x,
    y,
    width,
    line_gap=3
):
    lines = wrap_text(font, text, width)

    for line in lines:
        rendered = font.render(line, True, color)
        surface.blit(rendered, (x, y))
        y += rendered.get_height() + line_gap

    return y


def draw_dialogue_panel(
    surface,
    speaker_font,
    message_font,
    speaker,
    message,
    elapsed,
    show_full=False,
    allow_continue=True,
):
    panel = pygame.Surface(
        (PANEL_WIDTH, PANEL_HEIGHT),
        pygame.SRCALPHA
    )

    pygame.draw.rect(
        panel,
        PANEL_BACKGROUND,
        (0, 0, PANEL_WIDTH, PANEL_HEIGHT),
        border_radius=5
    )

    pygame.draw.rect(
        panel,
        PANEL_OUTER_BORDER,
        (1, 1, PANEL_WIDTH - 2, PANEL_HEIGHT - 2),
        width=2,
        border_radius=5
    )

    pygame.draw.rect(
        panel,
        PANEL_INNER_BORDER,
        (7, 7, PANEL_WIDTH - 14, PANEL_HEIGHT - 14),
        width=1,
        border_radius=3
    )

    surface.blit(panel, (PANEL_X, PANEL_Y))

    name_surface = speaker_font.render(
        speaker,
        True,
        PANEL_NAME_COLOR
    )

    name_x = PANEL_X + 28
    name_y = PANEL_Y + 9

    name_bg = pygame.Rect(
        name_x - 10,
        name_y - 3,
        name_surface.get_width() + 28,
        name_surface.get_height() + 8
    )

    pygame.draw.rect(
        surface,
        (25, 31, 48),
        name_bg,
        border_radius=3
    )

    pygame.draw.rect(
        surface,
        PANEL_OUTER_BORDER,
        name_bg,
        width=1,
        border_radius=3
    )

    surface.blit(name_surface, (name_x, name_y))

    if show_full:
        visible = message
    else:
        count = visible_character_count(message, elapsed)
        visible = message[:count]

    draw_wrapped_text(
        surface,
        message_font,
        visible,
        PANEL_TEXT_COLOR,
        PANEL_X + 30,
        PANEL_Y + 57,
        PANEL_WIDTH - 85,
        line_gap=2
    )

    complete = len(visible) >= len(message)

    if allow_continue and complete:
        pulse = 0.5 + 0.5 * math.sin(elapsed * 4.0)
        arrow_alpha = int(120 + pulse * 135)

        arrow = pygame.Surface((18, 12), pygame.SRCALPHA)

        pygame.draw.polygon(
            arrow,
            (245, 225, 175, arrow_alpha),
            [(2, 2), (16, 2), (9, 10)]
        )

        surface.blit(
            arrow,
            (
                PANEL_X + PANEL_WIDTH - 38,
                PANEL_Y + PANEL_HEIGHT - 25
            )
        )

    return complete


