                "Стойкость": 1, "Выносливость": 10,
            }
        else:
            increments = {
                "Здоровье": 10, "Сила": 1,
                "Ловкость": 1, "Стойкость": 1,
            }
        return [(name, value, increments[name])
                for name, value in progression[character_id]["stats"].items()]

    def profile_skill_rows(character_id):
        data = progression[character_id]
        rows = []
        for name, rank in data["skills"].items():
            next_rank = min(3, rank + 1)
            if rank >= 3:
                preview = "Максимальный ранг"
            elif character_id == "player" and name == "Базовая атака мечом":
                current = (rank - 1) * 10
                upcoming = (next_rank - 1) * 10
                preview = f"Бонус физического урона: {current}% → {upcoming}%"
            elif character_id == "player" and name == "Круговая атака":
                current = 65 + (rank - 1) * 5
                upcoming = 65 + (next_rank - 1) * 5
                preview = f"Коэффициент урона по каждой цели: {current}% → {upcoming}%"
            elif character_id == "player" and name == "Блок мечом":
                current = 70 + (rank - 1) * 5
                upcoming = 70 + (next_rank - 1) * 5
                preview = f"Снижение физического урона: {current}% → {upcoming}%"
            elif character_id == "player" and name == "Берсерк":
                damage_now = 30 + (rank - 1) * 5
                damage_next = 30 + (next_rank - 1) * 5
                crit_now = 20 + (rank - 1) * 5
                crit_next = 20 + (next_rank - 1) * 5
                mult_now = 0.60 + (rank - 1) * 0.15
                mult_next = 0.60 + (next_rank - 1) * 0.15
                preview = (
                    f"Урон: +{damage_now}% → +{damage_next}%; "
                    f"крит. шанс: +{crit_now} → +{crit_next} п.п.; "
                    f"крит. множитель: +{mult_now:.2f} → +{mult_next:.2f}"
                )
            elif character_id == "dinara" and name == "Атака скалкой":
                current = (rank - 1) * 10
                upcoming = (next_rank - 1) * 10
                preview = f"Бонус урона атаки: {current}% → {upcoming}%"
            else:
                preview = "Усиление способности"
            rows.append((name, rank, preview))
        return rows

    def profile_plus_rect(index):
        return pygame.Rect(770, 178 + index * 48, 42, 38)

    def apply_profile_upgrade(index):
        character_id = profile_character
        data = progression[character_id]
        if profile_tab == "stats":
            rows = profile_stat_rows(character_id)
            if not (0 <= index < len(rows)) or data["stat_points"] <= 0:
                return
            name, value, increment = rows[index]
            data["stats"][name] = value + increment
            data["stat_points"] -= 1
            print(f"[EVT005][LEVEL] {character_id}: {name} -> {data['stats'][name]}")
        else:
            rows = profile_skill_rows(character_id)
            if not (0 <= index < len(rows)) or data["skill_points"] <= 0:
                return
            name, rank, description = rows[index]
            if rank >= 3:
                return
            data["skills"][name] = rank + 1
            data["skill_points"] -= 1
            print(f"[EVT005][SKILL] {character_id}: {name} -> rank {rank + 1}")

