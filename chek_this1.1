    def advance_dialogue():
        nonlocal dialogue_index
        nonlocal dialogue_elapsed
        nonlocal stage
        nonlocal current_emotion
        nonlocal inspection_pause_elapsed

        line = current_line()

        if line is None:
            return

        # Первое нажатие после начала печати:
        # показать всю текущую реплику.
        if visible_character_count(
            line["text"],
            dialogue_elapsed
        ) < len(line["text"]):

            dialogue_elapsed = text_duration(line["text"]) + 1.0
            return

        # Следующее нажатие — следующая реплика.
        dialogue_index += 1
        dialogue_elapsed = 0.0

        next_line = current_line()

        if next_line is not None:
            current_emotion = next_line.get(
                "emotion",
                current_emotion
            )
            return

        stage = dialogue_next_stage

        if stage == "name_input":
            pygame.key.start_text_input()

        elif stage == "inspection_pause":
            inspection_pause_elapsed = 0.0
            current_emotion = "base"

        elif stage == "kitchen_intro":
            begin_kitchen_intro_dialogue()

