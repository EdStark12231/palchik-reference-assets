    def _handle_admin_panel_event(self, event):
        if not self.admin_panel_open or event.type != pygame.MOUSEBUTTONDOWN or event.button != 1:
            return False
        screen_w, screen_h = self.screen.get_size()
        tex_w, tex_h = self.screen_texture.size
        pos = (int(event.pos[0] * tex_w / max(1, screen_w)),
               int(event.pos[1] * tex_h / max(1, screen_h)))
        if self.admin_panel_rect and not self.admin_panel_rect.collidepoint(pos):
            return True

        for tab_id, rect in self.admin_tab_rects.items():
            if rect.collidepoint(pos):
                self.admin_panel_tab = tab_id
                return True

        for action, rect in self.admin_button_rects.items():
            if not rect.collidepoint(pos):
                continue
            if action == "close":
                self.admin_panel_open = False
            elif action == "new_game":
                self._admin_start_new_game()
            elif action == "menu":
                if self.game_logic.word_shock_active or self.event_lifecycle.is_tracked("EVT_002_WORD_SHOCK"):
                    self._cancel_managed_word_shock(reason="RETURN_TO_MENU")
                if self.game_logic.roach_attack_active or self.event_lifecycle.is_tracked("EVT_001_ROACH_ATTACK"):
                    self._cancel_managed_roach_attack(reason="RETURN_TO_MENU")
