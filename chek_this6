    def _update_evt004(self, dt):
        """Update EVT004 and route state-transition audio; return active state."""
        runtime = self.evt004_runtime
        if runtime is None:
            return False
        result = runtime.update(dt) if runtime.running else runtime.result()
        self._route_evt004_audio_events(runtime.drain_audio_events())
        if result is not None:
            if result.result == "VICTORY":
                self._finish_evt004(failed=False, cancelled=False, reason="DRAGON_DEFEATED")
            elif result.result == "DEFEAT":
                self._finish_evt004(failed=True, cancelled=False, reason="ALL_INTERFACE_TARGETS_DESTROYED")
            elif result.result == "CANCELLED":
                self._finish_evt004(cancelled=True, reason=result.reason or "HOST_CANCELLED")
            return False
        return runtime.running

