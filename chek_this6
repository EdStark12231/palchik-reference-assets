                    elif pygame.K_KP0 <= event.key <= pygame.K_KP9:
                        digit = str(event.key - pygame.K_KP0)
                    if digit is not None and logic.current_cell_index < 3 and len(logic.current_cell_buffer) < 2:
                        logic.current_cell_buffer += digit
                        cache_invalidated = True
                        if len(logic.current_cell_buffer) == 2:
                            logic.input_buffer[logic.current_cell_index] = int(logic.current_cell_buffer)
                            logic.current_cell_index += 1
                            logic.current_cell_buffer = ""
                if cache_invalidated:
                    self.game_view.code_window_dirty = True

