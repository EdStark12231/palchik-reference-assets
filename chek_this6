                    elif logic.current_cell_index > 0:
                        logic.current_cell_index -= 1
                        logic.input_buffer[logic.current_cell_index] = None
                        logic.current_cell_buffer = ""
                        cache_invalidated = True
                elif event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                    self._submit_archive_pin()
                    return
                else:
                    digit = None
                    if pygame.K_0 <= event.key <= pygame.K_9:
