    def _draw_game_to_texture(self):
        w, h = self.screen_texture.size
        surf = pygame.Surface((w, h))
        if self.evt003_state in ("RUNNING", "GAME_OVER"):
            if self.evt003_state == "RUNNING":
                elapsed = max(0.0, time.monotonic() - self.evt003_started_at)
                duration = float(self.evt003_runtime.duration_seconds)
                remaining_seconds = max(0, int(math.ceil(duration - elapsed)))
                message = "PLEASE DON'T TOUCH ANYTHING"
                self.evt003_presentation.draw_check(
                    surf, message[:self.evt003_typewriter_count], elapsed,
                    wallpaper_index=self.game_logic.wallpaper_index,
                    remaining_seconds=remaining_seconds,
                    duration_seconds=duration,
                )
            else:
                progress = (time.monotonic() - self.evt003_gameover_started_at) / 2.35
                self.evt003_presentation.draw_game_over(
                    surf, progress, wallpaper_index=self.game_logic.wallpaper_index,
                )
            # The system cursor is normally composed by the gameplay renderer.
            # This exclusive event render path must compose it explicitly as well.
            self.menu_cursor.set_hover_state(False)
            self.menu_cursor.draw(surf)
            self.screen_texture.write(pygame.image.tobytes(surf, "RGBA", True))
            return
        glitch_intensity = self.game_logic.get_glitch_intensity()
        center_text = self.game_logic.get_center_text(self.current_lang)
        self.game_view._evt004_capture_background = bool(
            self.evt004_runtime is not None
            and self.evt004_runtime.running
        )
        self.game_view.draw(
            surf, 
            self.game_logic, 
            self.current_lang,
            self.game_seconds_left, 
            center_text, 
            self.game_blink_visible,
            glitch_intensity, 
            self.typed_phrase, 
            self.game_logic.total_clicks,
            self.game_logic.wallpaper_index, 
            self.easter_egg_phrase, 
            effects_enabled=self.effects_enabled,
            debug_mode=self.debug_mode
        )

        # EVT_004 overlay: draw dragon and damaged targets over the game scene
        self._draw_evt004(surf)

        if self.game_logic.word_shock_active:
            if self.admin_panel_open:
                self._draw_admin_panel(surf)
            self.screen_texture.write(pygame.image.tobytes(surf, "RGBA", True))
            return

        self._draw_event_collection_icon(surf)
