        mx, my = pygame.mouse.get_pos()
        image, (hotspot_x, hotspot_y) = self._current_cursor()

        # Keep pixel art crisp; pygame.transform.scale uses nearest-neighbour
        # sampling. During a click, the hover hand gets the short press squash;
        # arrow clicks use the four authored click frames instead.
        scale = self.scale if self.is_hovering else 1.0
        if scale != 1.0:
            width = max(1, round(image.get_width() * scale))
            height = max(1, round(image.get_height() * scale))
            image = pygame.transform.scale(image, (width, height))
            hotspot_x = round(hotspot_x * scale)
            hotspot_y = round(hotspot_y * scale)

        surface.blit(image, (mx - hotspot_x, my - hotspot_y))

    def dispose(self):
        pygame.mouse.set_visible(True)


