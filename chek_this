    def _handle_intro_slide_events(self, event):
        if not self.intro_slides_active or self.admin_panel_open:
            return
        if event.type == pygame.KEYDOWN and event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE):
            self._advance_intro_slide()
        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            screen_w, screen_h = self.screen.get_size()
            tex_w, tex_h = self.screen_texture.size
            pos = (int(event.pos[0] * tex_w / max(1, screen_w)),
                   int(event.pos[1] * tex_h / max(1, screen_h)))
            if self.intro_slide_button_rect and self.intro_slide_button_rect.collidepoint(pos):
                self._advance_intro_slide()

