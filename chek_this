            )

        seventh = ledger.resolve_violation(
            "phase_2", "occurrence-7", "PUNISHMENT", current_balance=1000
        )
        self.assertEqual(seventh["penalty_percent"], POST_FULL_BALANCE_PERCENTAGE)
