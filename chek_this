import pygame

class Backdrop:
    def __init__(self, image, fullscreen=True):
        self.image = image
        self.fullscreen = fullscreen

    def draw(self, surface):
        if self.image:
            if self.fullscreen:
                surface.blit(self.image, (0, 0))
            else:
                surface.blit(self.image, (0, surface.get_height() - self.image.get_height()))


# Scene-specific backdrop registry
SCENE_BACKDROPS = {
    "name_input": "name_input_bg.png",
    "game": "game_bg.png",
    "settings": "settings_bg.png",
}


def create_backdrop(scene_name, width, height):
    filename = SCENE_BACKDROPS.get(scene_name)
    if not filename:
        return None
    try:
        img = pygame.image.load(f"assets/{filename}").convert()
        if img.get_width() != width or img.get_height() != height:
            img = pygame.transform.scale(img, (width, height))
        return Backdrop(img, fullscreen=True)
    except Exception as e:
        print(f"Warning: could not load backdrop for {scene_name}: {e}")
        return None


