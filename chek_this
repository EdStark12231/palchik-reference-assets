import unittest
from typewriter import CharacterTypewriter


class CharacterTypewriterTests(unittest.TestCase):
    def test_reveals_one_character_at_start_then_by_interval(self):
        writer = CharacterTypewriter(0.1)
        writer.reset("PAL", started_at=10.0)
        self.assertEqual(writer.advance(10.0), 1)
        self.assertEqual(writer.visible_text, "P")
        self.assertEqual(writer.advance(10.05), 0)
        self.assertEqual(writer.advance(10.101), 1)
        self.assertEqual(writer.visible_text, "PA")

    def test_catches_up_all_elapsed_characters_and_reports_each_for_sound(self):
        writer = CharacterTypewriter(0.1)
        writer.reset("PALCHIK", started_at=2.0)
        self.assertEqual(writer.advance(2.35), 4)
        self.assertEqual(writer.visible_text, "PALC")
        self.assertEqual(writer.advance(3.0), 3)
        self.assertEqual(writer.visible_text, "PALCHIK")
        self.assertTrue(writer.complete)
        self.assertEqual(writer.advance(4.0), 0)

    def test_reset_starts_a_new_sequence(self):
        writer = CharacterTypewriter(0.1)
        writer.reset("OLD", started_at=0.0)
        writer.advance(0.2)
        writer.reset("NEW", started_at=5.0)
        self.assertEqual(writer.visible_count, 0)
        self.assertEqual(writer.advance(5.0), 1)
        self.assertEqual(writer.visible_text, "N")


if __name__ == "__main__":
    unittest.main()


