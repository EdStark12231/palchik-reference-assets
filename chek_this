import json
import os


class SaveManager:
    SAVE_FILE = "save_data.json"

    @classmethod
    def _read_raw_game_data(cls) -> dict:
        """Read the complete save object, preserving fields owned by other systems."""
        if not os.path.exists(cls.SAVE_FILE):
            return {}
        try:
            with open(cls.SAVE_FILE, "r", encoding="utf-8") as stream:
                data = json.load(stream)
            return data if isinstance(data, dict) else {}
        except (OSError, json.JSONDecodeError):
            return {}

    @classmethod
    def _write_raw_game_data(cls, data: dict) -> None:
        """Atomically write the complete save object."""
        directory = os.path.dirname(os.path.abspath(cls.SAVE_FILE))
        os.makedirs(directory, exist_ok=True)
        temporary_path = cls.SAVE_FILE + ".tmp"
        try:
            with open(temporary_path, "w", encoding="utf-8") as stream:
                json.dump(data, stream, indent=2, ensure_ascii=False)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary_path, cls.SAVE_FILE)
        except Exception:
            try:
                if os.path.exists(temporary_path):
                    os.remove(temporary_path)
            except OSError:
                pass
            raise

    @classmethod
    def load_game_data(cls) -> dict:
        data = cls._read_raw_game_data()
        return {
            "score": data.get("score", 0),
            "lang": data.get("lang", "RU"),
            "total_clicks": data.get("total_clicks", 0),
            "wallpaper_index": data.get("wallpaper_index", 0),
            "player_name": data.get("player_name", ""),
            "system_os_user": data.get("system_os_user", ""),
            "secret_code": data.get("secret_code", []),
            "hidden_hitbox_x": data.get("hidden_hitbox_x", 0),
            "hidden_hitbox_y": data.get("hidden_hitbox_y", 0),
            "lore_icon_visible": data.get("lore_icon_visible", False),
        }

    @classmethod
    def save_game_data(
        cls,
        score: int,
        lang: str,
        total_clicks: int = None,
        wallpaper_index: int = None,
        player_name: str = None,
        system_os_user: str = None,
        secret_code: list = None,
    ) -> None:
        try:
            data = cls._read_raw_game_data()
            old = cls.load_game_data()
            data["score"] = score
            data["lang"] = lang
            data["total_clicks"] = total_clicks if total_clicks is not None else old.get("total_clicks", 0)
            data["wallpaper_index"] = wallpaper_index if wallpaper_index is not None else old.get("wallpaper_index", 0)
            data["player_name"] = player_name if player_name is not None else old.get("player_name", "")
            data["system_os_user"] = system_os_user if system_os_user is not None else old.get("system_os_user", "")
            data["secret_code"] = secret_code if secret_code is not None else old.get("secret_code", [])
            data.setdefault("hidden_hitbox_x", old.get("hidden_hitbox_x", 0))
            data.setdefault("hidden_hitbox_y", old.get("hidden_hitbox_y", 0))
            data.setdefault("lore_icon_visible", old.get("lore_icon_visible", False))
            cls._write_raw_game_data(data)
        except Exception:
            # Preserve legacy behavior: ordinary gameplay saves do not crash the game.
            pass

    @classmethod
    def load_event_collection_state(cls) -> dict:
        """Load the secret collection unlock and per-event progress."""
        data = cls._read_raw_game_data()
        unlocked = data.get("event_collection_unlocked", False)
        progress = data.get("event_collection_progress", {})
        return {
            "unlocked": unlocked is True,
            "progress": dict(progress) if isinstance(progress, dict) else {},
        }

    @classmethod
    def save_event_collection_state(cls, *, unlocked=None, progress=None) -> None:
        """Persist collection state without replacing unrelated save fields."""
        data = cls._read_raw_game_data()
        if unlocked is not None:
            if not isinstance(unlocked, bool):
                raise TypeError("unlocked must be bool or None")
            data["event_collection_unlocked"] = unlocked
        if progress is not None:
            if not isinstance(progress, dict):
                raise TypeError("progress must be a dictionary or None")
            data["event_collection_progress"] = progress
        cls._write_raw_game_data(data)

    @classmethod
    def load_event_state(cls, event_id: str) -> dict:
        if not isinstance(event_id, str) or not event_id.strip():
            raise ValueError("event_id must be a non-empty string")
        data = cls._read_raw_game_data()
        event_states = data.get("event_states", {})
        if not isinstance(event_states, dict):
            return {}
        state = event_states.get(event_id, {})
        return dict(state) if isinstance(state, dict) else {}

    @classmethod
    def save_event_state(cls, event_id: str, state: dict, *, score: int = None) -> None:
        """Persist event history and an optional balance update in one atomic write."""
        if not isinstance(event_id, str) or not event_id.strip():
            raise ValueError("event_id must be a non-empty string")
        if not isinstance(state, dict):
            raise TypeError("state must be a dictionary")
        data = cls._read_raw_game_data()
        event_states = data.get("event_states", {})
        if not isinstance(event_states, dict):
            event_states = {}
        event_states[event_id] = state
        data["event_states"] = event_states
        if score is not None:
            if isinstance(score, bool) or not isinstance(score, int) or score < 0:
                raise ValueError("score must be a non-negative integer")
            data["score"] = score
        cls._write_raw_game_data(data)


