    def _handle_admin_panel_event(self, event):
        if not self.admin_panel_open or event.type != pygame.MOUSEBUTTONDOWN or event.button != 1:
            return False
        screen_w, screen_h = self.screen.get_size()
        tex_w, tex_h = self.screen_texture.size
        pos = (int(event.pos[0] * tex_w / max(1, screen_w)),
               int(event.pos[1] * tex_h / max(1, screen_h)))
        if self.admin_panel_rect and not self.admin_panel_rect.collidepoint(pos):
            return True

        for tab_id, rect in self.admin_tab_rects.items():
            if rect.collidepoint(pos):
                self.admin_panel_tab = tab_id
                return True

        for action, rect in self.admin_button_rects.items():
            if not rect.collidepoint(pos):
                continue
            if action == "close":
                self.admin_panel_open = False
            elif action == "new_game":
                self._admin_start_new_game()
            elif action == "menu":
                if self.game_logic.word_shock_active or self.event_lifecycle.is_tracked("EVT_002_WORD_SHOCK"):
                    self._cancel_managed_word_shock(reason="RETURN_TO_MENU")
                if self.game_logic.roach_attack_active or self.event_lifecycle.is_tracked("EVT_001_ROACH_ATTACK"):
                    self._cancel_managed_roach_attack(reason="RETURN_TO_MENU")
                else:
                    self._stop_roach_audio()
                self.admin_panel_open = False
                self.intro_slides_active = False
                self.name_entry_active = False
                self.name_input_scene = None
                self.current_screen = "menu"
                self.audio_box.stop_music()
                self.audio_box.play_menu_music()
            elif action.startswith("phase_") or action == "final":
                if not self._admin_phase_controls_available():
                    return True
                phase_clicks = {
                    "phase_0": 0, "phase_1": 1500, "phase_2": 2000,
                    "phase_3": 2500, "phase_4": 2800, "final": 3000,
                }
                self._admin_set_phase(phase_clicks[action])
            elif action.startswith("minigame_"):
                if not self._admin_phase_controls_available():
                    return True
                game_id = action[len("minigame_"):]
                if game_id == "reset":
                    self._admin_reset_minigame()
                else:
                    self._admin_launch_minigame(game_id)
            elif action == "event_trigger_EVT_001_ROACH_ATTACK":
                self._admin_trigger_event("EVT_001_ROACH_ATTACK")
            elif action == "event_stop_EVT_001_ROACH_ATTACK":
                self._admin_stop_event("EVT_001_ROACH_ATTACK")
            elif action == "event_reset_EVT_001_ROACH_ATTACK":
                self._admin_reset_event("EVT_001_ROACH_ATTACK")
            elif action == "event_inspect_EVT_001_ROACH_ATTACK":
                self._admin_inspect_event("EVT_001_ROACH_ATTACK")
            elif action == "event_trigger_EVT_002_WORD_SHOCK":
                self._admin_trigger_event("EVT_002_WORD_SHOCK")
            elif action == "event_stop_EVT_002_WORD_SHOCK":
                self._admin_stop_event("EVT_002_WORD_SHOCK")
            elif action == "event_trigger_EVT_003_PLEASE_DONT_TOUCH":
                if self._admin_trigger_evt003():
                    self.admin_panel_open = False
                    self._show_notification("EVT_003: REAL TRIGGER", duration=1800)
            elif action.startswith("event_test_EVT_003_PLEASE_DONT_TOUCH_"):
                phase_id = action[len("event_test_EVT_003_PLEASE_DONT_TOUCH_"):]
                if self._admin_test_evt003(phase_id):
