"""Custom pixel cursor support for PALCHIK.EXE.

The cursor pack is stored relative to this file so launch location does not
change which sprites are loaded. Phase 0 remains the only normal cursor;
phase-specific variants are intentionally not switched automatically.
"""
from pathlib import Path
import pygame


PROJECT_ROOT = Path(__file__).resolve().parent
CURSOR_PACK_ROOT = PROJECT_ROOT / "assets" / "cursor" / "PALCHIK_pack_v1"
LEGACY_CURSOR_ROOT = PROJECT_ROOT / "assets" / "cursor" / "Pixel_style"


class CustomCursorManager:
    """Draw a pixel-art cursor with correct hotspots and click feedback."""

    CLICK_FRAME_DURATION_MS = 45
    CLICK_ANIMATION_DURATION_MS = 4 * CLICK_FRAME_DURATION_MS
    PRESS_SCALE_DURATION_MS = 80
    PRESS_SCALE = 0.85

    def __init__(self):
        # Keep the existing theme toggle and its initial setting.
        self.current_theme = "dark"
        self.is_hovering = False
        self.hitboxes = {}

        self.cursor_images = {
            theme: {
                "arrow": str(CURSOR_PACK_ROOT / theme / "phase_0.png"),
                "hand": str(CURSOR_PACK_ROOT / theme / "hover_hand.png"),
            }
            for theme in ("dark", "light")
        }

        self.cursor_hotspots = {
            "arrow": (0, 0),
            "hand": (9, 0),
            "click": (0, 0),
        }
        self.scale = 1.0
        self.animation_start_time = 0
        self.scale_until = 0
        self.is_animating = False
        self.textures = {"dark": {}, "light": {}}
        self.click_frames = {"dark": [], "light": []}
        self._load_cursor_textures()
        pygame.mouse.set_visible(False)

    @staticmethod
    def _load_image(path):
        """Load an RGBA cursor without requiring a display mode in tests/tools."""
        image = pygame.image.load(str(path))
        if pygame.display.get_init() and pygame.display.get_surface() is not None:
            return image.convert_alpha()
        return image.copy()

    def _candidate_paths(self, theme, cursor_type):
        if cursor_type == "arrow":
            yield CURSOR_PACK_ROOT / theme / "phase_0.png"
            yield LEGACY_CURSOR_ROOT / theme / "pointer.png"
            yield LEGACY_CURSOR_ROOT / theme / "alternate.png"
        elif cursor_type == "hand":
            yield CURSOR_PACK_ROOT / theme / "hover_hand.png"
            yield CURSOR_PACK_ROOT / theme / "hand.png"
            yield LEGACY_CURSOR_ROOT / theme / "link2.png"

    def _load_cursor_textures(self):
        for theme in ("dark", "light"):
            for cursor_type in ("arrow", "hand"):
                loaded = None
                for path in self._candidate_paths(theme, cursor_type):
                    if not path.is_file():
                        continue
                    try:
                        loaded = self._load_image(path)
                        break
                    except (pygame.error, OSError):
                        continue

                if loaded is None:
                    loaded = self._make_fallback_cursor(theme, cursor_type)
                self.textures[theme][cursor_type] = loaded

            for frame_index in range(1, 5):
