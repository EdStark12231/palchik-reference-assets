"""Persistent decision and penalty history for EVT_003.

The ledger is intentionally independent from the not-yet-finalized event
narrative. It records compliance and resolves each violation exactly once.
"""
from __future__ import annotations

from copy import deepcopy
from typing import Any


EVENT_ID = "EVT_003_PLEASE_DONT_TOUCH"
PENALTY_PERCENTAGES = (5, 10, 20, 40, 80, 100)
POST_FULL_BALANCE_PERCENTAGE = 80
VALID_PHASES = frozenset(
    ("phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "final")
)
VALID_DECISIONS = frozenset(("FORGIVENESS", "PUNISHMENT"))


class EVT003PenaltyLedger:
    """Stores the persistent player history for PLEASE DON'T TOUCH ANYTHING.

    A unique occurrence_id (ideally EventInstance.instance_id) makes both
    compliance records and violation resolutions idempotent.
    """

    def __init__(self, state: dict[str, Any] | None = None):
        raw = state if isinstance(state, dict) else {}
        self._history: list[dict[str, Any]] = []
        self._attempted_phases: dict[str, str] = {}
        attempts = raw.get("attempted_phases", [])
        if isinstance(attempts, list):
            for attempt in attempts:
                if not isinstance(attempt, dict):
                    continue
                phase = str(attempt.get("phase", "")).strip().lower()
                occurrence_id = str(attempt.get("occurrence_id", "")).strip()
                if phase in VALID_PHASES and occurrence_id and phase not in self._attempted_phases:
                    self._attempted_phases[phase] = occurrence_id
        seen: set[str] = set()
        history = raw.get("history", [])
        if isinstance(history, list):
            for entry in history:
                if not isinstance(entry, dict):
                    continue
                occurrence_id = str(entry.get("occurrence_id", "")).strip()
                outcome = entry.get("outcome")
                phase = entry.get("phase")
                if (
                    not occurrence_id
                    or occurrence_id in seen
                    or outcome not in ("COMPLIANCE", "VIOLATION")
                    or phase not in VALID_PHASES
                ):
                    continue
                if outcome == "VIOLATION" and entry.get("decision") not in VALID_DECISIONS:
                    continue
                seen.add(occurrence_id)
                self._history.append(deepcopy(entry))
                self._attempted_phases.setdefault(str(phase), occurrence_id)

    @staticmethod
    def _validate_occurrence(phase: str, occurrence_id: str) -> tuple[str, str]:
        normalized_phase = str(phase).strip().lower()
        normalized_id = str(occurrence_id).strip()
        if normalized_phase not in VALID_PHASES:
            raise ValueError(f"Unsupported EVT_003 phase: {phase!r}")
        if not normalized_id:
            raise ValueError("occurrence_id must be a non-empty string")
        return normalized_phase, normalized_id

    @staticmethod
    def _validate_balance(balance: int) -> int:
        if isinstance(balance, bool) or not isinstance(balance, int):
            raise TypeError("current_balance must be an integer")
        if balance < 0:
            raise ValueError("current_balance cannot be negative")
        return balance

    def _find_occurrence(self, occurrence_id: str) -> dict[str, Any] | None:
        for entry in self._history:
            if entry["occurrence_id"] == occurrence_id:
                return entry
        return None

    @property
    def violation_count(self) -> int:
        return sum(entry["outcome"] == "VIOLATION" for entry in self._history)

    @property
    def compliance_count(self) -> int:
        return sum(entry["outcome"] == "COMPLIANCE" for entry in self._history)

    @property
    def forgiveness_count(self) -> int:
        return sum(
            entry["outcome"] == "VIOLATION" and entry.get("decision") == "FORGIVENESS"
            for entry in self._history
        )

    @property
    def punishment_count(self) -> int:
        return sum(
            entry["outcome"] == "VIOLATION" and entry.get("decision") == "PUNISHMENT"
            for entry in self._history
        )

    @property
    def full_balance_penalty_used(self) -> bool:
        return any(
            entry.get("outcome") == "VIOLATION"
            and entry.get("decision") == "PUNISHMENT"
            and entry.get("penalty_percent") == 100
            for entry in self._history
        )

    @property
    def last_outcome(self) -> str | None:
        return self._history[-1]["outcome"] if self._history else None

    def to_dict(self) -> dict[str, Any]:
        return {
            "schema_version": 1,
            "violation_count": self.violation_count,
            "compliance_count": self.compliance_count,
            "forgiveness_count": self.forgiveness_count,
            "punishment_count": self.punishment_count,
            "full_balance_penalty_used": self.full_balance_penalty_used,
            "last_outcome": self.last_outcome,
            "attempted_phases": [
                {"phase": phase, "occurrence_id": occurrence_id}
                for phase, occurrence_id in self._attempted_phases.items()
            ],
            "history": deepcopy(self._history),
        }

    def has_attempted_phase(self, phase: str) -> bool:
        phase = str(phase).strip().lower()
        return phase in VALID_PHASES and phase in self._attempted_phases

    def reserve_attempt(self, phase: str, occurrence_id: str) -> dict[str, Any]:
        phase, occurrence_id = self._validate_occurrence(phase, occurrence_id)
        existing = self._attempted_phases.get(phase)
        if existing is not None:
            if existing == occurrence_id:
                return {"reserved": False, "already_reserved": True, "occurrence_id": existing}
            raise ValueError(f"EVT_003 already attempted in {phase}")
        self._attempted_phases[phase] = occurrence_id
        return {"reserved": True, "already_reserved": False, "occurrence_id": occurrence_id}

    def record_compliance(self, phase: str, occurrence_id: str) -> dict[str, Any]:
        phase, occurrence_id = self._validate_occurrence(phase, occurrence_id)
        existing = self._find_occurrence(occurrence_id)
        if existing is not None:
            if existing["outcome"] != "COMPLIANCE":
                raise ValueError("Occurrence already resolved as a violation")
