        allowed, reason = self.manager.can_start("EVT_001_ROACH_ATTACK")
        self.assertFalse(allowed)
        self.assertEqual(reason, "RESOURCE_EVENT_OVERLAY_OCCUPIED")
        self.bridge.finish(EVENT_ID, cancelled=True, reason="TEST")
        self.assertTrue(self.manager.can_start("EVT_001_ROACH_ATTACK")[0])

