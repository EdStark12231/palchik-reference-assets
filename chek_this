    def verify_sector_click(self, clicked_index):
        if not self.minigame_active:
            return "INACTIVE"
        if clicked_index == self.target_sector_index:
            self.minigame_clicks += 1
            if self.minigame_clicks >= 3:
                self.minigame_active = False
                self.system_jammed = False
                self.clicks_in_cycle = 0
                if hasattr(self, "click_timestamps"):
                    self.click_timestamps.clear()
                if hasattr(self, "cooldown_clicks_remaining"):
                    self.cooldown_clicks_remaining = 400
                self._sync_to_disk()
                self.on_clean_finished()
                return "MINIGAME_WIN"
            else:
                current_target = self.target_sector_index
                while self.target_sector_index == current_target:
                    self.target_sector_index = random.randint(0, 3)
                self.on_ui_update()
                return "SECTOR_CLEARED"
        else:
            self.minigame_clicks = 0
            self.target_sector_index = random.randint(0, 3)
            self.on_ui_update()
            return "SECTOR_FAIL"

