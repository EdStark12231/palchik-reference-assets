"""PALCHIK diagnostic logging shared by the game and admin panel."""
from __future__ import annotations

from collections import deque
from datetime import datetime
import logging
from logging.handlers import RotatingFileHandler
from pathlib import Path
import sys
import threading

_BUFFER = deque(maxlen=120)
_LOCK = threading.RLock()
_CONFIGURED_PATH: Path | None = None


class _AdminMemoryHandler(logging.Handler):
    def emit(self, record: logging.LogRecord) -> None:
        try:
            entry = {
                "created": float(record.created),
                "time": datetime.fromtimestamp(record.created).strftime("%H:%M:%S"),
                "level": record.levelname,
                "logger": record.name,
                "message": record.getMessage(),
                "traceback": self.formatException(record.exc_info) if record.exc_info else "",
            }
            with _LOCK:
                _BUFFER.append(entry)
        except Exception:
            self.handleError(record)

    def formatException(self, exc_info):
        import traceback
        return "".join(traceback.format_exception(*exc_info))


def configure_app_logging(project_root: str | Path) -> tuple[logging.Logger, Path]:
    global _CONFIGURED_PATH
    log_path = Path(project_root).resolve() / "logs" / "palchik.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    root = logging.getLogger()
    root.setLevel(min(root.level or logging.WARNING, logging.INFO))
    if _CONFIGURED_PATH != log_path:
        for handler in list(root.handlers):
            if getattr(handler, "_palchik_owned", False):
                root.removeHandler(handler)
                try:
                    handler.close()
                except Exception:
                    pass
        formatter = logging.Formatter(
            "%(asctime)s | %(levelname)s | %(name)s | %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S",
        )
        file_handler = RotatingFileHandler(
            log_path, maxBytes=2 * 1024 * 1024, backupCount=3, encoding="utf-8"
        )
        file_handler.setFormatter(formatter)
        file_handler._palchik_owned = True
        memory_handler = _AdminMemoryHandler()
        memory_handler.setLevel(logging.INFO)
        memory_handler._palchik_owned = True
        root.addHandler(file_handler)
        root.addHandler(memory_handler)
        _CONFIGURED_PATH = log_path
    logger = logging.getLogger("PALCHIK")
    logger.setLevel(logging.DEBUG)
    return logger, log_path


def log_exception(logger: logging.Logger, context: str, exc: BaseException) -> None:
    logger.error("%s: %s", context, exc, exc_info=(type(exc), exc, exc.__traceback__))


def get_recent_log_entries(limit: int = 12, *, minimum_level: str = "WARNING") -> list[dict]:
    levels = {"DEBUG": logging.DEBUG, "INFO": logging.INFO, "WARNING": logging.WARNING,
              "ERROR": logging.ERROR, "CRITICAL": logging.CRITICAL}
    threshold = levels.get(str(minimum_level).upper(), logging.WARNING)
    with _LOCK:
        entries = [dict(item) for item in _BUFFER if levels.get(item["level"], logging.INFO) >= threshold]
    return entries[-max(1, int(limit)): ]


def install_uncaught_exception_hook(logger: logging.Logger) -> None:
    if getattr(sys.excepthook, "_palchik_hook", False):
        return
    previous = sys.excepthook

    def hook(exc_type, exc_value, exc_tb):
        logger.critical(
            "UNCAUGHT APPLICATION EXCEPTION",
            exc_info=(exc_type, exc_value, exc_tb),
        )
        previous(exc_type, exc_value, exc_tb)

    hook._palchik_hook = True
    sys.excepthook = hook


