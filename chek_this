        surface.blit(shadow, (actual_rect.x - 4, actual_rect.y + 1))
        surface.blit(scaled, actual_rect)
        self.secret_input_rect = actual_rect

        hit_scale_x = draw_w / max(1, panel_w)
        hit_scale_y = draw_h / max(1, panel_h)
        def to_screen_rect(local_rect):
            return pygame.Rect(
                actual_rect.x + int(local_rect.x * hit_scale_x),
                actual_rect.y + int(local_rect.y * hit_scale_y),
                max(1, int(local_rect.width * hit_scale_x)),
                max(1, int(local_rect.height * hit_scale_y)),
            )
        self.secret_input_close_rect = to_screen_rect(close_local)
        self.secret_input_ok_rect = to_screen_rect(ok_local)
        self.secret_input_cancel_rect = to_screen_rect(cancel_local)

    def _open_event_collection(self):
        if not self.event_collection_unlocked or self.event_collection_open:
            return False
        self.event_collection_open = True
        self.event_collection_opened_at = time.monotonic()
        self.event_collection_closing = False
        self.event_collection_closing_started_at = 0.0
        return True

    def _close_event_collection(self):
        if self.event_collection_open and not self.event_collection_closing:
            self.event_collection_closing = True
            self.event_collection_closing_started_at = time.monotonic()

    def _draw_event_collection_icon(self, surface):
        if not self.event_collection_unlocked:
            self.event_collection_icon_rect = None
            return
        width, height = surface.get_size()
        game = self.game_view
        occupied = []
        for name in (
            "rect_back", "rect_target", "rect_phrase_btn", "rect_pbar",
            "rect_wallpaper", "rect_lore_icon", "rect_instant_wash",
            "rect_free_wash_btn", "rect_name_entry_btn", "lore_win_rect",
        ):
            rect = getattr(game, name, None)
            if rect is not None:
                occupied.append((rect.x, rect.y, rect.width, rect.height))
        for rect in getattr(game, "rect_sectors", ()):
            if rect is not None:
                occupied.append((rect.x, rect.y, rect.width, rect.height))
        # Reserve the existing lower-right status/notification area as well.
        occupied.append((max(0, width - 520), max(0, height - 62), min(520, width), 62))
        chosen = choose_event_collection_icon_rect((width, height), occupied, icon_size=42, margin=18)
        if chosen is None:
            self.event_collection_icon_rect = None
            return
        rect = pygame.Rect(*chosen)
        self.event_collection_icon_rect = rect

        now = time.monotonic()
        pulse = 0.5 + 0.5 * math.sin(now * 3.8)
        halo = pygame.Surface((rect.width + 18, rect.height + 18), pygame.SRCALPHA)
        pygame.draw.rect(halo, (0, 255, 105, int(28 + 44 * pulse)), (4, 4, rect.width + 10, rect.height + 10), 5)
        surface.blit(halo, (rect.x - 9, rect.y - 9))
        pygame.draw.rect(surface, (4, 18, 25), rect)
        pygame.draw.rect(surface, (0, 210, 95), rect, 2)
        pygame.draw.rect(surface, (35, 105, 122), rect.inflate(-8, -8), 1)
        # Pixel book glyph; the old wallpaper and lore shortcuts retain their own slots.
        pygame.draw.rect(surface, (160, 225, 255), (rect.x + 10, rect.y + 9, 9, 24))
        pygame.draw.rect(surface, (195, 245, 255), (rect.x + 21, rect.y + 9, 10, 24))
        pygame.draw.rect(surface, (4, 30, 42), (rect.x + 18, rect.y + 9, 4, 24))
        pygame.draw.line(surface, (20, 90, 110), (rect.x + 12, rect.y + 15), (rect.x + 17, rect.y + 15), 1)
        pygame.draw.line(surface, (20, 90, 110), (rect.x + 23, rect.y + 15), (rect.x + 29, rect.y + 15), 1)

    def _draw_event_collection_window(self, surface):
        width, height = surface.get_size()
        now = time.monotonic()
        opening_t = min(1.0, max(0.0, (now - self.event_collection_opened_at) / 0.30))
        opening_ease = 1.0 - (1.0 - opening_t) ** 3
        closing_t = 0.0
        if self.event_collection_closing:
            closing_t = min(1.0, max(0.0, (now - self.event_collection_closing_started_at) / 0.22))
        visibility = opening_ease * (1.0 - closing_t)
        if self.event_collection_closing and closing_t >= 1.0:
            self.event_collection_open = False
            self.event_collection_closing = False
            self.event_collection_window_rect = None
            self.event_collection_close_rect = None
            return

        shade = pygame.Surface((width, height), pygame.SRCALPHA)
        shade.fill((0, 0, 0, int(118 * visibility)))
        surface.blit(shade, (0, 0))

        # Compact two-column archive: all 12 entries remain visible at once.
        panel_w = min(760, max(280, width - 36))
        panel_h = min(520, max(280, height - 36))
        if panel_w > width - 12:
            panel_w = width - 12
        if panel_h > height - 12:
            panel_h = height - 12
        final_panel = pygame.Rect((width - panel_w) // 2, (height - panel_h) // 2, panel_w, panel_h)
        scale = 0.90 + 0.10 * visibility
        draw_w, draw_h = max(1, int(panel_w * scale)), max(1, int(panel_h * scale))
        layer = pygame.Surface((panel_w, panel_h), pygame.SRCALPHA)

        # Windows 95 shell with restrained arcade status accents.
        layer.fill((192, 192, 192, 255))
        pygame.draw.rect(layer, (255, 255, 255), (0, 0, panel_w, panel_h), 2)
        pygame.draw.line(layer, (255, 255, 255), (2, 2), (panel_w - 3, 2), 1)
        pygame.draw.line(layer, (255, 255, 255), (2, 2), (2, panel_h - 3), 1)
        pygame.draw.line(layer, (64, 64, 64), (2, panel_h - 3), (panel_w - 3, panel_h - 3), 1)
        pygame.draw.line(layer, (64, 64, 64), (panel_w - 3, 2), (panel_w - 3, panel_h - 3), 1)

        title_bar = pygame.Rect(4, 4, panel_w - 8, 30)
        pygame.draw.rect(layer, (0, 0, 128), title_bar)
        # Pixel archive icon.
        pygame.draw.rect(layer, (192, 192, 192), (10, 10, 15, 17))
        pygame.draw.rect(layer, (0, 0, 0), (10, 10, 15, 17), 1)
        pygame.draw.line(layer, (0, 0, 128), (17, 12), (17, 25), 2)
        pygame.draw.line(layer, (0, 0, 128), (12, 16), (15, 16), 1)
        pygame.draw.line(layer, (0, 0, 128), (19, 16), (23, 16), 1)
        title_font = pygame.font.SysFont("Arial", 16 if panel_w >= 440 else 12, bold=True)
        title_text = "PALCHIK.EXE — КОЛЛЕКЦИЯ СОБЫТИЙ" if panel_w >= 440 else "КОЛЛЕКЦИЯ СОБЫТИЙ"
        title = title_font.render(title_text, True, (255, 255, 255))
        layer.blit(title, (32, 10))

        close_local = pygame.Rect(panel_w - 27, 9, 18, 18)
        pygame.draw.rect(layer, (192, 192, 192), close_local)
        pygame.draw.line(layer, (255, 255, 255), close_local.topleft, (close_local.right - 1, close_local.top), 2)
        pygame.draw.line(layer, (255, 255, 255), close_local.topleft, (close_local.left, close_local.bottom - 1), 2)
        pygame.draw.line(layer, (64, 64, 64), (close_local.left, close_local.bottom - 1), (close_local.right - 1, close_local.bottom - 1), 2)
        pygame.draw.line(layer, (64, 64, 64), (close_local.right - 1, close_local.top), (close_local.right - 1, close_local.bottom - 1), 2)
        close_glyph = pygame.font.SysFont("Arial", 12, bold=True).render("X", True, (0, 0, 0))
        layer.blit(close_glyph, close_glyph.get_rect(center=close_local.center))

        found_count = sum(
            1 for item_id, _ in EVENT_COLLECTION_ITEMS
            if self.event_collection_progress.get(item_id, {}).get("found")
            or self.event_collection_progress.get(item_id, {}).get("completed")
        )
        completed_count = sum(
            1 for item_id, _ in EVENT_COLLECTION_ITEMS
            if self.event_collection_progress.get(item_id, {}).get("completed")
        )
        summary_text = (
            f"НАЙДЕНО: {found_count:02d}/{len(EVENT_COLLECTION_ITEMS):02d}     ПРОЙДЕНО: {completed_count:02d}/{len(EVENT_COLLECTION_ITEMS):02d}"
            if panel_w >= 520 else
            f"НАЙДЕНО {found_count:02d}/{len(EVENT_COLLECTION_ITEMS):02d}  |  ПРОЙДЕНО {completed_count:02d}/{len(EVENT_COLLECTION_ITEMS):02d}"
        )
        summary_font = pygame.font.SysFont("Courier New", 12 if panel_w >= 520 else 9, bold=True)
        summary = summary_font.render(summary_text, True, (0, 0, 96))
        layer.blit(summary, (18, 45))

        # Progress meter and short archive hint.
        meter = pygame.Rect(18, 65, panel_w - 36, 7)
        pygame.draw.rect(layer, (96, 96, 96), meter)
        if len(EVENT_COLLECTION_ITEMS):
            fill_w = int((meter.width - 2) * (found_count / len(EVENT_COLLECTION_ITEMS)))
            if fill_w > 0:
                pygame.draw.rect(layer, (0, 128, 0), (meter.x + 1, meter.y + 1, fill_w, meter.height - 2))
        hint_font = pygame.font.SysFont("Arial", 10)
        hint_text = "СОБЫТИЕ ПОЯВИТСЯ В АРХИВЕ ПОСЛЕ ОБНАРУЖЕНИЯ" if panel_w >= 420 else "АРХИВ ОБНОВЛЯЕТСЯ ПРИ ОБНАРУЖЕНИИ"
        hint = hint_font.render(hint_text, True, (55, 55, 55))
        layer.blit(hint, (18, 79))

        # Use two columns on normal displays and three shorter columns when
        # vertical space is limited; all 12 entries stay inside the window.
        compact_grid = panel_h < 390
        columns = 3 if compact_grid else 2
        rows_per_column = 4 if compact_grid else 6
        col_gap = 10 if compact_grid else 12
        usable_width = max(1, panel_w - 36 - col_gap * (columns - 1))
        col_w = max(1, usable_width // columns)
        top = 101
        footer_y = panel_h - 20
        available_h = max(1, footer_y - top - 9)
        row_h = min(62, max(27, available_h // rows_per_column))
        card_h = max(23, row_h - 3)
        name_size = 12 if col_w >= 250 else (10 if col_w >= 125 else 8)
        status_size = 10 if col_w >= 250 else (8 if col_w >= 125 else 7)
        name_font = pygame.font.SysFont("Courier New", name_size, bold=True)
        status_font = pygame.font.SysFont("Courier New", status_size, bold=True)

        for index, (item_id, item_name) in enumerate(EVENT_COLLECTION_ITEMS):
            col = index // rows_per_column
            row = index % rows_per_column
            item_rect = pygame.Rect(
                18 + col * (col_w + col_gap),
                top + row * row_h,
                col_w,
                card_h,
            )
            item_progress = min(1.0, max(0.0, (now - self.event_collection_opened_at - 0.05 - index * 0.035) / 0.22))
            item_ease = 1.0 - (1.0 - item_progress) ** 2
            if item_ease <= 0:
                continue
            shown_rect = item_rect.move(0, int((1.0 - item_ease) * 11))
            progress = self.event_collection_progress.get(item_id, {})
            completed = bool(progress.get("completed", False))
            found = bool(progress.get("found", False)) or completed

            card_bg = (205, 225, 205) if completed else ((215, 228, 240) if found else (192, 192, 192))
            pygame.draw.rect(layer, card_bg, shown_rect)
            pygame.draw.line(layer, (255, 255, 255), shown_rect.topleft, (shown_rect.right - 1, shown_rect.top), 2)
            pygame.draw.line(layer, (255, 255, 255), shown_rect.topleft, (shown_rect.left, shown_rect.bottom - 1), 2)
            pygame.draw.line(layer, (96, 96, 96), (shown_rect.left, shown_rect.bottom - 1), (shown_rect.right - 1, shown_rect.bottom - 1), 2)
            pygame.draw.line(layer, (96, 96, 96), (shown_rect.right - 1, shown_rect.top), (shown_rect.right - 1, shown_rect.bottom - 1), 2)

            status_text, status_color = (
                ("ПРОЙДЕНО", (0, 105, 35)) if completed else
                (("НАЙДЕНО · ЕЩЁ НЕ ПРОЙДЕНО", (0, 75, 125)) if found else ("НЕ НАЙДЕНО", (80, 80, 80)))
            )
            indicator_color = (0, 150, 45) if completed else ((0, 105, 180) if found else (110, 110, 110))
            compact_card = shown_rect.height < 30
            indicator_size = 5 if compact_card else 7
            indicator_x = shown_rect.x + (5 if compact_card else 7)
            indicator_y = shown_rect.y + (5 if compact_card else 8)
            pygame.draw.rect(layer, indicator_color, (indicator_x, indicator_y, indicator_size, indicator_size))
            name_color = (15, 25, 35) if found else (75, 75, 75)
            name_surface = name_font.render(item_name, True, name_color)
            name_left = shown_rect.x + (13 if compact_card else 19)
            if name_surface.get_width() > shown_rect.width - (name_left - shown_rect.x) - 5:
                name_surface = pygame.font.SysFont("Arial", max(7, name_size - 1), bold=True).render(item_name, True, name_color)
            name_y = shown_rect.y + (3 if compact_card else 5)
            layer.blit(name_surface, (name_left, name_y))
            status_surface = status_font.render(status_text, True, status_color)
            if status_surface.get_width() > shown_rect.width - 10:
                status_surface = pygame.font.SysFont("Arial", max(7, status_size - 1), bold=True).render(status_text, True, status_color)
            status_bottom_pad = 2 if compact_card else 4
            layer.blit(status_surface, (shown_rect.x + 5, shown_rect.bottom - status_surface.get_height() - status_bottom_pad))

        footer = pygame.font.SysFont("Courier New", 10, bold=True).render(
            "ESC / X — ЗАКРЫТЬ АРХИВ", True, (35, 35, 80)
        )
        layer.blit(footer, footer.get_rect(center=(panel_w // 2, footer_y)))

        # Animated arcade scan marker along the inner bottom edge.
        if visibility > 0.45:
            scan_span = max(1, panel_w - 30)
            scan_x = 12 + int((now * 125) % scan_span)
            pygame.draw.line(layer, (0, 125, 45), (scan_x, panel_h - 5), (min(panel_w - 8, scan_x + 18), panel_h - 5), 2)

        scaled = pygame.transform.scale(layer, (draw_w, draw_h))
        scaled.set_alpha(max(0, min(255, int(255 * visibility))))
        actual_rect = scaled.get_rect(
            center=(final_panel.centerx, final_panel.centery + int((1.0 - opening_ease) * 16))
        )
        shadow = pygame.Surface((draw_w + 10, draw_h + 10), pygame.SRCALPHA)
        pygame.draw.rect(
            shadow, (0, 0, 0, int(100 * visibility)),
            pygame.Rect(4, 4, draw_w, draw_h),
        )
        surface.blit(shadow, (actual_rect.x - 4, actual_rect.y + 1))
        surface.blit(scaled, actual_rect)
        self.event_collection_window_rect = final_panel
        self.event_collection_close_rect = pygame.Rect(
            actual_rect.x + int(close_local.x * scale),
            actual_rect.y + int(close_local.y * scale),
            max(1, int(close_local.width * scale)),
            max(1, int(close_local.height * scale)),
        )

    def _draw_admin_panel(self, surface):
        self.admin_button_rects = {}
        self.admin_tab_rects = {}
        if not self.admin_panel_open:
            return

        w, h = surface.get_size()
        shade = pygame.Surface((w, h), pygame.SRCALPHA)
        shade.fill((0, 0, 0, 150))
        surface.blit(shade, (0, 0))

        panel_w = min(720, w - 32)
        panel_h = min(752 if self.admin_panel_tab == "events" else 620 if self.admin_panel_tab == "logs" else 500, h - 16)
        panel = pygame.Rect((w - panel_w) // 2, (h - panel_h) // 2, panel_w, panel_h)
