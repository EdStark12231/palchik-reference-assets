        methods = {
            node.name: node for cls in tree.body if isinstance(cls, ast.ClassDef)
            for node in cls.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
        }
        required = {
            "_start_word_shock", "_cancel_managed_word_shock",
            "_sync_managed_word_shock", "_submit_word_shock_answer",
            "_admin_stop_event", "_admin_reset_event", "_admin_inspect_event",
            "_admin_set_phase", "_admin_start_new_game", "_begin_game_session",
            "_update_game",
