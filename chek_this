"""Lifecycle bridge for events whose gameplay is still owned by legacy controllers."""
from __future__ import annotations

from typing import Any

from .contracts import EventInstance, EventStatus
from .manager import EventManager


class LegacyEventLifecycle:
    """Tie a legacy gameplay controller to EventManager resource ownership.

    This bridge is intentionally transitional: it does not move gameplay logic.
    It guarantees that each legacy event has one managed runtime instance and
    that its resource claims are released exactly once on completion/cancellation.
    """

    def __init__(self, manager: EventManager):
        self.manager = manager
        self._instance_ids: dict[str, str] = {}

    def begin(self, event_id: str, *, data: dict[str, Any] | None = None) -> EventInstance:
        current = self.instance_for(event_id)
        if current is not None and current.status in (
            EventStatus.ACTIVE, EventStatus.SUSPENDED, EventStatus.WAITING
        ):
            raise RuntimeError("EVENT_ALREADY_ACTIVE")
        self._instance_ids.pop(event_id, None)
        instance = self.manager.begin(event_id, data=data)
        self._instance_ids[event_id] = instance.instance_id
        return instance

    def instance_for(self, event_id: str) -> EventInstance | None:
        instance_id = self._instance_ids.get(event_id)
        if instance_id is None:
            return None
        instance = self.manager.instances.get(instance_id)
        if instance is None:
            self._instance_ids.pop(event_id, None)
        return instance

    def finish(
        self,
        event_id: str,
        *,
        cancelled: bool = False,
        reason: str | None = None,
    ) -> EventInstance | None:
        instance_id = self._instance_ids.get(event_id)
        if instance_id is None:
            return None
        instance = self.manager.finish(instance_id, cancelled=cancelled, reason=reason)
        self._instance_ids.pop(event_id, None)
        return instance

    def is_tracked(self, event_id: str) -> bool:
        return self.instance_for(event_id) is not None


