            layer.blit(label_surface, (101, slots_y + max(4, (slot_h - label_surface.get_height()) // 2)))

        # Use the archive dialog's short confirmation message and keyboard equivalents.
        footer_color = (150, 25, 25) if error_active else (0, 0, 0)
        footer_text = (
            "ДОСТУП ОТКЛОНЁН · ПОВТОРИТЕ ВВОД" if error_active else
            "Нажмите OK для подтверждения."
        )
        footer_font = pygame.font.SysFont("Arial", 12 if panel_w >= 420 else 9, bold=False)
        footer_surface = footer_font.render(footer_text, True, footer_color)
        footer_y = 165 if panel_h >= 190 else panel_h - 12
        if panel_w >= 420:
            layer.blit(footer_surface, (101, footer_y))
        else:
            if footer_surface.get_width() > panel_w - 16:
                footer_surface = pygame.font.SysFont("Arial", 8, bold=False).render(footer_text, True, footer_color)
            layer.blit(footer_surface, footer_surface.get_rect(center=(panel_w // 2, footer_y)))

        scaled = pygame.transform.scale(layer, (draw_w, draw_h))
        scaled.set_alpha(max(0, min(255, int(255 * visibility))))
        actual_rect = scaled.get_rect(
            center=(final_panel.centerx + shake_x,
                    final_panel.centery + int((1.0 - opening_ease) * 14))
        )
        shadow = pygame.Surface((draw_w + 10, draw_h + 10), pygame.SRCALPHA)
        pygame.draw.rect(
            shadow, (0, 0, 0, int(105 * visibility)),
            pygame.Rect(4, 4, draw_w, draw_h),
