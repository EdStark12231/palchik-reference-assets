    def _evt003_state_payload(self):
        state = self.evt003_penalty_ledger.to_dict()
        if self.evt003_pending_notification is not None:
            state["pending_notification"] = dict(self.evt003_pending_notification)
        return state

    def _save_evt003_state(self, *, score=None):
        SaveManager.save_event_state(
            EVT003_EVENT_ID, self._evt003_state_payload(), score=score
        )

    def reserve_evt003_attempt(self, phase: str, occurrence_id: str):
        """Persist once-per-phase reservation before the event is shown."""
        previous = self.evt003_penalty_ledger.to_dict()
        result = self.evt003_penalty_ledger.reserve_attempt(phase, occurrence_id)
        if result.get("reserved"):
            try:
                self._save_evt003_state()
            except Exception:
                self.evt003_penalty_ledger = EVT003PenaltyLedger(previous)
                raise
        return result

    def record_evt003_compliance(self, phase: str, occurrence_id: str):
        """Record a successful PLEASE DON'T TOUCH ANYTHING check exactly once."""
        previous = self.evt003_penalty_ledger.to_dict()
        result = self.evt003_penalty_ledger.record_compliance(phase, occurrence_id)
        if result["recorded"]:
            try:
                self._save_evt003_state()
            except Exception:
                self.evt003_penalty_ledger = EVT003PenaltyLedger(previous)
                raise
        return result

    def resolve_evt003_violation(
        self, phase: str, occurrence_id: str, decision: str, *, pending_notification=None
    ):
        """Atomically persist violation history, penalty balance and pending notice."""
        previous_state = self.evt003_penalty_ledger.to_dict()
        previous_pending = self.evt003_pending_notification
        result = self.evt003_penalty_ledger.resolve_violation(
            phase, occurrence_id, decision, current_balance=int(self.score)
        )
        if result["already_resolved"]:
            return result
        new_score = result["balance_after"]
        if pending_notification is not None:
            self.evt003_pending_notification = dict(pending_notification)
        try:
            self._save_evt003_state(
                score=new_score if result["decision"] == "PUNISHMENT" else None
            )
        except Exception:
            self.evt003_penalty_ledger = EVT003PenaltyLedger(previous_state)
            self.evt003_pending_notification = previous_pending
            raise
        if result["decision"] == "PUNISHMENT":
            self.score = new_score
            self.on_ui_update()
        return result

    def set_evt003_pending_notification(self, payload):
        """Persist the punishment notice until the next gameplay entry is acknowledged."""
        previous = self.evt003_pending_notification
        self.evt003_pending_notification = dict(payload)
        try:
            self._save_evt003_state()
        except Exception:
            self.evt003_pending_notification = previous
            raise

    def consume_evt003_pending_notification(self):
        """Clear a pending notice only after its OK button is acknowledged."""
        if self.evt003_pending_notification is None:
            return None
        previous = self.evt003_pending_notification
        self.evt003_pending_notification = None
        try:
            self._save_evt003_state()
        except Exception:
            self.evt003_pending_notification = previous
            raise
        return dict(previous)

    def is_horror_phase(self):
        return self.get_phase_index() >= 1

    def lucky_click_chance(self):
        if not self.is_horror_phase():
            return 0.05, 5
        phase_idx = self.get_phase_index()
        if phase_idx >= 4:
            return 0.01, -2
        if phase_idx >= 3:
            return 0.02, 1
        if phase_idx >= 1:
            return 0.03, 2
        return 0.05, 5

    def register_click(self):
        if self.timer_active or self.clicks_in_cycle >= 10 or self.minigame_active:
            return "IGNORE"
        if self.system_jammed:
            return "JAMMED"
            
        if self.cooldown_clicks_remaining > 0:
            self.cooldown_clicks_remaining -= 1
            
        current_time = time.monotonic()
        self.click_timestamps.append(current_time)
        if len(self.click_timestamps) > 8:
            self.click_timestamps.pop(0)
            
        if len(self.click_timestamps) == 8 and self.cooldown_clicks_remaining <= 0:
            intervals = [
                self.click_timestamps[i] - self.click_timestamps[i-1]
                for i in range(1, len(self.click_timestamps))
            ]
            mean_interval = sum(intervals) / 7.0
            is_monotonous = all(abs(i - mean_interval) < 0.004 for i in intervals)
            if is_monotonous and mean_interval < 0.5:
                self.system_jammed = True
                self.start_memory_minigame()
                return "TRAP_TRIGGERED"

        if self.clicks_in_cycle == 0 and not self.ghost_mode_active:
            if random.random() < 0.025:
                self.ghost_mode_active = True

        if self.clicks_in_cycle == 9:
            if self.required_final_clicks == 0:
                self.required_final_clicks = random.randint(3, 4)
                self.current_final_clicks = 0
                
            self.current_final_clicks += 1
            if self.current_final_clicks < self.required_final_clicks:
                self.total_clicks += 1
                return "RESISTANCE"
            else:
                self.required_final_clicks = 0
                self.current_final_clicks = 0

        if self.ghost_mode_active and self.clicks_in_cycle < 9:
            increment = random.randint(1, 2)
            self.clicks_in_cycle += increment
            self.score += increment * 2
            self.total_clicks += increment * 2
            if self.clicks_in_cycle >= 9:
                self.clicks_in_cycle = 9
                self.ghost_mode_active = False
            self._sync_to_disk()
            self.on_ui_update()
            return "GHOST_BOOST"
        else:
            self.clicks_in_cycle += 1
            self.total_clicks += 1
            lucky_chance, bonus = self.lucky_click_chance()
            if random.random() < lucky_chance:
                self.score += bonus
                self._sync_to_disk()
                self.on_ui_update(lucky=True)
            if self.clicks_in_cycle == 10:
                self.score += 5
                self._sync_to_disk()
                self.horror_cooldown = False
                self.on_limit_reached()
            else:
                self.on_ui_update()
            self._sync_to_disk()
            return "NORMAL"

    def wash_hands_instantly(self):
        if self.score >= self.upgrade_cost and self.clicks_in_cycle >= 10 and not self.timer_active and not self.system_jammed:
            self.score -= self.upgrade_cost
            if random.random() < 0.15:
                self.start_memory_minigame()
                self._sync_to_disk()
                self.on_ui_update()
                return "TRAP_TRIGGERED"
            self.clicks_in_cycle = 0
            self._sync_to_disk()
            self.horror_cooldown = False
            self.on_clean_finished()
            return True
        return False

    def _apply_phase_scaling(self):
        """Обновляет параметры мини-игры в зависимости от фазы."""
        pf = self.get_phase_factor()
        
        # Таймер чисток: от 30с (фаза 0) до 10с (финал)
        self.timer_duration = max(10000, int(self.base_timer_duration * (1.0 - pf * 0.7)))
        
        # Скорость ухода планеты увеличена на 35%, рост по фазам сохранён.
        self.sprite_speed = (3.5 + pf * 5.5) * 1.35
        
        # Кол-во кликов для появления спрайта: от 3 (фаза 0) до 1 (финал)
        self.sprite_spawn_clicks = max(1, 3 - int(pf * 2.5))

    def start_free_clean(self):
        if self.timer_active:
            return
        self.timer_active = True
        self._apply_phase_scaling()
        self.timer_start_time = int(time.monotonic() * 1000)
        self.last_second_checked = int(self.timer_duration // 1000)
        self.on_ui_update(seconds_left=self.last_second_checked)

    def start_memory_minigame(self):
        """Prepare the existing four-sector memory challenge for a direct test run."""
        self.minigame_active = True
        self.minigame_progress = 0
        self.minigame_clicks = 0
        self.sectors = ["0x0F", "0x3B", "0x7A", "0xED"]
        random.shuffle(self.sectors)
        self.target_sector_index = random.randint(0, len(self.sectors) - 1)
        return True

    def update(self):
        if not self.timer_active:
            return
        current_time = int(time.monotonic() * 1000)
        elapsed = current_time - self.timer_start_time
        
        if elapsed >= self.timer_duration:
            self.timer_active = False
            self.clicks_in_cycle = 0
            self.timer_clicks = 0
            
            if random.random() < 0.15:
                self.sprite_active = False
                self.chase_planets.clear()
                self.chase_planet_active = False
                self.start_memory_minigame()
                self._sync_to_disk()
                self.on_ui_update()
                return "TRAP_TRIGGERED"

            if self.sprite_active:
                self.sprite_active = False
                self.chase_planets.clear()
                # Флаг Chase Planet сохраняется до конца экрана результата.
                self.score = max(0, self.score - 10)
                
                phase_key = self.get_phase()
                
                lang_key = self.current_lang.upper() if self.current_lang.upper() in self.translations else self.current_lang.lower()
                lang_pack = self.translations.get(lang_key, self.translations.get("RU", self.translations.get("ru", {})))
                
                text_data = lang_pack.get("earth_phases", {}).get(phase_key, {"fail": ["ОШИБКА"]})
                self.set_notification(random.choice(text_data["fail"]), duration=5000)
                self.notification_color = (214, 48, 49)

                
                self.fade_screen_active = True
                self.fade_start_time = int(time.monotonic() * 1000)

            self._sync_to_disk()
            self.on_clean_finished()
        else:
            self.seconds_left = int((self.timer_duration - elapsed) // 1000)
            if self.seconds_left != getattr(self, "last_second_checked", 30):
                self.last_second_checked = self.seconds_left
                self.on_ui_update(seconds_left=self.seconds_left)

            
