def choose_event_collection_icon_rect(
    surface_size: tuple[int, int],
    occupied_rects: object = (),
    icon_size: int = 42,
    margin: int = 18,
) -> tuple[int, int, int, int] | None:
    """Choose a free HUD slot without covering existing gameplay controls.

    Rectangles are supplied as (x, y, width, height). Candidates are ordered
    from upper-right down the right edge, then into free left-side slots.
    """
    width, height = int(surface_size[0]), int(surface_size[1])
    if width < icon_size or height < icon_size:
        return None

    occupied = []
    for rect in occupied_rects or ():
        if rect is None:
            continue
        try:
            x, y, w, h = (int(value) for value in rect)
        except (TypeError, ValueError):
            continue
        if w > 0 and h > 0:
            occupied.append((x, y, w, h))

    step = icon_size + 12
    candidates = [
        (width - icon_size - margin, margin),
        (width - icon_size - margin, margin + step),
        (width - icon_size - margin, margin + 2 * step),
        (margin, margin + step),
        (margin, height - icon_size - margin),
        (width - icon_size - margin, max(margin, height // 3)),
    ]

    def available(x: int, y: int) -> bool:
        if x < 0 or y < 0 or x + icon_size > width or y + icon_size > height:
            return False
        for ox, oy, ow, oh in occupied:
            if x < ox + ow and x + icon_size > ox and y < oy + oh and y + icon_size > oy:
                return False
        return True

    for x, y in candidates:
        if available(x, y):
            return (x, y, icon_size, icon_size)

    # Last-resort deterministic scan over the upper half of the HUD.
    y_limit = max(margin, min(height - icon_size - margin, height // 2))
    for y in range(margin, y_limit + 1, step):
        for x in range(width - icon_size - margin, margin - 1, -step):
            if available(x, y):
                return (x, y, icon_size, icon_size)
    return None


