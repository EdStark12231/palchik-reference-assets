        win_w = min(win_w, w - 24)
        win_h = min(win_h, h - 24)
        win = pygame.Rect((w - win_w) // 2, (h - win_h) // 2, win_w, win_h)
        pygame.draw.rect(surf, (0, 0, 0), win.move(6, 7))
        pygame.draw.rect(surf, (192, 192, 192), win)
        pygame.draw.rect(surf, (255, 255, 255), win, 2)
        pygame.draw.rect(surf, (128, 128, 128), win, 1)
        title_bar = pygame.Rect(win.x + 3, win.y + 3, win.width - 6, 30)
        pygame.draw.rect(surf, (0, 0, 128), title_bar)
        title_font = pygame.font.SysFont("Arial", 18, bold=True)
        title = title_font.render("PALCHIK.exe - Information", True, (255, 255, 255))
        surf.blit(title, (title_bar.x + 10, title_bar.y + 5))

        content = pygame.Rect(win.x + 18, win.y + 48, win.width - 36, win.height - 112)
        pygame.draw.rect(surf, (255, 255, 255), content)
        pygame.draw.rect(surf, (128, 128, 128), content, 1)
        heading_font = pygame.font.SysFont("Arial", 25, bold=True)
        body_font = pygame.font.SysFont("Arial", 24)
        typed_text = self.intro_slide_display_text
        if "\n\n" in typed_text:
            heading_display, body_display = typed_text.split("\n\n", 1)
        else:
            heading_display = typed_text.split("\n", 1)[0]
            body_display = ""
        heading = heading_font.render(heading_display, True, (25, 35, 55))
        surf.blit(heading, (content.x + 28, content.y + 26))
        pygame.draw.line(surf, (190, 190, 190),
                         (content.x + 28, content.y + 66),
                         (content.right - 28, content.y + 66), 1)

        lines = self._wrap_intro_text(body_display, body_font, content.width - 56)
        line_y = content.y + 92
        line_height = body_font.get_linesize() + 8
        max_lines = max(1, (content.height - 112) // line_height)
        for line in lines[:max_lines]:
            rendered = body_font.render(line, True, (25, 25, 25))
            surf.blit(rendered, (content.x + 28, line_y))
            line_y += line_height

        footer_font = pygame.font.SysFont("Arial", 16)
        progress = footer_font.render(
            f"{self.intro_slide_index + 1} / {len(self._get_intro_slides())}",
            True, (60, 60, 60)
        )
        surf.blit(progress, (win.x + 22, win.bottom - 43))

        self.intro_slide_button_rect = None
        if self.intro_slide_char_index >= len(self.intro_slide_full_text):
            button_w, button_h = 174, 42
            button = pygame.Rect(win.right - button_w - 22, win.bottom - 54, button_w, button_h)
            self.intro_slide_button_rect = button
            pygame.draw.rect(surf, (128, 128, 128), button.move(2, 2))
