    def _begin_managed_event(self, event_id, *, data=None):
        """Reserve Event Manager resources before starting a legacy event controller."""
        try:
            return self.event_lifecycle.begin(event_id, data=data)
        except RuntimeError as exc:
            self._show_notification(f"Событие заблокировано: {exc}", duration=1800)
            return None

    def _finish_managed_event(self, event_id, *, cancelled=False, reason=None):
        """Finish the managed instance and restore temporary legacy parameters."""
        instance = self.event_lifecycle.instance_for(event_id)
        finished = self.event_lifecycle.finish(
            event_id, cancelled=cancelled, reason=reason
        )
        if (
            instance is not None
            and event_id == "EVT_001_ROACH_ATTACK"
            and "previous_roach_reward_per_roach" in instance.data
        ):
            self.game_logic.roach_reward_per_roach = int(
                instance.data["previous_roach_reward_per_roach"]
            )
        return finished

    def _cancel_managed_roach_attack(self, *, reset=False, reason="CANCELLED"):
        if reset:
            self.game_logic.reset_roach_attack()
        else:
            self.game_logic.stop_roach_attack()
        self._finish_managed_event(
            "EVT_001_ROACH_ATTACK", cancelled=True, reason=reason
        )
        self._stop_roach_audio()

    def _cancel_managed_word_shock(self, *, reset=False, reason="CANCELLED"):
        """Cancel the legacy Word Shock controller and release its managed resources."""
        if reset:
            self.game_logic.reset_word_shock()
        else:
            self.game_logic.stop_word_shock()
        pygame.key.stop_text_input()
        self._finish_managed_event(
            "EVT_002_WORD_SHOCK", cancelled=True, reason=reason
        )

    def _sync_managed_word_shock(self):
        """Reconcile Event Manager state with the legacy Word Shock controller."""
        event_id = "EVT_002_WORD_SHOCK"
        instance = self.event_lifecycle.instance_for(event_id)
        if instance is None:
            return
        if self.game_logic.word_shock_active:
            definition = self.event_catalog.get(event_id)
            start_phase = instance.data.get("phase_at_start")
            if (
                definition is not None
                and definition.phase_policy == "CANCEL"
                and start_phase is not None
                and self.game_logic.get_phase() != start_phase
            ):
                self._cancel_managed_word_shock(reason="PHASE_CHANGED")
            return
        completed = self.game_logic.word_shock_event_status == "COMPLETED"
        self._finish_managed_event(
            event_id,
            cancelled=not completed,
            reason=None if completed else self.game_logic.word_shock_event_status,
        )
        pygame.key.stop_text_input()

    def _sync_managed_roach_attack(self):
        """Reconcile the managed lifecycle with the still-legacy gameplay state."""
        event_id = "EVT_001_ROACH_ATTACK"
        instance = self.event_lifecycle.instance_for(event_id)
        if instance is None:
            return

        if self.game_logic.roach_attack_active:
            definition = self.event_catalog.get(event_id)
            start_phase = instance.data.get("phase_at_start")
            if (
                definition is not None
                and definition.phase_policy == "CANCEL"
                and start_phase is not None
                and self.game_logic.get_phase() != start_phase
            ):
                self._cancel_managed_roach_attack(reason="PHASE_CHANGED")
            return

        completed = self.game_logic.roach_event_status == "COMPLETED"
        self._finish_managed_event(
            event_id,
            cancelled=not completed,
            reason=None if completed else self.game_logic.roach_event_status,
        )
        self._stop_roach_audio()

    def _managed_event_inspect(self, event_id, legacy_text):
        instance = self.event_lifecycle.instance_for(event_id)
        if instance is None:
            history = [
                item for item in self.event_manager.instances.values()
                if item.event_id == event_id
            ]
            instance = max(
                history, key=lambda item: item.started_at or 0.0, default=None
            )
        if instance is not None:
            manager_state = instance.status.value
        else:
            blocked = self.event_manager.last_block_reason.get(event_id)
            manager_state = f"BLOCKED ({blocked})" if blocked else "IDLE"
        return f"{legacy_text} | Event Manager: {manager_state}"

    def _start_roach_attack(self, launch_source="ACTION_SEQUENCE"):
        """Запустить EVT_001: 24 таракана тремя волнами по восемь."""
        logic = self.game_logic
        if logic.roach_attack_active or logic.word_shock_active:
            return False
        if (
            logic.minigame_active
            or logic.timer_active
            or logic.sprite_active
            or logic.fade_screen_active
            or logic.chase_planet_active
        ):
            self._show_notification(
                "Сначала завершите активный игровой режим.", duration=1800
            )
            return False

        event_config = self.event_catalog.configuration("EVT_001_ROACH_ATTACK") or {}
        parameters = event_config.get("parameters", {})
        try:
            roaches_per_event = int(parameters.get("roaches_per_event", 24))
            reward_per_roach = int(parameters.get("reward_per_roach", 1))
        except (TypeError, ValueError):
            self._show_notification("Некорректная конфигурация EVT_001.", duration=1800)
            return False
        if not 1 <= roaches_per_event <= 48 or reward_per_roach < 0:
            self._show_notification("Параметры EVT_001 вне допустимого диапазона.", duration=1800)
            return False
        width, height = self.screen_texture.size
        target_exclusion = self.game_view.rect_target.inflate(170, 150)
        min_x, max_x = 28, max(28, width - 62)
        min_y = max(132, int(height * 0.27))
        max_y = max(min_y, height - 118)
        occupied = []
        entities = []
        band_width = min(150, max(70, width // 8))
        left_columns = (min_x, min(max_x, min_x + band_width // 2), min(max_x, min_x + band_width))
        right_columns = (
            max(min_x, max_x - band_width),
            max(min_x, max_x - band_width // 2),
            max_x,
        )
        row_positions = [
            round(min_y + (max_y - min_y) * row / 3)
            for row in range(4)
        ]
        spawn_slots = [
            (x, y, "left" if x in left_columns else "right")
            for y in row_positions
            for x in (*left_columns, *right_columns)
        ]
        spawn_slots = [
            slot for slot in spawn_slots
            if not pygame.Rect(slot[0], slot[1], 32, 25).colliderect(target_exclusion)
        ]
        random.shuffle(spawn_slots)

        if len(spawn_slots) < roaches_per_event:
            # Lower resolutions get a compact edge layout; avoid the target in every slot.
            edge_columns = (min_x, max_x)
            compact_rows = [
                round(min_y + (max_y - min_y) * row / 11)
                for row in range(12)
            ]
            extra_slots = [
                (x, y, "left" if x == min_x else "right")
                for y in compact_rows
                for x in edge_columns
            ]
            for slot in extra_slots:
                candidate = pygame.Rect(slot[0], slot[1], 32, 25)
                if not candidate.colliderect(target_exclusion) and slot not in spawn_slots:
                    spawn_slots.append(slot)
                if len(spawn_slots) >= roaches_per_event:
                    break

        for index in range(roaches_per_event):
            wave = index // 8
            if index < len(spawn_slots):
                base_x, base_y, side = spawn_slots[index]
            else:
                side = "left" if index % 2 == 0 else "right"
                base_x = min_x if side == "left" else max_x
                base_y = row_positions[index % len(row_positions)]
            x_jitter = 1 if width < 720 else 3
            x = max(min_x, min(max_x, base_x + random.randint(-x_jitter, x_jitter)))
            y = max(min_y, min(max_y, base_y + random.randint(-10, 10)))
            occupied.append(pygame.Rect(x, y, 32, 25))
            speed = random.uniform(108.0, 168.0)
            spread = random.uniform(-0.72, 0.72)
            angle = spread if side == "left" else 3.14159265 + spread
            vx = math.cos(angle) * speed
            vy = math.sin(angle) * speed
            entities.append({
                "x": float(x), "y": float(y), "vx": vx, "vy": vy,
                "base_speed": speed,
                "spawn_delay": wave * 0.78 + random.uniform(0.0, 0.20),
                "visible": wave == 0,
                "anim_offset": random.randint(0, 900),
                "turn_timer": random.uniform(0.25, 0.85),
                "direction": "right" if vx >= 0 else "left",
            })

        previous_reward = int(logic.roach_reward_per_roach)
        instance = self._begin_managed_event(
            "EVT_001_ROACH_ATTACK",
            data={
                "launch_source": str(launch_source),
                "phase_at_start": logic.get_phase(),
                "previous_roach_reward_per_roach": previous_reward,
                "configured_roaches": roaches_per_event,
                "configured_reward_per_roach": reward_per_roach,
            },
        )
        if instance is None:
            return False

        logic.roach_reward_per_roach = reward_per_roach
        try:
            started = logic.start_roach_attack(entities)
        except Exception:
            self._finish_managed_event(
                "EVT_001_ROACH_ATTACK", cancelled=True, reason="START_EXCEPTION"
            )
            raise
        if not started:
            self._finish_managed_event(
                "EVT_001_ROACH_ATTACK", cancelled=True, reason="LEGACY_START_REJECTED"
            )
            return False

        logic.roach_announcement_started_at = pygame.time.get_ticks()
        self.admin_event_inspect_text = self._managed_event_inspect(
            "EVT_001_ROACH_ATTACK", logic.inspect_roach_attack()
        )
        self.audio_box.play_roach_attack("start")
        return True

    def _start_word_shock(self, launch_source="ACTION_SEQUENCE"):
        """Start EVT_002 through Event Manager before activating its legacy controller."""
        logic = self.game_logic
        event_id = "EVT_002_WORD_SHOCK"
        payload = self.event_catalog.configuration(event_id) or {}
        parameters = payload.get("parameters", {})
        try:
            duration_min = int(parameters.get("duration_min_seconds", 120))
            duration_max = int(parameters.get("duration_max_seconds", 180))
            confirmation_delay = float(parameters.get("confirmation_after_seconds", 30))
            wrong_answer_extension = int(parameters.get("wrong_answer_extension_seconds", 60))
            if duration_min < 120 or duration_max > 180 or duration_min > duration_max:
                raise ValueError("INVALID_DURATION_RANGE")
            if confirmation_delay < 0 or wrong_answer_extension < 1:
                raise ValueError("INVALID_TIMING_PARAMETERS")
        except (TypeError, ValueError) as exc:
            self._show_notification(f"Некорректная конфигурация {event_id}: {exc}", duration=2200)
            return False
        duration = random.randint(duration_min, duration_max)
        instance = self._begin_managed_event(
            event_id,
            data={
                "launch_source": str(launch_source),
                "phase_at_start": logic.get_phase(),
                "duration_seconds": duration,
                "confirmation_after_seconds": confirmation_delay,
                "wrong_answer_extension_seconds": wrong_answer_extension,
            },
        )
        if instance is None:
            return False
        try:
            started = logic.start_word_shock(
                duration_seconds=duration,
                confirmation_after_seconds=confirmation_delay,
                wrong_answer_extension_seconds=wrong_answer_extension,
            )
        except Exception:
            self._finish_managed_event(event_id, cancelled=True, reason="START_EXCEPTION")
            raise
        if not started:
            self._finish_managed_event(event_id, cancelled=True, reason="LEGACY_START_REJECTED")
            return False
        self.game_view.word_shock_confirm_rect = None
        self.admin_event_inspect_text = self._managed_event_inspect(
            event_id, logic.inspect_word_shock()
        )
        return True

    def _submit_word_shock_answer(self):
        result = self.game_logic.submit_word_shock_answer(self.game_logic.word_shock_input)
        if result == "ACCEPTED":
            pygame.key.stop_text_input()
            self._finish_managed_event("EVT_002_WORD_SHOCK", cancelled=False)
            self.admin_event_inspect_text = self._managed_event_inspect(
                "EVT_002_WORD_SHOCK", self.game_logic.inspect_word_shock()
            )
        return result

    def _handle_word_shock_input(self, event):
        logic = self.game_logic
        if not logic.word_shock_active or not logic.word_shock_modal_visible:
            return
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_BACKSPACE:
                logic.word_shock_input = logic.word_shock_input[:-1]
            elif event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                self._submit_word_shock_answer()
            # Остальные клавиши, включая Escape и F2, не закрывают событие.
            return
        if event.type == getattr(pygame, "TEXTINPUT", -1):
            text = getattr(event, "text", "")
            cleaned = "".join(ch for ch in text if ch.isprintable() and ch not in "\r\n\t")
            logic.word_shock_input = (logic.word_shock_input + cleaned)[:32]
            return
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            win_w, win_h = self.screen.get_size()
            tex_w, tex_h = self.screen_texture.size
            pos = (
                int(event.pos[0] * (tex_w / max(1, win_w))),
                int(event.pos[1] * (tex_h / max(1, win_h))),
            )
            confirm_rect = getattr(self.game_view, "word_shock_confirm_rect", None)
            if confirm_rect and confirm_rect.collidepoint(pos):
                self._submit_word_shock_answer()

    def _sync_roach_audio(self):
        logic = self.game_logic
        blocked = (
            logic.minigame_active
            or logic.timer_active
            or logic.sprite_active
            or logic.chase_planet_active
            or logic.fade_screen_active
            or logic.clicks_in_cycle >= 10
            or logic.code_window_open
            or logic.lore_window_open
            or logic.lore_text_viewer_open
            or logic.lore_image_viewer_open
        )
        visible = any(
            item.get("visible", True) or item.get("spawn_delay", 0.0) <= 0.0
            for item in logic.roach_entities
        )
        should_play = logic.roach_attack_active and visible and not blocked
        if should_play and not self._roach_scuttle_playing:
            self._roach_scuttle_playing = self.audio_box.play_roach_attack("scuttle_loop")
        elif not should_play and self._roach_scuttle_playing:
            self.audio_box.stop_roach_scuttle()
            self._roach_scuttle_playing = False

    def _stop_roach_audio(self):
        """Stop every dedicated EVT_001 channel when the event/session is stopped."""
        self.audio_box.stop_roach_attack_audio()
        self._roach_scuttle_playing = False

    def _log_exception(self, context, exc):
        """Record caught exceptions both in logs/palchik.log and the admin log tab."""
        log_exception(self.app_logger, str(context), exc)

    def _open_admin_log_file(self):
        self.log_file_path.parent.mkdir(parents=True, exist_ok=True)
        self.log_file_path.touch(exist_ok=True)
        try:
            if os.name == "nt":
                os.startfile(str(self.log_file_path))
            else:
                subprocess.Popen(["xdg-open", str(self.log_file_path)])
        except Exception as exc:
            self._log_exception("ADMIN_LOG_OPEN", exc)
            self._show_notification("Не удалось открыть файл журнала. См. путь в панели.", duration=2500)

    def _admin_event_registry(self):
        """Expose event metadata from the central catalog to the existing admin UI."""
        return {
            definition.event_id: {
                "label": definition.label,
                "description": definition.description,
            }
            for definition in self.event_catalog.all(enabled_only=True)
            if definition.metadata.get("admin_supported", False)
        }

    def _evt003_admin_block_reason(self):
        logic = self.game_logic
        blocked = (
            logic.word_shock_active or logic.roach_attack_active
            or logic.minigame_active or logic.timer_active or logic.sprite_active
            or logic.chase_planet_active or logic.fade_screen_active
            or logic.code_window_open or logic.lore_window_open
            or logic.lore_text_viewer_open or logic.lore_image_viewer_open
            or self.settings_box.is_open
        )
        return "GAMEPLAY_MODE_BUSY" if blocked else None

    def _start_evt003_admin_flow(self, phase, *, sandbox):
        if not self._admin_phase_controls_available():
            self._show_notification("EVT_003 доступен только в игровой сцене.", duration=1800)
            return False
        if self.evt003_state is not None:
            self._show_notification("EVT_003 уже выполняется.", duration=1800)
            return False
        reason = self._evt003_admin_block_reason()
        if reason:
            self._show_notification("EVT_003 нельзя запустить поверх другого игрового режима.", duration=2200)
            return False
        allowed, reason = self.evt003_runtime.can_start(phase, sandbox=sandbox)
        if not allowed:
            message = (
                "EVT_003 уже использовал реальную попытку в этой фазе."
                if reason == "ALREADY_OCCURRED_THIS_PHASE"
                else f"EVT_003 сейчас недоступен: {reason or 'EVENT_BLOCKED'}"
            )
            self._show_notification(message, duration=2600)
            return False
        try:
            instance = self.evt003_runtime.start(phase, sandbox=sandbox)
        except Exception as exc:
            self._log_exception(f"EVT003_ADMIN_START phase={phase} sandbox={sandbox}", exc)
            self._show_notification("EVT_003: не удалось запустить событие. Откройте F2 → ЖУРНАЛ.", duration=2800)
            return False
        self.evt003_instance_id = instance.instance_id
        self.evt003_started_at = float(instance.started_at or time.monotonic())
        self.evt003_typewriter_count = 0
        self.evt003_typewriter.reset(
            "PLEASE DON'T TOUCH ANYTHING", started_at=self.evt003_started_at,
            interval=self.evt003_typewriter_interval,
        )
        self.evt003_dialog_payload = None
        self.evt003_is_sandbox = bool(sandbox)
        self.evt003_state = "RUNNING"
        self.evt003_scheduled_phase = phase
        self.evt003_next_check_at = float("inf")
        return True

    def _admin_trigger_evt003(self):
        """Real run: consumes a persistent phase attempt and applies normal outcomes."""
        return self._start_evt003_admin_flow(self.game_logic.get_phase(), sandbox=False)

    def _admin_test_evt003(self, phase):
        """Repeatable sandbox run: same presentation/resources, no player-save writes."""
        return self._start_evt003_admin_flow(str(phase), sandbox=True)

    def _admin_trigger_event(self, event_id):
        if event_id not in self._admin_event_registry():
            self._show_notification("Неизвестный ID события.", duration=1600)
            return
        if not self._admin_phase_controls_available():
            self._show_notification("События доступны только в игровой сцене.", duration=1800)
            return
        if event_id == "EVT_001_ROACH_ATTACK":
            started = self._start_roach_attack(launch_source="ADMIN")
        elif event_id == "EVT_002_WORD_SHOCK":
            started = self._start_word_shock(launch_source="ADMIN")
        elif event_id == "EVT_003_PLEASE_DONT_TOUCH":
            started = self._admin_trigger_evt003()
        else:
            self._show_notification("Для этого события нет ручного обработчика.", duration=1800)
            return
        if started:
            self.admin_panel_tab = "events"
            self.admin_panel_open = False
            self._show_notification(event_id + ": TRIGGERED", duration=1800)

    def _admin_stop_event(self, event_id):
        if event_id == "EVT_001_ROACH_ATTACK":
            self._cancel_managed_roach_attack(reason="ADMIN_STOP")
            self.admin_event_inspect_text = self._managed_event_inspect(
                event_id, self.game_logic.inspect_roach_attack()
            )
        elif event_id == "EVT_002_WORD_SHOCK":
            self._cancel_managed_word_shock(reason="ADMIN_STOP")
            self.admin_event_inspect_text = self._managed_event_inspect(
                event_id, self.game_logic.inspect_word_shock()
            )
        else:
            return
        self.admin_panel_tab = "events"
        self._show_notification(event_id + ": STOPPED", duration=1500)

    def _admin_reset_event(self, event_id):
        if event_id == "EVT_001_ROACH_ATTACK":
            self._cancel_managed_roach_attack(reset=True, reason="ADMIN_RESET")
            self.admin_event_inspect_text = self._managed_event_inspect(
                event_id, self.game_logic.inspect_roach_attack()
            )
        elif event_id == "EVT_002_WORD_SHOCK":
            self._cancel_managed_word_shock(reset=True, reason="ADMIN_RESET")
            self.admin_event_inspect_text = self._managed_event_inspect(
                event_id, self.game_logic.inspect_word_shock()
            )
        else:
            return
        self.admin_panel_tab = "events"
        self._show_notification(event_id + ": RESET", duration=1500)

    def _admin_inspect_event(self, event_id):
        if event_id == "EVT_001_ROACH_ATTACK":
            self.admin_event_inspect_text = self._managed_event_inspect(
                event_id, self.game_logic.inspect_roach_attack()
            )
        elif event_id == "EVT_002_WORD_SHOCK":
            self.admin_event_inspect_text = self._managed_event_inspect(
                event_id, self.game_logic.inspect_word_shock()
            )

    def _admin_phase_controls_available(self):
        return (
            self.current_screen == "game"
            and self.crash_stage == 0
            and not self.intro_slides_active
            and not self.name_entry_active
            and not self.channel_switch_active
        )

    def _admin_set_phase(self, clicks):
        if not self._admin_phase_controls_available():
            return
        # Phase jumps clear transient state from the previous phase, but keep score.
        if self.game_logic.word_shock_active or self.event_lifecycle.is_tracked("EVT_002_WORD_SHOCK"):
            self._cancel_managed_word_shock(reason="PHASE_RESET")
        if self.game_logic.roach_attack_active or self.event_lifecycle.is_tracked("EVT_001_ROACH_ATTACK"):
            self._cancel_managed_roach_attack(reason="PHASE_RESET")
        self.game_logic.reset_session(reset_progress=False)
        self.game_logic.total_clicks = int(clicks)
        self.game_logic._sync_to_disk()
        self.final_phase_triggered = False
        self.crash_stage = 0
        self.fake_crash_start = 0
        self.game_view.recalculate_layout()
        self._show_notification(f"ADMIN: phase position {clicks} clicks", duration=1800)
        self._on_limit_reached()

    def _open_secret_input(self, *, force=False):
        # The unlock is persistent, but the prompt is a per-game-session
        # interaction. A saved unlock must never suppress the next session's PIN.
        if self.secret_prompt_session.completed_this_session and not force:
            return False
        if self.secret_input_open:
            return True
        self.secret_input_value = ""
        self.secret_input_started_at = time.monotonic()
        self.secret_input_last_digit_at = 0.0
        self.secret_input_error_until = 0.0
        self.secret_input_closing = False
        self.secret_input_closing_started_at = 0.0
        self.secret_input_open = True
        return True

    def _submit_secret_input(self, candidate=None):
        attempt = self.secret_input_value if candidate is None else str(candidate)
        if not is_valid_numeric_code(attempt):
            self.secret_input_value = ""
            self.secret_input_error_until = time.monotonic() + 0.75
            self._show_notification("НЕВЕРНЫЙ ПАРОЛЬ", duration=1800)
            return False
        try:
            SaveManager.save_event_collection_state(
                unlocked=True, progress=self.event_collection_progress,
            )
        except Exception:
            self.app_logger.exception("Не удалось сохранить разблокировку коллекции событий")
            self.secret_input_error_until = time.monotonic() + 0.75
            self._show_notification("ОШИБКА СОХРАНЕНИЯ ДОСТУПА", duration=2200)
            return False
        self.event_collection_unlocked = True
        self.secret_prompt_session.mark_completed()
        self.secret_input_closing = True
        self.secret_input_closing_started_at = time.monotonic()
        self.secret_input_value = ""
        self.event_collection_open = False
        self.event_collection_closing = False
        self.event_collection_window_rect = None
        self.event_collection_close_rect = None
        self._show_notification("ПАРОЛЬ ВЕРНЫЙ · КОЛЛЕКЦИЯ СОБЫТИЙ ОТКРЫТА", duration=2600)
        return True

    def _cancel_secret_input(self):
        if self.secret_input_closing:
            return
        self.secret_input_closing = True
        self.secret_input_closing_started_at = time.monotonic()


    def _confirm_secret_input(self):
        if self.secret_input_closing:
            return False
        if len(self.secret_input_value) != SECRET_ACCESS_CODE_LENGTH:
            self.secret_input_error_until = time.monotonic() + 0.55
            self._show_notification("ВВЕДИТЕ 6 ЦИФР", duration=1500)
            return False
        return self._submit_secret_input()

    def _handle_secret_input_key(self, event):
        if self.secret_input_closing:
            return
        if event.key == pygame.K_ESCAPE:
            # Keep the explicit state transition here for the existing integration contract.
            self.secret_input_closing = True
            self.secret_input_closing_started_at = time.monotonic()
            return
        if event.key == pygame.K_BACKSPACE:
            self.secret_input_value = self.secret_input_value[:-1]
            return
        if event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
            self._confirm_secret_input()
            return
        digit = None
        unicode_value = getattr(event, "unicode", "")
        if isinstance(unicode_value, str) and len(unicode_value) == 1 and unicode_value.isascii() and unicode_value.isdigit():
            digit = unicode_value
        elif pygame.K_0 <= event.key <= pygame.K_9:
            digit = str(event.key - pygame.K_0)
        elif pygame.K_KP0 <= event.key <= pygame.K_KP9:
            digit = str(event.key - pygame.K_KP0)
        if digit is not None and len(self.secret_input_value) < SECRET_ACCESS_CODE_LENGTH:
            self.secret_input_value += digit
            self.secret_input_last_digit_at = time.monotonic()

    def mark_event_found(self, event_id):
        """Mark a collection item as discovered; safe for future event handlers."""
        updated = mark_event_found(self.event_collection_progress, event_id)
        SaveManager.save_event_collection_state(progress=updated)
        self.event_collection_progress = updated

    def mark_event_completed(self, event_id):
        """Mark an event as completed (completion also implies discovery)."""
        updated = mark_event_completed(self.event_collection_progress, event_id)
        SaveManager.save_event_collection_state(progress=updated)
        self.event_collection_progress = updated

    def _draw_secret_input(self, surface):
        if not self.secret_input_open:
            self.secret_input_rect = None
            self.secret_input_close_rect = None
            self.secret_input_ok_rect = None
            self.secret_input_cancel_rect = None
            return

        width, height = surface.get_size()
        target = getattr(self.game_view, "rect_target", None)

        # Preserve the existing dimensions and placement below the target button.
        panel_w = min(680, max(260, width - 32))
        if panel_w > width - 12:
            panel_w = width - 12
        panel_h = min(214, max(146, height - 24))
        x = (width - panel_w) // 2
        if target is not None:
            y = target.bottom + 18
            if y + panel_h > height - 12:
                y = target.top - panel_h - 18
        else:
            y = int(height * 0.56 - panel_h / 2)
        y = max(6, min(height - panel_h - 6, y))
        final_panel = pygame.Rect(x, y, panel_w, panel_h)

        now = time.monotonic()
        opening_t = min(1.0, max(0.0, (now - self.secret_input_started_at) / 0.30))
        opening_ease = 1.0 - (1.0 - opening_t) ** 3
        closing_t = 0.0
        if self.secret_input_closing:
            closing_t = min(1.0, max(0.0, (now - self.secret_input_closing_started_at) / 0.22))
        visibility = opening_ease * (1.0 - closing_t)
        if self.secret_input_closing and closing_t >= 1.0:
            self.secret_input_open = False
            self.secret_input_closing = False
            self.secret_input_value = ""
            self.secret_prompt_session.retry_after_cancel()
            self.secret_input_rect = None
            self.secret_input_close_rect = None
            self.secret_input_ok_rect = None
            self.secret_input_cancel_rect = None
            return

        scale_x = 0.86 + 0.14 * visibility
        scale_y = 0.92 + 0.08 * visibility
        draw_w = max(1, int(panel_w * scale_x))
        draw_h = max(1, int(panel_h * scale_y))
        layer = pygame.Surface((panel_w, panel_h), pygame.SRCALPHA)

        error_active = now < self.secret_input_error_until
        error_elapsed = max(0.0, 0.75 - (self.secret_input_error_until - now)) if error_active else 0.0
        error_strength = max(0.0, 1.0 - error_elapsed / 0.75) if error_active else 0.0
        shake_x = int(math.sin(error_elapsed * 58.0) * 7 * error_strength) if error_active else 0

        # Match GameScene._draw_hidden_code_ui: classic Win9x bevel and blue title bar.
        layer.fill((192, 192, 192, 255))
        pygame.draw.rect(layer, (128, 128, 128), (0, 0, panel_w, panel_h), 2)
        pygame.draw.rect(layer, (255, 255, 255), (2, 2, panel_w - 4, 1))
        pygame.draw.rect(layer, (255, 255, 255), (2, 2, 1, panel_h - 4))
        pygame.draw.rect(layer, (64, 64, 64), (2, panel_h - 3, panel_w - 4, 1))
        pygame.draw.rect(layer, (64, 64, 64), (panel_w - 3, 2, 1, panel_h - 4))

        title_bar_h = 24
        pygame.draw.rect(layer, (192, 192, 192), (3, title_bar_h, panel_w - 6, panel_h - title_bar_h - 3))
