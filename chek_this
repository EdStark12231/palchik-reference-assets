    def __init__(self):
        self._claims: dict[str, dict[str, ResourceClaim]] = {}

    def can_acquire(self, claim: ResourceClaim) -> tuple[bool, str | None]:
        owners = self._claims.get(claim.resource, {})
        for owner_id, current in owners.items():
            if owner_id == claim.event_id:
                continue
            if current.mode == ResourceMode.EXCLUSIVE or claim.mode == ResourceMode.EXCLUSIVE:
                return False, f"RESOURCE_{claim.resource.upper()}_OCCUPIED"
        return True, None

    def acquire(self, claim: ResourceClaim) -> tuple[bool, str | None]:
        allowed, reason = self.can_acquire(claim)
        if not allowed:
            return False, reason
        self._claims.setdefault(claim.resource, {})[claim.event_id] = claim
        return True, None

    def release(self, event_id: str, resource: str | None = None) -> None:
        resources = (resource,) if resource is not None else tuple(self._claims)
        for key in resources:
            owners = self._claims.get(key)
            if owners is None:
                continue
            owners.pop(event_id, None)
            if not owners:
                self._claims.pop(key, None)

    def release_all(self, event_id: str) -> None:
        self.release(event_id)

    def owners(self, resource: str) -> tuple[str, ...]:
        return tuple(self._claims.get(resource, {}))


