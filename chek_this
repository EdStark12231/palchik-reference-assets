class InterfaceTarget:
    key: str
    label: str
    rect: pygame.Rect
    kind: str
    priority: int
    attack_mode: str
    max_hp: int
    hp: int
    hit_flash: float = 0.0
    shake_time: float = 0.0
    fragments: list[Particle] = field(default_factory=list)
    destroyed: bool = False
    visible: bool = True

    @property
    def center(self) -> pygame.Vector2:
        return pygame.Vector2(self.rect.center)

    @property
    def radius(self) -> float:
        return max(12.0, math.hypot(self.rect.width, self.rect.height) * 0.5)

    def take_damage(self, rng: random.Random) -> bool:
        if self.destroyed or not self.visible:
            return False
        self.hp = max(0, self.hp - 1)
        self.hit_flash = 0.22
        self.shake_time = 0.24
        count = 24 if self.hp == 0 else 9
        for _ in range(count):
            pos = pygame.Vector2(
                rng.uniform(self.rect.left, self.rect.right),
                rng.uniform(self.rect.top, self.rect.bottom),
            )
            angle = rng.uniform(0.0, math.tau)
            speed = rng.uniform(55.0, 185.0 if self.hp == 0 else 115.0)
            self.fragments.append(Particle(
                pos, pygame.Vector2(math.cos(angle), math.sin(angle)) * speed,
                rng.choice((GB_MID_DARK, GB_LIGHT, GB_BRIGHT)),
                rng.uniform(0.30, 0.85), 0.85,
                size=rng.choice((2, 3, 4)), gravity=105.0, drag=0.32,
                kind='ui_debris',
            ))
        if self.hp == 0:
            self.destroyed = True
        return self.destroyed

    def update(self, dt: float) -> None:
        self.hit_flash = max(0.0, self.hit_flash - dt)
        self.shake_time = max(0.0, self.shake_time - dt)
        for p in self.fragments:
            p.update(dt)
        self.fragments = [p for p in self.fragments if p.alive]

    def draw_damage(self, surface: pygame.Surface, background: pygame.Surface) -> None:
        for particle in self.fragments:
            Dragon._draw_particle(surface, particle)
        if not self.visible:
            return

        rect = self.rect.clip(surface.get_rect())
        if rect.width <= 0 or rect.height <= 0:
            return

        if self.destroyed:
            # Restore the exact current PALCHIK backdrop under the removed interface element.
            surface.blit(background, rect.topleft, rect)
            # A short-lived dark scorch remains after the letters/button disappear.
            if self.hit_flash > 0:
                scorch = pygame.Surface(rect.size, pygame.SRCALPHA)
                scorch.fill((8, 16, 8, int(90 * self.hit_flash / 0.22)))
                surface.blit(scorch, rect.topleft)
            return

        if self.hp < self.max_hp:
            # Crack marks overlay the original UI; they do not replace its font or artwork.
            inset = rect.inflate(-4, -4)
            if inset.width > 4 and inset.height > 4:
                seed = sum(ord(ch) for ch in self.key)
                rng = random.Random(seed + self.max_hp - self.hp)
                crack_color = GB_BRIGHT if self.hit_flash > 0 else GB_MID_DARK
                for idx in range(self.max_hp - self.hp):
                    x = rng.randint(inset.left + 2, max(inset.left + 2, inset.right - 2))
                    y = rng.randint(inset.top + 2, max(inset.top + 2, inset.bottom - 2))
                    points = [(x, y)]
                    for _ in range(3):
                        x += rng.randint(-9, 9)
                        y += rng.randint(3, 9)
                        points.append((max(inset.left, min(inset.right, x)), max(inset.top, min(inset.bottom, y))))
                    pygame.draw.lines(surface, crack_color, False, points, 1)

        if self.hit_flash > 0:
            flash = pygame.Surface(rect.size, pygame.SRCALPHA)
            flash.fill((155, 188, 15, int(68 * self.hit_flash / 0.22)))
            surface.blit(flash, rect.topleft)

