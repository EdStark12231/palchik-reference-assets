        self.assertEqual(instance.status, EventStatus.ACTIVE)
        self.assertEqual(self.manager.arbiter.owners("keyboard_text_input"), (EVENT_ID,))
        self.assertEqual(self.manager.arbiter.owners("main_gameplay"), (EVENT_ID,))
        self.assertEqual(self.manager.arbiter.owners("event_overlay"), (EVENT_ID,))
        self.assertEqual(self.manager.arbiter.owners("event_timer"), (EVENT_ID,))

    def test_word_shock_blocks_roach_attack_while_exclusive_overlay_is_owned(self):
