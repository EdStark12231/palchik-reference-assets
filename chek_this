        self.assertEqual(ledger.violation_count, 1)
        self.assertEqual(ledger.forgiveness_count, 1)
        self.assertEqual(ledger.punishment_count, 0)

        punished = ledger.resolve_violation(
            "phase_1", "punished-1", "PUNISHMENT", current_balance=1000
        )
        self.assertEqual(punished["penalty_percent"], 5)
        self.assertEqual(punished["penalty_amount"], 50)

