            pygame.draw.line(layer, (96, 96, 96), slot.topleft, (slot.left, slot.bottom - 1))
            pygame.draw.line(layer, (255, 255, 255), (slot.left, slot.bottom - 1), (slot.right - 1, slot.bottom - 1))
            pygame.draw.line(layer, (255, 255, 255), (slot.right - 1, slot.top), (slot.right - 1, slot.bottom - 1))

            is_filled = index < len(self.secret_input_value)
            is_active = index == len(self.secret_input_value) and index < SECRET_ACCESS_CODE_LENGTH
            if is_filled:
                digit_surface = digit_font.render(self.secret_input_value[index], True, (0, 0, 0))
