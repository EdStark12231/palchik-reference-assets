        config = self.catalog.configuration(EVENT_ID)
        params = config["parameters"]
        self.assertEqual(params["duration_min_seconds"], 120)
        self.assertEqual(params["duration_max_seconds"], 180)
        self.assertEqual(params["confirmation_after_seconds"], 30)
        self.assertEqual(params["wrong_answer_extension_seconds"], 60)
        self.assertTrue(config["enabled"])

