            source=EventSource.ACTION, implementation="legacy.roach_attack",
            config_file="evt_001_roach_attack.json", resources=("game_objects", "score", "main_gameplay"),
            exclusive_resources=("roach_input", "event_overlay"), subcategories=("ACTION_02",),
