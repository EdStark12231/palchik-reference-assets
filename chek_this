            pygame.draw.line(layer, (255, 255, 255), rect.topleft, (rect.right - 1, rect.top))
            pygame.draw.line(layer, (255, 255, 255), rect.topleft, (rect.left, rect.bottom - 1))
            pygame.draw.line(layer, (96, 96, 96), (rect.left, rect.bottom - 1), (rect.right - 1, rect.bottom - 1))
            pygame.draw.line(layer, (96, 96, 96), (rect.right - 1, rect.top), (rect.right - 1, rect.bottom - 1))
            button_font = pygame.font.SysFont("Arial", 11, bold=True)
            button_surface = button_font.render(label, True, (0, 0, 0))
