    def get_click_phrase(self, phase: str) -> str:
        """Return a random click phrase for the given phase, with special handling."""
        from localization import TRANSLATIONS
        lang = getattr(self, 'current_lang', 'RU')
        if lang not in TRANSLATIONS:
            lang = 'RU'
        phrases_data = TRANSLATIONS[lang].get('click_phrases', {})
        pool = phrases_data.get(phase, [])
        if not pool and lang != 'RU':
            pool = TRANSLATIONS['RU'].get('click_phrases', {}).get(phase, [])
        if not pool:
            return ""
        # Special phrase: 2% chance once per session
        if not getattr(self, 'special_phrase_triggered', False) and random.random() < 0.02:
            self.special_phrase_triggered = True
            return phrases_data.get('special', '')
        # Phase 4 error phrase: 5% chance
        if phase == 'phase_4':
            error_phrase = "Ошибка обработки клика #показывать с шансом в 5%"
            if lang == 'US':
                error_phrase = "Click processing error #show with 5% chance"
            elif lang == 'ES':
                error_phrase = "Error de procesamiento de clic #mostrar con 5% de probabilidad"
            elif lang == 'DE':
                error_phrase = "Klickverarbeitungsfehler #mit 5% Wahrscheinlichkeit anzeigen"
            if random.random() < 0.05:
                return error_phrase
        phrase = random.choice(pool)
        # Alice phrase stub
        if 'Алиса' in phrase or 'Alice' in phrase:
            if 'Подлая еврейская музыка' in phrase or 'Underhanded Jewish Music' in phrase or 'Música judía despreciable' in phrase or 'Untertänige jüdische Musik' in phrase or '卑鄙的犹太音乐' in phrase:
                print("ALICE: Подлая еврейская музыка")  # временная заглушка
        return phrase

    def get_phase(self) -> str:
        tc = self.total_clicks
        for phase, threshold in sorted(PHASE_THRESHOLDS.items(), key=lambda x: x[1], reverse=True):
            if tc >= threshold:
                return phase
        return "phase_0"

    def get_phase_index(self) -> int:
        return list(PHASE_THRESHOLDS.keys()).index(self.get_phase())

    def get_phase_factor(self) -> float:
        phase = self.get_phase()
        if phase == "final": return 1.0
        if phase == "phase_4": return 0.85
        if phase == "phase_3": return 0.65
        if phase == "phase_2": return 0.45
        if phase == "phase_1": return 0.25
        return 0.0

    def get_next_phase(self) -> str:
        phases = list(PHASE_THRESHOLDS.keys())
        current = self.get_phase()
        idx = phases.index(current)
        if idx + 1 < len(phases):
            return phases[idx + 1]
        return current

