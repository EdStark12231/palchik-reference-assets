    def _update_game(self):
        if self.evt004_result_state is not None:
            self._update_evt004_result_screen()
            return
        if self.event_collection_open or self.secret_input_open:
            return
        if self.evt004_runtime is not None:
            self._update_evt004(self.clock.get_time() / 1000.0)
            # EVT004 has an exclusive main_gameplay claim; do not tick normal gameplay underneath it.
            return
        if self.evt003_state is not None:
            self._update_evt003()
            return
        self._maybe_start_evt003()
        if self.evt003_state is not None:
            return
        if self.game_logic.word_shock_active or self.event_lifecycle.is_tracked("EVT_002_WORD_SHOCK"):
            self._sync_managed_word_shock()
        if self.game_logic.word_shock_active:
            word_shock_update = self.game_logic.update_word_shock()
            if word_shock_update == "MODAL_OPEN":
                pygame.key.start_text_input()
            elif word_shock_update == "EXPIRED":
                pygame.key.stop_text_input()
                self._sync_managed_word_shock()
            return
        now = pygame.time.get_ticks()
        dt = self.clock.get_time() / 1000.0
        self._update_hidden_system(dt)
        self._update_code_init(dt)
        
        # Отслеживаем завершение погони, чтобы проиграть звук ухода планеты
        # только при истечении таймера, а не после успешного захвата.
        chase_was_active = self.game_logic.sprite_active
        chase_timer_was_active = self.game_logic.timer_active

        # Оптимизация: GameLogic.update() вызываем с dt для возможности throttling
        self.game_logic.update()
        self._sync_managed_roach_attack()
        sequence_update = self.game_logic.update_roach_sequence()
        if sequence_update == "ROACH_TRIGGER":
            self._start_roach_attack()
        _roach_mode_blocked = (
            self.game_logic.minigame_active
            or self.game_logic.timer_active
            or self.game_logic.sprite_active
            or self.game_logic.chase_planet_active
            or self.game_logic.fade_screen_active
            or self.game_logic.clicks_in_cycle >= 10
        )
        if self.game_logic.roach_attack_active and not _roach_mode_blocked:
            _roach_forbidden = self.game_view.rect_target.inflate(170, 150)
            _win_w, _win_h = self.screen.get_size()
            _tex_w, _tex_h = self.screen_texture.size
            _mouse = pygame.mouse.get_pos()
            _cursor_tex = (
                int(_mouse[0] * (_tex_w / max(1, _win_w))),
                int(_mouse[1] * (_tex_h / max(1, _win_h))),
            )
            self.game_logic.update_roaches(
                dt, self.game_view.width, self.game_view.height,
                _roach_forbidden, cursor_pos=_cursor_tex,
            )
        self._sync_roach_audio()

        if (
            chase_was_active
            and chase_timer_was_active
            and not self.game_logic.sprite_active
            and self.game_logic.fade_screen_active
        ):
            self.audio_box.play_chase_planet("escape")

        self.game_view.update_animations()
        
        # Оптимизация CPU: обновляем уведомления и horror-фразы не каждый кадр, а раз в ~200 мс
        if now - getattr(self, '_last_notification_update', 0) >= 200:
            self._last_notification_update = now
            
            if self.game_logic.clicks_in_cycle >= 10 and not self.game_logic.minigame_active and not self.game_logic.timer_active and not self.game_logic.fade_screen_active:
                now_ms = int(time.monotonic() * 1000)
                if self.game_logic.notification_timer <= now_ms or self.game_logic.notification_text in ("", TRANSLATIONS[self.current_lang]["hint"]):
                    text_source = TRANSLATIONS[self.current_lang]
                    
                    phase_key = self.game_logic.get_phase()
                    
                    if phase_key in ["phase_0", "phase_1"]:
                        phrases_pool = text_source["phrases"]
                    else:
                        phrases_pool = text_source["horror_phrases"]
                        
                    self.game_logic.set_notification(random.choice(phrases_pool), duration=5000)
            
            # Update personalized horror phrases based on phase
            if self.game_logic.is_horror_phase() and self.game_logic.player_name:
                phase_idx = self.game_logic.get_phase_index()
                phase_num = min(4, max(0, phase_idx - 1))
                
                if phase_num >= 2:
                    personalized = self.game_logic.get_personalized_horror_phrase(self.current_lang, phase_num)
                    if personalized and random.random() < 0.3:
                        self.game_logic.set_notification(personalized, duration=7000)

        if now - self.game_last_blink_time >= 500:
            self.game_blink_visible = not self.game_blink_visible
            self.game_last_blink_time = now
        else:
            self.game_blink_visible = True
        if self.final_phase_triggered and self.game_logic.is_final_phase():
            keep = self.game_view.update_typewriter(self.game_logic.total_clicks)
            self.typed_phrase = self.game_view.display_phrase
            if not keep and not self.game_logic.timer_active:
                self.game_logic.timer_active = False
                self.crash_stage = 1
                self.fake_crash_start = now
        else:
            self.game_view.update_typewriter(self.game_logic.total_clicks)
            self.typed_phrase = self.game_view.display_phrase

        if self.easter_egg_timer and now > self.easter_egg_timer:
            self.easter_egg_phrase = ""
            self.easter_egg_timer = 0
        if self.game_logic.sprite_active and not self.game_logic.minigame_active:
            win_w, win_h = self.screen.get_size()
            tex_w, tex_h = self.screen_texture.size
            mouse_pos = pygame.mouse.get_pos()
            mouse_tex_x = int(mouse_pos[0] * (tex_w / win_w))
            mouse_tex_y = int(mouse_pos[1] * (tex_h / win_h))

            _chase_planets = getattr(self.game_logic, "chase_planets", [])

            if _chase_planets:
                for _planet in _chase_planets:
                    _center_x = _planet["x"] + 22
                    _center_y = _planet["y"] + 22
                    _dx = _center_x - mouse_tex_x
                    _dy = _center_y - mouse_tex_y
                    _dist = math.hypot(_dx, _dy)

                    if 0 < _dist < 110:
                        _planet["x"] += (
                            (_dx / _dist) * self.game_logic.sprite_speed
                            + random.uniform(-1.5, 1.5)
                        )
                        _planet["y"] += (
                            (_dy / _dist) * self.game_logic.sprite_speed
                            + random.uniform(-1.5, 1.5)
                        )

                    _planet["x"] = max(
                        40, min(self.game_view.width - 84, _planet["x"])
                    )
                    _planet["y"] = max(
                        40, min(self.game_view.height - 84, _planet["y"])
                    )

                _first_planet = _chase_planets[0]
                self.game_logic.sprite_x = _first_planet["x"]
                self.game_logic.sprite_y = _first_planet["y"]
            else:
                # Совместимость с прежним одиночным режимом.
                _center_x = self.game_logic.sprite_x + 22
                _center_y = self.game_logic.sprite_y + 22
                _dx = _center_x - mouse_tex_x
                _dy = _center_y - mouse_tex_y
                _dist = math.hypot(_dx, _dy)

                if 0 < _dist < 110:
                    self.game_logic.sprite_x += (
                        (_dx / _dist) * self.game_logic.sprite_speed
                        + random.uniform(-1.5, 1.5)
                    )
                    self.game_logic.sprite_y += (
                        (_dy / _dist) * self.game_logic.sprite_speed
                        + random.uniform(-1.5, 1.5)
                    )

                    self.game_logic.sprite_x = max(
                        40, min(self.game_view.width - 84, self.game_logic.sprite_x)
                    )
                    self.game_logic.sprite_y = max(
                        40, min(self.game_view.height - 84, self.game_logic.sprite_y)
                    )

        if self.game_logic.fade_screen_active:
            current_ms = int(time.monotonic() * 1000)
            if current_ms - self.game_logic.fade_start_time >= self.game_logic.fade_duration:
                self.game_logic.fade_screen_active = False
                self.game_logic.chase_planet_active = False
                self.game_logic.clicks_in_cycle = 0
                self.game_logic.set_notification(TRANSLATIONS[self.current_lang]["hint"], duration=5000)
                self.game_logic.notification_color = (255, 255, 255)

        # If the second main-button press also started an exclusive legacy
        # event, defer the secret prompt until that event releases its gameplay lock.
        if (
            not self.secret_input_open
            and self.secret_prompt_session.prompt_pending
            and not self.game_logic.roach_attack_active
            and not self.game_logic.minigame_active
            and not self.game_logic.timer_active
            and not self.game_logic.sprite_active
            and not self.game_logic.chase_planet_active
            and not self.game_logic.fade_screen_active
            and not self.game_logic.code_window_open
            and not self.game_logic.lore_window_open
        ):
            self._open_secret_input()

        # Subtitle system update
        self._update_subtitles()

