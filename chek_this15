    def _draw_game_to_texture(self):
        w, h = self.screen_texture.size
        surf = pygame.Surface((w, h))
        if self.evt004_result_state is not None:
            self._draw_evt004_result_screen(surf)
            self.menu_cursor.set_hover_state(False)
            self.menu_cursor.draw(surf)
            self.screen_texture.write(
                pygame.image.tobytes(surf, "RGBA", True)
            )
            return
        if self.evt003_state in ("RUNNING", "GAME_OVER"):
            if self.evt003_state == "RUNNING":
                elapsed = max(0.0, time.monotonic() - self.evt003_started_at)
                duration = float(self.evt003_runtime.duration_seconds)
                remaining_seconds = max(0, int(math.ceil(duration - elapsed)))
                message = "PLEASE DON'T TOUCH ANYTHING"
                self.evt003_presentation.draw_check(
                    surf, message[:self.evt003_typewriter_count], elapsed,
                    wallpaper_index=self.game_logic.wallpaper_index,
                    remaining_seconds=remaining_seconds,
                    duration_seconds=duration,
                )
            else:
                progress = (time.monotonic() - self.evt003_gameover_started_at) / 2.35
                self.evt003_presentation.draw_game_over(
                    surf, progress, wallpaper_index=self.game_logic.wallpaper_index,
                )
            # The system cursor is normally composed by the gameplay renderer.
            # This exclusive event render path must compose it explicitly as well.
            self.menu_cursor.set_hover_state(False)
            self.menu_cursor.draw(surf)
            self.screen_texture.write(pygame.image.tobytes(surf, "RGBA", True))
            return
        glitch_intensity = self.game_logic.get_glitch_intensity()
        center_text = self.game_logic.get_center_text(self.current_lang)
        self.game_view._evt004_capture_background = bool(
            self.evt004_runtime is not None
            and self.evt004_runtime.running
        )
        self.game_view.draw(
            surf, 
            self.game_logic, 
            self.current_lang,
            self.game_seconds_left, 
            center_text, 
            self.game_blink_visible,
            glitch_intensity, 
            self.typed_phrase, 
            self.game_logic.total_clicks,
            self.game_logic.wallpaper_index, 
            self.easter_egg_phrase, 
            effects_enabled=self.effects_enabled,
            debug_mode=self.debug_mode
        )

        # EVT_004 overlay: draw dragon and damaged targets over the game scene
        self._draw_evt004(surf)

        if self.game_logic.word_shock_active:
            if self.admin_panel_open:
                self._draw_admin_panel(surf)
            self.screen_texture.write(pygame.image.tobytes(surf, "RGBA", True))
            return

        self._draw_event_collection_icon(surf)
        self._draw_secret_input(surf)

        clicks = self.game_logic.total_clicks
        phase_name = self._get_phase_name(clicks)
        info_text = f"{phase_name} | CLICKS: {clicks}"
        info_surf = text_cache.get_surface(self.game_view.apply_glitch(info_text, glitch_intensity), "Courier New", 16, (0, 255, 0), bold=True)
        surf.blit(info_surf, (w - info_surf.get_width() - 10, h - info_surf.get_height() - 10))

        if self.notification_text and pygame.time.get_ticks() < self.notification_timer:
            notif_surf = text_cache.get_surface(self.notification_text, "Courier New", 16, (255, 255, 0), bold=True)
            surf.blit(notif_surf, (w - notif_surf.get_width() - 10, h - notif_surf.get_height() - 40))
        elif self.notification_text:
            self.notification_text = ""

        # Draw subtitles
        self._draw_subtitles(surf, self.font_subtitle)

        # Debug overlay (restored - toggle with backtick key)
        if self.debug_mode:
            # Secret code
            code_str = f"SECRET CODE: {self.game_logic.secret_code}"
            code_surf = text_cache.get_surface(code_str, "Courier New", 16, (0, 255, 0), bold=True)
            surf.blit(code_surf, (10, 10))
            # FPS
            fps = int(self.clock.get_fps())
            fps_text = f"FPS: {fps}"
            fps_surf = text_cache.get_surface(fps_text, "Courier New", 16, (0, 255, 0), bold=True)
            surf.blit(fps_surf, (10, 30))
            # Frame time
            dt = self.clock.get_time()
            dt_text = f"Frame: {dt} ms"
            dt_surf = text_cache.get_surface(dt_text, "Courier New", 16, (0, 255, 0), bold=True)
            surf.blit(dt_surf, (10, 50))
            # CPU usage (if psutil available)
            if PSUTIL_AVAILABLE:
                cpu_percent = psutil.cpu_percent(interval=0.0)
                cpu_text = f"CPU: {cpu_percent}%"
                cpu_surf = text_cache.get_surface(cpu_text, "Courier New", 16, (0, 255, 0), bold=True)
                surf.blit(cpu_surf, (10, 70))
                # Memory usage
                mem = psutil.virtual_memory()
                mem_text = f"RAM: {mem.percent}% ({mem.used//1024//1024} MB / {mem.total//1024//1024} MB)"
                mem_surf = text_cache.get_surface(mem_text, "Courier New", 16, (0, 255, 0), bold=True)
                surf.blit(mem_surf, (10, 90))

            text_cache.remove_by_text_prefix("FPS:")
            text_cache.remove_by_text_prefix("Frame: ")
            text_cache.remove_by_text_prefix("CPU:")
            text_cache.remove_by_text_prefix("RAM:")
            text_cache.remove_by_text_prefix("SECRET CODE:")

        self._draw_admin_panel(surf)
        if self.event_collection_open and self.evt003_state is None:
            self._draw_event_collection_window(surf)
        if self.evt003_state in ("FORGIVENESS_DIALOG", "PENDING_NOTICE"):
            payload = self.evt003_dialog_payload or {}
            self.evt003_ok_rect = self.evt003_presentation.draw_dialog(
                surf,
                payload.get("text", "Нарушение зафиксировано."),
                title=payload.get("title", "СИСТЕМНОЕ УВЕДОМЛЕНИЕ"),
            )
        self.menu_cursor.draw(surf)
        self.screen_texture.write(pygame.image.tobytes(surf, 'RGBA', True))

