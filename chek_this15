    def run(self):
        while self.running:
            # Cursor animations must advance in every scene, not only the menu.
            self.menu_cursor.update()
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    self.running = False
                    pygame.quit()
                    sys.exit()
                if (
                    self.current_screen == "game"
                    and self.evt004_result_state is not None
                ):
                    self._handle_evt004_result_event(event)
                    continue
                if self.current_screen == "game" and self.evt003_state is not None:
                    self._handle_evt003_event(event)
                    continue
                if self.current_screen == "game" and self.game_logic.word_shock_active:
                    if event.type == pygame.KEYDOWN and event.key == pygame.K_F2:
                        self.admin_panel_open = not self.admin_panel_open
                        continue
                    if self.admin_panel_open:
                        if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                            self.admin_panel_open = False
                        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                            self._handle_admin_panel_event(event)
                        elif event.type == pygame.VIDEORESIZE:
                            self._handle_game_events(event)
                        continue
                    self._handle_game_events(event)
                    continue
                if event.type == pygame.KEYDOWN and event.key == pygame.K_F2:
                    panel_available = (
                        self.current_screen == "menu"
                        or (
                            self.current_screen == "game"
                            and not self.channel_switch_active
                            and (self.intro_slides_active or self.name_entry_active or self.crash_stage == 0)
                        )
                    )
                    if panel_available:
                        self.admin_panel_open = not self.admin_panel_open
                    continue
                if self.admin_panel_open:
                    if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                        self.admin_panel_open = False
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        self._handle_admin_panel_event(event)
                    continue
                if self.current_screen == "game" and self.channel_switch_active:
                    continue
                if self.current_screen == "menu":
                    self._handle_menu_events(event)
                elif self.current_screen == "game":
                    if self.intro_slides_active:
                        self._handle_intro_slide_events(event)
                    elif self.name_entry_active:
                        self._handle_name_entry_events(event)
                    elif self.crash_stage == 0:
                        self._handle_game_events(event)
                elif self.current_screen == "intro":
