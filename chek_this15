    def _update_evt004_result_screen(self):
        """Advance the result title one character at a time."""
        if self.evt004_result_state is None:
            return

        if self.evt004_result_revealed:
            return

        now = time.monotonic()
        newly_revealed = self.evt004_result_typewriter.advance(now)

        self.evt004_result_typewriter_count = min(
            len(self.evt004_result_text),
            max(
                0,
                int(self.evt004_result_typewriter.visible_count),
            ),
        )

        for _ in range(newly_revealed):
            self.audio_box.play_typewriter_tick()

        if self.evt004_result_typewriter_count >= len(
            self.evt004_result_text
        ):
            self.evt004_result_revealed = True

