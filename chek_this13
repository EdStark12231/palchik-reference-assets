    def _handle_admin_panel_event(self, event):
        if not self.admin_panel_open or event.type != pygame.MOUSEBUTTONDOWN or event.button != 1:
            return False
        screen_w, screen_h = self.screen.get_size()
        tex_w, tex_h = self.screen_texture.size
        pos = (int(event.pos[0] * tex_w / max(1, screen_w)),
               int(event.pos[1] * tex_h / max(1, screen_h)))
        if self.admin_panel_rect and not self.admin_panel_rect.collidepoint(pos):
            return True

        for tab_id, rect in self.admin_tab_rects.items():
            if rect.collidepoint(pos):
                self.admin_panel_tab = tab_id
                return True

        for action, rect in self.admin_button_rects.items():
            if not rect.collidepoint(pos):
                continue
            if action == "close":
                self.admin_panel_open = False
            elif action == "new_game":
                self._admin_start_new_game()
            elif action == "menu":
                if self.game_logic.word_shock_active or self.event_lifecycle.is_tracked("EVT_002_WORD_SHOCK"):
                    self._cancel_managed_word_shock(reason="RETURN_TO_MENU")
                if self.game_logic.roach_attack_active or self.event_lifecycle.is_tracked("EVT_001_ROACH_ATTACK"):
                    self._cancel_managed_roach_attack(reason="RETURN_TO_MENU")
                else:
                    self._stop_roach_audio()
                self.admin_panel_open = False
                self.intro_slides_active = False
                self.name_entry_active = False
                self.name_input_scene = None
                self.current_screen = "menu"
                self.audio_box.stop_music()
                self.audio_box.play_menu_music()
            elif action.startswith("phase_") or action == "final":
                if not self._admin_phase_controls_available():
                    return True
                phase_clicks = {
                    "phase_0": 0, "phase_1": 1500, "phase_2": 2000,
                    "phase_3": 2500, "phase_4": 2800, "final": 3000,
                }
                self._admin_set_phase(phase_clicks[action])
            elif action.startswith("minigame_"):
                if not self._admin_phase_controls_available():
                    return True
                game_id = action[len("minigame_"):]
                if game_id == "reset":
                    self._admin_reset_minigame()
                else:
                    self._admin_launch_minigame(game_id)
            elif action == "event_trigger_EVT_001_ROACH_ATTACK":
                self._admin_trigger_event("EVT_001_ROACH_ATTACK")
            elif action == "event_stop_EVT_001_ROACH_ATTACK":
                self._admin_stop_event("EVT_001_ROACH_ATTACK")
            elif action == "event_reset_EVT_001_ROACH_ATTACK":
                self._admin_reset_event("EVT_001_ROACH_ATTACK")
            elif action == "event_inspect_EVT_001_ROACH_ATTACK":
                self._admin_inspect_event("EVT_001_ROACH_ATTACK")
            elif action == "event_trigger_EVT_002_WORD_SHOCK":
                self._admin_trigger_event("EVT_002_WORD_SHOCK")
            elif action == "event_stop_EVT_002_WORD_SHOCK":
                self._admin_stop_event("EVT_002_WORD_SHOCK")
            elif action == "event_trigger_EVT_003_PLEASE_DONT_TOUCH":
                if self._admin_trigger_evt003():
                    self.admin_panel_open = False
                    self._show_notification("EVT_003: REAL TRIGGER", duration=1800)
            elif action.startswith("event_test_EVT_003_PLEASE_DONT_TOUCH_"):
                phase_id = action[len("event_test_EVT_003_PLEASE_DONT_TOUCH_"):]
                if self._admin_test_evt003(phase_id):
                    self.admin_panel_open = False
                    self._show_notification(f"EVT_003 SANDBOX: {phase_id}", duration=1800)
            elif action == "event_reset_sandbox_EVT_003_PLEASE_DONT_TOUCH":
                if self.evt003_state is None:
                    self.evt003_runtime.reset_sandbox_history()
                    self._show_notification("EVT_003 sandbox history reset.", duration=1800)
            elif action == "logs_open_file":
                self._open_admin_log_file()
            elif action == "debug":
                self.debug_mode = not self.debug_mode
            elif action == "effects":
                self.effects_enabled = not self.effects_enabled
            elif action == "profiler":
                self.profiler.start(duration=10.0, scenario="admin_panel")
                self._show_notification("Профилирование запущено (10 сек)", duration=1500)
            elif action == "secret_force_open":
                self._open_secret_input(force=True)
                self.admin_panel_open = False
                self._show_notification("ТЕСТ: ПОЛЕ СЕКРЕТНОГО ВВОДА", duration=1500)
            elif action == "secret_test_success":
                self._open_secret_input(force=True)
                self.admin_panel_open = False
                self._submit_secret_input(SECRET_ACCESS_CODE)
            elif action == "secret_test_failure":
                self._open_secret_input(force=True)
                self.admin_panel_open = False
                self._submit_secret_input("000000")
            elif action == "secret_clear_input":
                self.secret_input_open = False
                self.secret_input_closing = False
                self.secret_input_value = ""
                self.secret_prompt_session.retry_after_cancel()
                self._show_notification("ПОЛЕ СЕКРЕТНОГО ВВОДА СБРОШЕНО", duration=1500)
            elif action == "secret_reset_collection":
                try:
                    SaveManager.save_event_collection_state(unlocked=False)
                except Exception:
                    self.app_logger.exception("Не удалось сбросить коллекцию событий")
                    self._show_notification("ОШИБКА СБРОСА КОЛЛЕКЦИИ", duration=1800)
                else:
                    self.event_collection_unlocked = False
                    self.event_collection_open = False
                    self.event_collection_closing = False
                    self.secret_input_open = False
                    self.secret_input_closing = False
                    self.secret_input_value = ""
                    self.secret_prompt_session.begin_session()
                    self._show_notification("ДОСТУП К КОЛЛЕКЦИИ СБРОШЕН", duration=1800)
            return True
        return True

    def _exit_game(self):
        self.audio_box.play_click()
        self.running = False
        pygame.quit()
        sys.exit()

    def _on_game_ui_update(self, seconds_left=None, lucky=False):
        if seconds_left is not None:
            self.game_seconds_left = seconds_left
        if lucky:
            self.game_view.trigger_target_animation()
            self.audio_box.play_lucky()

    def _on_limit_reached(self):
        lang_code = self.current_lang if self.current_lang in TRANSLATIONS else "RU"
        tc = self.game_logic.total_clicks
        phase_idx = self.game_logic.get_phase_index()
        if phase_idx >= 5 and not self.final_phase_triggered:
            self.final_phase_triggered = True
            self.game_logic.timer_active = True
            phrase = TRANSLATIONS[lang_code]["horror_phrases"][12]
            self.game_view.set_phrase(phrase, 0.0, tc, is_horror=True, saved_meme=self.game_current_phrase)
            self.game_current_phrase = phrase
            return
        if self.game_logic.horror_cooldown:
            return
        pool_range, glitch, only_horror = self.game_logic.get_phrase_pool_and_glitch()
        if only_horror:
            if phase_idx >= 4:
                phrase = "".join(random.choice("01#&%?") for _ in range(random.randint(20,40)))
                self.game_view.set_phrase(phrase, 1.0, tc, is_horror=True, saved_meme=self.game_current_phrase)
                self.game_current_phrase = phrase
            else:
                phrases = TRANSLATIONS[lang_code]["horror_phrases"]
                idx = random.choice(list(pool_range)) if pool_range else 0
                phrase = phrases[idx]
                self.game_view.set_phrase(phrase, glitch, tc, is_horror=True, saved_meme=self.game_current_phrase)
                self.game_current_phrase = phrase
        else:
            use_horror = random.random() < (0.2 if phase_idx >= 1 else 0)
            if use_horror and not self.game_logic.horror_cooldown:
                phrases = TRANSLATIONS[lang_code]["horror_phrases"]
                max_idx = min(len(phrases)-1, max(pool_range) if pool_range else 0)
                idx = random.randint(0, max_idx) if max_idx>=0 else 0
                phrase = phrases[idx]
                self.game_view.set_phrase(phrase, glitch, tc, is_horror=True, saved_meme=self.game_current_phrase)
                self.game_current_phrase = phrase
            else:
                self._set_meme_phrase()

    def _on_clean_finished(self):
        self.game_seconds_left = 30

    def _update_menu(self):
        current_time = pygame.time.get_ticks()
        self.current_lang = self.settings_box.current_lang
        if current_time - self.menu_start_time > self.start_delay:
            if self.hint_alpha < 255.0:
                self.hint_alpha += 5.1
                if self.hint_alpha > 255.0:
                    self.hint_alpha = 255.0
                    self.hint_visible = True
            if self.hint_alpha == 255.0 and current_time - self.last_blink_time > self.blink_interval:
                self.hint_visible = not self.hint_visible
                self.last_blink_time = current_time
        else:
            self.hint_alpha = 0.0
            self.hint_visible = False
        if self.game_logic.get_phase_index() >= 3:
            self.menu_jitter_offset = random.randint(-2, 2)
        else:
            self.menu_jitter_offset = 0

    def _commit_player_name(self, name):
        name = (name or "").strip()
        if not name:
            return
        self.player_name = name
        self.game_logic.player_name = name
        self.game_logic.name_verified = self.game_logic.verify_player_name(name)
        self.game_logic.system_os_user = self.name_input_scene.system_os_user
        self.game_logic.is_authentic = (name.lower() == self.name_input_scene.system_os_user.lower())
        SaveManager.save_game_data(
            self.game_logic.score,
            self.current_lang,
            self.game_logic.total_clicks,
            self.game_logic.wallpaper_index,
            name,
            self.name_input_scene.system_os_user
        )
        self.name_entry_active = False
        self.name_input_scene = None
        self._begin_intro_slides()

    def _handle_name_entry_events(self, event):
        if not self.name_input_scene:
            return
        if event.type == pygame.KEYDOWN:
            result = self.name_input_scene.handle_keyboard(event)
            if result == "QUIT":
                self.name_entry_active = False
                self.name_input_scene = None
                self.current_screen = "menu"
                self.audio_box.play_menu_music()
            elif result == "DONE":
                self._commit_player_name(self.name_input_scene.buffer)
        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            self.menu_cursor.trigger_click_animation()
            w, h = self.screen.get_size()
            mouse_pos = event.pos
            tex_w, tex_h = self.screen_texture.size
            pos_x = int(mouse_pos[0] * (tex_w / w))
            pos_y = int(mouse_pos[1] * (tex_h / h))
            result = self.name_input_scene.handle_mouse((pos_x, pos_y))
            if result == "QUIT":
                self.name_entry_active = False
                self.name_input_scene = None
                self.current_screen = "menu"
                self.audio_box.play_menu_music()
            elif result == "DONE":
                self._commit_player_name(self.name_input_scene.buffer)
        elif event.type == pygame.MOUSEMOTION:
            w, h = self.screen.get_size()
            mouse_pos = event.pos
            tex_w, tex_h = self.screen_texture.size
            pos_x = int(mouse_pos[0] * (tex_w / w))
            pos_y = int(mouse_pos[1] * (tex_h / h))
            self.name_input_scene.get_hover((pos_x, pos_y))

    def _handle_game_events(self, event):
        if (self.evt004_runtime is not None and self.evt004_runtime.running
                and event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE):
            self._finish_evt004(cancelled=True, reason="PLAYER_CANCELLED")
            return
        if self.game_logic.word_shock_active and event.type != pygame.VIDEORESIZE:
            self._handle_word_shock_input(event)
            return
        if self.secret_input_open and event.type != pygame.VIDEORESIZE:
            if event.type == pygame.KEYDOWN:
                self._handle_secret_input_key(event)
            elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                screen_w, screen_h = self.screen.get_size()
                tex_w, tex_h = self.screen_texture.size
                mouse_pos = (
                    int(event.pos[0] * tex_w / max(1, screen_w)),
                    int(event.pos[1] * tex_h / max(1, screen_h)),
                )
                close_rect = getattr(self, "secret_input_close_rect", None)
                cancel_rect = getattr(self, "secret_input_cancel_rect", None)
                ok_rect = getattr(self, "secret_input_ok_rect", None)
                if close_rect and close_rect.collidepoint(mouse_pos):
                    self._cancel_secret_input()
                elif cancel_rect and cancel_rect.collidepoint(mouse_pos):
                    self._cancel_secret_input()
                elif ok_rect and ok_rect.collidepoint(mouse_pos):
                    self._confirm_secret_input()
            return
        if self.event_collection_open and event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                self._close_event_collection()
            return
        if event.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode((event.w, event.h), pygame.FULLSCREEN | pygame.DOUBLEBUF | pygame.OPENGL)
            self._setup_menu_hitboxes()
            self.game_view.width, self.game_view.height = event.w, event.h
            self.game_view.recalculate_layout()
        elif event.type == pygame.MOUSEBUTTONUP and event.button == 1:
            self.game_logic.timer_scale = 1.0
            self.game_view.lore_window_dragging = False
            self.game_view.lore_scroll_dragging = False
        elif event.type == pygame.MOUSEWHEEL and getattr(self.game_logic, "lore_window_open", False):
            if not getattr(self.game_logic, "lore_text_viewer_open", False) and not getattr(self.game_logic, "lore_image_viewer_open", False):
                screen_w, screen_h = self.screen.get_size()
                tex_w, tex_h = self.screen_texture.size
                mouse_pos = pygame.mouse.get_pos()
                pos = (int(mouse_pos[0] * (tex_w / screen_w)), int(mouse_pos[1] * (tex_h / screen_h)))
                if self.game_view.handle_lore_wheel(self.game_logic, pos, event.y):
                    return
        elif event.type == pygame.MOUSEMOTION:
            if self.game_view.lore_window_dragging:
                tex_w, tex_h = self.screen_texture.size
                screen_w, screen_h = self.screen.get_size()
                mouse_tex_x = int(event.pos[0] * (tex_w / screen_w))
                mouse_tex_y = int(event.pos[1] * (tex_h / screen_h))
                
                win_w = int(tex_w * 0.65)
                win_h = int(tex_h * 0.55)
                base_x = (tex_w - win_w) // 2
                base_y = (tex_h - win_h) // 2
                
                new_x = mouse_tex_x - self.game_view.lore_drag_start_x
                new_y = mouse_tex_y - self.game_view.lore_drag_start_y
                self.game_view.lore_window_offset_x = new_x - base_x
                self.game_view.lore_window_offset_y = new_y - base_y
                
                self.game_view.lore_window_offset_x = max(-base_x, min(tex_w - win_w - base_x, self.game_view.lore_window_offset_x))
                self.game_view.lore_window_offset_y = max(-base_y, min(tex_h - win_h - base_y, self.game_view.lore_window_offset_y))
            elif getattr(self.game_logic, "lore_window_open", False):
                tex_w, tex_h = self.screen_texture.size
                screen_w, screen_h = self.screen.get_size()
                pos = (int(event.pos[0] * (tex_w / screen_w)), int(event.pos[1] * (tex_h / screen_h)))
                self.game_view.handle_lore_motion(self.game_logic, pos)
            
        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            self.menu_cursor.trigger_click_animation()
            win_w, win_h = self.screen.get_size()
            tex_w, tex_h = self.screen_texture.size
            pos_x = int(event.pos[0] * (tex_w / win_w))
            pos_y = int(event.pos[1] * (tex_h / win_h))
            pos = (pos_x, pos_y)

            # EVT_004 exclusively owns left-click input while the encounter is active.
            if self._handle_evt004_click(pos):
                return

            if self.event_collection_open:
                if self.event_collection_closing:
                    return
                if (self.event_collection_close_rect and self.event_collection_close_rect.collidepoint(pos)):
                    self._close_event_collection()
                elif self.event_collection_window_rect and not self.event_collection_window_rect.collidepoint(pos):
                    self._close_event_collection()
                return
            if self.event_collection_icon_rect and self.event_collection_icon_rect.collidepoint(pos):
                self._open_event_collection()
                return

            hx = getattr(self.game_logic, "hidden_hitbox_x", 0)
            hy = getattr(self.game_logic, "hidden_hitbox_y", 0)
            hidden_rect = pygame.Rect(hx - 15, hy - 15, 30, 30)
            if hidden_rect.collidepoint(pos) and not getattr(self.game_logic, "code_window_open", False):
                self.game_logic.code_window_open = True
                self.game_logic.input_buffer = [None, None, None]
                self.game_logic.current_cell_index = 0
                self.game_logic.current_cell_buffer = ""
                self.game_logic.system_response_text = ""
                self.game_view.code_window_dirty = True
                return
            if getattr(self.game_logic, "code_window_open", False):
                close_rect = getattr(self.game_view, "code_close_rect", None)
                if close_rect and close_rect.collidepoint(pos):
                    self._cancel_archive_pin()
                    return
                cancel_rect = getattr(self.game_view, "code_cancel_btn_rect", None)
                if cancel_rect and cancel_rect.collidepoint(pos):
                    self._cancel_archive_pin()
                    return
                if self.code_init_active:
                    return
                ok_rect = getattr(self.game_view, "ok_btn_rect", None)
                if ok_rect and ok_rect.collidepoint(pos):
                    self._submit_archive_pin()
                    return
                for index, field_rect in enumerate(getattr(self.game_view, "code_input_rects", [])):
                    if field_rect.collidepoint(pos):
                        self.game_logic.current_cell_index = index
                        self.game_logic.current_cell_buffer = ""
                        self.game_logic.input_buffer[index] = None
                        self.game_view.code_window_dirty = True
                        return
                return
            if getattr(self.game_logic, "lore_window_open", False):
                if hasattr(self.game_view, 'handle_lore_viewer_click'):
                    if self.game_view.handle_lore_viewer_click(self.game_logic, pos):
                        return
                
                lore_rect = getattr(self.game_view, 'lore_win_rect', None)
                if not lore_rect:
                    return
                
                close_rect = getattr(self.game_view, 'lore_close_rect', None)
                if close_rect and close_rect.collidepoint(pos):
                    self.game_view.handle_lore_click(self.game_logic, pos)
                    return

                if hasattr(self.game_view, "handle_lore_menu_click"):
                    if self.game_view.handle_lore_menu_click(self.game_logic, pos):
                        return

                header_rect = pygame.Rect(lore_rect.x, lore_rect.y, lore_rect.width, 24)
                if header_rect.collidepoint(pos):
                    if not (close_rect and close_rect.collidepoint(pos)):
                        self.game_view.lore_window_dragging = True
                        self.game_view.lore_drag_start_x = pos[0] - lore_rect.x
                        self.game_view.lore_drag_start_y = pos[1] - lore_rect.y
                    return
                
                if hasattr(self.game_view, 'handle_lore_click'):
                    self.game_view.handle_lore_click(self.game_logic, pos)
                return
            
            if getattr(self.game_logic, "lore_icon_visible", False):
                if hasattr(self.game_view, 'rect_lore_icon') and self.game_view.rect_lore_icon:
                    if self.game_view.rect_lore_icon.collidepoint(pos):
                        self.game_logic.lore_window_open = not self.game_logic.lore_window_open
                        return
            
            if self.game_view.rect_back.collidepoint(pos):
                if self.game_logic.roach_attack_active or self.event_lifecycle.is_tracked("EVT_001_ROACH_ATTACK"):
                    self._cancel_managed_roach_attack(reason="BACK_TO_MENU")
                else:
                    self._stop_roach_audio()
                self.current_screen = "menu"
                self.audio_box.play_menu_music()
                return
            elif self.game_view.rect_wallpaper.collidepoint(pos):
                next_index = self.game_logic.wallpaper_index + 1
                self.game_logic.set_wallpaper(next_index)
                return
            elif hasattr(self, 'subtitle_rect') and self.subtitle_rect and self.subtitle_rect.collidepoint(pos):
                if self.subtitle_state == "waiting_click":
                    # По упрощённой механике субтитр исчезает мгновенно по клику
                    self.subtitle_state = "idle"
                    self.subtitle_state_timer = 0.0
                    self.subtitle_next_idle_timer = 0.0
                    self.subtitle_alpha = 0
                return

            if self.game_logic.minigame_active:
                for idx, rect in enumerate(self.game_view.rect_sectors):
                    if rect.collidepoint(pos):
                        self.game_logic.verify_sector_click(idx)
                        return
                return
            if (
                self.game_logic.roach_attack_active
                and not self.game_logic.timer_active
                and not self.game_logic.sprite_active
                and not self.game_logic.chase_planet_active
                and not self.game_logic.fade_screen_active
                and self.game_logic.clicks_in_cycle < 10
            ):
                for hitbox_slot, roach_rect in enumerate(self.game_view.roach_hitboxes):
                    if roach_rect.collidepoint(pos):
                        roach_index = self.game_view.roach_hitbox_indices[hitbox_slot]
                        roach_center = roach_rect.center
                        reward = self.game_logic.squash_roach(roach_index)
                        if reward:
                            self.game_view.trigger_roach_squash(roach_center)
                            self.audio_box.play_roach_attack("squash")
                            self._sync_managed_roach_attack()
                        return

            if self.game_logic.clicks_in_cycle < 10 and not self.game_logic.timer_active and not self.game_logic.fade_screen_active:
                if self.game_view.rect_target.collidepoint(pos):
                    # Отдельный короткий звук взаимодействия с игровым объектом.
                    self.audio_box.play_game_click()
                    if self.game_logic.clicks_in_cycle == 0 and not self.secret_input_open:
                        self.secret_prompt_session.begin_click_cycle()
                    result = self.game_logic.register_click()
                    prompt_due = self.secret_prompt_session.register_accepted_click(
                        result not in ("IGNORE", "JAMMED", "TRAP_TRIGGERED")
                    )
                    if result in ("NORMAL", "GHOST_BOOST", "RESISTANCE"):
                        sequence_result = self.game_logic.record_roach_sequence_click()
                        if sequence_result == "WORD_SHOCK_TRIGGER":
                            self._start_word_shock()
                            return
                        if sequence_result == "ROACH_TRIGGER":
                            self._start_roach_attack()
                            return
                    if (
                        prompt_due
                        and not self.secret_input_open
                        and not self.game_logic.roach_attack_active
                        and not self.game_logic.minigame_active
                        and not self.game_logic.timer_active
                        and not self.game_logic.sprite_active
                        and not self.game_logic.chase_planet_active
                        and not self.game_logic.fade_screen_active
                        and not self.game_logic.code_window_open
                        and not self.game_logic.lore_window_open
                    ):
                        self._open_secret_input()
                    if result in ["NORMAL", "LUCKY"]:
                        self.game_view.trigger_target_animation()
                        if result == "LUCKY":
                            self.game_view.trigger_label_animation()
                    return
                else:
                    now = pygame.time.get_ticks()
                    if now - getattr(self.game_logic, 'click_phrase_cooldown', 0) > 1500:
                        phase = self.game_logic.get_phase()
                        phrase = self.game_logic.get_click_phrase(phase)
                        if phrase:
                            self.game_logic.current_click_phrase = phrase
                            self.game_logic.click_phrase_timer = now + 2000
                            self.game_logic.click_phrase_cooldown = now
                            self.game_logic.click_phrase_alpha = 0
                            self.game_logic.click_phrase_scale = 0.0
                            self.game_logic.click_phrase_y_offset = 0
                            self.game_logic.click_phrase_pos = list(pos)
            else:
                if self.game_logic.fade_screen_active:
                    return

                # Проверяем попадание по любой активной планете.
                _chase_planet_target_index = None
                _chase_planets = getattr(self.game_logic, "chase_planets", [])

                if self.game_logic.sprite_active:
                    if _chase_planets:
                        for _planet_index, _planet in enumerate(_chase_planets):
                            _planet_rect = pygame.Rect(
                                int(_planet["x"]), int(_planet["y"]), 44, 44
                            )
                            if _planet_rect.collidepoint(pos):
                                _chase_planet_target_index = _planet_index
                                break
                    else:
                        _legacy_rect = pygame.Rect(
                            int(self.game_logic.sprite_x),
                            int(self.game_logic.sprite_y),
                            44, 44,
                        )
                        if _legacy_rect.collidepoint(pos):
                            _chase_planet_target_index = -1

                if (
                    (self.game_logic.timer_active or self.game_logic.sprite_active)
                    and _chase_planet_target_index is None
                ):
                    self.audio_box.play_chase_planet("click")

                if self.game_logic.sprite_active:
                    if _chase_planet_target_index is not None:
                        self.audio_box.play_chase_planet("catch")

                        self.game_logic.chase_planets_caught_round += 1
                        self.game_logic.chase_planets_caught_total += 1
                        self.game_logic.score += 10

                        if _chase_planet_target_index == -1:
                            self.game_logic.chase_planets.clear()
                        else:
                            self.game_logic.chase_planets.pop(
                                _chase_planet_target_index
                            )

                        if self.game_logic.chase_planets:
                            _first_planet = self.game_logic.chase_planets[0]
                            self.game_logic.sprite_x = _first_planet["x"]
                            self.game_logic.sprite_y = _first_planet["y"]
                            self.game_logic.sprite_active = True
                            self.game_logic.chase_planet_active = True
                            return

                        # Раунд завершается после поимки последней планеты.
                        self.game_logic.sprite_active = False
                        self.game_logic.timer_active = False
                        self.game_logic.timer_clicks = 0
                        self.game_logic.chase_planet_active = True

                        self.audio_box.play_chase_planet("victory", queue=True)

                        phase_key = self.game_logic.get_phase()
                        earth_data = TRANSLATIONS[self.current_lang]["earth_phases"]
                        if phase_key not in earth_data:
                            phase_key = "phase_4"

                        win_pool = earth_data[phase_key]["win"]
                        self.game_logic.set_notification(
                            random.choice(win_pool), duration=5000
                        )
                        self.game_logic.notification_color = (46, 204, 113)
                        self.game_logic.fade_screen_active = True
                        self.game_logic.fade_start_time = int(time.monotonic() * 1000)
                        return
                    else:
                        now = pygame.time.get_ticks()
                        if now - getattr(self.game_logic, 'click_phrase_cooldown', 0) > 1500:
                            phase = self.game_logic.get_phase()
                            phrase = self.game_logic.get_click_phrase(phase)
                            if phrase:
                                self.game_logic.current_click_phrase = phrase
                                self.game_logic.click_phrase_timer = now + 2000
                                self.game_logic.click_phrase_cooldown = now
                                self.game_logic.click_phrase_alpha = 0
                                self.game_logic.click_phrase_scale = 0.0
                                self.game_logic.click_phrase_y_offset = 0
                                self.game_logic.click_phrase_pos = list(pos)
                        return

                click_phrase_shown = False

                if self.game_logic.timer_active:
                    pbar_center_x = tex_w // 2
                    pbar_center_y = int(tex_h * 0.48)

                    click_rect = pygame.Rect(pbar_center_x - 200, pbar_center_y - 22, 400, 44)
                    
                    if click_rect.collidepoint(pos) and not self.game_logic.sprite_active:
                        self.game_logic.timer_clicks += 1
                        self.game_logic.timer_scale = 0.94
                        spawn_needed = getattr(self.game_logic, "sprite_spawn_clicks", 3)
                        if self.game_logic.timer_clicks >= spawn_needed:
                            self._spawn_chase_planets()
                        return
                    else:
                        click_phrase_shown = True

                else:
                    if self.game_view.rect_instant_wash.collidepoint(pos) and self.game_logic.score >= self.game_logic.upgrade_cost and not self.game_logic.system_jammed:
                        self.game_logic.wash_hands_instantly()
                        return
                    elif self.game_view.rect_free_wash_btn.collidepoint(pos):
                        if self.game_logic.system_jammed:
                            if self.game_logic.try_unjam_system():
                                self._show_notification("SYSTEM RESET")
                        else:
                            self._start_free_clean_flow()
                        return
                    else:
                        click_phrase_shown = True
                
                if click_phrase_shown:
                    now = pygame.time.get_ticks()
                    if now - getattr(self.game_logic, 'click_phrase_cooldown', 0) > 1500:
                        phase = self.game_logic.get_phase()
                        phrase = self.game_logic.get_click_phrase(phase)
                        if phrase:
                            self.game_logic.current_click_phrase = phrase
                            self.game_logic.click_phrase_timer = now + 2000
                            self.game_logic.click_phrase_cooldown = now
                            self.game_logic.click_phrase_alpha = 0
                            self.game_logic.click_phrase_scale = 0.0
                            self.game_logic.click_phrase_y_offset = 0
                            self.game_logic.click_phrase_pos = list(pos)
                    return
        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_BACKQUOTE or (hasattr(event, 'unicode') and event.unicode in ('ё', 'Ё', '`', '~')):
                self.debug_mode = not self.debug_mode
                self._show_notification(f"DEBUG HITBOXES: {'ON' if self.debug_mode else 'OFF'}", duration=1000)
                # Запуск профайлера на 10 секунд
                if self.current_screen == "menu":
                    scenario = "menu"
                elif self.current_screen == "game":
                    if self.game_logic.code_window_open:
                        scenario = "game_code_window"
                    elif self.game_logic.lore_window_open:
                        scenario = "game_lore_window"
                    elif self.settings_box.is_open:
                        scenario = "game_settings"
                    else:
                        scenario = "gameplay"
                else:
                    scenario = "unknown"
                self.profiler.start(duration=10.0, scenario=scenario)
                self._show_notification(f"Профилирование запущено (10 сек)", duration=1500)
            elif event.key == pygame.K_F7:
                self.game_logic.total_clicks = 1500
                self.game_logic._sync_to_disk()
                self.game_logic.horror_cooldown = False
                self.game_view.recalculate_layout()
                msg = f"CHEAT: Phase 1 (1500 clicks)"
                self._show_notification(msg)
                self._on_limit_reached()
            elif event.key == pygame.K_F8:
                self.game_logic.total_clicks = 2500
                self.game_logic._sync_to_disk()
                self.game_logic.horror_cooldown = False
                self.game_view.recalculate_layout()
                msg = f"CHEAT: Phase 2 (2500 clicks)"
                self._show_notification(msg)
                self._on_limit_reached()
            elif event.key == pygame.K_F9:
                self.game_logic.cheat_to_paranoia()
                self.game_logic.horror_cooldown = False
                self.game_view.recalculate_layout()
                new_clicks = self.game_logic.total_clicks
                phase = self._get_phase_name(new_clicks)
                msg = f"CHEAT: jumped to {phase} ({new_clicks} clicks)"
                self._show_notification(msg)
                self._on_limit_reached()
            elif event.key == pygame.K_F10:
                self.game_logic.total_clicks = 2800
                self.game_logic._sync_to_disk()
                self.game_logic.horror_cooldown = False
                self.game_view.recalculate_layout()
                msg = f"CHEAT: Phase 4 (2800 clicks)"
                self._show_notification(msg)
                self._on_limit_reached()
            elif event.key == pygame.K_F11:
                self.game_logic.total_clicks = 3000
                self.game_logic._sync_to_disk()
                self.game_logic.horror_cooldown = False
                self.game_view.recalculate_layout()
                msg = f"CHEAT: Final Phase (3000 clicks)"
                self._show_notification(msg)
                self._on_limit_reached()
            elif event.key == pygame.K_F12:
                self._reset_progress()
            elif event.key == pygame.K_F5:
                self.effects_enabled = not self.effects_enabled
                self._show_notification(f"EFFECTS: {'ON' if self.effects_enabled else 'OFF'}", duration=1500)
            elif event.key == pygame.K_F3:
                if self.current_screen == "menu":
                    scenario = "menu"
                elif self.current_screen == "game":
                    if self.game_logic.code_window_open:
                        scenario = "game_code_window"
                    elif self.game_logic.lore_window_open:
                        scenario = "game_lore_window"
                    elif self.settings_box.is_open:
                        scenario = "game_settings"
                    else:
                        scenario = "gameplay"
                else:
                    scenario = "unknown"
                self.profiler.start(duration=10.0, scenario=scenario)
                self._show_notification(f"Профилирование запущено (10 сек)", duration=1500)
            elif (getattr(self.game_logic, "lore_window_open", False)
                  and not getattr(self.game_logic, "code_window_open", False)
                  and not getattr(self.game_logic, "lore_text_viewer_open", False)
                  and not getattr(self.game_logic, "lore_image_viewer_open", False)
                  and self.game_view.handle_lore_key(self.game_logic, event)):
                return
            elif getattr(self.game_logic, "code_window_open", False):
                logic = self.game_logic
                if event.key == pygame.K_ESCAPE:
                    self._cancel_archive_pin()
                    return
                if self.code_init_active:
                    return
                cache_invalidated = False
                if event.key == pygame.K_BACKSPACE:
                    if logic.current_cell_buffer:
                        logic.current_cell_buffer = logic.current_cell_buffer[:-1]
                        cache_invalidated = True
                    elif logic.current_cell_index > 0:
                        logic.current_cell_index -= 1
                        logic.input_buffer[logic.current_cell_index] = None
                        logic.current_cell_buffer = ""
                        cache_invalidated = True
                elif event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                    self._submit_archive_pin()
                    return
                else:
                    digit = None
                    if pygame.K_0 <= event.key <= pygame.K_9:
                        digit = str(event.key - pygame.K_0)
                    elif pygame.K_KP0 <= event.key <= pygame.K_KP9:
                        digit = str(event.key - pygame.K_KP0)
                    if digit is not None and logic.current_cell_index < 3 and len(logic.current_cell_buffer) < 2:
                        logic.current_cell_buffer += digit
                        cache_invalidated = True
                        if len(logic.current_cell_buffer) == 2:
                            logic.input_buffer[logic.current_cell_index] = int(logic.current_cell_buffer)
                            logic.current_cell_index += 1
                            logic.current_cell_buffer = ""
                if cache_invalidated:
                    self.game_view.code_window_dirty = True

    def _draw_menu_to_texture(self):
        w, h = self.screen.get_size()
        surf = pygame.Surface((w, h))
        if self.settings_box.accessibility_visual:
            surf.fill((38, 50, 56))
        else:
            surf.fill(COLOR_BLACK)

        glitch_intensity = self.game_logic.get_glitch_intensity()
        title_text = "PALCHIK"
        if self.effects_enabled and self.game_logic.get_phase_index() >= 3 and random.random() < 0.03:
            title_text = random.choice(["PALCH1K", "PALCH!K", "PALCH|K", "ERROR"])
        title_surf = text_cache.render_with_font(self.font_title, self.apply_glitch(title_text, glitch_intensity), True, COLOR_WHITE)
        title_rect = title_surf.get_rect(center=(w // 2 + self.menu_jitter_offset, h // 2 - 30 + self.menu_jitter_offset))
        surf.blit(title_surf, title_rect)

        if self.hint_alpha > 0.0:
            hint_str = TRANSLATIONS[self.current_lang]["hint"]
            alpha = int(self.hint_alpha) if (self.hint_visible or self.hint_alpha < 255.0) else 0
            if alpha > 0:
                raw = text_cache.get_surface(self.apply_glitch(hint_str, glitch_intensity), "Courier New", 16, COLOR_DARK_GREY, bold=True)
                tmp = pygame.Surface(raw.get_size(), pygame.SRCALPHA)
                tmp.blit(raw, (0, 0))
                tmp.set_alpha(alpha)
                surf.blit(tmp, tmp.get_rect(center=(w // 2 + self.menu_jitter_offset // 2, h // 2 + 50 + self.menu_jitter_offset // 2)))

        for name, box in self.menu_cursor.hitboxes.items():
            if name == "start":
                continue
            rect = box["rect"]
            if name == "lang":
                label = "🌐"
            elif name == "theme":
                label = "🎨"
            elif name == "settings":
                label = "⚙️"
            elif name == "exit":
                label = "🚪"
            else:
                continue
            if self.effects_enabled and name == "settings" and self.game_logic.get_phase_index() >= 3 and random.random() < 0.02:
                label = random.choice(["⚙️⚠️", "💀", "???"])
            btn_txt = text_cache.get_surface(label, "Segoe UI Symbol", 22, COLOR_GREY, bold=True)
            btn_rect = btn_txt.get_rect(center=(rect.centerx + self.menu_jitter_offset, rect.centery + self.menu_jitter_offset))
            surf.blit(btn_txt, btn_rect)

        self.settings_box.draw(surf, self.font_title, self.font_txt_btn, self.current_lang,
                               int(self.audio_box._volume * 100))
        
        # Debug mode FPS and performance monitoring
        if self.debug_mode:
            fps = int(self.clock.get_fps())
            fps_surf = text_cache.get_surface(f"FPS: {fps}", "Courier New", 16, (0, 255, 0), bold=True)
            surf.blit(fps_surf, (10, 10))
            
            dt = self.clock.get_time()
            dt_text = f"Frame: {dt} ms"
            dt_surf = text_cache.get_surface(dt_text, "Courier New", 16, (0, 255, 0), bold=True)
            surf.blit(dt_surf, (10, 30))
            
            if PSUTIL_AVAILABLE:
                cpu_percent = psutil.cpu_percent(interval=0.0)
                cpu_text = f"CPU: {cpu_percent}%"
                cpu_surf = text_cache.get_surface(cpu_text, "Courier New", 16, (0, 255, 0), bold=True)
                surf.blit(cpu_surf, (10, 50))
                
                mem = psutil.virtual_memory()
                mem_text = f"RAM: {mem.percent}% ({mem.used//1024//1024} MB / {mem.total//1024//1024} MB)"
                mem_surf = text_cache.get_surface(mem_text, "Courier New", 16, (0, 255, 0), bold=True)
                surf.blit(mem_surf, (10, 70))

            text_cache.remove_by_text_prefix("FPS:")
            text_cache.remove_by_text_prefix("Frame: ")
            text_cache.remove_by_text_prefix("CPU:")
            text_cache.remove_by_text_prefix("RAM:")
            text_cache.remove_by_text_prefix("SECRET CODE:")
        
        self._draw_admin_panel(surf)
        self.menu_cursor.draw(surf)
        self.screen_texture.write(pygame.image.tostring(surf, 'RGBA', True))

    def _draw_game_to_texture(self):
        w, h = self.screen_texture.size
        surf = pygame.Surface((w, h))
        if self.evt004_result_state is not None:
            self._draw_evt004_result_screen(surf)
            self.menu_cursor.set_hover_state(False)
            self.menu_cursor.draw(surf)
            self.screen_texture.write(
                pygame.image.tobytes(surf, "RGBA", True)
            )
            return
        if self.evt003_state in ("RUNNING", "GAME_OVER"):
            if self.evt003_state == "RUNNING":
                elapsed = max(0.0, time.monotonic() - self.evt003_started_at)
                duration = float(self.evt003_runtime.duration_seconds)
                remaining_seconds = max(0, int(math.ceil(duration - elapsed)))
                message = "PLEASE DON'T TOUCH ANYTHING"
                self.evt003_presentation.draw_check(
                    surf, message[:self.evt003_typewriter_count], elapsed,
                    wallpaper_index=self.game_logic.wallpaper_index,
                    remaining_seconds=remaining_seconds,
                    duration_seconds=duration,
                )
            else:
                progress = (time.monotonic() - self.evt003_gameover_started_at) / 2.35
                self.evt003_presentation.draw_game_over(
                    surf, progress, wallpaper_index=self.game_logic.wallpaper_index,
                )
            # The system cursor is normally composed by the gameplay renderer.
            # This exclusive event render path must compose it explicitly as well.
            self.menu_cursor.set_hover_state(False)
            self.menu_cursor.draw(surf)
            self.screen_texture.write(pygame.image.tobytes(surf, "RGBA", True))
