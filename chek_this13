        pygame.draw.line(layer, (91, 69, 25), (66, 106), (73, 99), 8)
        pygame.draw.line(layer, (244, 196, 55), (66, 106), (73, 99), 5)
        pygame.draw.line(layer, (91, 69, 25), (73, 113), (80, 106), 8)
