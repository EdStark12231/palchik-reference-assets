        layer.blit(hint, (18, 79))

        # Use two columns on normal displays and three shorter columns when
        # vertical space is limited; all 12 entries stay inside the window.
        compact_grid = panel_h < 390
        columns = 3 if compact_grid else 2
        rows_per_column = 4 if compact_grid else 6
        col_gap = 10 if compact_grid else 12
        usable_width = max(1, panel_w - 36 - col_gap * (columns - 1))
        col_w = max(1, usable_width // columns)
        top = 101
        footer_y = panel_h - 20
        available_h = max(1, footer_y - top - 9)
        row_h = min(62, max(27, available_h // rows_per_column))
        card_h = max(23, row_h - 3)
        name_size = 12 if col_w >= 250 else (10 if col_w >= 125 else 8)
        status_size = 10 if col_w >= 250 else (8 if col_w >= 125 else 7)
        name_font = pygame.font.SysFont("Courier New", name_size, bold=True)
        status_font = pygame.font.SysFont("Courier New", status_size, bold=True)

        for index, (item_id, item_name) in enumerate(EVENT_COLLECTION_ITEMS):
            col = index // rows_per_column
            row = index % rows_per_column
            item_rect = pygame.Rect(
                18 + col * (col_w + col_gap),
                top + row * row_h,
                col_w,
                card_h,
            )
            item_progress = min(1.0, max(0.0, (now - self.event_collection_opened_at - 0.05 - index * 0.035) / 0.22))
            item_ease = 1.0 - (1.0 - item_progress) ** 2
            if item_ease <= 0:
                continue
            shown_rect = item_rect.move(0, int((1.0 - item_ease) * 11))
            progress = self.event_collection_progress.get(item_id, {})
            completed = bool(progress.get("completed", False))
            found = bool(progress.get("found", False)) or completed

            card_bg = (205, 225, 205) if completed else ((215, 228, 240) if found else (192, 192, 192))
            pygame.draw.rect(layer, card_bg, shown_rect)
            pygame.draw.line(layer, (255, 255, 255), shown_rect.topleft, (shown_rect.right - 1, shown_rect.top), 2)
            pygame.draw.line(layer, (255, 255, 255), shown_rect.topleft, (shown_rect.left, shown_rect.bottom - 1), 2)
            pygame.draw.line(layer, (96, 96, 96), (shown_rect.left, shown_rect.bottom - 1), (shown_rect.right - 1, shown_rect.bottom - 1), 2)
            pygame.draw.line(layer, (96, 96, 96), (shown_rect.right - 1, shown_rect.top), (shown_rect.right - 1, shown_rect.bottom - 1), 2)

            status_text, status_color = (
                ("ПРОЙДЕНО", (0, 105, 35)) if completed else
                (("НАЙДЕНО · ЕЩЁ НЕ ПРОЙДЕНО", (0, 75, 125)) if found else ("НЕ НАЙДЕНО", (80, 80, 80)))
            )
            indicator_color = (0, 150, 45) if completed else ((0, 105, 180) if found else (110, 110, 110))
            compact_card = shown_rect.height < 30
            indicator_size = 5 if compact_card else 7
            indicator_x = shown_rect.x + (5 if compact_card else 7)
            indicator_y = shown_rect.y + (5 if compact_card else 8)
            pygame.draw.rect(layer, indicator_color, (indicator_x, indicator_y, indicator_size, indicator_size))
            name_color = (15, 25, 35) if found else (75, 75, 75)
            name_surface = name_font.render(item_name, True, name_color)
            name_left = shown_rect.x + (13 if compact_card else 19)
            if name_surface.get_width() > shown_rect.width - (name_left - shown_rect.x) - 5:
                name_surface = pygame.font.SysFont("Arial", max(7, name_size - 1), bold=True).render(item_name, True, name_color)
            name_y = shown_rect.y + (3 if compact_card else 5)
            layer.blit(name_surface, (name_left, name_y))
            status_surface = status_font.render(status_text, True, status_color)
            if status_surface.get_width() > shown_rect.width - 10:
                status_surface = pygame.font.SysFont("Arial", max(7, status_size - 1), bold=True).render(status_text, True, status_color)
            status_bottom_pad = 2 if compact_card else 4
            layer.blit(status_surface, (shown_rect.x + 5, shown_rect.bottom - status_surface.get_height() - status_bottom_pad))

        footer = pygame.font.SysFont("Courier New", 10, bold=True).render(
