            phrases_pool = TRANSLATIONS[self.current_lang]["horror_phrases"]
            self.game_logic.set_notification(random.choice(phrases_pool), duration=5000)
        self.game_logic.notification_color = (255, 255, 255)

    def _spawn_chase_planets(self):
        """Create the standard Chase Planet round used by the live timer flow."""
        self.audio_box.play_chase_planet("spawn")
        tex_w, tex_h = self.screen_texture.size
        logic = self.game_logic
        logic.chase_planet_rounds_started += 1
        logic.chase_planets_target_count = min(6, logic.chase_planet_rounds_started)
        logic.chase_planets_caught_round = 0
        logic.chase_planet_active = True
        logic.chase_planets = []

        min_x = 40
        max_x = max(min_x, tex_w - 84)
        min_y = 60
        max_y = max(min_y, tex_h - 84)

        for _planet_number in range(logic.chase_planets_target_count):
            position = None
            for _attempt in range(30):
                x = random.randint(min_x, max_x)
                y = random.randint(min_y, max_y)
                if all(
                    math.hypot(x - other["x"], y - other["y"]) >= 78
                    for other in logic.chase_planets
                ):
                    position = (x, y)
                    break
            if position is None:
                position = (random.randint(min_x, max_x), random.randint(min_y, max_y))
            logic.chase_planets.append({"x": float(position[0]), "y": float(position[1])})

        first_planet = logic.chase_planets[0]
        logic.sprite_x = first_planet["x"]
        logic.sprite_y = first_planet["y"]
        logic.sprite_active = True
        logic.set_notification(TRANSLATIONS[self.current_lang]["earth_catch"], duration=5000)
        logic.notification_color = (255, 165, 0)

    def _start_chase_planet_test(self):
        """Enter the real timed Chase Planet state and spawn its first round immediately."""
        self._start_free_clean_flow()
        self.game_logic.timer_clicks = self.game_logic.sprite_spawn_clicks
        self._spawn_chase_planets()

