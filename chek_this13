            self._show_notification("EVT_004 УЖЕ ВЫПОЛНЯЕТСЯ", duration=1500)
            return False
        try:
            instance = self.event_manager.begin("EVT_004_ADVENTURE_ROAD", {
                "source": "ADMIN",
                "admin_sandbox": True,
            })
        except RuntimeError as exc:
            self._show_notification(f"EVT_004 БЛОКИРОВАН: {exc}", duration=2000)
            return False
        if not self._initialize_evt004_instance(instance):
            return False
        self._show_notification("EVT_004: АДМИН-ТЕСТ ЗАПУЩЕН", duration=2000)
        return True

    def _finish_evt004(self, cancelled=False, failed=False, reason=None):
        """Finish EVT_004: release resources, save outcome, restore audio/game state."""
        if self.evt004_instance_id is None:
            return
        instance_id = self.evt004_instance_id
        outcome = None
        if self.evt004_runtime is not None:
            result = self.evt004_runtime.result()
            if result is not None:
                outcome = result.result
        if cancelled and self.evt004_runtime is not None and self.evt004_runtime.running:
            self.evt004_runtime.cancel(reason or "HOST_CANCELLED")
            result = self.evt004_runtime.result()
            if result is not None:
                outcome = result.result
        if cancelled and outcome is None:
            outcome = "CANCELLED"
        if failed or outcome == "DEFEAT":
            event_status_failed = True
            event_status_cancelled = False
        elif cancelled or outcome == "CANCELLED":
            event_status_failed = False
            event_status_cancelled = True
        else:
            event_status_failed = False
            event_status_cancelled = False
        try:
            instance = self.event_manager.finish(
                instance_id,
                cancelled=event_status_cancelled,
                failed=event_status_failed,
                reason=reason,
            )
        except KeyError:
            instance = None
        is_admin_sandbox = False
        if self.evt004_runtime is not None:
            inst = self.event_manager.instances.get(instance_id)
            if inst is not None:
                is_admin_sandbox = bool(inst.data.get("admin_sandbox", False))
        if not is_admin_sandbox and outcome is not None:
            state = {
                "outcome": outcome,
                "reason": reason or "",
                "dragon_hp": self.evt004_runtime.dragon_hp if self.evt004_runtime else 0,
                "dragon_max_hp": self.evt004_runtime.dragon_hp_max if self.evt004_runtime else 0,
                "destroyed_targets": self.evt004_runtime.destroyed_targets if self.evt004_runtime else 0,
                "total_targets": self.evt004_runtime.total_targets if self.evt004_runtime else 0,
                "finished_at": time.monotonic(),
            }
            try:
                SaveManager.save_event_state("EVT_004_ADVENTURE_ROAD", state)
            except Exception:
                self.app_logger.exception("EVT_004 save state failed")
            if outcome == "VICTORY":
                try:
                    from events.secret_access import mark_event_completed, normalize_event_collection_progress
                    data = SaveManager._read_raw_game_data()
                    progress = normalize_event_collection_progress(data.get("event_collection_progress", {}))
                    progress = mark_event_completed(progress, "road_of_adventures")
                    SaveManager.save_event_collection_state(progress=progress)
                except Exception:
                    self.app_logger.exception("EVT_004 collection save failed")
            elif outcome == "DEFEAT":
                try:
                    from events.secret_access import mark_event_found, normalize_event_collection_progress
                    data = SaveManager._read_raw_game_data()
                    progress = normalize_event_collection_progress(data.get("event_collection_progress", {}))
                    progress = mark_event_found(progress, "road_of_adventures")
                    SaveManager.save_event_collection_state(progress=progress)
                except Exception:
                    self.app_logger.exception("EVT_004 defeat collection save failed")
        try:
            self._stop_evt004_audio()
            self.audio_box.play_game_music()
        except Exception:
            self.app_logger.exception("EVT_004 audio restore failed")
        # Preserve the final dragon image before the runtime is released.
        self.evt004_result_dragon_surface = None
        if outcome in ("VICTORY", "DEFEAT") and self.evt004_runtime is not None:
            try:
                dragon = getattr(self.evt004_runtime, "dragon", None)
                if dragon is not None:
                    transformed = dragon.transformed_sprite(for_death=True)
                    if transformed is not None:
                        self.evt004_result_dragon_surface = transformed.copy()
            except Exception:
                self.app_logger.exception("EVT_004 result dragon snapshot failed")
        self.evt004_runtime = None
        self.evt004_presentation = None
        self.evt004_instance_id = None
        self.evt004_started_at = 0.0
        if outcome in ("VICTORY", "DEFEAT"):
            self._start_evt004_result_screen(outcome)
        elif outcome == "CANCELLED":
            self._show_notification("EVT_004: ОТМЕНЕНО", duration=2000)
        self.secret_prompt_session.retry_after_event()

    def _start_evt004_result_screen(self, outcome):
        """Start the exclusive EVT_004 story ending screen."""
        if outcome == "VICTORY":
            title = "YOU WIN"
            text = (
                "Драконы… Драконы всегда были бичом нашего мира.\n\n"
                "Поздравляем тебя, герой! Ты одолел злобного дракона и "
                "совершил подвиг, о котором будут слагать легенды.\n\n"
                "Следуй дальше своим путём, герой. Мы надеемся, что ещё "
                "услышим множество славных рассказов о твоих свершениях!"
            )
        elif outcome == "DEFEAT":
            title = "GAME OVER"
            text = (
                "Ты храбро сражался со злобным драконом, но даже твоей "
                "отваги оказалось недостаточно, чтобы одолеть его.\n\n"
                "Здесь заканчивается твой жизненный путь, герой… "
                "Но не сказания о твоём имени.\n\n"
                "Пусть память о твоей храбрости живёт в веках."
            )
        else:
            return False

        self.evt004_result_state = outcome
        self.evt004_result_title = title
        self.evt004_result_text = text
        self.evt004_result_started_at = time.monotonic()
        self.evt004_result_typewriter_count = 0
        self.evt004_result_revealed = False
        self.evt004_result_interval = 0.045

        self.evt004_result_typewriter.reset(
            text,
            started_at=self.evt004_result_started_at,
            interval=self.evt004_result_interval,
        )
        return True

    def _update_evt004_result_screen(self):
        """Advance the result title one character at a time."""
        if self.evt004_result_state is None:
            return

        if self.evt004_result_revealed:
            return

        now = time.monotonic()
        newly_revealed = self.evt004_result_typewriter.advance(now)

        self.evt004_result_typewriter_count = min(
            len(self.evt004_result_text),
            max(
                0,
                int(self.evt004_result_typewriter.visible_count),
            ),
        )

        for _ in range(newly_revealed):
            self.audio_box.play_typewriter_tick()

        if self.evt004_result_typewriter_count >= len(
            self.evt004_result_text
        ):
            self.evt004_result_revealed = True

    def _reveal_evt004_result_text(self):
        """Finish typewriter animation without closing the screen."""
        if self.evt004_result_state is None:
            return

        self.evt004_result_revealed = True
        self.evt004_result_typewriter_count = len(
            self.evt004_result_text
        )

    def _close_evt004_result_screen(self):
        """Release the result screen and return to normal gameplay."""
        if self.evt004_result_state is None:
            return

        self.evt004_result_state = None
        self.evt004_result_title = ""
        self.evt004_result_text = ""
        self.evt004_result_started_at = 0.0
        self.evt004_result_typewriter_count = 0
        self.evt004_result_revealed = False
        self.evt004_result_dragon_surface = None

    def _handle_evt004_result_event(self, event):
        """Consume all gameplay input while the result screen is active."""
        if event.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode(
                (event.w, event.h),
                pygame.FULLSCREEN | pygame.DOUBLEBUF | pygame.OPENGL,
            )
            self._setup_menu_hitboxes()
            self.game_view.width = event.w
            self.game_view.height = event.h
            self.game_view.recalculate_layout()
            return

        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                self._close_evt004_result_screen()
            elif event.key in (
                pygame.K_RETURN,
                pygame.K_KP_ENTER,
                pygame.K_SPACE,
            ):
                if not self.evt004_result_revealed:
                    self._reveal_evt004_result_text()
                else:
                    self._close_evt004_result_screen()
            return

        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if not self.evt004_result_revealed:
                self._reveal_evt004_result_text()
            else:
                self._close_evt004_result_screen()

    def _draw_evt004_result_screen(self, surface):
        """Draw a restrained 8-bit adventure ending."""
        width, height = surface.get_size()
        surface.fill((0, 0, 0))

        # Use the project's existing ContraPhobotech font.
        game_view = getattr(self, "game_view", None)
        font = getattr(game_view, "font_main", None) if game_view else None
        if font is None:
            font = self.font_hint

        if self.evt004_result_state == "VICTORY":
            title_color = (218, 210, 166)
            body_color = (190, 198, 184)
            dragon_tint = None
        else:
            title_color = (190, 164, 164)
            body_color = (174, 174, 174)
            dragon_tint = (190, 150, 150)

        # The dragon is the only large visual element.
        dragon = self.evt004_result_dragon_surface
        dragon_bottom = int(height * 0.34)

        if dragon is not None:
            try:
                image = dragon.copy()
                source_width, source_height = image.get_size()
                if source_width > 0 and source_height > 0:
                    max_width = int(width * 0.34)
                    max_height = int(height * 0.28)
                    scale = min(
                        max_width / source_width,
                        max_height / source_height,
                        1.0,
                    )
                    target_size = (
                        max(1, int(source_width * scale)),
                        max(1, int(source_height * scale)),
                    )
                    image = pygame.transform.scale(image, target_size)
                    if dragon_tint is not None:
                        overlay = pygame.Surface(image.get_size(), pygame.SRCALPHA)
                        overlay.fill((*dragon_tint, 72))
                        image.blit(overlay, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
                    image_rect = image.get_rect(
                        center=(width // 2, int(height * 0.19))
                    )
                    surface.blit(image, image_rect)
                    dragon_bottom = image_rect.bottom
            except Exception:
                self.app_logger.exception("EVT_004 result dragon drawing failed")

        # Classic compact title: no panel, border, shadow or button decoration.
        title = getattr(self, "evt004_result_title", "")
        if title:
            title_surface = font.render(title, True, title_color)
            max_title_width = int(width * 0.82)
            if title_surface.get_width() > max_title_width:
                scale = max_title_width / title_surface.get_width()
                title_surface = pygame.transform.scale(
                    title_surface,
                    (
                        max(1, int(title_surface.get_width() * scale)),
                        max(1, int(title_surface.get_height() * scale)),
                    ),
                )
            title_rect = title_surface.get_rect(
                center=(width // 2, max(dragon_bottom + 24, int(height * 0.39)))
            )
            surface.blit(title_surface, title_rect)

        # Reveal only the typewriter-visible part of the approved story.
        visible_text = self.evt004_result_text[
            :self.evt004_result_typewriter_count
        ]

        text_top = max(int(height * 0.48), dragon_bottom + int(height * 0.12))
        text_bottom = int(height * 0.88)
        max_text_width = int(width * 0.82)
        line_height = max(font.get_linesize(), font.get_height() + 2)

        paragraphs = visible_text.split("\n\n")
        rendered_lines = []

        for paragraph in paragraphs:
            words = paragraph.split()
            if not words:
                rendered_lines.append("")
                continue

            current = ""
            for word in words:
                candidate = word if not current else current + " " + word
                if current and font.size(candidate)[0] > max_text_width:
                    rendered_lines.append(current)
                    current = word
                else:
                    current = candidate
            if current:
                rendered_lines.append(current)
            rendered_lines.append("")

        if rendered_lines and rendered_lines[-1] == "":
            rendered_lines.pop()

        total_height = len(rendered_lines) * line_height
        available_height = max(1, text_bottom - text_top)

        # If needed, reduce the rendered glyph surfaces uniformly; do not change fonts.
        render_scale = min(1.0, available_height / max(1, total_height))
        y = text_top

        for line in rendered_lines:
            if not line:
                y += max(5, int(line_height * 0.55 * render_scale))
                continue

            line_surface = font.render(line, True, body_color)
            if render_scale < 1.0:
                line_surface = pygame.transform.scale(
                    line_surface,
                    (
                        max(1, int(line_surface.get_width() * render_scale)),
                        max(1, int(line_surface.get_height() * render_scale)),
                    ),
                )
            rect = line_surface.get_rect(center=(width // 2, y + line_surface.get_height() // 2))
            surface.blit(line_surface, rect)
            y += max(1, int(line_height * render_scale))

        if self.evt004_result_revealed:
            hint_font = self.font_hint
            hint_text = "ENTER / SPACE / CLICK"
            hint_surface = hint_font.render(hint_text, True, (112, 120, 128))
            max_hint_width = int(width * 0.72)
            if hint_surface.get_width() > max_hint_width:
                scale = max_hint_width / hint_surface.get_width()
                hint_surface = pygame.transform.scale(
                    hint_surface,
                    (
                        max(1, int(hint_surface.get_width() * scale)),
                        max(1, int(hint_surface.get_height() * scale)),
                    ),
                )
            surface.blit(
                hint_surface,
                hint_surface.get_rect(center=(width // 2, int(height * 0.95))),
            )

    def _update_evt004(self, dt):
        """Update EVT004 and route state-transition audio; return active state."""
        runtime = self.evt004_runtime
        if runtime is None:
            return False
        result = runtime.update(dt) if runtime.running else runtime.result()
        self._route_evt004_audio_events(runtime.drain_audio_events())
        if result is not None:
            if result.result == "VICTORY":
                self._finish_evt004(failed=False, cancelled=False, reason="DRAGON_DEFEATED")
            elif result.result == "DEFEAT":
                self._finish_evt004(failed=True, cancelled=False, reason="ALL_INTERFACE_TARGETS_DESTROYED")
            elif result.result == "CANCELLED":
                self._finish_evt004(cancelled=True, reason=result.reason or "HOST_CANCELLED")
            return False
        return runtime.running

    def _draw_evt004(self, surface):
        """Draw EVT_004 using the clean background captured before UI rendering."""
        if self.evt004_runtime is None or self.evt004_presentation is None:
            return
        if not self.evt004_runtime.running:
            return

        snapshot = getattr(
            self.game_view, "_evt004_background_snapshot", None
        )
        if snapshot is None or snapshot.get_size() != surface.get_size():
            return

        self.evt004_presentation.draw(
            surface, self.evt004_runtime, snapshot
        )

    def _handle_evt004_click(self, pos):
        """Route mouse click to EVT_004 runtime. Returns True if consumed."""
        if self.evt004_runtime is None or not self.evt004_runtime.running:
            return False
        self.evt004_runtime.player_attack(pos)
        return True

