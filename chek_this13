    def _update_intro_slides(self):
        if not self.intro_slides_active or self.admin_panel_open:
            return
        dt = max(0.0, min(self.clock.get_time() / 1000.0, 0.15))
        self.intro_slide_typewriter_accum += dt
        interval = 0.028
        count = int(self.intro_slide_typewriter_accum / interval)
        if count <= 0:
            return
        self.intro_slide_typewriter_accum -= count * interval
        self.intro_slide_char_index = min(
            len(self.intro_slide_full_text), self.intro_slide_char_index + count
        )
        self.intro_slide_display_text = self.intro_slide_full_text[:self.intro_slide_char_index]

    def _advance_intro_slide(self):
        if not self.intro_slides_active:
            return
        if self.intro_slide_char_index < len(self.intro_slide_full_text):
            return
        if self.intro_slide_index + 1 >= len(self._get_intro_slides()):
            self._begin_game_session(reset_progress=True)
            return
        self.intro_slide_index += 1
        self._load_intro_slide()

    def _wrap_intro_text(self, text, font, max_width):
        result = []
        for paragraph in text.split("\n"):
            if not paragraph:
                result.append("")
                continue
            words = paragraph.split()
            line = ""
            for word in words:
                candidate = word if not line else line + " " + word
                if font.size(candidate)[0] <= max_width or not line:
                    line = candidate
                else:
                    result.append(line)
                    line = word
            if line:
                result.append(line)
        return result

    def _draw_intro_slides_to_texture(self):
        w, h = self.screen_texture.size
        surf = pygame.Surface((w, h))
        surf.fill((12, 15, 20))

        # Restrained late-90s software dialog, not a horror presentation.
        win_w = min(780, max(420, w - 64))
        win_h = min(500, max(340, h - 64))
        win_w = min(win_w, w - 24)
        win_h = min(win_h, h - 24)
        win = pygame.Rect((w - win_w) // 2, (h - win_h) // 2, win_w, win_h)
        pygame.draw.rect(surf, (0, 0, 0), win.move(6, 7))
        pygame.draw.rect(surf, (192, 192, 192), win)
        pygame.draw.rect(surf, (255, 255, 255), win, 2)
        pygame.draw.rect(surf, (128, 128, 128), win, 1)
        title_bar = pygame.Rect(win.x + 3, win.y + 3, win.width - 6, 30)
        pygame.draw.rect(surf, (0, 0, 128), title_bar)
        title_font = pygame.font.SysFont("Arial", 18, bold=True)
        title = title_font.render("PALCHIK.exe - Information", True, (255, 255, 255))
        surf.blit(title, (title_bar.x + 10, title_bar.y + 5))

        content = pygame.Rect(win.x + 18, win.y + 48, win.width - 36, win.height - 112)
        pygame.draw.rect(surf, (255, 255, 255), content)
        pygame.draw.rect(surf, (128, 128, 128), content, 1)
        heading_font = pygame.font.SysFont("Arial", 25, bold=True)
        body_font = pygame.font.SysFont("Arial", 24)
        typed_text = self.intro_slide_display_text
        if "\n\n" in typed_text:
            heading_display, body_display = typed_text.split("\n\n", 1)
        else:
            heading_display = typed_text.split("\n", 1)[0]
            body_display = ""
        heading = heading_font.render(heading_display, True, (25, 35, 55))
        surf.blit(heading, (content.x + 28, content.y + 26))
        pygame.draw.line(surf, (190, 190, 190),
                         (content.x + 28, content.y + 66),
                         (content.right - 28, content.y + 66), 1)

        lines = self._wrap_intro_text(body_display, body_font, content.width - 56)
        line_y = content.y + 92
        line_height = body_font.get_linesize() + 8
        max_lines = max(1, (content.height - 112) // line_height)
        for line in lines[:max_lines]:
            rendered = body_font.render(line, True, (25, 25, 25))
            surf.blit(rendered, (content.x + 28, line_y))
            line_y += line_height

        footer_font = pygame.font.SysFont("Arial", 16)
        progress = footer_font.render(
            f"{self.intro_slide_index + 1} / {len(self._get_intro_slides())}",
            True, (60, 60, 60)
        )
        surf.blit(progress, (win.x + 22, win.bottom - 43))

        self.intro_slide_button_rect = None
        if self.intro_slide_char_index >= len(self.intro_slide_full_text):
            button_w, button_h = 174, 42
            button = pygame.Rect(win.right - button_w - 22, win.bottom - 54, button_w, button_h)
            self.intro_slide_button_rect = button
            pygame.draw.rect(surf, (128, 128, 128), button.move(2, 2))
            pygame.draw.rect(surf, (212, 208, 200), button)
            pygame.draw.line(surf, (255, 255, 255), button.topleft, (button.right - 1, button.top), 2)
            pygame.draw.line(surf, (255, 255, 255), button.topleft, (button.left, button.bottom - 1), 2)
            pygame.draw.line(surf, (80, 80, 80), (button.left, button.bottom - 1), (button.right - 1, button.bottom - 1), 2)
            pygame.draw.line(surf, (80, 80, 80), (button.right - 1, button.top), (button.right - 1, button.bottom - 1), 2)
            label = "НАЧАТЬ ИГРУ" if self.intro_slide_index == len(self._get_intro_slides()) - 1 else "ОК"
            button_font = pygame.font.SysFont("Arial", 20, bold=True)
            button_text = button_font.render(label, True, (20, 20, 20))
            surf.blit(button_text, button_text.get_rect(center=button.center))

        self._draw_admin_panel(surf)
        self.menu_cursor.draw(surf)
        self.screen_texture.write(pygame.image.tobytes(surf, 'RGBA', True))

    def _handle_intro_slide_events(self, event):
        if not self.intro_slides_active or self.admin_panel_open:
            return
        if event.type == pygame.KEYDOWN and event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE):
            self._advance_intro_slide()
        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            screen_w, screen_h = self.screen.get_size()
            tex_w, tex_h = self.screen_texture.size
            pos = (int(event.pos[0] * tex_w / max(1, screen_w)),
                   int(event.pos[1] * tex_h / max(1, screen_h)))
            if self.intro_slide_button_rect and self.intro_slide_button_rect.collidepoint(pos):
                self._advance_intro_slide()

