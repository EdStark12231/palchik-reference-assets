    def _load_subtitle_phrases(self, phase):
        """Загружает все фразы для указанной фазы из всех категорий (микс) для текущего языка."""
        lang_code = self.current_lang.lower()
        echoes_dir = os.path.join("assets", "echoes", lang_code)
        
        phase_map = {
            "phase_0": "phase_0.txt",
            "phase_1": "phase_1.txt",
            "phase_2": "phase_2.txt",
            "phase_3": "phase_3.txt",
            "phase_4": "phase_4.txt",
            "final": "final.txt"
        }
        filename = phase_map.get(phase)
        if not filename:
            return []
        
        if not os.path.isdir(echoes_dir):
            return []
        
        all_phrases = []
        for category in os.listdir(echoes_dir):
            category_path = os.path.join(echoes_dir, category)
            if not os.path.isdir(category_path):
                continue
            filepath = os.path.join(category_path, filename)
            if os.path.exists(filepath):
                try:
                    with open(filepath, "r", encoding="utf-8") as f:
                        lines = [line.strip() for line in f if line.strip()]
                        all_phrases.extend(lines)
                except Exception:
                    self.app_logger.exception("Ошибка загрузки субтитров: %s", filepath)
        
        return all_phrases

    def _update_subtitles(self):
        """Обновляет состояние субтитров."""
        if self.current_screen != "game" or self.settings_box.is_open:
            return
            
        dt = self.clock.get_time() / 1000.0
        phase = self.game_logic.get_phase()
        
        if self.subtitle_state == "idle":
            self.subtitle_next_idle_timer += dt
            if self.subtitle_next_idle_timer >= random.uniform(3.0, 8.0):
                phrases = self._load_subtitle_phrases(phase)
                if not phrases:
                    from localization import TRANSLATIONS
                    lang_code = self.current_lang if self.current_lang in TRANSLATIONS else "RU"
                    phrases = TRANSLATIONS[lang_code].get("subtitles", {}).get(phase, [])
                    if not phrases and lang_code != "RU":
                        phrases = TRANSLATIONS["RU"].get("subtitles", {}).get(phase, [])
                if not phrases:
                    phrases = ["..."]
                self.subtitle_full_text = random.choice(phrases)
                self.subtitle_displayed_text = ""
                self.subtitle_state = "typewriter"
                self.subtitle_state_timer = 0.0
                self.subtitle_typewriter_timer = 0.0
                self.subtitle_alpha = 255
                self.subtitle_next_idle_timer = 0.0

        elif self.subtitle_state == "typewriter":
            self.subtitle_typewriter_timer += dt
            if self.subtitle_typewriter_timer >= self.subtitle_typewriter_speed:
                self.subtitle_typewriter_timer = 0.0
                if len(self.subtitle_displayed_text) < len(self.subtitle_full_text):
                    self.subtitle_displayed_text = self.subtitle_full_text[:len(self.subtitle_displayed_text) + 1]
                else:
                    self.subtitle_state = "waiting_click"

        elif self.subtitle_state == "waiting_click":
            # Ждём клика игрока; субтитр скрывается по клику в _handle_game_events
            pass

    def _draw_subtitles(self, surface, font):
        """Рисует субтитры в нижней части экрана. (оптимизировано)"""
        if not self.subtitle_displayed_text or self.subtitle_alpha <= 0:
            return
        
        w, h = surface.get_size()
        bar_height = 80
        bar_y = h - int(h * 0.10) - bar_height // 2
        max_text_width = int(w * 0.80)
        
        # Кэшированный шрифт для измерения
        font_key = ("Arial", 24, True, False)
        fnt = text_cache.get_font_object("Arial", 24, bold=True)
        
        display_text = self.subtitle_displayed_text
        words = display_text.split()
        lines = []
        current_line = []
        
        # Однопроходный перенос строк: измеряем ширину через get_surface (кэшируется)
        for word in words:
            test_line = " ".join(current_line + [word])
            test_surf = text_cache.get_surface(test_line, "Arial", 24, (200, 200, 200), bold=True)
            if test_surf.get_width() <= max_text_width:
                current_line.append(word)
            else:
                if current_line:
                    lines.append(" ".join(current_line))
                current_line = [word]
        if current_line:
            lines.append(" ".join(current_line))
        
        line_height = 28
        total_height = len(lines) * line_height
        
        bg_padding_x = 20
        bg_padding_y = 10
        bg_width = max_text_width + bg_padding_x * 2
        bg_height = total_height + bg_padding_y * 2
        bg_x = (w - bg_width) // 2
        bg_y = bar_y - bg_padding_y
        
        # Фон — только если есть строки
        if lines:
            bg_surf = pygame.Surface((bg_width, bg_height), pygame.SRCALPHA)
            bg_surf.fill((0, 0, 0, int(153 * self.subtitle_alpha / 255)))
            surface.blit(bg_surf, (bg_x, bg_y))
            
            text_start_y = bg_y + bg_padding_y
            for idx, line in enumerate(lines):
                text_y = text_start_y + idx * line_height
                line_surf = text_cache.get_surface(line, "Arial", 24, (255, 255, 255), bold=True)
                line_surf.set_alpha(self.subtitle_alpha)
                text_x = (w - line_surf.get_width()) // 2
                surface.blit(line_surf, (text_x, text_y))
        
        self.subtitle_rect = pygame.Rect(bg_x, bg_y, bg_width, bg_height)

    def _draw_name_entry_to_texture(self):
        w, h = self.screen_texture.size
        surf = pygame.Surface((w, h))
