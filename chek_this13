        def draw_wrapped_text(text, x, y, max_width, font, color, max_lines=2):
            words = str(text).split()
            lines = []
            line = ""
            for word in words:
                candidate = word if not line else line + " " + word
                if font.size(candidate)[0] <= max_width or not line:
                    line = candidate
                else:
                    lines.append(line)
                    line = word
            if line:
                lines.append(line)
            line_height = font.get_linesize() + 1
            for line_index, line_text in enumerate(lines[:max_lines]):
                rendered = font.render(line_text, True, color)
                surface.blit(rendered, (x, y + line_index * line_height))

