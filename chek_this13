class Profiler:
    """Система сбора метрик производительности."""
    def __init__(self):
        self.recording = False
        self.start_time = 0
        self.duration = 10.0  # секунд
        self.fps_values = []
        self.frame_times = []
        self.cpu_values = []
        self.ram_values = []
        self.scenario = "unknown"
    
    def start(self, duration=10.0, scenario="unknown"):
        self.recording = True
        self.start_time = time.time()
        self.duration = duration
        self.scenario = scenario
        self.fps_values = []
        self.frame_times = []
        self.cpu_values = []
        self.ram_values = []
    
    def tick(self, fps, dt):
        if not self.recording:
            return
        elapsed = time.time() - self.start_time
        self.fps_values.append(fps)
        self.frame_times.append(dt)
        if PSUTIL_AVAILABLE:
            self.cpu_values.append(psutil.cpu_percent(interval=0.0))
            mem = psutil.virtual_memory()
            self.ram_values.append(mem.percent)
        if elapsed >= self.duration:
            self.stop()
    
    def stop(self):
        self.recording = False
        self._print_report()
        self._save_report()
    
    def _print_report(self):
        if not self.fps_values:
            return
        avg_fps = sum(self.fps_values) / len(self.fps_values)
        min_fps = min(self.fps_values)
        max_fps = max(self.fps_values)
        avg_dt = sum(self.frame_times) / len(self.frame_times) * 1000
        min_dt = min(self.frame_times) * 1000
        max_dt = max(self.frame_times) * 1000
        
        print("\n" + "="*50)
        print("  ОТЧЁТ ПРОФИЛИРОВАНИЯ")
        print("="*50)
        print(f"  Сценарий: {self.scenario}")
        print(f"  Длительность: {self.duration:.1f} сек")
        print(f"  Кадров записано: {len(self.fps_values)}")
        print(f"  FPS: средний {avg_fps:.1f}, мин {min_fps:.0f}, макс {max_fps:.0f}")
        print(f"  Время кадра: среднее {avg_dt:.2f} мс, мин {min_dt:.2f}, макс {max_dt:.2f}")
        if self.cpu_values:
            avg_cpu = sum(self.cpu_values) / len(self.cpu_values)
            print(f"  Загрузка CPU: {avg_cpu:.1f}%")
        if self.ram_values:
            avg_ram = sum(self.ram_values) / len(self.ram_values)
            print(f"  Использование RAM: {avg_ram:.1f}%")
        print("="*50 + "\n")
    
    def _save_report(self):
        if not self.fps_values:
            return
        import os
        os.makedirs("profiles", exist_ok=True)
        timestamp = time.strftime("%Y%m%d_%H%M%S")
        filename = f"profiles/profile_{timestamp}_{self.scenario}.txt"
        
        avg_fps = sum(self.fps_values) / len(self.fps_values)
        min_fps = min(self.fps_values)
        max_fps = max(self.fps_values)
        avg_dt = sum(self.frame_times) / len(self.frame_times) * 1000
        min_dt = min(self.frame_times) * 1000
        max_dt = max(self.frame_times) * 1000
        
        with open(filename, "w", encoding="utf-8") as f:
            f.write("="*50 + "\n")
            f.write("  ОТЧЁТ ПРОФИЛИРОВАНИЯ\n")
            f.write("="*50 + "\n")
            f.write(f"  Сценарий: {self.scenario}\n")
            f.write(f"  Длительность: {self.duration:.1f} сек\n")
            f.write(f"  Кадров записано: {len(self.fps_values)}\n")
            f.write(f"  FPS: средний {avg_fps:.1f}, мин {min_fps:.0f}, макс {max_fps:.0f}\n")
            f.write(f"  Время кадра: среднее {avg_dt:.2f} мс, мин {min_dt:.2f}, макс {max_dt:.2f}\n")
            if self.cpu_values:
                avg_cpu = sum(self.cpu_values) / len(self.cpu_values)
                f.write(f"  Загрузка CPU: {avg_cpu:.1f}%\n")
            if self.ram_values:
                avg_ram = sum(self.ram_values) / len(self.ram_values)
                f.write(f"  Использование RAM: {avg_ram:.1f}%\n")
            f.write("="*50 + "\n")

