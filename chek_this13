    def _handle_menu_events(self, event):
        if event.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode((event.w, event.h), pygame.FULLSCREEN | pygame.DOUBLEBUF | pygame.OPENGL)
            self._setup_menu_hitboxes()
            self.game_view.width, self.game_view.height = event.w, event.h
            self.game_view.recalculate_layout()
        elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            self.menu_cursor.trigger_click_animation()
            if self.settings_box.is_open:
                self._handle_settings_click(event.pos)
            else:
                self.menu_cursor.handle_click(event.pos, event.pos)

    def _handle_settings_click(self, pos):
        for name, rect in self.settings_box.hitboxes.items():
            if rect.collidepoint(pos):
                if name.startswith("lang_"):
                    code = name.split("_")[1]
                    self.current_lang = code
                    self.game_logic.current_lang = code
                    SaveManager.save_game_data(self.game_logic.score, code, self.game_logic.total_clicks, self.game_logic.wallpaper_index)
                    self.settings_box.close_dialog()
                elif name == "vol_minus":
                    self.audio_box.set_volume(self.audio_box._volume - 0.1)
                elif name == "vol_plus":
                    self.audio_box.set_volume(self.audio_box._volume + 0.1)
                elif name == "toggle_vibration":
                    self.settings_box.vibration = not self.settings_box.vibration
                elif name == "toggle_audio_acc":
                    self.settings_box.accessibility_audio = not self.settings_box.accessibility_audio
                    self.audio_box.accessibility_audio = self.settings_box.accessibility_audio
                elif name == "toggle_visual_acc":
                    self.settings_box.accessibility_visual = not self.settings_box.accessibility_visual
                elif name == "btn_close":
                    self.settings_box.close_dialog()
                return

    def _cancel_archive_pin(self):
        logic = self.game_logic
        logic.code_window_open = False
        logic.input_buffer = [None, None, None]
        logic.current_cell_index = 0
        logic.current_cell_buffer = ""
        logic.system_response_text = ""
        logic.failed_attempts_count = 0
        logic.auto_close_timer = 0.0
        self.code_init_active = False
        self.game_view.code_window_dirty = True

    def _submit_archive_pin(self):
        logic = self.game_logic
        if self.code_init_active:
            return
        if logic.current_cell_buffer or any(value is None for value in logic.input_buffer):
            logic.system_response_text = "Введите все три части PIN-кода."
            self.game_view.code_window_dirty = True
            return

        if logic.input_buffer == logic.secret_code:
            logic.lore_icon_visible = False
            logic.input_buffer = [None, None, None]
            logic.current_cell_index = 0
            logic.current_cell_buffer = ""
            logic.failed_attempts_count = 0
            logic.auto_close_timer = 0.0
            SaveManager.save_game_data(
                logic.score,
                self.current_lang,
                logic.total_clicks,
                logic.wallpaper_index,
                self.player_name,
                logic.system_os_user,
            )
            self._start_code_init_sequence()
            return

        logic.failed_attempts_count += 1
        logic.input_buffer = [None, None, None]
        logic.current_cell_index = 0
        logic.current_cell_buffer = ""
        if logic.failed_attempts_count >= 3:
            logic.system_response_text = "Ошибка доступа"
            logic.auto_close_timer = 2.0
        else:
            logic.system_response_text = "Ошибка доступа. Код неверен."
        self.game_view.code_window_dirty = True

    def _start_code_init_sequence(self):
        self.code_init_active = True
        self.code_init_step = 0
        self.code_init_text = "Инициализация проверки системы.. Пожалуйста, подождите"
        self.code_init_display = ""
        self.code_init_word_index = 0
        self.code_init_timer = 0.0
        self.code_init_phase_timer = 0.0
        self.code_init_word_count = 0
        self.code_init_current_word = 0
        self.game_logic.system_response_text = ""
        self.game_view.code_window_dirty = True

    def _update_code_init(self, dt):
        if not self.code_init_active:
            return
        
        if self.code_init_step == 0:
            if self.code_init_word_count == 0:
                words = self.code_init_text.split()
                self.code_init_word_count = len(words)
                self.code_init_current_word = 0
                self.code_init_display = ""
            
            self.code_init_timer += dt
            if self.code_init_timer >= 0.4:
                self.code_init_timer = 0.0
                if self.code_init_current_word < self.code_init_word_count:
                    words = self.code_init_text.split()
                    if self.code_init_display:
                        self.code_init_display += " " + words[self.code_init_current_word]
                    else:
                        self.code_init_display = words[self.code_init_current_word]
                    self.code_init_current_word += 1
                    self.game_logic.system_response_text = self.code_init_display
                    self.game_view.code_window_dirty = True
                else:
                    self.code_init_step = 1
                    self.code_init_phase_timer = 0.0
                    self.code_init_timer = 0.0
                    self.code_init_current_word = 0
                    self.code_init_display = ""
        
        elif self.code_init_step == 1:
            self.code_init_phase_timer += dt
            if self.code_init_phase_timer >= 2.5:
                self.code_init_text = "Инициализация завершена. Сектор памяти восстановлен."
                self.code_init_step = 2
                self.code_init_timer = 0.0
                self.code_init_current_word = 0
                self.code_init_display = ""
                self.code_init_phase_timer = 0.0
                self.code_init_word_count = 0
                self.game_view.code_window_dirty = True
        
        elif self.code_init_step == 2:
            if self.code_init_word_count == 0:
                words = self.code_init_text.split()
                self.code_init_word_count = len(words)
                self.code_init_current_word = 0
                self.code_init_display = ""
            
            self.code_init_timer += dt
            if self.code_init_timer >= 0.4:
                self.code_init_timer = 0.0
                if self.code_init_current_word < self.code_init_word_count:
                    words = self.code_init_text.split()
                    if self.code_init_display:
                        self.code_init_display += " " + words[self.code_init_current_word]
                    else:
                        self.code_init_display = words[self.code_init_current_word]
                    self.code_init_current_word += 1
                    self.game_logic.system_response_text = self.code_init_display
                    self.game_view.code_window_dirty = True
                else:
                    self.code_init_step = 3
                    self.code_init_phase_timer = 0.0
                    self.code_init_timer = 0.0
        
        elif self.code_init_step == 3:
            self.code_init_phase_timer += dt
            if self.code_init_phase_timer >= 1.5:
                self.game_logic.code_window_open = False
                self.code_init_active = False
                self.game_logic.system_response_text = ""
                self.game_logic.input_buffer = [None, None, None]
                self.game_logic.current_cell_index = 0
                self.game_logic.current_cell_buffer = ""
                self.channel_switch_active = True
                self.channel_switch_start_ms = pygame.time.get_ticks()
                self.audio_box.play_channel_switch()

    def _update_hidden_system(self, dt):
        logic = self.game_logic
        if getattr(logic, "auto_close_timer", 0.0) > 0:
            logic.auto_close_timer -= dt
            if logic.auto_close_timer <= 0:
                logic.code_window_open = False
                logic.secret_code = [14, 17, 23]
                random.shuffle(logic.secret_code)
                logic.failed_attempts_count = 0
                logic.input_buffer = [None, None, None]
                logic.current_cell_index = 0
                logic.current_cell_buffer = ""
                logic.system_response_text = ""
                SaveManager.save_game_data(
                    logic.score,
                    self.current_lang,
                    logic.total_clicks,
                    logic.wallpaper_index,
                    self.player_name,
                    getattr(logic, "system_os_user", "")
                )

    def _evt003_schedule_phase(self, phase):
        self.evt003_scheduled_phase = str(phase)
        self.evt003_next_check_at = time.monotonic() + random.uniform(
            self.evt003_runtime.random_delay_min_seconds,
            self.evt003_runtime.random_delay_max_seconds,
        )

    def _evt003_begin_gameplay_entry(self):
        # Sandbox punishment follows the same visible menu -> next-entry dialog
        # flow as a real event, but its notice stays volatile and never enters saves.
        sandbox_pending = getattr(self, "evt003_sandbox_pending_notice", None)
        if isinstance(sandbox_pending, dict) and sandbox_pending.get("text"):
            self.evt003_dialog_payload = dict(sandbox_pending)
            self.evt003_state = "PENDING_NOTICE"
            self.evt003_is_sandbox = True
        else:
            pending = getattr(self.game_logic, "evt003_pending_notification", None)
            if isinstance(pending, dict) and pending.get("text"):
                self.evt003_dialog_payload = dict(pending)
                self.evt003_state = "PENDING_NOTICE"
            else:
                self.evt003_state = None
                self.evt003_dialog_payload = None
            self.evt003_is_sandbox = False
        self.evt003_instance_id = None
        self._evt003_schedule_phase(self.game_logic.get_phase())

    def _maybe_start_evt003(self):
        if self.current_screen != "game" or self.crash_stage != 0:
            return
        if self.intro_slides_active or self.name_entry_active or self.admin_panel_open or self.channel_switch_active:
            return
        phase = self.game_logic.get_phase()
        now = time.monotonic()
        if phase != self.evt003_scheduled_phase:
            self._evt003_schedule_phase(phase)
        if now < self.evt003_next_check_at:
            return
        logic = self.game_logic
        blocked = (
            logic.word_shock_active or logic.roach_attack_active
            or logic.minigame_active or logic.timer_active or logic.sprite_active
            or logic.chase_planet_active or logic.fade_screen_active
            or logic.code_window_open or logic.lore_window_open
            or logic.lore_text_viewer_open or logic.lore_image_viewer_open
            or self.settings_box.is_open
        )
        if blocked:
            self.evt003_next_check_at = now + 4.0
            return
        allowed, reason = self.evt003_runtime.can_start(phase)
        if not allowed:
            if reason == "ALREADY_OCCURRED_THIS_PHASE":
                self.evt003_next_check_at = float("inf")
            else:
                self.evt003_next_check_at = now + 5.0
            return
        try:
            instance = self.evt003_runtime.start(phase)
        except Exception as exc:
            self._log_exception("EVT003_RANDOM_START", exc)
            self.evt003_next_check_at = now + 8.0
            return
        self.evt003_instance_id = instance.instance_id
        self.evt003_started_at = float(instance.started_at or now)
        self.evt003_typewriter_count = 0
        self.evt003_typewriter.reset(
            "PLEASE DON'T TOUCH ANYTHING", started_at=self.evt003_started_at,
            interval=self.evt003_typewriter_interval,
        )
        self.evt003_is_sandbox = False
        self.evt003_state = "RUNNING"

    def _evt003_violation(self):
        if self.evt003_state != "RUNNING" or not self.evt003_instance_id:
            return
        try:
            result = self.evt003_runtime.register_click(self.evt003_instance_id)
        except Exception as exc:
            self._log_exception("EVT003_VIOLATION_RESOLUTION", exc)
            # Fail closed: do not route this click into ordinary gameplay.
            self.evt003_state = "GAME_OVER"
            self.evt003_gameover_started_at = time.monotonic()
            self.audio_box.play_evt003_failure()
            return
        self.evt003_instance_id = None
        self.evt003_dialog_payload = {
            "text": result["notification_text"],
            "title": "СИСТЕМНОЕ ПРЕДУПРЕЖДЕНИЕ" if result["decision"] == "FORGIVENESS" else "СИСТЕМНОЕ НАРУШЕНИЕ",
            "phase": result["phase"],
            "notification_type": result["notification_type"],
        }
        if result.get("sandbox") and result["decision"] == "PUNISHMENT":
            # The real runtime persists its notice in GameLogic. Sandbox must
            # mirror the presentation without touching persistent player data.
            self.evt003_sandbox_pending_notice = dict(self.evt003_dialog_payload)
        if result["decision"] == "FORGIVENESS":
            self.evt003_state = "FORGIVENESS_DIALOG"
            self.audio_box.play_evt003_reprimand()
        else:
            self.evt003_state = "GAME_OVER"
            self.evt003_gameover_started_at = time.monotonic()
            self.audio_box.play_evt003_failure()

    def _evt003_acknowledge_dialog(self):
        state = self.evt003_state
        if state == "PENDING_NOTICE":
            if self.evt003_is_sandbox:
                self.evt003_sandbox_pending_notice = None
            else:
                self.game_logic.consume_evt003_pending_notification()
        was_sandbox = self.evt003_is_sandbox
        self.evt003_state = None
        self.evt003_instance_id = None
        self.evt003_dialog_payload = None
        self.evt003_ok_rect = None
        self.evt003_is_sandbox = False
        if was_sandbox:
            self._evt003_schedule_phase(self.game_logic.get_phase())
        self.audio_box.play_click()

    def _evt003_cancel_sandbox(self):
        instance_id = self.evt003_instance_id
        try:
            if instance_id:
                self.evt003_runtime.cancel(instance_id, reason="ADMIN_SANDBOX_ESCAPE")
        except Exception as exc:
            self._log_exception("EVT003_SANDBOX_CANCEL", exc)
        self.evt003_instance_id = None
        self.evt003_state = None
        self.evt003_dialog_payload = None
        self.evt003_ok_rect = None
        self.evt003_typewriter_count = 0
        self.evt003_is_sandbox = False
        self._evt003_schedule_phase(self.game_logic.get_phase())
        self._show_notification("EVT_003 SANDBOX: тест отменён; сохранения не изменены.", duration=2200)

    def _handle_evt003_event(self, event):
        """Exclusive input path while the check, animation or Win95 dialog is active."""
        if event.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode(
                (event.w, event.h), pygame.FULLSCREEN | pygame.DOUBLEBUF | pygame.OPENGL
            )
            self._setup_menu_hitboxes()
            self.game_view.width, self.game_view.height = event.w, event.h
            self.game_view.recalculate_layout()
            return
        if self.evt003_is_sandbox and event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
            self._evt003_cancel_sandbox()
            return
        if self.evt003_state == "RUNNING":
            if event.type in (pygame.MOUSEBUTTONDOWN, pygame.MOUSEWHEEL):
                # At/after the 30-second deadline the check has already succeeded;
                # do not turn a late event-queue delivery into a false violation.
                if time.monotonic() - self.evt003_started_at >= self.evt003_runtime.duration_seconds:
                    self._update_evt003()
                else:
                    self._evt003_violation()
            return
        if self.evt003_state in ("FORGIVENESS_DIALOG", "PENDING_NOTICE"):
            acknowledge = event.type == pygame.KEYDOWN and event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE)
            if event.type == pygame.MOUSEBUTTONDOWN and self.evt003_ok_rect:
                win_w, win_h = self.screen.get_size()
                tex_w, tex_h = self.screen_texture.size
                pos = (
                    int(event.pos[0] * tex_w / max(1, win_w)),
                    int(event.pos[1] * tex_h / max(1, win_h)),
                )
                acknowledge = self.evt003_ok_rect.collidepoint(pos)
            if acknowledge:
                self._evt003_acknowledge_dialog()
            return
        # The punishment animation is intentionally non-interactive.
        return

    def _update_evt003(self):
        now = time.monotonic()
        if self.evt003_state == "RUNNING":
            elapsed = max(0.0, now - self.evt003_started_at)
            newly_revealed = self.evt003_typewriter.advance(now)
            self.evt003_typewriter_count = self.evt003_typewriter.visible_count
            for _ in range(newly_revealed):
                self.audio_box.play_typewriter_tick()
            try:
                outcome = self.evt003_runtime.update(self.evt003_instance_id)
            except Exception as exc:
                self._log_exception("EVT003_COMPLIANCE_SAVE", exc)
                was_sandbox = self.evt003_is_sandbox
                try:
                    self.evt003_runtime.cancel(self.evt003_instance_id, reason="PRESENTATION_RECOVERY")
                except Exception:
                    pass
                self.evt003_instance_id = None
                self.evt003_state = None
                self.evt003_is_sandbox = False
                self._show_notification("EVT_003: ошибка. Подробности: F2 → ЖУРНАЛ.", duration=3500)
                if was_sandbox:
                    self._evt003_schedule_phase(self.game_logic.get_phase())
                return
            if outcome is not None:
                was_sandbox = self.evt003_is_sandbox
                self.evt003_instance_id = None
                self.evt003_state = None
                self.evt003_typewriter_count = 0
                self.audio_box.play_evt003_success()
                if was_sandbox:
                    self.evt003_is_sandbox = False
                    self._evt003_schedule_phase(self.game_logic.get_phase())
                    self._show_notification("SANDBOX: COMPLIANCE · баланс и история не изменены.", duration=2600)
                else:
                    self.evt003_next_check_at = float("inf")
            return
        if self.evt003_state == "GAME_OVER":
            progress = (now - self.evt003_gameover_started_at) / 2.35
            if progress >= 1.0:
                was_sandbox = self.evt003_is_sandbox
                self.evt003_state = None
                self.evt003_dialog_payload = None
                self.evt003_instance_id = None
                self.evt003_is_sandbox = False
                if was_sandbox:
                    # Sandbox isolates persistent balance/history, not the visible game-over flow.
                    self._evt003_schedule_phase(self.game_logic.get_phase())
                    self.admin_panel_open = False
                self.current_screen = "menu"
                self.audio_box.play_menu_music()
            return

    def _update_game(self):
        if self.evt004_result_state is not None:
            self._update_evt004_result_screen()
            return
        if self.event_collection_open or self.secret_input_open:
            return
        if self.evt004_runtime is not None:
            self._update_evt004(self.clock.get_time() / 1000.0)
            # EVT004 has an exclusive main_gameplay claim; do not tick normal gameplay underneath it.
            return
        if self.evt003_state is not None:
            self._update_evt003()
            return
        self._maybe_start_evt003()
        if self.evt003_state is not None:
            return
        if self.game_logic.word_shock_active or self.event_lifecycle.is_tracked("EVT_002_WORD_SHOCK"):
            self._sync_managed_word_shock()
        if self.game_logic.word_shock_active:
            word_shock_update = self.game_logic.update_word_shock()
            if word_shock_update == "MODAL_OPEN":
                pygame.key.start_text_input()
            elif word_shock_update == "EXPIRED":
                pygame.key.stop_text_input()
                self._sync_managed_word_shock()
            return
        now = pygame.time.get_ticks()
        dt = self.clock.get_time() / 1000.0
        self._update_hidden_system(dt)
        self._update_code_init(dt)
        
        # Отслеживаем завершение погони, чтобы проиграть звук ухода планеты
        # только при истечении таймера, а не после успешного захвата.
        chase_was_active = self.game_logic.sprite_active
        chase_timer_was_active = self.game_logic.timer_active

        # Оптимизация: GameLogic.update() вызываем с dt для возможности throttling
        self.game_logic.update()
        self._sync_managed_roach_attack()
        sequence_update = self.game_logic.update_roach_sequence()
        if sequence_update == "ROACH_TRIGGER":
            self._start_roach_attack()
        _roach_mode_blocked = (
            self.game_logic.minigame_active
            or self.game_logic.timer_active
            or self.game_logic.sprite_active
            or self.game_logic.chase_planet_active
            or self.game_logic.fade_screen_active
            or self.game_logic.clicks_in_cycle >= 10
        )
        if self.game_logic.roach_attack_active and not _roach_mode_blocked:
            _roach_forbidden = self.game_view.rect_target.inflate(170, 150)
            _win_w, _win_h = self.screen.get_size()
            _tex_w, _tex_h = self.screen_texture.size
            _mouse = pygame.mouse.get_pos()
            _cursor_tex = (
                int(_mouse[0] * (_tex_w / max(1, _win_w))),
                int(_mouse[1] * (_tex_h / max(1, _win_h))),
            )
            self.game_logic.update_roaches(
                dt, self.game_view.width, self.game_view.height,
                _roach_forbidden, cursor_pos=_cursor_tex,
            )
        self._sync_roach_audio()

        if (
            chase_was_active
            and chase_timer_was_active
            and not self.game_logic.sprite_active
            and self.game_logic.fade_screen_active
        ):
            self.audio_box.play_chase_planet("escape")

        self.game_view.update_animations()
        
        # Оптимизация CPU: обновляем уведомления и horror-фразы не каждый кадр, а раз в ~200 мс
        if now - getattr(self, '_last_notification_update', 0) >= 200:
            self._last_notification_update = now
            
