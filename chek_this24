        draw_wrapped_text(
            surface,
            font,
            item["description"],
            TEXT_COLOR,
            x + 225,
            y + 65,
            195,
            line_gap=4
        )

    draw_centered_text(
        surface,
        font,
        "СТРЕЛКИ — выбор     ENTER — подтвердить     1–4 — быстрый выбор",
        MUTED_COLOR,
        (WIDTH // 2, HEIGHT - 12)
    )


# ============================================================
# ОСНОВНАЯ СЦЕНА
# ============================================================

def main():
    pygame.init()

    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    pygame.display.set_caption(
        "PALCHIK — EVT_005: Найди сладкий рулет"
    )

    clock = pygame.time.Clock()

    speaker_font = load_font(19)
    message_font = load_font(22)
    small_font = load_font(17)
    tooltip_font = load_font(14)
    title_font = load_font(25)

    for path in (
        ROOM_PATH,
        KITCHEN_PATH,
        CHIBI_PATH,
        KITCHEN_ITEMS_PATH_1,
        KITCHEN_ITEMS_PATH_2,
        FONT_PATH,
    ):
        if not path.is_file():
            raise FileNotFoundError(f"Не найден ресурс: {path}")

    room = load_room()
    kitchen_room = load_kitchen_room()
    kitchen_item_sprites = load_kitchen_item_sprites()
    emotions = load_dinara()
    class_images = load_class_images()

    neutral = emotions["base"]
    silhouette = make_silhouette(neutral)

    # Free-roam kitchen uses the separate chibi artwork.
    chibi_dinara_source = load_image(CHIBI_PATH)
    kitchen_dinara_image = fit_image(
        chibi_dinara_source,
        *KITCHEN_DINARA_MAX_SIZE
    )

    kitchen_class_images = [
        fit_image(image, *KITCHEN_PLAYER_MAX_SIZE)
        if image is not None else None
        for image in class_images
    ]

    kitchen_items = build_kitchen_items(kitchen_item_sprites)

    # --------------------------------------------------------
    # Состояние
    # --------------------------------------------------------

    stage = "narrator_intro_pause"

    narrator_intro_elapsed = 0.0
    narrator_index = 0

    dialogue_index = 0
    dialogue_elapsed = 0.0

    dialogue = []
    dialogue_next_stage = None

    white_elapsed = 0.0
    shake_line_index = 0

    room_elapsed = 0.0

    inspection_pause_elapsed = 0.0
    greeting_laugh_elapsed = 0.0
    greeting_return_elapsed = 0.0

    player_name = ""
    greeting_index = 0
    selected_class = 0
    selected_class_data = None

    current_emotion = "base"

    kitchen_player_x = float(KITCHEN_PLAYER_FOOT[0])
    kitchen_player_y = float(KITCHEN_PLAYER_FOOT[1])
    kitchen_move_target = None
    kitchen_target_item_id = None
    kitchen_inventory = []
    kitchen_pickup_notice = ""
    kitchen_pickup_notice_timer = 0.0

    running = True

    # --------------------------------------------------------
    # Единая последовательность диалогов
    # --------------------------------------------------------

    def set_dialogue(lines, next_stage):
        nonlocal dialogue
        nonlocal dialogue_index
        nonlocal dialogue_elapsed
        nonlocal dialogue_next_stage

        dialogue = lines
        dialogue_index = 0
        dialogue_elapsed = 0.0
        dialogue_next_stage = next_stage

    def current_line():
        if not dialogue:
            return None

        if dialogue_index < 0 or dialogue_index >= len(dialogue):
            return None

        return dialogue[dialogue_index]

    def advance_dialogue():
        nonlocal dialogue_index
        nonlocal dialogue_elapsed
        nonlocal stage
        nonlocal current_emotion

        line = current_line()

        if line is None:
            return

        # Первое нажатие после начала печати:
        # показать всю текущую реплику.
        if visible_character_count(
            line["text"],
            dialogue_elapsed
        ) < len(line["text"]):

            dialogue_elapsed = text_duration(line["text"]) + 1.0
            return

        # Следующее нажатие — следующая реплика.
        dialogue_index += 1
        dialogue_elapsed = 0.0

        next_line = current_line()

        if next_line is not None:
            current_emotion = next_line.get(
                "emotion",
                current_emotion
            )
            return

        stage = dialogue_next_stage

        if stage == "name_input":
            pygame.key.start_text_input()

        if stage == "inspection_pause":
            nonlocal inspection_pause_elapsed
            inspection_pause_elapsed = 0.0
            current_emotion = "base"

    # --------------------------------------------------------
    # Переходы сценария
    # --------------------------------------------------------

    def begin_white_shake():
        nonlocal stage
        nonlocal shake_line_index
        nonlocal white_elapsed

        stage = "white_shake"
        shake_line_index = 0
        white_elapsed = 0.0

    def begin_room():
        nonlocal stage
        nonlocal room_elapsed

        stage = "room_reveal"
        room_elapsed = 0.0

    def begin_dinara_dialogue():
        nonlocal stage
        nonlocal current_emotion

        stage = "dinara_dialogue"
        current_emotion = "недовольна"

        set_dialogue(
            [
                {
                    "speaker": "Динара",
                    "text": "Наконец-то ты проснулся!",
                    "emotion": "недовольна",
                },
                {
                    "speaker": "Динара",
                    "text": "Я целый час пытаюсь тебя разбудить!",
                    "emotion": "недовольна",
                },

                # Рассказчик: игрок постепенно приходит в себя.
                {
                    "speaker": "Рассказчик",
                    "text": "Вы еле-еле смогли протереть свои глаза",
                    "emotion": "base",
                },
                {
                    "speaker": "Рассказчик",
                    "text": "Девушка приютившая вас, была явно не довольна тем,",
                    "emotion": "base",
                },
                {
                    "speaker": "Рассказчик",
                    "text": "Что вы так долго спите.",
                    "emotion": "base",
                },

                # Игрок.
                {
                    "speaker": "Игрок",
                    "text": "Ох... извините, *зевок*",
                    "emotion": "base",
                },
                {
                    "speaker": "Игрок",
                    "text": "Я был так вымотан...",
                    "emotion": "base",
                },

                # Рассказчик замечает взгляд Динары.
                {
                    "speaker": "Рассказчик",
                    "text": "Вы ловите на себе оценивающий взгляд,",
                    "emotion": "base",
                },
                {
                    "speaker": "Рассказчик",
                    "text": "От которого вам стало не по себе",
                    "emotion": "base",
                },

                {
                    "speaker": "Динара",
                    "text": "Да...",
                    "emotion": "base",
                },
            ],
            "inspection_pause"
        )

    def begin_after_inspection_pause():
        nonlocal stage
        nonlocal current_emotion

        stage = "dinara_dialogue"
        current_emotion = "base"

        set_dialogue(
            [
                {
                    "speaker": "Динара",
                    "text": "Ты и правда выглядишь потрёпанным.",
                    "emotion": "base",
                },
                {
                    "speaker": "Игрок",
                    "text": "...",
                    "emotion": "base",
                },
                {
                    "speaker": "Динара",
                    "text": "Как тебя хоть зовут?",
                    "emotion": "вопрос",
                },
            ],
            "name_input"
        )

    def begin_name_introduction():
        nonlocal stage
        nonlocal current_emotion

        stage = "name_introduction"
        current_emotion = "base"

        set_dialogue(
            [
                {
                    "speaker": "Динара",
                    "text": f"Вот как... {player_name}.",
                    "emotion": "base",
                },
                {
                    "speaker": "Динара",
                    "text": "Что ж, я слышала имена и получше...",
                    "emotion": "base",
                },
                {
                    "speaker": "Динара",
                    "text": "Меня зовут Динара Рыжая.",
                    "emotion": "base",
                },
                {
                    "speaker": "Динара",
                    "text": "Можно просто Ди.",
                    "emotion": "smile",
                },
            ],
            "greeting"
        )

    def begin_greeting_response(index):
        nonlocal stage
        nonlocal greeting_index
        nonlocal current_emotion

        greeting_index = index

        selected = GREETING_CHOICES[index]

        stage = "after_greeting"
        current_emotion = "base"

        lines = []

        for sentence in selected[1]:
            lines.append({
                "speaker": player_name,
                "text": sentence,
                "emotion": "base",
            })

        # После последней реплики игрока запускается
        # отдельная сцена молчаливого смеха Динары.
        set_dialogue(lines, "greeting_laugh")

    def begin_class_dialogue():
        nonlocal stage
        nonlocal current_emotion

        stage = "class_dialogue"
        current_emotion = "base"

        set_dialogue(
            [
                {
                    "speaker": "Динара",
                    "text": "Чтож, расскажи о себе, герой...",
                    "emotion": "вопрос",
                }
            ],
            "class_select"
        )

    def confirm_class():
        nonlocal stage
        nonlocal selected_class_data
        nonlocal current_emotion
        nonlocal kitchen_player_x
        nonlocal kitchen_player_y
        nonlocal kitchen_items
        nonlocal kitchen_move_target
        nonlocal kitchen_target_item_id
        nonlocal kitchen_inventory
        nonlocal kitchen_pickup_notice
        nonlocal kitchen_pickup_notice_timer

        selected_class_data = CLASSES[selected_class]
        kitchen_player_x = float(KITCHEN_PLAYER_FOOT[0])
        kitchen_player_y = float(KITCHEN_PLAYER_FOOT[1])
        kitchen_items = build_kitchen_items(kitchen_item_sprites)
        kitchen_move_target = None
        kitchen_target_item_id = None
        kitchen_inventory.clear()
        kitchen_pickup_notice = ""
        kitchen_pickup_notice_timer = 0.0

        stage = "class_confirmed"
        current_emotion = "base"

        class_name = selected_class_data["name"].lower()

        # Здесь сценарий останавливается.
        # Продолжение истории пока не добавляется.
        set_dialogue(
            [
                {
                    "speaker": player_name,
                    "text": "Мне особо нечего рассказать о себе...",
                    "emotion": "base",
                },
                {
                    "speaker": player_name,
                    "text": f"Я {class_name}.",
                    "emotion": "base",
                },
            ],
            "kitchen_scene"
        )

    # --------------------------------------------------------
    # Общий обработчик продолжения
    # SPACE и ЛКМ вызывают именно эту функцию.
    # --------------------------------------------------------

    def advance_action():
        nonlocal narrator_index
        nonlocal dialogue_elapsed
        nonlocal shake_line_index
        nonlocal white_elapsed
        nonlocal stage

        if stage in (
            "narrator_intro_pause",
            "inspection_pause",
            "greeting_laugh",
            "greeting_return",
        ):
            return

        if stage == "narrator":
            text = NARRATOR_LINES[narrator_index]

            if visible_character_count(
                text,
                dialogue_elapsed
            ) < len(text):
                dialogue_elapsed = text_duration(text) + 1.0
                return

            narrator_index += 1
            dialogue_elapsed = 0.0

            if narrator_index >= len(NARRATOR_LINES):
                begin_white_shake()

            return

        if stage == "white_shake":
            text = WAKE_LINES[shake_line_index]

            if visible_character_count(
                text,
                white_elapsed
            ) < len(text):
                white_elapsed = text_duration(text) + 1.0
                return

            shake_line_index += 1
            white_elapsed = 0.0

            if shake_line_index >= len(WAKE_LINES):
                begin_room()

            return

        if stage in (
            "dinara_dialogue",
            "name_introduction",
            "after_greeting",
            "class_dialogue",
            "class_confirmed",
        ):
            advance_dialogue()

    # --------------------------------------------------------
    # Сброс
    # --------------------------------------------------------

    def reset_scene():
        nonlocal stage
        nonlocal narrator_intro_elapsed
        nonlocal narrator_index
        nonlocal dialogue_index
        nonlocal dialogue_elapsed
        nonlocal dialogue
        nonlocal dialogue_next_stage
        nonlocal white_elapsed
        nonlocal shake_line_index
        nonlocal room_elapsed
        nonlocal inspection_pause_elapsed
        nonlocal greeting_laugh_elapsed
        nonlocal greeting_return_elapsed
        nonlocal player_name
        nonlocal greeting_index
        nonlocal selected_class
        nonlocal selected_class_data
        nonlocal current_emotion

        stage = "narrator_intro_pause"

        narrator_intro_elapsed = 0.0
        narrator_index = 0

        dialogue_index = 0
        dialogue_elapsed = 0.0

        dialogue = []
        dialogue_next_stage = None

        white_elapsed = 0.0
        shake_line_index = 0
        room_elapsed = 0.0

        inspection_pause_elapsed = 0.0
        greeting_laugh_elapsed = 0.0
        greeting_return_elapsed = 0.0

        player_name = ""
        greeting_index = 0
        selected_class = 0
        selected_class_data = None

        current_emotion = "base"

    # --------------------------------------------------------
    # Информация о запуске
    # --------------------------------------------------------

    print()
    print("=" * 60)
    print("PALCHIK EVT_005 — SWEET ROLL")
    print("=" * 60)
    print("Эмоций Динары:", len(emotions))
    print(
        "Изображений классов:",
        sum(image is not None for image in class_images)
    )
    print()
    print("SPACE / ЛКМ — продолжить")
    print("Ввод имени — клавиатура, ENTER")
    print("1–3 / стрелки — выбор приветствия")
    print("Стрелки / 1–4 — выбор класса")
    print("ENTER — подтвердить класс")
    print("КУХНЯ: WASD / СТРЕЛКИ — перемещение")
    print("КУХНЯ: наведение — описание, ЛКМ — подойти и подобрать")
    print("R — перезапуск")
    print("ESC — выход")
    print()

    # --------------------------------------------------------
    # Главный цикл
    # --------------------------------------------------------
    debug_stage = None
    while running:
        dt = min(clock.tick(FPS) / 1000.0, 0.05)

        # ----------------------------------------------------
        # Автоматические временные стадии
        # ----------------------------------------------------

        if stage == "narrator_intro_pause":
            narrator_intro_elapsed += dt

            if narrator_intro_elapsed >= INTRO_PAUSE_DURATION:
                stage = "narrator"
                dialogue_elapsed = 0.0

        elif stage == "narrator":
            dialogue_elapsed += dt

        elif stage == "white_shake":
            white_elapsed += dt

        elif stage == "room_reveal":
            room_elapsed += dt

            # Движение и протирание глаз идут одновременно.
            # Этот эффект оставлен без изменений.
            if room_elapsed >= max(
                MOVEMENT_DURATION,
                EYE_REVEAL_START + EYE_REVEAL_DURATION
            ):
                begin_dinara_dialogue()

        elif stage == "inspection_pause":
            inspection_pause_elapsed += dt

            if inspection_pause_elapsed >= INSPECTION_PAUSE_DURATION:
                begin_after_inspection_pause()

        elif stage == "greeting_laugh":
            greeting_laugh_elapsed += dt

            if greeting_laugh_elapsed >= GREETING_LAUGH_DURATION:
                stage = "greeting_return"
                greeting_return_elapsed = 0.0
                current_emotion = "base"

        elif stage == "greeting_return":
            greeting_return_elapsed += dt

            if greeting_return_elapsed >= GREETING_RETURN_DURATION:
                begin_class_dialogue()

        elif stage in (
            "dinara_dialogue",
            "name_introduction",
            "after_greeting",
            "class_dialogue",
            "class_confirmed",
        ):
            dialogue_elapsed += dt

        # ----------------------------------------------------
        # События
        # ----------------------------------------------------

        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                running = False

            elif event.type == pygame.KEYDOWN:

                if event.key == pygame.K_ESCAPE:
                    running = False
                    continue

                # Ввод имени имеет приоритет над горячими клавишами.
                if stage == "name_input":

                    if event.key == pygame.K_BACKSPACE:
                        player_name = player_name[:-1]

                    elif event.key == pygame.K_RETURN:
                        cleaned = player_name.strip()

                        if cleaned:
                            player_name = cleaned
                            pygame.key.stop_text_input()
                            begin_name_introduction()

                    continue

                # Перезапуск доступен вне ввода имени.
                if event.key == pygame.K_r:
                    reset_scene()
                    pygame.key.stop_text_input()
                    continue

                if event.key == pygame.K_SPACE:
                    advance_action()
                    continue

                # Выбор приветствия.
                if stage == "greeting":

                    if event.key in (
                        pygame.K_LEFT,
                        pygame.K_UP
                    ):
                        greeting_index = (
                            greeting_index - 1
                        ) % len(GREETING_CHOICES)

                    elif event.key in (
                        pygame.K_RIGHT,
                        pygame.K_DOWN
                    ):
                        greeting_index = (
                            greeting_index + 1
                        ) % len(GREETING_CHOICES)

                    elif event.key in (
                        pygame.K_1,
                        pygame.K_2,
                        pygame.K_3
                    ):
                        greeting_index = event.key - pygame.K_1
                        begin_greeting_response(greeting_index)

                    elif event.key == pygame.K_RETURN:
                        begin_greeting_response(greeting_index)

                    continue

                # Выбор класса.
                if stage == "class_select":

                    if event.key in (
                        pygame.K_LEFT,
                        pygame.K_UP
                    ):
                        selected_class = (
                            selected_class - 1
                        ) % len(CLASSES)

                    elif event.key in (
                        pygame.K_RIGHT,
                        pygame.K_DOWN
                    ):
                        selected_class = (
                            selected_class + 1
                        ) % len(CLASSES)

                    elif event.key in (
                        pygame.K_1,
                        pygame.K_2,
                        pygame.K_3,
                        pygame.K_4
                    ):
                        selected_class = event.key - pygame.K_1

                    elif event.key == pygame.K_RETURN:
                        confirm_class()

                    continue

            elif event.type == pygame.TEXTINPUT:

                if stage == "name_input":
                    candidate = player_name + event.text

                    if len(candidate) <= 18:
                        if all(
                            character.isprintable()
                            for character in event.text
                        ):
                            player_name = candidate

            elif event.type == pygame.MOUSEBUTTONDOWN:

                if event.button != 1:
                    continue

                if stage == "greeting":

                    for index in range(len(GREETING_CHOICES)):
                        rect = pygame.Rect(
                            180,
                            170 + index * 65,
                            600,
                            55
                        )

                        if rect.collidepoint(event.pos):
                            begin_greeting_response(index)
                            break

                    continue

                if stage == "class_select":

                    for index, (x, y) in enumerate(CLASS_POSITIONS):
                        rect = pygame.Rect(x, y, 440, 220)

                        if rect.collidepoint(event.pos):
                            if selected_class == index:
                                confirm_class()
                            else:
                                selected_class = index
                            break

                    continue

                if stage == "name_input":
                    continue

                if stage == "kitchen_scene":
                    clicked_item = None

                    for item in reversed(kitchen_items):
                        hit_rect = item["rect"].inflate(14, 14)
                        if hit_rect.collidepoint(event.pos):
                            clicked_item = item
                            break

                    if clicked_item is not None:
                        kitchen_move_target = clicked_item["approach"]
                        kitchen_target_item_id = clicked_item["id"]
                    else:
                        kitchen_move_target = None
                        kitchen_target_item_id = None

                    continue

                advance_action()

        # ----------------------------------------------------
        # Kitchen free-roam movement
        # ----------------------------------------------------

        if stage == "kitchen_scene":
            keys = pygame.key.get_pressed()

            move_x = (
                int(keys[pygame.K_RIGHT] or keys[pygame.K_d])
                - int(keys[pygame.K_LEFT] or keys[pygame.K_a])
            )

            move_y = (
                int(keys[pygame.K_DOWN] or keys[pygame.K_s])
                - int(keys[pygame.K_UP] or keys[pygame.K_w])
            )

            if move_x or move_y:
                # Manual movement cancels automatic item approach.
                kitchen_move_target = None
                kitchen_target_item_id = None

                magnitude = math.hypot(move_x, move_y)
                step = KITCHEN_PLAYER_SPEED * dt / magnitude
                kitchen_player_x += move_x * step
                kitchen_player_y += move_y * step

                kitchen_player_x = clamp(
                    kitchen_player_x,
                    *KITCHEN_PLAYER_X_BOUNDS
                )
                kitchen_player_y = clamp(
                    kitchen_player_y,
                    *KITCHEN_PLAYER_Y_BOUNDS
                )

            elif kitchen_move_target is not None:
                target_x, target_y = kitchen_move_target
                dx = target_x - kitchen_player_x
                dy = target_y - kitchen_player_y
                distance = math.hypot(dx, dy)

                if distance <= KITCHEN_ITEM_ARRIVAL_RADIUS:
                    kitchen_player_x = target_x
                    kitchen_player_y = target_y

                    target_item = next(
                        (
                            item for item in kitchen_items
                            if item["id"] == kitchen_target_item_id
                        ),
                        None
                    )

                    if target_item is not None:
                        approach_x, approach_y = target_item["approach"]
                        actual_distance = math.hypot(
                            kitchen_player_x - approach_x,
                            kitchen_player_y - approach_y
                        )

                        # Pickup is allowed only after reaching the approach point.
                        if actual_distance <= KITCHEN_ITEM_INTERACTION_RADIUS:
                            kitchen_inventory.append(target_item["id"])
                            kitchen_pickup_notice = "Подобрано: " + target_item["name"]
                            kitchen_pickup_notice_timer = 1.8
                            kitchen_items.remove(target_item)

                    kitchen_move_target = None
                    kitchen_target_item_id = None

                elif distance > 0.0:
                    step = min(KITCHEN_ITEM_SPEED * dt, distance)
                    kitchen_player_x += dx / distance * step
                    kitchen_player_y += dy / distance * step

                    kitchen_player_x = clamp(
                        kitchen_player_x,
                        *KITCHEN_PLAYER_X_BOUNDS
                    )
                    kitchen_player_y = clamp(
                        kitchen_player_y,
                        *KITCHEN_PLAYER_Y_BOUNDS
                    )

            if kitchen_pickup_notice_timer > 0.0:
                kitchen_pickup_notice_timer = max(
                    0.0,
                    kitchen_pickup_notice_timer - dt
                )

        if stage != debug_stage:
            debug_stage = stage
            print(
                f"[STAGE] {stage!r} | "
                f"room_size={room.get_size()} | "
                f"room_pixel={room.get_at((10, 10))}"
            )

        # ----------------------------------------------------
        # Отрисовка
        # ----------------------------------------------------

        frame = pygame.Surface((WIDTH, HEIGHT))
        frame.fill(BLACK)

        # ----------------------------------------------------
        # Начальная пауза перед рассказчиком
        # ----------------------------------------------------

        if stage == "narrator_intro_pause":
            frame.fill(BLACK)

        # ----------------------------------------------------
        # Рассказчик
        # ----------------------------------------------------

        elif stage == "narrator":

            frame.fill(BLACK)

            message = NARRATOR_LINES[narrator_index]

            draw_dialogue_panel(
                frame,
                speaker_font,
                message_font,
                "Рассказчик",
                message,
                dialogue_elapsed
            )

        # ----------------------------------------------------
        # Белый экран и тряска
        # ----------------------------------------------------

        elif stage == "white_shake":

            frame.fill(WHITE)

            message = WAKE_LINES[shake_line_index]

            draw_dialogue_panel(
                frame,
                speaker_font,
                message_font,
                "Игрок",
                message,
                white_elapsed,
                show_full=False
            )

        # ----------------------------------------------------
        # Комната и пробуждение
        # ----------------------------------------------------

        elif stage == "room_reveal":

            frame.blit(room, (0, 0))

            movement_progress = ease_in_out(
                room_elapsed / MOVEMENT_DURATION
            )

            x = START_X + (
                END_X - START_X
            ) * movement_progress

            y = START_Y + (
                END_Y - START_Y
            ) * movement_progress

            # Сначала силуэт.
            draw_character(
                frame,
                silhouette,
                x,
                y
            )

            # Цветное изображение постепенно проявляется
            # одновременно с эффектом пробуждения.
            reveal_elapsed = max(
                0.0,
                room_elapsed - EYE_REVEAL_START
            )

            reveal_progress = ease_in_out(
                reveal_elapsed / EYE_REVEAL_DURATION
            )

            draw_character(
                frame,
                neutral,
                x,
                y,
                alpha=int(255 * reveal_progress)
            )

            draw_eye_reveal(frame, room_elapsed)

        # ----------------------------------------------------
        # Пауза после «Да...»
        # ----------------------------------------------------

        elif stage == "inspection_pause":

            frame.blit(room, (0, 0))

            draw_character(
                frame,
                neutral,
                END_X,
                END_Y
            )

        # ----------------------------------------------------
        # Молчаливый смех Динары
        # ----------------------------------------------------

        elif stage == "greeting_laugh":

            frame.blit(room, (0, 0))

            draw_character(
                frame,
                emotions.get("Счастье", neutral),
                END_X,
                END_Y
            )

        # ----------------------------------------------------
        # Динара возвращается к обычному выражению лица
        # ----------------------------------------------------

        elif stage == "greeting_return":

            frame.blit(room, (0, 0))

            draw_character(
                frame,
                neutral,
                END_X,
                END_Y
            )

        # ----------------------------------------------------
        # Сцены с Динарой
        # ----------------------------------------------------

        elif stage in (
            "dinara_dialogue",
            "name_input",
            "name_introduction",
            "greeting",
            "after_greeting",
            "class_dialogue",
        ):

            frame.blit(room, (0, 0))

            if stage == "name_input":
                emotion_image = emotions.get(
                    "вопрос",
                    neutral
                )

            elif stage == "greeting":
                emotion_image = emotions.get(
                    "smile",
                    neutral
                )

            else:
                line = current_line()

                emotion_name = (
                    line.get("emotion", current_emotion)
                    if line else current_emotion
                )

                emotion_image = emotions.get(
                    emotion_name,
                    neutral
                )

            draw_character(
                frame,
                emotion_image,
                END_X,
                END_Y
            )

            # Ввод имени.
            if stage == "name_input":

                draw_dialogue_panel(
                    frame,
                    speaker_font,
                    message_font,
                    "Игрок",
                    "Меня зовут...",
                    99999.0,
                    allow_continue=False,
                    show_full=True
                )

                input_rect = pygame.Rect(
                    190, 230, 580, 65
                )

                pygame.draw.rect(
                    frame,
                    (15, 20, 34),
                    input_rect,
                    border_radius=6
                )

                pygame.draw.rect(
                    frame,
                    GOLD,
                    input_rect,
                    width=2,
                    border_radius=6
                )

                name_text = player_name

                if int(pygame.time.get_ticks() / 500) % 2 == 0:
                    name_text += "|"

                draw_centered_text(
                    frame,
                    message_font,
                    name_text,
                    TEXT_COLOR,
                    input_rect.center
                )

                draw_centered_text(
                    frame,
                    small_font,
                    "Введи имя и нажми ENTER",
                    MUTED_COLOR,
                    (WIDTH // 2, 315)
                )

            # Выбор приветствия.
            elif stage == "greeting":

                draw_dialogue_panel(
                    frame,
                    speaker_font,
                    message_font,
                    "Динара",
                    "Ну что, как тебе моё имя?",
                    99999.0,
                    show_full=True
                )

                draw_greeting_choices(
                    frame,
                    small_font,
                    greeting_index
                )

            # Обычные диалоги.
            else:

                line = current_line()

                if line is not None:

                    draw_dialogue_panel(
                        frame,
                        speaker_font,
                        message_font,
                        line["speaker"],
                        line["text"],
                        dialogue_elapsed
                    )

        # ----------------------------------------------------
        # Выбор класса
        # ----------------------------------------------------

        elif stage == "class_select":

            draw_class_selection(
                frame,
                title_font,
                small_font,
                class_images,
                selected_class
            )

        # ----------------------------------------------------
        # Последние согласованные реплики
        # ----------------------------------------------------

        elif stage == "kitchen_scene":

            frame.blit(kitchen_room, (0, 0))

            # World items are drawn over the background, behind characters.
            mouse_pos = pygame.mouse.get_pos()
            hovered_item = None

            for item in kitchen_items:
                item_rect = item["image"].get_rect(center=item["position"])
                item["rect"] = item_rect
                frame.blit(item["image"], item_rect)

                if item_rect.collidepoint(mouse_pos):
                    hovered_item = item

            player_image = kitchen_class_images[selected_class]
            player_foot_x = round(kitchen_player_x)
            player_foot_y = round(kitchen_player_y)
            dinara_foot_y = KITCHEN_DINARA_FOOT[1]

            # Depth sorting: lower foot position is closer to the camera.
            if player_foot_y < dinara_foot_y:
                draw_ground_character(
                    frame, player_image, player_foot_x, player_foot_y
                )
                draw_ground_character(
                    frame, kitchen_dinara_image, *KITCHEN_DINARA_FOOT
                )
            else:
                draw_ground_character(
                    frame, kitchen_dinara_image, *KITCHEN_DINARA_FOOT
                )
                draw_ground_character(
                    frame, player_image, player_foot_x, player_foot_y
                )

            # Visible destination marker while the hero is approaching an item.
            if kitchen_move_target is not None:
                marker = (
                    round(kitchen_move_target[0]),
                    round(kitchen_move_target[1])
                )
                pygame.draw.circle(frame, GOLD, marker, 12, 2)
                pygame.draw.circle(frame, GOLD, marker, 3)

            # Compact inventory count for this pickup prototype.
            inventory_panel = pygame.Rect(14, 14, 156, 30)
            pygame.draw.rect(frame, (15, 20, 34), inventory_panel, border_radius=5)
            pygame.draw.rect(frame, PANEL_OUTER_BORDER, inventory_panel, 1, border_radius=5)
            inventory_text = small_font.render(
                f"Предметов: {len(kitchen_inventory)}", True, TEXT_COLOR
            )
            frame.blit(inventory_text, (inventory_panel.x + 9, inventory_panel.y + 6))

            # Hover outline and compact item description.
            if hovered_item is not None:
                highlight = hovered_item["rect"].inflate(10, 10)
                pygame.draw.rect(frame, GOLD, highlight, 2, border_radius=5)

                tooltip_width = 238
                tooltip_height = 78
                tooltip_x = clamp(
                    mouse_pos[0] + 15, 8, WIDTH - tooltip_width - 8
                )
                tooltip_y = clamp(
                    mouse_pos[1] + 15, 8, HEIGHT - tooltip_height - 8
                )
                tooltip_rect = pygame.Rect(
                    tooltip_x, tooltip_y, tooltip_width, tooltip_height
                )
                pygame.draw.rect(frame, (15, 20, 34), tooltip_rect, border_radius=5)
                pygame.draw.rect(frame, PANEL_OUTER_BORDER, tooltip_rect, 1, border_radius=5)

                title_surface = small_font.render(
                    hovered_item["name"], True, GOLD
                )
                frame.blit(title_surface, (tooltip_x + 9, tooltip_y + 6))

                description_lines = wrap_text(
                    tooltip_font,
                    hovered_item["description"],
                    tooltip_width - 18
                )[:2]

                description_y = tooltip_y + 29
                for description_line in description_lines:
                    description_surface = tooltip_font.render(
                        description_line, True, TEXT_COLOR
                    )
                    frame.blit(
                        description_surface,
                        (tooltip_x + 9, description_y)
                    )
                    description_y += description_surface.get_height() + 1

                hint_surface = tooltip_font.render(
                    "ЛКМ — подойти и подобрать", True, MUTED_COLOR
                )
                frame.blit(
                    hint_surface,
                    (tooltip_x + 9, tooltip_y + tooltip_height - 18)
                )

            if kitchen_pickup_notice_timer > 0.0 and kitchen_pickup_notice:
                notice_surface = small_font.render(
                    kitchen_pickup_notice, True, GOLD
                )
                notice_rect = notice_surface.get_rect(
                    midtop=(WIDTH // 2, 16)
                )
                notice_panel = notice_rect.inflate(22, 12)
                pygame.draw.rect(
                    frame, (15, 20, 34), notice_panel, border_radius=5
                )
                pygame.draw.rect(
                    frame, PANEL_OUTER_BORDER, notice_panel, 1, border_radius=5
                )
                frame.blit(notice_surface, notice_rect)

        elif stage == "class_confirmed":

            frame.blit(room, (0, 0))

            draw_character(
                frame,
                neutral,
                END_X,
                END_Y
            )

            line = current_line()

            if line is not None:
                draw_dialogue_panel(
                    frame,
                    speaker_font,
                    message_font,
                    line["speaker"],
                    line["text"],
                    dialogue_elapsed
                )

        # ----------------------------------------------------
        # Вывод
        # ----------------------------------------------------

        if stage == "white_shake":
            draw_shaken_frame(
                screen,
                frame,
                white_elapsed
            )
        else:
            screen.blit(frame, (0, 0))

        pygame.display.flip()

    pygame.key.stop_text_input()
    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
