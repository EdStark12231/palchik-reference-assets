def clamp(value, minimum, maximum):
    return max(minimum, min(maximum, value))


def ease_in_out(value):
    value = clamp(value, 0.0, 1.0)
    return value * value * (3.0 - 2.0 * value)


def load_font(size):
    if FONT_PATH.is_file():
        try:
            font = pygame.font.Font(str(FONT_PATH), size)

            test = font.metrics(
                "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
                "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
            )

            if test and all(item is not None for item in test):
                return font

            print("[ВНИМАНИЕ] Шрифт не полностью поддерживает кириллицу.")

        except pygame.error:
            pass

    return pygame.font.SysFont("arial", size)


def load_image(path):
    if not path.is_file():
        raise FileNotFoundError(f"Не найден ресурс: {path}")

    return pygame.image.load(str(path)).convert_alpha()


def fit_image(image, max_width, max_height):
    scale = min(
        max_width / image.get_width(),
        max_height / image.get_height()
    )

    size = (
        max(1, round(image.get_width() * scale)),
        max(1, round(image.get_height() * scale))
    )

    return pygame.transform.smoothscale(image, size)


def crop_transparent_bounds(image):
    bounds = image.get_bounding_rect()

    if bounds.width <= 0 or bounds.height <= 0:
        raise ValueError("В изображении отсутствует видимая область.")

    return image.subsurface(bounds).copy()


def make_silhouette(image):
    silhouette = image.copy()
    silhouette.fill(
        (12, 16, 30, 255),
        special_flags=pygame.BLEND_RGBA_MULT
    )
    return silhouette


def wrap_text(font, text, max_width):
    words = text.split()
    lines = []
    current = ""

    for word in words:
        candidate = word if not current else current + " " + word

        if font.size(candidate)[0] <= max_width:
            current = candidate
        else:
            if current:
                lines.append(current)
            current = word

    if current:
        lines.append(current)

    return lines


def draw_centered_text(surface, font, text, color, center):
    rendered = font.render(text, True, color)
    surface.blit(rendered, rendered.get_rect(center=center))


