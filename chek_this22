    def _start_evt003_admin_flow(self, phase, *, sandbox):
        if not self._admin_phase_controls_available():
            self._show_notification("EVT_003 доступен только в игровой сцене.", duration=1800)
            return False
        if self.evt003_state is not None:
            self._show_notification("EVT_003 уже выполняется.", duration=1800)
            return False
        reason = self._evt003_admin_block_reason()
        if reason:
            self._show_notification("EVT_003 нельзя запустить поверх другого игрового режима.", duration=2200)
            return False
        allowed, reason = self.evt003_runtime.can_start(phase, sandbox=sandbox)
        if not allowed:
            message = (
                "EVT_003 уже использовал реальную попытку в этой фазе."
                if reason == "ALREADY_OCCURRED_THIS_PHASE"
                else f"EVT_003 сейчас недоступен: {reason or 'EVENT_BLOCKED'}"
            )
            self._show_notification(message, duration=2600)
            return False
        try:
            instance = self.evt003_runtime.start(phase, sandbox=sandbox)
        except Exception as exc:
            self._log_exception(f"EVT003_ADMIN_START phase={phase} sandbox={sandbox}", exc)
            self._show_notification("EVT_003: не удалось запустить событие. Откройте F2 → ЖУРНАЛ.", duration=2800)
            return False
        self.evt003_instance_id = instance.instance_id
        self.evt003_started_at = float(instance.started_at or time.monotonic())
        self.evt003_typewriter_count = 0
        self.evt003_typewriter.reset(
            "PLEASE DON'T TOUCH ANYTHING", started_at=self.evt003_started_at,
            interval=self.evt003_typewriter_interval,
        )
        self.evt003_dialog_payload = None
        self.evt003_is_sandbox = bool(sandbox)
        self.evt003_state = "RUNNING"
        self.evt003_scheduled_phase = phase
        self.evt003_next_check_at = float("inf")
        return True

