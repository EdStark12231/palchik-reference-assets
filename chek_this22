        if self.roach_sequence_second_clicks:
            if now > self.roach_sequence_second_deadline:
                self._clear_event_sequence()
                return "ROACH_TRIGGER"
            self.roach_sequence_second_clicks += 1
            if self.roach_sequence_second_clicks >= 3:
                self._clear_event_sequence()
                return "WORD_SHOCK_TRIGGER"
            self.roach_sequence_second_deadline = now + 1.0
            return "WORD_SEQUENCE"
        if self.roach_sequence_pending:
            if now < self.roach_sequence_deadline:
                self._clear_event_sequence()
                self.roach_sequence_click_times = [now]
                return "RESET_SEQUENCE"
            if now <= self.roach_sequence_grace_deadline:
                self.roach_sequence_pending = False
                self.roach_sequence_click_times = []
                self.roach_sequence_second_clicks = 1
                self.roach_sequence_second_deadline = now + 1.0
                return "WORD_SEQUENCE"
            self._clear_event_sequence()
            return "ROACH_TRIGGER"
        self.roach_sequence_click_times.append(now)
        if len(self.roach_sequence_click_times) >= 3:
            self.roach_sequence_click_times = []
            self.roach_sequence_pending = True
            self.roach_sequence_deadline = now + self.roach_sequence_pause_duration
            self.roach_sequence_grace_deadline = self.roach_sequence_deadline + 1.0
            return "ROACH_CANDIDATE"
