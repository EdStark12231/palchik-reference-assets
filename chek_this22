        instance = self._active(instance_id)
        elapsed = max(0.0, self.clock() - float(instance.started_at or 0.0))
        if elapsed < self.duration_seconds:
            return None
        phase = instance.data["phase"]
        try:
            if instance.data.get("sandbox"):
                saved = self._sandbox_ledger.record_compliance(phase, instance.instance_id)
            else:
                saved = self.game_logic.record_evt003_compliance(phase, instance.instance_id)
        except Exception:
            self.event_manager.finish(
                instance.instance_id, cancelled=True, reason="COMPLIANCE_SAVE_FAILED"
            )
            raise
        self.event_manager.finish(instance.instance_id, reason="COMPLIANCE")
        return {
            "outcome": "COMPLIANCE", "phase": phase,
            "instance_id": instance.instance_id,
            "recorded": bool(saved.get("recorded")),
        }

