    def register_click(self, instance_id):
        instance = self._active(instance_id)
        phase = instance.data["phase"]
        sandbox = bool(instance.data.get("sandbox"))
        ledger = self._sandbox_ledger if sandbox else self.ledger
        first_violation = ledger.violation_count == 0
        decision = self._select_decision(ledger)
        notice_type = (
            "FORGIVENESS" if decision == "FORGIVENESS"
            else "FIRST_NOTICE" if first_violation
            else "PUNISHMENT"
        )
        notification_text = self.notifications[phase][notice_type]
        pending_notice = {
            "text": notification_text,
            "title": "СИСТЕМНОЕ НАРУШЕНИЕ",
            "phase": phase,
            "notification_type": notice_type,
        }
        try:
            if sandbox:
                result = ledger.resolve_violation(
                    phase, instance.instance_id, decision,
                    current_balance=int(self.game_logic.score),
                )
            else:
                result = self.game_logic.resolve_evt003_violation(
                    phase, instance.instance_id, decision,
                    pending_notification=pending_notice if decision == "PUNISHMENT" else None,
                )
        except Exception:
            self.event_manager.finish(
                instance.instance_id, cancelled=True, reason="VIOLATION_SAVE_FAILED"
            )
            raise
        self.event_manager.finish(instance.instance_id, reason="VIOLATION")
        return {
            "outcome": "VIOLATION", "decision": decision,
            "phase": phase, "instance_id": instance.instance_id,
            "notification_type": notice_type,
            "notification_text": notification_text,
            "penalty_number": result.get("penalty_number"),
            "penalty_percent": result.get("penalty_percent", 0),
            "penalty_amount": result.get("penalty_amount", 0),
            "balance_before": result.get("balance_before"),
            "balance_after": result.get("balance_after"),
            "return_to_menu": decision == "PUNISHMENT",
            "continue_game": decision == "FORGIVENESS",
            "sandbox": sandbox,
        }

