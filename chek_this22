                    if (
                        prompt_due
                        and not self.secret_input_open
                        and not self.game_logic.roach_attack_active
                        and not self.game_logic.minigame_active
                        and not self.game_logic.timer_active
                        and not self.game_logic.sprite_active
                        and not self.game_logic.chase_planet_active
