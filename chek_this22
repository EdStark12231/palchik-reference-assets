    def _handle_evt003_event(self, event):
        """Exclusive input path while the check, animation or Win95 dialog is active."""
        if event.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode(
                (event.w, event.h), pygame.FULLSCREEN | pygame.DOUBLEBUF | pygame.OPENGL
            )
            self._setup_menu_hitboxes()
            self.game_view.width, self.game_view.height = event.w, event.h
            self.game_view.recalculate_layout()
            return
        if self.evt003_is_sandbox and event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
            self._evt003_cancel_sandbox()
            return
        if self.evt003_state == "RUNNING":
            if event.type in (pygame.MOUSEBUTTONDOWN, pygame.MOUSEWHEEL):
                # At/after the 30-second deadline the check has already succeeded;
                # do not turn a late event-queue delivery into a false violation.
                if time.monotonic() - self.evt003_started_at >= self.evt003_runtime.duration_seconds:
                    self._update_evt003()
                else:
                    self._evt003_violation()
            return
        if self.evt003_state in ("FORGIVENESS_DIALOG", "PENDING_NOTICE"):
            acknowledge = event.type == pygame.KEYDOWN and event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE)
            if event.type == pygame.MOUSEBUTTONDOWN and self.evt003_ok_rect:
                win_w, win_h = self.screen.get_size()
                tex_w, tex_h = self.screen_texture.size
                pos = (
                    int(event.pos[0] * tex_w / max(1, win_w)),
                    int(event.pos[1] * tex_h / max(1, win_h)),
                )
                acknowledge = self.evt003_ok_rect.collidepoint(pos)
            if acknowledge:
                self._evt003_acknowledge_dialog()
            return
        # The punishment animation is intentionally non-interactive.
        return

