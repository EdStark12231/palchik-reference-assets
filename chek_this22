    def _select_decision(self, ledger=None):
        """Forgiveness requires a proven clean check after the latest violation.

        The first violation is punished. A later violation is forgiven only if
        the player completed at least one clean EVT_003 check after the previous
        violation. Forgiveness remains in history and never resets the penalty
        ladder; without an intervening compliance the next violation is punished.
        """
        history = (ledger or self.ledger).to_dict().get("history", [])
        last_violation_index = -1
        for index, item in enumerate(history):
            if item.get("outcome") == "VIOLATION":
                last_violation_index = index
        if last_violation_index < 0:
            return "PUNISHMENT"
        clean_after = any(
            item.get("outcome") == "COMPLIANCE"
            for item in history[last_violation_index + 1:]
        )
        return "FORGIVENESS" if clean_after else "PUNISHMENT"

