            if self.event_collection_icon_rect and self.event_collection_icon_rect.collidepoint(pos):
                self._open_event_collection()
                return

            hx = getattr(self.game_logic, "hidden_hitbox_x", 0)
            hy = getattr(self.game_logic, "hidden_hitbox_y", 0)
            hidden_rect = pygame.Rect(hx - 15, hy - 15, 30, 30)
            if hidden_rect.collidepoint(pos) and not getattr(self.game_logic, "code_window_open", False):
                self.game_logic.code_window_open = True
                self.game_logic.input_buffer = [None, None, None]
                self.game_logic.current_cell_index = 0
                self.game_logic.current_cell_buffer = ""
                self.game_logic.system_response_text = ""
                self.game_view.code_window_dirty = True
                return
            if getattr(self.game_logic, "code_window_open", False):
                close_rect = getattr(self.game_view, "code_close_rect", None)
                if close_rect and close_rect.collidepoint(pos):
                    self._cancel_archive_pin()
                    return
                cancel_rect = getattr(self.game_view, "code_cancel_btn_rect", None)
                if cancel_rect and cancel_rect.collidepoint(pos):
                    self._cancel_archive_pin()
                    return
                if self.code_init_active:
                    return
                ok_rect = getattr(self.game_view, "ok_btn_rect", None)
                if ok_rect and ok_rect.collidepoint(pos):
                    self._submit_archive_pin()
                    return
                for index, field_rect in enumerate(getattr(self.game_view, "code_input_rects", [])):
                    if field_rect.collidepoint(pos):
                        self.game_logic.current_cell_index = index
                        self.game_logic.current_cell_buffer = ""
                        self.game_logic.input_buffer[index] = None
                        self.game_view.code_window_dirty = True
                        return
                return
            if getattr(self.game_logic, "lore_window_open", False):
                if hasattr(self.game_view, 'handle_lore_viewer_click'):
                    if self.game_view.handle_lore_viewer_click(self.game_logic, pos):
                        return
                
                lore_rect = getattr(self.game_view, 'lore_win_rect', None)
                if not lore_rect:
                    return
                
                close_rect = getattr(self.game_view, 'lore_close_rect', None)
                if close_rect and close_rect.collidepoint(pos):
                    self.game_view.handle_lore_click(self.game_logic, pos)
                    return

                if hasattr(self.game_view, "handle_lore_menu_click"):
                    if self.game_view.handle_lore_menu_click(self.game_logic, pos):
                        return

                header_rect = pygame.Rect(lore_rect.x, lore_rect.y, lore_rect.width, 24)
                if header_rect.collidepoint(pos):
                    if not (close_rect and close_rect.collidepoint(pos)):
                        self.game_view.lore_window_dragging = True
                        self.game_view.lore_drag_start_x = pos[0] - lore_rect.x
                        self.game_view.lore_drag_start_y = pos[1] - lore_rect.y
                    return
                
                if hasattr(self.game_view, 'handle_lore_click'):
                    self.game_view.handle_lore_click(self.game_logic, pos)
                return
            
            if getattr(self.game_logic, "lore_icon_visible", False):
                if hasattr(self.game_view, 'rect_lore_icon') and self.game_view.rect_lore_icon:
                    if self.game_view.rect_lore_icon.collidepoint(pos):
                        self.game_logic.lore_window_open = not self.game_logic.lore_window_open
                        return
            
            if self.game_view.rect_back.collidepoint(pos):
                if self.game_logic.roach_attack_active or self.event_lifecycle.is_tracked("EVT_001_ROACH_ATTACK"):
                    self._cancel_managed_roach_attack(reason="BACK_TO_MENU")
                else:
                    self._stop_roach_audio()
                self.current_screen = "menu"
                self.audio_box.play_menu_music()
                return
            elif self.game_view.rect_wallpaper.collidepoint(pos):
                next_index = self.game_logic.wallpaper_index + 1
                self.game_logic.set_wallpaper(next_index)
                return
            elif hasattr(self, 'subtitle_rect') and self.subtitle_rect and self.subtitle_rect.collidepoint(pos):
                if self.subtitle_state == "waiting_click":
                    # По упрощённой механике субтитр исчезает мгновенно по клику
                    self.subtitle_state = "idle"
                    self.subtitle_state_timer = 0.0
                    self.subtitle_next_idle_timer = 0.0
                    self.subtitle_alpha = 0
                return

            if self.game_logic.minigame_active:
                for idx, rect in enumerate(self.game_view.rect_sectors):
                    if rect.collidepoint(pos):
                        self.game_logic.verify_sector_click(idx)
                        return
                return
            if (
                self.game_logic.roach_attack_active
                and not self.game_logic.timer_active
                and not self.game_logic.sprite_active
                and not self.game_logic.chase_planet_active
                and not self.game_logic.fade_screen_active
                and self.game_logic.clicks_in_cycle < 10
            ):
                for hitbox_slot, roach_rect in enumerate(self.game_view.roach_hitboxes):
                    if roach_rect.collidepoint(pos):
                        roach_index = self.game_view.roach_hitbox_indices[hitbox_slot]
                        roach_center = roach_rect.center
                        reward = self.game_logic.squash_roach(roach_index)
                        if reward:
                            self.game_view.trigger_roach_squash(roach_center)
                            self.audio_box.play_roach_attack("squash")
                            self._sync_managed_roach_attack()
