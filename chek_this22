    def update_roaches(self, dt, width, height, forbidden_rect=None, cursor_pos=None):
        """Хаотичное движение тараканов с реакцией бегства от курсора."""
        if not self.roach_attack_active:
            return
        dt = max(0.0, min(float(dt), 0.05))
        width = max(100, int(width))
        height = max(100, int(height))
        roach_w, roach_h = 32, 25
        min_x, max_x = 26.0, float(max(26, width - roach_w - 26))
        min_y = float(max(132, int(height * 0.27)))
        max_y = float(max(int(min_y), height - 118))

        for roach in self.roach_entities:
            delay = float(roach.get("spawn_delay", 0.0))
            if delay > 0.0:
                delay = max(0.0, delay - dt)
                roach["spawn_delay"] = delay
                if delay > 0.0:
                    continue
                roach["visible"] = True

            if not roach.get("visible", True):
                roach["visible"] = True

            base_speed = float(roach.get("base_speed", 112.0))
            vx, vy = float(roach.get("vx", 0.0)), float(roach.get("vy", 0.0))
            turn_timer = float(roach.get("turn_timer", 0.0)) - dt

            if cursor_pos is not None:
                cx, cy = float(cursor_pos[0]), float(cursor_pos[1])
                dx = (float(roach["x"]) + roach_w * 0.5) - cx
                dy = (float(roach["y"]) + roach_h * 0.5) - cy
                distance = math.hypot(dx, dy)
            else:
                distance = 9999.0
                dx = dy = 0.0

            if distance < 205.0 and distance > 0.01:
                intensity = 1.0 - distance / 205.0
                flee_speed = base_speed * (2.05 + intensity * 1.10)
                desired_vx = dx / distance * flee_speed
                desired_vy = dy / distance * flee_speed
                blend = min(1.0, dt * (7.0 + intensity * 7.0))
                vx += (desired_vx - vx) * blend
                vy += (desired_vy - vy) * blend
                roach["turn_timer"] = max(turn_timer, 0.22)
            else:
                if turn_timer <= 0.0:
                    angle = math.atan2(vy, vx) + random.uniform(-0.95, 0.95)
                    target_speed = base_speed * random.uniform(0.78, 1.22)
                    vx = math.cos(angle) * target_speed
                    vy = math.sin(angle) * target_speed
                    turn_timer = random.uniform(0.30, 0.82)
                roach["turn_timer"] = turn_timer

            roach["turn_timer"] = max(0.0, float(roach.get("turn_timer", turn_timer)))
            # Gentle separation keeps the swarm from collapsing into one pile.
            repel_x = repel_y = 0.0
            for other in self.roach_entities:
                if other is roach or other.get("spawn_delay", 0.0) > 0.0 or not other.get("visible", True):
                    continue
                ox = (float(roach["x"]) + roach_w * 0.5) - (float(other["x"]) + roach_w * 0.5)
                oy = (float(roach["y"]) + roach_h * 0.5) - (float(other["y"]) + roach_h * 0.5)
                distance_sq = ox * ox + oy * oy
                if 1.0 < distance_sq < 46.0 * 46.0:
                    distance_other = math.sqrt(distance_sq)
                    strength = (46.0 - distance_other) / 46.0
                    repel_x += (ox / distance_other) * strength * base_speed * 0.75
                    repel_y += (oy / distance_other) * strength * base_speed * 0.75
            vx += repel_x * min(1.0, dt * 3.0)
            vy += repel_y * min(1.0, dt * 3.0)

            speed = math.hypot(vx, vy)
            max_speed = base_speed * (3.0 if distance < 205.0 else 1.45)
            min_speed = base_speed * 0.58
            if speed > max_speed:
                vx, vy = vx / speed * max_speed, vy / speed * max_speed
            elif 0.01 < speed < min_speed:
                vx, vy = vx / speed * min_speed, vy / speed * min_speed

            x = float(roach["x"]) + vx * dt
            y = float(roach["y"]) + vy * dt
            if x < min_x or x > max_x:
                vx = -vx
                x = max(min_x, min(max_x, x))
            if y < min_y or y > max_y:
                vy = -vy
                y = max(min_y, min(max_y, y))

            candidate = pygame.Rect(int(x), int(y), roach_w, roach_h)
            if forbidden_rect is not None and candidate.colliderect(forbidden_rect):
                center_x, center_y = candidate.center
                if abs(center_x - forbidden_rect.centerx) >= abs(center_y - forbidden_rect.centery):
                    if center_x < forbidden_rect.centerx:
                        x = forbidden_rect.left - roach_w - 4
                        vx = -abs(vx)
                    else:
                        x = forbidden_rect.right + 4
                        vx = abs(vx)
                else:
                    if center_y < forbidden_rect.centery:
                        y = forbidden_rect.top - roach_h - 4
                        vy = -abs(vy)
                    else:
                        y = forbidden_rect.bottom + 4
                        vy = abs(vy)

            roach["x"] = max(min_x, min(max_x, x))
            roach["y"] = max(min_y, min(max_y, y))
            roach["vx"], roach["vy"] = vx, vy
            if abs(vx) >= abs(vy):
                roach["direction"] = "right" if vx >= 0 else "left"
            else:
                roach["direction"] = "down" if vy >= 0 else "up"
            roach["turn_timer"] = max(0.0, float(roach.get("turn_timer", turn_timer)))

