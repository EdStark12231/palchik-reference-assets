def battle_ai_effect_for_event(actor_id, action_event):
    """Return the visual effect key and target IDs for a companion/enemy action."""
    event = action_event or {}
    kind = event.get("kind")
    if actor_id == "dinara":
        if kind == "attack":
            return "dinara_attack", [event.get("target")]
        if kind == "heal":
            return "dinara_heal", [event.get("target", "dinara")]
        if kind == "defend":
            return "dinara_defend", ["dinara"]
    elif actor_id in ("goblin_1", "goblin_2"):
        if kind == "attack":
            return "goblin_attack", [event.get("target")]
        if kind == "net":
            return "goblin_net", list(event.get("targets", []))
        if kind == "inspire":
            return "goblin_inspire", [event.get("target", actor_id)]
    return None

