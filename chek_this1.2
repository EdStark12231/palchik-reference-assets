        pygame.draw.rect(surface, (12, 16, 29), queue_rect, border_radius=5)
        pygame.draw.rect(surface, PANEL_INNER_BORDER, queue_rect, 1, border_radius=5)
        player_label = {"warrior": "ВОИН", "rogue": "ПЛУТ", "paladin": "ПАЛАДИН", "mage": "МАГ"}.get(battle_engine.player_class, "ИГРОК")
        labels = {"player": player_label, "dinara": "ДИНАРА", "goblin_1": "Г1", "goblin_2": "Г2"}
        portrait_keys = {
            "player": battle_engine.player_class, "dinara": "dinara",
            "goblin_1": "goblin", "goblin_2": "goblin",
        }
        x = queue_rect.x + 8
        for actor_id in queue_ids:
            label = labels[actor_id]
            selected = actor_id == battle_engine.current_actor_id
            rect = pygame.Rect(x, queue_rect.y + 8, 72 if actor_id in ("player", "dinara") else 42, 30)
            pygame.draw.rect(surface, (75, 66, 43) if selected else (35, 43, 59), rect, border_radius=4)
            portrait_source = battle_portraits.get(portrait_keys[actor_id])
            if portrait_source is not None:
                mini = fit_image(portrait_source, 23, 23)
                surface.blit(mini, (rect.x + 3, rect.centery - mini.get_height() // 2))
            text_s = tooltip_font.render(label, True, GOLD if selected else TEXT_COLOR)
            surface.blit(text_s, text_s.get_rect(center=(rect.centerx + 10, rect.centery)))
            x += rect.width + 4

        # Союзники слева, противники справа; HP отображается сердцами.
        def hearts(actor_id, center, label):
            combatant = battle_engine.actors[actor_id]
            rect = pygame.Rect(center[0] - 84, center[1] - 18, 168, 52)
            pygame.draw.rect(surface, (12, 16, 29), rect, border_radius=5)
            pygame.draw.rect(surface, PANEL_INNER_BORDER, rect, 1, border_radius=5)
            portrait_key = {
                "player": battle_engine.player_class, "dinara": "dinara",
                "goblin_1": "goblin", "goblin_2": "goblin",
            }[actor_id]
            portrait_source = battle_portraits.get(portrait_key)
            if portrait_source is not None:
                card_portrait = fit_image(portrait_source, 38, 38)
                surface.blit(card_portrait, (rect.x + 4, rect.y + 7))
            label_s = tooltip_font.render(label, True, GOLD if combatant["alive"] else MUTED_COLOR)
            surface.blit(label_s, (rect.x + 46, rect.y + 5))
            hp_pct = combatant["hp"] / combatant["max_hp"] if combatant["max_hp"] else 0
            filled = max(0, min(5, int(math.ceil(hp_pct * 5))))
            for i in range(5):
                color = (220, 65, 75) if i < filled else (85, 85, 92)
                hx = rect.x + 51 + i * 13
                hy = rect.y + 35
                pygame.draw.circle(surface, color, (hx - 2, hy - 2), 2)
                pygame.draw.circle(surface, color, (hx + 2, hy - 2), 2)
                pygame.draw.polygon(surface, color, [(hx - 4, hy - 1), (hx + 4, hy - 1), (hx, hy + 4)])
            hp_s = tooltip_font.render(f"{combatant['hp']}/{combatant['max_hp']}", True, TEXT_COLOR)
            surface.blit(hp_s, (rect.right - hp_s.get_width() - 5, rect.y + 27))
            status_entries = []
            if combatant.get("burn_turns", 0):
                status_entries.append(("burn", combatant["burn_turns"], "Горение"))
            if combatant.get("poison_turns", 0):
                status_entries.append(("poison", combatant["poison_turns"], "Яд"))
            if combatant.get("bleed_turns", 0):
                status_entries.append(("bleed", combatant["bleed_turns"], "Кровотечение"))
            if combatant.get("stun_turns", 0):
                status_entries.append(("stun", combatant["stun_turns"], "Оглушение"))
            if combatant.get("stun_immunity_turns", 0):
                status_entries.append(("shield", combatant["stun_immunity_turns"], "Иммунитет к оглушению"))
            if combatant.get("hidden_turns", 0):
                status_entries.append(("hidden", combatant["hidden_turns"], "Скрытность"))
            if combatant.get("faith_shield_hits_left", 0):
                shield_label = combatant.get("shield_label", "Защита")
                shield_icon_key = "faith_shield" if shield_label == "Щит веры" else "shield"
                status_entries.append((shield_icon_key, combatant["faith_shield_hits_left"], shield_label))
            taunt_left = battle_engine.taunt_turns_by_enemy.get(actor_id, 0)
            if taunt_left:
                status_entries.append(("taunt", taunt_left, "Провокация"))

            icon_mouse = pygame.mouse.get_pos()
            for badge_index, (status_key, count, status_label) in enumerate(status_entries[:7]):
                cell = BATTLE_STATUS_ICON_CELLS.get(status_key)
                if cell is None:
                    continue
                icon_source = visual_assets["status_icons"].get(status_key)
                if icon_source is None:
                    continue
                status_icon = fit_image(icon_source, 16, 16)
                icon_rect = pygame.Rect(rect.x + 5 + badge_index * 21, rect.bottom + 2, 16, 16)
                surface.blit(status_icon, icon_rect)
                count_s = tooltip_font.render(str(count), True, TEXT_COLOR)
                surface.blit(count_s, (icon_rect.right - count_s.get_width() + 1, icon_rect.bottom - 8))
                if icon_rect.collidepoint(icon_mouse):
                    tip = small_font.render(f"{status_label}: {count}", True, TEXT_COLOR)
                    tip_rect = tip.get_rect(topleft=(icon_rect.x, icon_rect.bottom + 1)).inflate(10, 6)
                    pygame.draw.rect(surface, (12, 16, 29), tip_rect, border_radius=3)
                    pygame.draw.rect(surface, PANEL_OUTER_BORDER, tip_rect, 1, border_radius=3)
                    surface.blit(tip, tip.get_rect(center=tip_rect.center))


        # Four compact cards are aligned above their corresponding actors.
        # This keeps HP labels clear of the character sprites.
        hearts("player", (185, 94), player_label)
        hearts("dinara", (375, 94), "ДИНАРА")
        hearts("goblin_1", (660, 94), "ГОБЛИН 1")
        hearts("goblin_2", (840, 94), "ГОБЛИН 2")

        if battle_message_timer > 0.0 and battle_message:
            msg = small_font.render(battle_message, True, GOLD)
            msg_rect = msg.get_rect(center=(WIDTH // 2, 278))
            frame_rect = msg_rect.inflate(20, 12)
            pygame.draw.rect(surface, (12, 16, 29), frame_rect, border_radius=4)
            pygame.draw.rect(surface, PANEL_OUTER_BORDER, frame_rect, 1, border_radius=4)
            surface.blit(msg, msg_rect)

        # Dynamic class-specific command and skill menu.
        current = battle_engine.current_actor_id
        if current == "player" and battle_engine.result is None:
            labels = battle_menu_labels()
            rects = battle_menu_rects()
            for i, (label, rect) in enumerate(zip(labels, rects)):
                pygame.draw.rect(surface, (37, 46, 62), rect, border_radius=5)
                selected = i == battle_selected_command
                pygame.draw.rect(surface, GOLD if selected else PANEL_INNER_BORDER,
                                 rect, 2 if selected else 1, border_radius=5)
                icon_cell = BATTLE_MENU_ICON_CELLS.get(label)
                custom_icon = visual_assets["menu_custom_icons"].get(label)
                if icon_cell is not None or custom_icon is not None:
                    if icon_cell is not None:
                        icon_column, icon_row = icon_cell
                        icon_source = visual_assets["skill_icons"][icon_row][icon_column]
                        menu_icon = fit_image(icon_source, 30, 30)
                    else:
                        menu_icon = custom_icon
                    surface.blit(menu_icon, (rect.x + 8, rect.centery - menu_icon.get_height() // 2))
                    label_s = tooltip_font.render(label, True, TEXT_COLOR)
                    surface.blit(label_s, label_s.get_rect(center=(rect.centerx + 14, rect.centery)))
                else:
                    label_s = tooltip_font.render(label, True, TEXT_COLOR)
                    surface.blit(label_s, label_s.get_rect(center=rect.center))
        if battle_ui_mode == "target":
            for i, (label, rect) in enumerate(zip(battle_menu_labels(), battle_menu_rects())):
                if i == len(battle_menu_labels()) - 1:
                    continue
                pygame.draw.rect(surface, (18, 24, 37), rect, border_radius=4)
                hovered = rect.collidepoint(pygame.mouse.get_pos())
                pygame.draw.rect(surface, GOLD if hovered else PANEL_INNER_BORDER, rect,
                                 2 if hovered else 1, border_radius=4)
                text_s = small_font.render(f"{i + 1}. {label}", True, TEXT_COLOR)
                surface.blit(text_s, text_s.get_rect(center=rect.center))
