    def player_mage_spell(self, spell_key, target_id=None):
        """Единый обработчик двенадцати заклинаний трёх школ Мага."""
        actor_id = "player"
        actor = self.actors[actor_id]
        if self.player_class != "mage" or self.current_actor_id != actor_id:
            return False

        spells = {
            # Школа огня
            "fireball": {"name": "Огненный шар", "rank": "Огненный шар", "cost": "mage_fireball_mp", "type": "fire", "coefficient": 1.00, "recovery": "mage_single_recovery", "target": True},
            "flame_wave": {"name": "Пылающая волна", "rank": "Пылающая волна", "cost": "mage_flame_wave_mp", "type": "fire", "coefficient": 0.72, "recovery": "mage_aoe_recovery", "aoe": True},
            "burning_mark": {"name": "Клеймо пламени", "rank": "Клеймо пламени", "cost": "mage_burning_mark_mp", "type": "fire", "coefficient": 0.55, "recovery": "mage_single_recovery", "target": True, "burn": True},
            "meteor_rain": {"name": "Метеоритный дождь", "rank": "Метеоритный дождь", "cost": "mage_meteor_rain_mp", "type": "fire", "coefficient": 0.92, "recovery": "mage_heavy_recovery", "aoe": True},
            # Школа льда
            "ice_shard": {"name": "Ледяная стрела", "rank": "Ледяная стрела", "cost": "mage_ice_shard_mp", "type": "ice", "coefficient": 1.00, "recovery": "mage_single_recovery", "target": True},
            "frost_storm": {"name": "Ледяной шторм", "rank": "Ледяной шторм", "cost": "mage_frost_storm_mp", "type": "ice", "coefficient": 0.65, "recovery": "mage_aoe_recovery", "aoe": True},
            "ice_chains": {"name": "Ледяные оковы", "rank": "Ледяные оковы", "cost": "mage_ice_chains_mp", "type": "ice", "coefficient": 0.60, "recovery": "mage_single_recovery", "target": True, "stun": True},
            "ice_armor": {"name": "Ледяная броня", "rank": "Ледяная броня", "cost": "mage_ice_armor_mp", "type": "ice", "coefficient": 0.0, "recovery": "mage_utility_recovery", "guard": True},
            # Школа арканы
            "arcane_bolt": {"name": "Арканический разряд", "rank": "Арканический разряд", "cost": "mage_arcane_bolt_mp", "type": "arcane", "coefficient": 1.05, "recovery": "mage_single_recovery", "target": True},
            "chain_lightning": {"name": "Цепная молния", "rank": "Цепная молния", "cost": "mage_chain_lightning_mp", "type": "arcane", "coefficient": 0.75, "recovery": "mage_aoe_recovery", "aoe": True},
            "mana_siphon": {"name": "Похищение маны", "rank": "Похищение маны", "cost": "mage_mana_siphon_mp", "type": "arcane", "coefficient": 0.65, "recovery": "mage_single_recovery", "target": True, "siphon": True},
            "time_rift": {"name": "Временной разлом", "rank": "Временной разлом", "cost": "mage_time_rift_mp", "type": "arcane", "coefficient": 0.88, "recovery": "mage_heavy_recovery", "target": True, "delay": True},
        }
        spell = spells.get(spell_key)
        if spell is None:
            return False
        cost = self.balance[spell["cost"]]
        if actor["mp"] < cost:
            return False
        if spell.get("target"):
            if (target_id not in self.living("enemy") or not self.alive(target_id)):
                return False
            targets = [target_id]
        elif spell.get("aoe"):
            targets = self.living("enemy")
            if not targets:
                return False
        else:
            targets = []

        rank = int(actor.get("skill_ranks", {}).get(spell["rank"], 1))
        actor["mp"] -= cost
        event_hits = []
        if spell.get("guard"):
            guard = min(0.70, 0.35 + max(0, rank - 1) * 0.05)
            actor["physical_guard"] = guard
            actor["magic_guard"] = guard
            actor["faith_shield_hits_left"] = 2 + (1 if rank >= 3 else 0)
            actor["shield_label"] = "Ледяная броня"
            self.last_action_event = {
                "kind": "mage_spell", "spell": spell_key, "spell_name": spell["name"],
                "actor": actor_id, "physical_guard": guard, "magic_guard": guard,
                "hits_left": actor["faith_shield_hits_left"], "rank": rank,
            }
        else:
            for victim_id in targets:
                coefficient = spell["coefficient"] * (1.0 + max(0, rank - 1) * 0.10)
                damage = self._spell_attack_value(actor_id, coefficient)
                result = self._damage(
                    actor_id, victim_id, damage,
                    damage_type=spell["type"], can_crit=False,
                )
                hit = {"target": victim_id, "damage": result["damage"]}
                if result["damage"] and spell.get("burn"):
                    victim = self.actors[victim_id]
                    victim["burn_damage"] = max(
                        victim.get("burn_damage", 0), 4 + max(0, rank - 1)
                    )
                    victim["burn_turns"] = max(
                        victim.get("burn_turns", 0), 3 + (1 if rank >= 3 else 0)
                    )
                    hit["burn"] = True
                if result["damage"] and spell.get("stun"):
                    hit["stunned"] = self._apply_stun(
                        victim_id, 1 + (1 if rank >= 3 else 0)
                    )
                if result["damage"] and spell.get("siphon"):
                    restored = min(
                        actor["max_mp"] - actor["mp"], 12 + max(0, rank - 1) * 5
                    )
                    actor["mp"] += restored
                    hit["mp_restored"] = restored
                if result["damage"] and spell.get("delay"):
                    delay = 2200.0 + max(0, rank - 1) * 600.0
                    self.actors[victim_id]["ready_at"] += delay
                    hit["delay"] = delay
                event_hits.append(hit)
            self.last_action_event = {
                "kind": "mage_spell", "spell": spell_key, "spell_name": spell["name"],
                "actor": actor_id, "hits": event_hits, "rank": rank,
                "damage_type": spell["type"],
            }

        self._finish_action(actor_id, self.balance[spell["recovery"]])
        return True

    def player_circle_attack(self):
