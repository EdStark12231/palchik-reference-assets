def clamp(value, minimum, maximum):
    return max(minimum, min(maximum, value))


def ease_in_out(value):
    value = clamp(value, 0.0, 1.0)
    return value * value * (3.0 - 2.0 * value)


def load_font(size):
    if FONT_PATH.is_file():
        try:
            font = pygame.font.Font(str(FONT_PATH), size)

            test = font.metrics(
                "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
                "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
            )

            if test and all(item is not None for item in test):
                return font

            print("[ВНИМАНИЕ] Шрифт не полностью поддерживает кириллицу.")

        except pygame.error:
            pass

    return pygame.font.SysFont("arial", size)


def load_image(path):
    if not path.is_file():
        raise FileNotFoundError(f"Не найден ресурс: {path}")

    return pygame.image.load(str(path)).convert_alpha()


def load_grid_atlas(path, columns, rows, expected_size, min_alpha=10):
    """Load a fixed-grid RGBA atlas and trim transparent cell margins."""
    atlas = load_image(path)
    if atlas.get_size() != tuple(expected_size):
        raise ValueError(
            f"Неверный размер атласа {path.name}: {atlas.get_size()}, "
            f"ожидался {tuple(expected_size)}."
        )

    cells = []
    for row in range(rows):
        line = []
        y0 = round(row * atlas.get_height() / rows)
        y1 = round((row + 1) * atlas.get_height() / rows)
        for column in range(columns):
            x0 = round(column * atlas.get_width() / columns)
            x1 = round((column + 1) * atlas.get_width() / columns)
            cell = atlas.subsurface(pygame.Rect(x0, y0, x1 - x0, y1 - y0)).copy()
            bounds = cell.get_bounding_rect(min_alpha=min_alpha)
            if bounds.width <= 0 or bounds.height <= 0:
                raise ValueError(
                    f"Пустая ячейка атласа {path.name}: row={row}, column={column}."
                )
            line.append(cell.subsurface(bounds).copy())
        cells.append(line)
    return cells


def load_evt005_visual_assets():
    """Load the EVT005 portrait, effect, skill-icon and status-icon atlases."""
    required = [PORTRAIT_ATLAS_PATH, SKILL_ICON_ATLAS_PATH, STATUS_ICON_ATLAS_PATH]
    required.extend(BATTLE_EFFECT_ATLAS_PATHS.values())
    missing = [str(path) for path in required if not path.is_file()]
    if missing:
        raise FileNotFoundError(
            "Не найдены новые визуальные ресурсы EVT005:\n" + "\n".join(missing)
        )

    portrait_grid = load_grid_atlas(
        PORTRAIT_ATLAS_PATH, 3, 3, (1536, 1536), min_alpha=8
    )
    portraits = {
        key: portrait_grid[row][column]
        for key, (column, row) in BATTLE_PORTRAIT_CELLS.items()
    }
    skill_icons = load_grid_atlas(
        SKILL_ICON_ATLAS_PATH, 6, 6, (2048, 2048), min_alpha=10
    )
    status_grid = load_grid_atlas(
        STATUS_ICON_ATLAS_PATH, 4, 3, (2048, 1536), min_alpha=10
    )
    status_icons = {
        key: status_grid[row][column]
        for key, (column, row) in BATTLE_STATUS_ICON_CELLS.items()
    }
    effects = {
        key: load_grid_atlas(path, 4, 4, (2048, 2048), min_alpha=12)
        for key, path in BATTLE_EFFECT_ATLAS_PATHS.items()
    }

    if len(portraits) != 9 or len(effects) != len(BATTLE_EFFECT_ATLAS_PATHS) or len(skill_icons) != 6 or len(status_icons) != 11:
        raise ValueError("Неожиданная структура визуальной библиотеки EVT005.")
    return {
        "portraits": portraits,
        "skill_icons": skill_icons,
        "status_icons": status_icons,
        "effects": effects,
    }


def fit_image(image, max_width, max_height):
    scale = min(
        max_width / image.get_width(),
        max_height / image.get_height()
    )

    size = (
        max(1, round(image.get_width() * scale)),
        max(1, round(image.get_height() * scale))
    )

    return pygame.transform.smoothscale(image, size)


