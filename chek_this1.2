    def set_battle_effect(effect_key, targets):
        spec = BATTLE_EFFECT_SPECS.get(effect_key)
        if spec is None:
            return
        atlas_key, atlas_row = spec
        target_ids = [target for target in targets if target in ("player", "dinara", "goblin_1", "goblin_2")]
        if not target_ids:
            return
        duration = BATTLE_VFX_DURATION
        battle_spell_flash.update({
            "type": atlas_key,
            "row": atlas_row,
            "effect_key": effect_key,
            "targets": target_ids,
            "timer": duration,
            "duration": duration,
            "spell": effect_key,
        })

    def handle_battle_command(command_index):
        nonlocal battle_ui_mode, battle_selected_command, battle_message, battle_message_timer
        nonlocal battle_selected_target, battle_selected_target_timer, battle_pending_action
        if battle_engine is None or battle_engine.current_actor_id != "player":
            return
        player_class = battle_engine.player_class

        def show_result(success, success_text, fail_text="Недостаточно ресурса для способности."):
            nonlocal battle_ui_mode, battle_selected_command, battle_message, battle_message_timer
            nonlocal battle_pending_action
            if success:
                battle_ui_mode = "commands"
                battle_selected_command = 0
                battle_pending_action = None
                battle_message = success_text
                battle_message_timer = 1.45
            else:
                battle_message = fail_text
                battle_message_timer = 1.25

        if battle_ui_mode == "commands":
            if command_index == 0:
                battle_pending_action = "basic"
                battle_ui_mode = "target"
                battle_selected_command = 0
            elif command_index == 1:
                battle_ui_mode = "skills"
                battle_selected_command = 0
            elif command_index == 2:
                battle_ui_mode = "items"
                battle_selected_command = 0
            elif command_index == 3:
                if player_class == "warrior":
                    show_result(battle_engine.player_defend(), "Воин занимает защитную позицию.", "Не удалось занять защитную позицию.")
                else:
                    show_result(battle_engine.player_defend(), "Персонаж занимает защитную позицию.")
        elif battle_ui_mode == "skills":
            if player_class == "mage":
                if command_index == 0:
                    battle_ui_mode = "mage_fire"
                    battle_selected_command = 0
                elif command_index == 1:
                    battle_ui_mode = "mage_ice"
                    battle_selected_command = 0
                elif command_index == 2:
                    battle_ui_mode = "mage_arcane"
                    battle_selected_command = 0
                else:
                    battle_ui_mode = "commands"
                    battle_selected_command = 0
            elif player_class == "warrior":
                if command_index == 0:
                    battle_pending_action = "basic"
                    battle_ui_mode = "target"
                    battle_selected_command = 0
                elif command_index == 1:
                    success = battle_engine.player_circle_attack()
                    event = battle_engine.last_action_event or {}
                    if success:
                        set_battle_effect("circle_attack", [hit.get("target") for hit in event.get("hits", [])])
                    show_result(success, "Воин выполняет круговую атаку!")
                elif command_index == 2:
                    success = battle_engine.player_sword_block()
                    if success:
                        set_battle_effect("sword_block", ["player"])
                    show_result(success, "Блок мечом: физический урон снижен.", "Недостаточно выносливости для блока мечом.")
                elif command_index == 3:
                    success = battle_engine.player_berserk()
                    if success:
                        set_battle_effect("berserk", ["player"])
                    show_result(success, "БЕРСЕРК! Урон и критические показатели усилены.", "Берсерк доступен при HP не выше 25% и достаточной Stamina.")
                else:
                    battle_ui_mode = "commands"
                    battle_selected_command = 0
            elif player_class == "rogue":
                if command_index == 0:
                    battle_pending_action = "venom"
                    battle_ui_mode = "target"
                    battle_selected_command = 0
                elif command_index == 1:
                    success = battle_engine.player_fan_blades()
                    event = battle_engine.last_action_event or {}
                    if success:
                        set_battle_effect("fan_blades", [hit.get("target") for hit in event.get("hits", [])])
                    show_result(success, "Разбойник выпускает веер отравленных клинков.", "Недостаточно Stamina для Веера клинков.")
                elif command_index == 2:
                    success = battle_engine.player_shadow_jump()
                    if success:
                        set_battle_effect("shadow_jump", ["player"])
                    show_result(success, "Разбойник исчезает в тени.", "Недостаточно Stamina для Прыжка в тень.")
                elif command_index == 3:
                    battle_pending_action = "head_strike"
                    battle_ui_mode = "target"
                    battle_selected_command = 0
                else:
                    battle_ui_mode = "commands"
                    battle_selected_command = 0
            elif player_class == "paladin":
                if command_index == 0:
                    battle_pending_action = "basic"
                    battle_ui_mode = "target"
                    battle_selected_command = 0
                elif command_index == 1:
                    success = battle_engine.player_faith_shield()
                    if success:
                        set_battle_effect("faith_shield", ["player"])
                    show_result(
                        success,
                        "Щит веры активирован: физический и магический урон снижен.",
                        "Недостаточно MP для Щита веры."
                    )
                elif command_index == 2:
                    battle_pending_action = "paladin_heal_single"
                    battle_ui_mode = "ally_target"
                    battle_selected_command = 0
                elif command_index == 3:
                    success = battle_engine.player_holy_prayer(group=True)
                    event = battle_engine.last_action_event or {}
                    if success:
                        set_battle_effect("holy_prayer", [item.get("target") for item in event.get("healing", [])])
                    total = sum(item["amount"] for item in event.get("healing", []))
                    show_result(success, f"Святая молитва исцеляет группу: +{total} HP.", "Недостаточно MP или союзникам не требуется лечение.")
                elif command_index == 4:
                    success = battle_engine.player_wrath_of_light()
                    event = battle_engine.last_action_event or {}
                    if success:
                        set_battle_effect("wrath_of_light", event.get("targets", []))
                    show_result(success, "Гнев света! Гоблины вынуждены атаковать Паладина.", "Недостаточно MP для Гнева света.")
                else:
                    battle_ui_mode = "commands"
                    battle_selected_command = 0
        elif battle_ui_mode in ("mage_fire", "mage_ice", "mage_arcane"):
            spell_groups = {
                "mage_fire": ["fireball", "flame_wave", "burning_mark", "meteor_rain"],
                "mage_ice": ["ice_shard", "frost_storm", "ice_chains", "ice_armor"],
                "mage_arcane": ["arcane_bolt", "chain_lightning", "mana_siphon", "time_rift"],
            }
            spell_order = spell_groups[battle_ui_mode]
            if command_index >= len(spell_order):
                battle_ui_mode = "skills"
                battle_selected_command = 0
            else:
                spell_key = spell_order[command_index]
                if spell_key in ("fireball", "burning_mark", "ice_shard", "ice_chains",
                                 "arcane_bolt", "mana_siphon", "time_rift"):
                    battle_pending_action = spell_key
                    battle_ui_mode = "target"
                    battle_selected_command = 0
                else:
                    success = battle_engine.player_mage_spell(spell_key)
                    event = battle_engine.last_action_event or {}
                    if success and event.get("kind") == "mage_spell":
                        effect_targets = [hit.get("target") for hit in event.get("hits", [])]
                        set_battle_effect(spell_key, effect_targets or ["player"])
                    total = sum(hit.get("damage", 0) for hit in event.get("hits", []))
                    detail = f"Общий урон: {total}." if event.get("hits") else "Защита активирована."
                    show_result(
                        success, f"{event.get('spell_name', 'Заклинание')}! {detail}",
                        "Недостаточно MP для выбранного заклинания."
                    )
        elif battle_ui_mode == "target":
            enemy_ids = battle_engine.living("enemy")
            if command_index < len(enemy_ids):
                target_id = enemy_ids[command_index]
                battle_selected_target = target_id
                battle_selected_target_timer = 1.4
                action = battle_pending_action or "basic"
                if action == "head_strike":
                    success = battle_engine.player_head_strike(target_id)
                elif action == "venom":
                    success = battle_engine.player_venom_blade(target_id)
                elif action in ("fireball", "burning_mark", "ice_shard", "ice_chains",
                                "arcane_bolt", "mana_siphon", "time_rift"):
                    success = battle_engine.player_mage_spell(action, target_id=target_id)
                else:
                    success = battle_engine.player_attack(target_id)
                if success:
                    event = battle_engine.last_action_event or {}
                    effect_key = action
                    if action == "basic":
                        effect_key = {
                            "warrior": "warrior_strike",
                            "paladin": "hammer_strike",
                            "mage": "staff_strike",
                            "rogue": "venom",
                        }.get(player_class)
                    if effect_key in BATTLE_EFFECT_SPECS:
                        set_battle_effect(effect_key, [target_id])
                    if event.get("kind") == "mage_spell":
                        hit = next((item for item in event.get("hits", [])
                                    if item.get("target") == target_id), {})
                        extras = []
                        if hit.get("burn"):
                            extras.append("горит")
                        if hit.get("stunned"):
                            extras.append("заморожен")
                        if hit.get("mp_restored"):
                            extras.append(f"+{hit['mp_restored']} MP")
                        if hit.get("delay"):
                            extras.append("ход отложен")
                        suffix = ("; " + ", ".join(extras)) if extras else ""
                        battle_message = f"{event.get('spell_name', 'Заклинание')}: {event.get('hits', [{}])[0].get('damage', 0)} урона{suffix}."
                    elif event.get("dodged"):
                        battle_message = f"{battle_engine.actors[target_id]['name']} уклоняется!"
                    elif event.get("stunned"):
                        battle_message = f"Удар по голове! {battle_engine.actors[target_id]['name']} оглушён."
                    elif event.get("poison"):
                        battle_message = f"Ядовитый удар! {battle_engine.actors[target_id]['name']} отравлен."
                    elif battle_engine.actors[target_id]["alive"]:
                        battle_message = f"{battle_engine.actors[target_id]['name']}: {event.get('damage', 0)} урона."
                    else:
                        battle_message = f"{battle_engine.actors[target_id]['name']} повержен!"
                    battle_message_timer = 1.4
                    battle_ui_mode = "commands"
                    battle_selected_command = 0
                    battle_pending_action = None
                else:
                    battle_message = "Действие недоступно: проверьте ресурс или цель."
                    battle_message_timer = 1.3
            else:
                battle_ui_mode = "commands"
                battle_selected_command = 0
                battle_pending_action = None
        elif battle_ui_mode == "ally_target":
            ally_ids = battle_engine.living("ally")
            if command_index < len(ally_ids):
                target_id = ally_ids[command_index]
                success = battle_engine.player_holy_prayer(target_id=target_id, group=False)
                event = battle_engine.last_action_event or {}
                if success:
                    set_battle_effect("holy_prayer", [target_id])
                healed = next((item["amount"] for item in event.get("healing", [])
                               if item["target"] == target_id), 0)
                show_result(
                    success,
                    f"Святая молитва восстанавливает {healed} HP персонажу {battle_engine.actors[target_id]['name']}.",
                    "Недостаточно MP или выбранный союзник не нуждается в лечении."
                )
            else:
                battle_ui_mode = "commands"
                battle_selected_command = 0
                battle_pending_action = None
        elif battle_ui_mode == "items":
            if command_index == 0:
                target_id = "player"
            elif command_index == 1:
                target_id = "dinara"
            else:
                battle_ui_mode = "commands"
                battle_selected_command = 0
                return
            if battle_engine.use_potion(target_id):
                event = battle_engine.last_action_event or {}
                show_result(True, f"Восстановлено {event.get('amount', 0)} HP.")
            else:
                battle_message = "Зелье недоступно или цель не нуждается в лечении."
                battle_message_timer = 1.2
        if battle_engine.result:
            finish_battle(battle_engine.result)
