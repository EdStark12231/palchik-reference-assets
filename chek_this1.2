        mode = mode or battle_ui_mode
        if mode == "commands":
            return ["Атака", "Навыки", "Предметы", "Защита"]
        if mode == "skills":
            menus = {
                "warrior": ["Базовая атака мечом", "Круговая атака", "Блок мечом", "Берсерк", "Назад"],
                "rogue": ["Ядовитый клинок", "Веер клинков", "Прыжок в тень", "Удар по голове", "Назад"],
                "paladin": ["Удар молотом", "Щит веры", "Святая молитва — цель", "Святая молитва — группа", "Гнев света", "Назад"],
                "mage": ["Школа огня", "Школа льда", "Школа арканы", "Назад"],
            }
            return menus.get(battle_engine.player_class if battle_engine else "warrior", ["Назад"])
        mage_school_menus = {
            "mage_fire": ["Огненный шар", "Пылающая волна", "Клеймо пламени", "Метеоритный дождь", "Назад"],
            "mage_ice": ["Ледяная стрела", "Ледяной шторм", "Ледяные оковы", "Ледяная броня", "Назад"],
            "mage_arcane": ["Арканический разряд", "Цепная молния", "Похищение маны", "Временной разлом", "Назад"],
        }
        if mode in mage_school_menus:
            return mage_school_menus[mode]
        if mode == "target":
            return [battle_engine.actors[aid]["name"] for aid in battle_engine.living("enemy")] + ["Назад"]
        if mode == "ally_target":
            return [battle_engine.actors[aid]["name"] for aid in battle_engine.living("ally")] + ["Назад"]
        if mode == "items":
            return ["Лечить героя", "Лечить Динару", "Назад"]
        return ["Назад"]

    def battle_menu_rects(mode=None):
        mode = mode or battle_ui_mode
        labels = battle_menu_labels(mode)
        if mode == "commands":
            return [pygame.Rect(12 + i * 212, HEIGHT - 70, 205, 55) for i in range(len(labels))]
        if mode in ("skills", "mage_fire", "mage_ice", "mage_arcane"):
            return [pygame.Rect(12 + (i % 3) * 315, HEIGHT - 122 + (i // 3) * 56, 300, 50) for i in range(len(labels))]
        if mode == "target":
            count = len(labels) - 1
            row_rects = [pygame.Rect(650, 330 + i * 65, 260, 58) for i in range(count)]
            return row_rects + [pygame.Rect(12, HEIGHT - 70, 205, 55)]
        if mode == "ally_target":
            count = len(labels) - 1
            row_rects = [pygame.Rect(24, 330 + i * 65, 260, 58) for i in range(count)]
            return row_rects + [pygame.Rect(12, HEIGHT - 70, 205, 55)]
        return [pygame.Rect(12 + i * 207, HEIGHT - 70, 200, 55) for i in range(len(labels))]

    def draw_battle_hud(surface):
        if battle_engine is None:
            return
        hud = pygame.Rect(12, 12, 290, 54)
        pygame.draw.rect(surface, (12, 16, 29), hud, border_radius=6)
        pygame.draw.rect(surface, PANEL_OUTER_BORDER, hud, 1, border_radius=6)
        actor = battle_engine.get_actor("player")
        player_portrait = battle_portraits.get(battle_engine.player_class)
        if player_portrait is not None:
            player_portrait = fit_image(player_portrait, 40, 40)
            surface.blit(player_portrait, (hud.x + 6, hud.y + 7))
        resource_line = (
            f"MP: {int(actor['mp'])}/{actor['max_mp']}"
            if actor.get("max_mp", 0) > 0
            else f"ST: {int(actor['stamina'])}/{actor['max_stamina']}"
        )
        lines = [f"HP: {actor['hp']}/{actor['max_hp']}", resource_line]
        for idx, line in enumerate(lines):
