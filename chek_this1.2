    def player_holy_prayer(self, target_id=None, group=False):
        actor_id = "player"
        actor = self.actors[actor_id]
        if self.player_class != "paladin" or self.current_actor_id != actor_id:
            return False
        rank = int(actor.get("skill_ranks", {}).get("Святая молитва", 1))
        if group:
            cost = self.balance["paladin_holy_prayer_group_mp"]
            heal_percent = 0.18 + max(0, rank - 1) * 0.04
            targets = self.living("ally")
        else:
            cost = self.balance["paladin_holy_prayer_single_mp"]
            heal_percent = 0.32 + max(0, rank - 1) * 0.06
            if target_id not in self.living("ally"):
                return False
            targets = [target_id]
        if actor["mp"] < cost:
            return False
        healing = []
        for target in targets:
            target_actor = self.actors[target]
            amount = max(1, int(round(target_actor["max_hp"] * heal_percent)))
            healed = min(amount, target_actor["max_hp"] - target_actor["hp"])
            if healed > 0:
                healing.append({"target": target, "amount": healed})
        if not healing:
            return False
        actor["mp"] -= cost
        for item in healing:
            self.actors[item["target"]]["hp"] += item["amount"]
        self.last_action_event = {
            "kind": "holy_prayer", "actor": actor_id,
            "group": bool(group), "healing": healing,
            "mp_spent": cost,
        }
        recovery = (self.balance["paladin_group_prayer_recovery"] if group
                    else self.balance["paladin_holy_prayer_recovery"])
        self._finish_action(actor_id, recovery)
        return True

