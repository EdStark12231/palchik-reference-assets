    def fast_travel_to_battle():
        """F2-only shortcut: skip story setup and battle with the currently selected class."""
        nonlocal player_name, selected_class, selected_class_data
        nonlocal fast_travel_active, fast_travel_restore_state
        nonlocal story_nodes, story_index, story_elapsed, story_next_action
        nonlocal story_choice_index, story_emotion
        nonlocal battle_story_goblins_visible, battle_story_bodies_visible

        # Never restart an active battle or bypass the scripted defeat choice.
        if stage in ("battle", "defeat_choices"):
            return False

        if not fast_travel_active:
            fast_travel_restore_state = (
                player_name, selected_class, selected_class_data
            )

        supported_classes = ("ВОИН", "ПЛУТ", "ПАЛАДИН", "МАГ")
        current_class_name = (
            selected_class_data.get("name") if selected_class_data else None
        )
        if current_class_name not in supported_classes:
            if (0 <= selected_class < len(CLASSES)
                    and CLASSES[selected_class]["name"] in supported_classes):
                selected_class_data = CLASSES[selected_class]
            else:
                warrior_index = next(
                    index for index, class_data in enumerate(CLASSES)
                    if class_data["name"] == "ВОИН"
                )
                selected_class = warrior_index
                selected_class_data = CLASSES[warrior_index]
        else:
            selected_class = next(
                index for index, class_data in enumerate(CLASSES)
                if class_data["name"] == current_class_name
            )
        ensure_player_class_progression(selected_class_data["name"])
        player_name = "тапок"

        # Clear any unfinished dialogue/choice so the battle opens cleanly.
        pygame.key.stop_text_input()
        story_nodes = []
        story_index = 0
        story_elapsed = 0.0
        story_next_action = None
        story_choice_index = 0
        story_emotion = "base"
        battle_story_bodies_visible = False
        battle_story_goblins_visible = True
        fast_travel_active = True

        start_battle()
        if stage == "battle":
            print('[EVT005][DEBUG] F2 fast travel: battle started with player name "тапок".')
            return True
        return False

