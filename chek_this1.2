        class_key = {"ВОИН": "warrior", "ПЛУТ": "rogue", "ПАЛАДИН": "paladin", "МАГ": "mage"}.get(class_name)
        if class_key is None:
            battle_message = "Не удалось определить боевой класс."
            battle_message_timer = 8.0
            stage = "battle_class_notice"
            return
