        assert battle_ai_effect_for_event("goblin_1", {"kind": "attack", "target": "dinara"}) == ("goblin_attack", ["dinara"])
        assert battle_ai_effect_for_event("goblin_2", {"kind": "net", "targets": ["player", "dinara"]}) == ("goblin_net", ["player", "dinara"])
