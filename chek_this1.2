    def finish_victory_sequence():
        nonlocal stage, battle_story_bodies_visible, battle_phase
        nonlocal kitchen_requested_item_id, kitchen_move_target
        nonlocal kitchen_target_action, kitchen_target_item_id
        nonlocal player_name, selected_class, selected_class_data
        nonlocal fast_travel_active, fast_travel_restore_state
        if battle_engine is not None:
            for actor_id in ("player", "dinara"):
                actor = battle_engine.actors[actor_id]
                actor["hp"] = actor["max_hp"]
                actor["alive"] = True
                if actor_id == "player":
                    actor["mp"] = actor["max_mp"]
            battle_engine.potion_count = 1
            # После победы зелье группы и MP магических классов восстановлены.
        battle_story_bodies_visible = False
        battle_phase = "complete"
        battle_ui_mode = "commands"
        battle_selected_command = 0
        kitchen_requested_item_id = None
        kitchen_move_target = None
        kitchen_target_action = None
        kitchen_target_item_id = None
        if fast_travel_active and fast_travel_restore_state is not None:
            (player_name, selected_class, selected_class_data) = fast_travel_restore_state
            fast_travel_restore_state = None
            fast_travel_active = False
        stage = "kitchen_scene"
        print("[EVT005] Battle won; returned to free kitchen movement.")

