# ============================================================
# EVT_005 — ПЕРВАЯ БОЕВАЯ СИСТЕМА (тестовый баланс V0.1)
# ============================================================

class EVT005BattleEngine:
    """Пошаговый движок первой тестовой схватки: Воин + Динара vs 2 гоблина.

    Все числа в BATTLE_BALANCE являются тестовыми стартовыми значениями,
    а не окончательно утверждённым балансом.
    """

    BATTLE_BALANCE = {
        "player": {
            "hp": 120, "stamina": 100, "strength": 12,
            "agility": 10, "toughness": 10,
        },
        "dinara": {
            "hp": 100, "attack": 10, "agility": 11, "toughness": 8,
        },
        "paladin": {
            "hp": 130, "mp": 100, "strength": 11,
            "agility": 9, "toughness": 13,
        },
        "goblin": {
            "hp": 55, "strength": 8, "agility": 12, "toughness": 2,
        },
        "basic_attack_stamina": 10,
        "circle_attack_stamina": 30,
        "sword_block_stamina": 15,
        "berserk_stamina": 35,
        "stamina_regen_per_time": 0.012,
        "basic_recovery": 780.0,
        "circle_recovery": 1080.0,
        "block_recovery": 650.0,
        "berserk_recovery": 900.0,
        "goblin_attack_recovery": 850.0,
        "goblin_net_recovery": 1180.0,
        "goblin_inspire_recovery": 1050.0,
        "dinara_attack_recovery": 800.0,
        "dinara_defend_recovery": 700.0,
        "bleed_damage": 3,
        "bleed_turns": 3,
        "bleed_chance": 0.25,
        "net_stun_turns": 2,
        "inspire_immunity_turns": 3,
        "net_multi_target_chance": 0.25,
        "potion_heal_percent": 0.35,
        "berserk_damage_bonus": 0.30,
        "berserk_crit_chance_bonus": 0.20,
        "berserk_crit_multiplier_bonus": 0.60,
        "berserk_attack_charges": 2,
        "dinara_heal_threshold": 0.35,
        "dinara_guard_threshold": 0.28,
        # Стартовые значения Паладина: молот бесплатен, умения расходуют MP.
        "paladin_faith_shield_mp": 18,
        "paladin_holy_prayer_single_mp": 20,
        "paladin_holy_prayer_group_mp": 32,
        "paladin_wrath_mp": 24,
        "paladin_faith_shield_hits": 3,
        "paladin_faith_shield_recovery": 720.0,
        "paladin_holy_prayer_recovery": 850.0,
        "paladin_group_prayer_recovery": 1120.0,
        "paladin_wrath_recovery": 900.0,
        # Стартовые параметры Мага и три школы заклинаний.
        "mage_fireball_mp": 18,
        "mage_flame_wave_mp": 28,
        "mage_burning_mark_mp": 16,
        "mage_meteor_rain_mp": 42,
        "mage_ice_shard_mp": 16,
        "mage_frost_storm_mp": 28,
        "mage_ice_chains_mp": 22,
        "mage_ice_armor_mp": 24,
        "mage_arcane_bolt_mp": 20,
        "mage_chain_lightning_mp": 32,
        "mage_mana_siphon_mp": 24,
        "mage_time_rift_mp": 28,
        "mage_single_recovery": 900.0,
        "mage_aoe_recovery": 1180.0,
        "mage_heavy_recovery": 1420.0,
        "mage_utility_recovery": 820.0,
    }

    def __init__(self, player_name="Воин", player_stats=None, dinara_stats=None,
                 player_skills=None, dinara_skills=None, player_class="warrior"):
        import random as _random
        self.random = _random.Random()
        self.balance = dict(self.BATTLE_BALANCE)
        player_stats = dict(player_stats or {})
        dinara_stats = dict(dinara_stats or {})
        player_skills = dict(player_skills or {})
        dinara_skills = dict(dinara_skills or {})
        self.clock = 0.0
        self.current_actor_id = None
        self.result = None
        self.potion_count = 1
        self.log = []
        self.last_event = None
        self.last_action_event = None
        self.extra_turn_pending = False
        # Для каждого гоблина отдельно учитываются оставшиеся действия провокации.
        self.taunt_targets_by_enemy = {}
        self.taunt_turns_by_enemy = {}
        self.actors = {
            "player": self._actor(
                "player", player_name, "ally", "warrior",
                player_stats.get("Здоровье", self.balance["player"]["hp"]),
                player_stats.get("Выносливость", self.balance["player"]["stamina"]),
                player_stats.get("Сила", self.balance["player"]["strength"]),
                player_stats.get("Ловкость", self.balance["player"]["agility"]),
                player_stats.get("Стойкость", self.balance["player"]["toughness"]),
                5.0, 1.5,
            ),
            "dinara": self._actor(
                "dinara", "Динара", "ally", "dinara",
                dinara_stats.get("Здоровье", self.balance["dinara"]["hp"]), 0,
                dinara_stats.get("Сила", self.balance["dinara"]["attack"]),
                dinara_stats.get("Ловкость", self.balance["dinara"]["agility"]),
                dinara_stats.get("Стойкость", self.balance["dinara"]["toughness"]),
                5.0, 1.5,
            ),
            "goblin_1": self._actor(
                "goblin_1", "Гоблин 1", "enemy", "goblin",
                self.balance["goblin"]["hp"], 0,
                self.balance["goblin"]["strength"],
                self.balance["goblin"]["agility"],
                self.balance["goblin"]["toughness"],
                4.0, 1.5,
            ),
            "goblin_2": self._actor(
                "goblin_2", "Гоблин 2", "enemy", "goblin",
                self.balance["goblin"]["hp"], 0,
                self.balance["goblin"]["strength"],
                self.balance["goblin"]["agility"],
                self.balance["goblin"]["toughness"],
                4.0, 1.5,
            ),
        }
        self.actors["player"]["skill_ranks"] = player_skills
        self.actors["dinara"]["skill_ranks"] = dinara_skills
        self.player_class = player_class
        class_defaults = {
            "warrior": {"hp": 120, "stamina": 100, "mp": 0, "strength": 12, "agility": 10, "toughness": 10, "attack": 5.0, "crit": 0.08, "crit_mult": 1.5},
            "rogue": {"hp": 100, "stamina": 120, "mp": 0, "strength": 11, "agility": 15, "toughness": 7, "attack": 7.0, "crit": 0.14, "crit_mult": 1.7},
            "paladin": {"hp": 130, "stamina": 0, "mp": 100, "strength": 11, "intellect": 0, "agility": 9, "toughness": 13, "attack": 6.0, "crit": 0.08, "crit_mult": 1.5},
            "mage": {"hp": 92, "stamina": 0, "mp": 140, "strength": 6, "intellect": 16, "agility": 12, "toughness": 7, "attack": 5.0, "crit": 0.05, "crit_mult": 1.5},
        }
        cfg = class_defaults.get(player_class, class_defaults["warrior"])
        player = self.actors["player"]
        player["role"] = player_class
        player["max_hp"] = int(player_stats.get("Здоровье", cfg["hp"]))
        player["hp"] = player["max_hp"]
        player["strength"] = float(player_stats.get("Сила", cfg["strength"]))
        player["intellect"] = float(player_stats.get("Интеллект", cfg.get("intellect", 0)))
        player["agility"] = float(player_stats.get("Ловкость", cfg["agility"]))
        player["toughness"] = float(player_stats.get("Стойкость", cfg["toughness"]))
        player["base_attack"] = float(cfg["attack"])
        player["crit_chance"] = float(cfg["crit"])
        player["crit_multiplier"] = float(cfg["crit_mult"])
        player["max_stamina"] = int(player_stats.get("Выносливость", cfg["stamina"]))
        player["stamina"] = player["max_stamina"]
        player["max_mp"] = int(player_stats.get("Магия", cfg["mp"])) if cfg["mp"] > 0 else 0
        player["mp"] = player["max_mp"]
        # Первый момент готовности зависит от скорости каждого бойца.
        for actor in self.actors.values():
            actor["ready_at"] = 1000.0 / max(1.0, actor["agility"])

    @staticmethod
    def _actor(actor_id, name, team, role, max_hp, max_stamina,
               strength, agility, toughness, base_attack, crit_multiplier):
        return {
            "id": actor_id, "name": name, "team": team, "role": role,
            "max_hp": int(max_hp), "hp": int(max_hp),
            "max_stamina": int(max_stamina), "stamina": int(max_stamina),
            "max_mp": 0, "mp": 0,
            "strength": float(strength), "intellect": 0.0, "agility": float(agility),
            "toughness": float(toughness), "base_attack": float(base_attack),
            "crit_chance": 0.08, "crit_multiplier": float(crit_multiplier),
            "ready_at": 0.0, "alive": True,
            "bleed_turns": 0, "poison_turns": 0, "poison_damage": 0,
            "burn_turns": 0, "burn_damage": 0,
            "stun_turns": 0, "stun_immunity_turns": 0,
            "hidden_turns": 0,
            "physical_guard": 0.0, "magic_guard": 0.0,
            "faith_shield_hits_left": 0, "shield_label": "Защита",
            "berserk_attacks_left": 0,
            "damage_buff": 0.0, "crit_chance_buff": 0.0,
            "crit_multiplier_buff": 0.0,
        }

    def alive(self, actor_id):
        actor = self.actors[actor_id]
        return actor["alive"] and actor["hp"] > 0

    def living(self, team=None):
        return [
            actor_id for actor_id, actor in self.actors.items()
            if actor["alive"] and actor["hp"] > 0
            and (team is None or actor["team"] == team)
        ]

    def check_result(self):
        if not self.alive("player"):
            self.result = "defeat"
        elif not self.living("enemy"):
            self.result = "victory"
        return self.result

    def get_actor(self, actor_id=None):
        actor_id = actor_id or self.current_actor_id
        return self.actors.get(actor_id) if actor_id else None

    def initiative_order(self):
        living = self.living()
        return sorted(living, key=lambda aid: (self.actors[aid]["ready_at"], aid))

    def _advance_clock(self, target_time):
        delta = max(0.0, target_time - self.clock)
        if delta and self.player_class in ("warrior", "rogue"):
            actor = self.actors["player"]
            if actor["alive"]:
                actor["stamina"] = min(
                    actor["max_stamina"],
                    actor["stamina"] + delta * self.balance["stamina_regen_per_time"],
                )
        self.clock = max(self.clock, target_time)

    def _damage(self, attacker_id, target_id, raw_damage, damage_type="physical",
                can_crit=True):
        if not self.alive(target_id):
            return {"damage": 0, "dodged": False, "critical": False}
        attacker = self.actors[attacker_id]
        target = self.actors[target_id]
        dodged = False
        critical = False
        damage = max(1.0, float(raw_damage))

        if damage_type == "physical":
            dodge_chance = min(0.28, max(0.0, target["agility"] * 0.006))
            if self.random.random() < dodge_chance:
                dodged = True
                self.last_event = {"kind": "dodge", "target": target_id}
                return {"damage": 0, "dodged": True, "critical": False}

            if can_crit:
                crit_chance = min(
                    0.75,
                    attacker["crit_chance"] + attacker["crit_chance_buff"],
                )
                if self.random.random() < crit_chance:
                    critical = True
                    damage *= (
                        attacker["crit_multiplier"]
                        + attacker["crit_multiplier_buff"]
                    )

            # Стойкость защищает только от прямого физического урона.
            mitigation = min(0.50, target["toughness"] * 0.015)
            damage *= (1.0 - mitigation)
            if target["physical_guard"] > 0.0:
                damage *= (1.0 - target["physical_guard"])
        elif damage_type in ("magic", "fire", "ice", "arcane"):
            if target["magic_guard"] > 0.0:
                damage *= (1.0 - target["magic_guard"])

        dealt = max(1, int(round(damage)))
        if damage_type in ("physical", "magic", "fire", "ice", "arcane") and target.get("faith_shield_hits_left", 0) > 0:
            target["faith_shield_hits_left"] -= 1
            if target["faith_shield_hits_left"] <= 0:
                target["faith_shield_hits_left"] = 0
                target["physical_guard"] = 0.0
                target["magic_guard"] = 0.0
        target["hp"] = max(0, target["hp"] - dealt)
        if target["hp"] <= 0:
            target["alive"] = False
        self.last_event = {
            "kind": "damage", "attacker": attacker_id,
            "target": target_id, "damage": dealt,
            "critical": critical, "damage_type": damage_type,
        }
        self.check_result()
        return {"damage": dealt, "dodged": dodged, "critical": critical}

    def _physical_attack_value(self, attacker_id, coefficient=1.0, skill_key=None):
        attacker = self.actors[attacker_id]
        raw = (attacker["base_attack"] + attacker["strength"] * 0.85) * coefficient
        ranks = attacker.get("skill_ranks", {})
        if attacker_id == "player":
            default_skill = {
                "warrior": "Базовая атака мечом",
                "rogue": "Ядовитый клинок",
                "paladin": "Удар молотом",
            }.get(self.player_class, "Базовая атака мечом")
            skill_key = skill_key or default_skill
            rank = int(ranks.get(skill_key, 1))
            raw *= (1.0 + max(0, rank - 1) * 0.10)
        elif attacker_id == "dinara":
            rank = int(ranks.get("Атака скалкой", 1))
            raw *= (1.0 + max(0, rank - 1) * 0.10)
        if attacker["berserk_attacks_left"] > 0:
            raw *= (1.0 + attacker["damage_buff"])
        return raw

    def _spell_attack_value(self, actor_id, coefficient=1.0, skill_key=None):
        actor = self.actors[actor_id]
        raw = (actor["base_attack"] + actor.get("intellect", 0.0) * 1.10) * coefficient
        if actor_id == "player" and skill_key:
            rank = int(actor.get("skill_ranks", {}).get(skill_key, 1))
            raw *= 1.0 + max(0, rank - 1) * 0.10
        return max(1.0, raw)

    def _consume_stamina(self, actor_id, cost):
        actor = self.actors[actor_id]
        if actor["stamina"] < cost:
            return False
        actor["stamina"] = max(0.0, actor["stamina"] - cost)
        return True

    def _apply_bleed(self, target_id):
        target = self.actors[target_id]
        if self.alive(target_id):
            target["bleed_turns"] = max(
                target["bleed_turns"], self.balance["bleed_turns"]
            )

    def _apply_stun(self, target_id, turns):
        target = self.actors[target_id]
        if not self.alive(target_id) or target["stun_immunity_turns"] > 0:
            return False
        target["stun_turns"] = max(target["stun_turns"], int(turns))
        return True

    def _finish_action(self, actor_id, recovery, extra_turn=False):
        actor = self.actors[actor_id]
        if actor["stun_immunity_turns"] > 0:
            actor["stun_immunity_turns"] -= 1
        if actor["berserk_attacks_left"] > 0 and actor_id != "player":
            actor["berserk_attacks_left"] -= 1
        if actor_id in ("goblin_1", "goblin_2"):
            for ally_id in ("player", "dinara"):
                ally = self.actors[ally_id]
                if ally["hidden_turns"] > 0:
                    ally["hidden_turns"] -= 1
            if self.taunt_turns_by_enemy.get(actor_id, 0) > 0:
                self.taunt_turns_by_enemy[actor_id] -= 1
                if self.taunt_turns_by_enemy[actor_id] <= 0:
                    self.taunt_turns_by_enemy.pop(actor_id, None)
                    self.taunt_targets_by_enemy.pop(actor_id, None)
        actor["ready_at"] = self.clock + (1.0 if extra_turn else recovery * 10.0 / max(1.0, actor["agility"]))
        self.current_actor_id = None
        if self.result is None:
            self.advance_to_next_turn()

    def advance_to_next_turn(self):
        if self.check_result() is not None:
            self.current_actor_id = None
            return None
        safety = 0
        while safety < 32:
            safety += 1
            order = self.initiative_order()
            if not order:
                break
            actor_id = order[0]
            actor = self.actors[actor_id]
            self._advance_clock(actor["ready_at"])
            if actor.get("faith_shield_hits_left", 0) <= 0:
                actor["physical_guard"] = 0.0
                actor["magic_guard"] = 0.0

            # Кровотечение наносит периодический урон без учёта защиты.
            if actor["bleed_turns"] > 0:
                bleed = self.balance["bleed_damage"]
                actor["hp"] = max(0, actor["hp"] - bleed)
                actor["bleed_turns"] -= 1
                self.last_event = {"kind": "bleed", "target": actor_id, "damage": bleed}
                if actor["hp"] <= 0:
                    actor["alive"] = False
                if self.check_result() is not None:
                    self.current_actor_id = None
                    return None
                if not actor["alive"]:
                    continue

            # Яд наносит периодический урон без учёта физической и магической защиты.
            if actor["poison_turns"] > 0:
                poison = int(actor["poison_damage"])
                actor["hp"] = max(0, actor["hp"] - poison)
                actor["poison_turns"] -= 1
                self.last_event = {"kind": "poison", "target": actor_id, "damage": poison}
                if actor["hp"] <= 0:
                    actor["alive"] = False
                if self.check_result() is not None:
                    self.current_actor_id = None
                    return None
                if not actor["alive"]:
                    continue
            # Горение наносит периодический урон без учёта физической и магической защиты.
            if actor.get("burn_turns", 0) > 0:
                burn = max(1, int(actor.get("burn_damage", 1)))
                actor["hp"] = max(0, actor["hp"] - burn)
                actor["burn_turns"] -= 1
                self.last_event = {"kind": "burn", "target": actor_id, "damage": burn}
                if actor["hp"] <= 0:
                    actor["alive"] = False
                if self.check_result() is not None:
                    self.current_actor_id = None
                    return None
                if not actor["alive"]:
                    continue

            # Оглушённый участник пропускает свой ход и получает новую задержку.
            if actor["stun_turns"] > 0:
                actor["stun_turns"] -= 1
                self.last_event = {"kind": "stunned", "target": actor_id}
                actor["ready_at"] = self.clock + 520.0 * 10.0 / max(1.0, actor["agility"])
                if actor["stun_immunity_turns"] > 0:
                    actor["stun_immunity_turns"] -= 1
                continue

            self.current_actor_id = actor_id
            self.last_event = {"kind": "turn", "actor": actor_id}
            return actor_id
        self.current_actor_id = None
        self.result = self.check_result() or "draw"
        return None

    def player_warrior_attack(self, target_id):
        actor_id = "player"
        if self.current_actor_id != actor_id or not self.alive(target_id) or self.actors[target_id]["team"] != "enemy":
            return False
        actor = self.actors[actor_id]
        cost = self.balance["basic_attack_stamina"]
        exhausted_attack = actor["stamina"] < cost
        if exhausted_attack:
            # При нехватке ресурса базовая атака остаётся доступной,
            # наносит ровно 1 урон и не сжигает остаток Stamina.
            # Удар истощения не может стать критическим.
            damage = 1
        else:
            actor["stamina"] -= cost
            damage = self._physical_attack_value(actor_id, skill_key="Базовая атака мечом")
        result = self._damage(
            actor_id, target_id, damage, can_crit=not exhausted_attack
        )
        self.last_action_event = {
            "kind": "attack", "attacker": actor_id, "target": target_id,
            "damage": result["damage"], "critical": result["critical"],
            "dodged": result["dodged"],
        }
        if actor["berserk_attacks_left"] > 0:
            actor["berserk_attacks_left"] -= 1
            if actor["berserk_attacks_left"] == 0:
                actor["damage_buff"] = 0.0
                actor["crit_chance_buff"] = 0.0
                actor["crit_multiplier_buff"] = 0.0
        self._finish_action(actor_id, self.balance["basic_recovery"])
        return True

    def _apply_poison(self, target_id, base_damage=3, turns=3, scale_existing=False):
        if not self.alive(target_id):
            return False
        target = self.actors[target_id]
        if target["poison_turns"] > 0 and scale_existing:
            target["poison_damage"] = min(12, max(1, int(round(target["poison_damage"] * 1.5))))
            target["poison_turns"] = max(target["poison_turns"], int(turns))
        else:
            target["poison_damage"] = max(int(target["poison_damage"]), int(base_damage))
            target["poison_turns"] = max(target["poison_turns"], int(turns))
        return True

    def player_attack(self, target_id):
        if self.player_class == "warrior":
            return self.player_warrior_attack(target_id)
        if self.player_class == "rogue":
            return self.player_venom_blade(target_id)
        if self.player_class == "paladin":
            return self.player_hammer_strike(target_id)
        if self.player_class == "mage":
            return self.player_staff_attack(target_id)
        return False

