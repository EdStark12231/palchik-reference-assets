    def use_potion(self, target_id):
        actor_id = self.current_actor_id
        if actor_id not in ("player", "dinara") or self.potion_count <= 0:
            return False
        if not self.alive(target_id) or self.actors[target_id]["team"] != "ally":
            return False
        target = self.actors[target_id]
        amount = max(1, int(round(target["max_hp"] * self.balance["potion_heal_percent"])))
        healed = min(amount, target["max_hp"] - target["hp"])
        if healed <= 0:
            return False
        target["hp"] += healed
        self.potion_count -= 1
        self.last_event = {"kind": "heal", "target": target_id, "amount": healed}
        self.last_action_event = {"kind": "heal", "actor": actor_id, "target": target_id, "amount": healed}
        recovery = self.balance["basic_recovery"] if actor_id == "player" else self.balance["dinara_attack_recovery"]
        self._finish_action(actor_id, recovery)
        return True

    def player_defend(self):
        actor_id = self.current_actor_id
        if actor_id not in ("player", "dinara"):
            return False
        actor = self.actors[actor_id]
        actor["physical_guard"] = 0.45
        self.last_action_event = {"kind": "defend", "actor": actor_id, "physical_guard": 0.45}
        if actor_id == "player":
            if actor["stamina"] >= 8:
                actor["stamina"] -= 8
            recovery = self.balance["block_recovery"]
        else:
            recovery = self.balance["dinara_defend_recovery"]
        self._finish_action(actor_id, recovery)
        return True

    def dinara_ai_action(self):
        actor_id = "dinara"
        if self.current_actor_id != actor_id or not self.alive(actor_id):
            return False
        living_allies = self.living("ally")
        if self.potion_count > 0:
            candidates = [
                aid for aid in living_allies
                if self.actors[aid]["hp"] / self.actors[aid]["max_hp"] <= self.balance["dinara_heal_threshold"]
            ]
            if candidates:
                target = min(candidates, key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"])
                self.log.append(f"Динара использует лечебное зелье на {self.actors[target]['name']}.")
                return self.use_potion(target)
        actor = self.actors[actor_id]
        if actor["hp"] / actor["max_hp"] <= self.balance["dinara_guard_threshold"]:
            self.log.append("Динара занимает защитную позицию.")
            return self.player_defend()
        targets = self.living("enemy")
        if not targets:
            self.result = "victory"
            return True
        # Выбирает противника по сочетанию оставшегося HP и небольшой случайности.
        target = min(
            targets,
            key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"] + self.random.random() * 0.15,
        )
        result = self._damage(actor_id, target, self._physical_attack_value(actor_id))
        self.last_action_event = {
            "kind": "attack", "attacker": actor_id, "target": target,
            "damage": result["damage"], "critical": result["critical"],
            "dodged": result["dodged"],
        }
        self.log.append(f"Динара атакует {self.actors[target]['name']} скалкой.")
        self._finish_action(actor_id, self.balance["dinara_attack_recovery"])
        return True

    def goblin_ai_action(self, actor_id):
        actor = self.actors[actor_id]
        if self.current_actor_id != actor_id or not self.alive(actor_id):
            return False
        forced_target = self.taunt_targets_by_enemy.get(actor_id)
        forced_turns = self.taunt_turns_by_enemy.get(actor_id, 0)
        if forced_turns > 0 and forced_target and self.alive(forced_target):
            # Провокация имеет приоритет даже над невидимостью другого союзника.
            targets = [forced_target]
        else:
            if forced_turns > 0:
                self.taunt_turns_by_enemy.pop(actor_id, None)
                self.taunt_targets_by_enemy.pop(actor_id, None)
            targets = [aid for aid in self.living("ally")
                       if self.actors[aid].get("hidden_turns", 0) <= 0]
        if not targets:
            self._finish_action(actor_id, self.balance["goblin_attack_recovery"])
            return True

        # Воодушевление полезно против Разбойника, у которого есть оглушение.
        # Паладин не накладывает стан, поэтому против него гоблины не тратят
        # действие на иммунитет без тактической причины.
        enemy_has_stun = any(
            self.actors[aid]["role"] == "rogue"
            for aid in targets
        )
        self_or_ally = [
            aid for aid in self.living("enemy")
            if self.actors[aid]["stun_immunity_turns"] <= 0
        ]
        recently_stunned = any(self.actors[aid]["stun_turns"] > 0 for aid in self.living("enemy"))
        wounded_goblin = any(
            self.actors[aid]["hp"] / self.actors[aid]["max_hp"] <= 0.55
            for aid in self.living("enemy")
        )
        if self_or_ally and (enemy_has_stun or recently_stunned or wounded_goblin) and self.random.random() < 0.25:
            chosen = min(
                self_or_ally,
                key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"] + self.random.random() * 0.1,
            )
            # Если гоблин усиливает себя, компенсируем уменьшение счётчика
            # в _finish_action: эффект должен начаться после применения.
            duration = self.balance["inspire_immunity_turns"]
            self.actors[chosen]["stun_immunity_turns"] = duration + (1 if chosen == actor_id else 0)
            self.last_action_event = {"kind": "inspire", "actor": actor_id, "target": chosen}
            self.log.append(f"{actor['name']} использует «Воодушевление» на {self.actors[chosen]['name']}.")
            self._finish_action(actor_id, self.balance["goblin_inspire_recovery"])
            return True

        valid_net_targets = [
            aid for aid in targets
            if self.actors[aid]["stun_immunity_turns"] <= 0
            and self.actors[aid]["stun_turns"] <= 0
        ]
        use_net = bool(valid_net_targets) and self.random.random() < 0.30
        if use_net:
            multi = len(valid_net_targets) > 1 and self.random.random() < self.balance["net_multi_target_chance"]
            selected = valid_net_targets if multi else [
                min(valid_net_targets, key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"] + self.random.random() * 0.2)
            ]
            landed = []
            for target_id in selected:
                if self._apply_stun(target_id, self.balance["net_stun_turns"]):
                    landed.append(target_id)
            if landed:
                names = ", ".join(self.actors[aid]["name"] for aid in landed)
                self.last_action_event = {"kind": "net", "actor": actor_id, "targets": landed}
                self.log.append(f"{actor['name']} использует «Лови их!» — сеть накрывает: {names}.")
                self._finish_action(actor_id, self.balance["goblin_net_recovery"])
                return True

        target_id = min(
            targets,
            key=lambda aid: self.actors[aid]["hp"] / self.actors[aid]["max_hp"] + self.random.random() * 0.20,
        )
        result = self._damage(
            actor_id, target_id, self._physical_attack_value(actor_id),
            damage_type="physical",
        )
        bleed_applied = False
        if result["damage"] and self.random.random() < self.balance["bleed_chance"]:
            self._apply_bleed(target_id)
            bleed_applied = True
            self.log.append(f"{actor['name']} накладывает кровотечение на {self.actors[target_id]['name']}.")
        self.last_action_event = {
            "kind": "attack", "attacker": actor_id, "target": target_id,
            "damage": result["damage"], "critical": result["critical"],
            "dodged": result["dodged"], "bleed": bleed_applied,
        }
        self.log.append(f"{actor['name']} атакует {self.actors[target_id]['name']} ржавым тесаком.")
        self._finish_action(actor_id, self.balance["goblin_attack_recovery"])
        return True

    def resolve_current_ai(self):
        actor_id = self.current_actor_id
        if actor_id == "dinara":
            return self.dinara_ai_action()
        if actor_id in ("goblin_1", "goblin_2"):
            return self.goblin_ai_action(actor_id)
        return False

    def summary(self):
        return {
            actor_id: {
                "name": actor["name"], "hp": actor["hp"],
                "max_hp": actor["max_hp"], "stamina": actor["stamina"],
                "max_stamina": actor["max_stamina"], "mp": actor["mp"],
                "max_mp": actor["max_mp"], "alive": actor["alive"],
                "bleed_turns": actor["bleed_turns"],
                "stun_turns": actor["stun_turns"],
                "stun_immunity_turns": actor["stun_immunity_turns"],
                "ready_at": actor["ready_at"],
            }
            for actor_id, actor in self.actors.items()
        }


def _evt005_hit_test_enemy(mouse_pos, enemy_hitboxes):
    """Return the living enemy under the cursor using shared screen hitboxes."""
    mouse_x, mouse_y = mouse_pos
    for enemy_id, (left, top, right, bottom) in enemy_hitboxes:
        if left <= mouse_x < right and top <= mouse_y < bottom:
            return enemy_id
    return None


def _evt005_battle_self_test():
    """Быстрый тест логики движка без запуска Pygame и загрузки ресурсов."""
    engine = EVT005BattleEngine("Тестовый воин")
    assert engine.potion_count == 1
    assert len(engine.living("enemy")) == 2
    assert len(engine.living("ally")) == 2
    assert engine.actors["player"]["max_stamina"] == 100

    # Проверяем: Динара может выбыть, а бой продолжается.
    engine.actors["dinara"]["hp"] = 0
    engine.actors["dinara"]["alive"] = False
    assert engine.check_result() is None
    assert engine.alive("player")

    # Проверяем: гибель героя немедленно означает поражение.
    engine.actors["player"]["hp"] = 0
    engine.actors["player"]["alive"] = False
    assert engine.check_result() == "defeat"

    # Проверяем: кровотечение обходит защиту и снимает ровно тик урона.
    engine = EVT005BattleEngine("Тестовый воин")
    goblin = engine.actors["goblin_1"]
    goblin["bleed_turns"] = 1
    goblin["toughness"] = 100.0
    goblin["physical_guard"] = 0.95
    before = goblin["hp"]
    goblin["ready_at"] = 1.0
    # Подвинем союзников позже, чтобы гоблин стал ближайшим участником.
    engine.actors["player"]["ready_at"] = 9000.0
    engine.actors["dinara"]["ready_at"] = 9000.0
    engine.actors["goblin_2"]["ready_at"] = 9000.0
    actor_id = engine.advance_to_next_turn()
    assert actor_id == "goblin_1"
    assert goblin["hp"] == before - engine.balance["bleed_damage"]

    # Проверяем: нулевая выносливость даёт базовой атаке ровно 1 урон,
    # не тратя ресурс и не блокируя возможность действия.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.current_actor_id = "player"
    engine.actors["player"]["stamina"] = 0
    for other_id in ("dinara", "goblin_1", "goblin_2"):
        engine.actors[other_id]["ready_at"] = engine.clock
    engine.actors["goblin_1"]["agility"] = 0
    target_before = engine.actors["goblin_1"]["hp"]
    assert engine.player_attack("goblin_1")
    assert engine.actors["goblin_1"]["hp"] == target_before - 1
    assert engine.last_action_event["damage"] == 1
    assert not engine.last_action_event["critical"]
    assert engine.actors["player"]["stamina"] == 0

    # При частичном запасе ниже цены атаки остаток не сгорает:
    # герой наносит 1 урон и продолжает восстанавливать ресурс со временем.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.current_actor_id = "player"
    engine.actors["player"]["stamina"] = 5
    for other_id in ("dinara", "goblin_1", "goblin_2"):
        engine.actors[other_id]["ready_at"] = engine.clock
    engine.actors["goblin_1"]["agility"] = 0
    target_before = engine.actors["goblin_1"]["hp"]
    assert engine.player_attack("goblin_1")
    assert engine.actors["goblin_1"]["hp"] == target_before - 1
    assert engine.last_action_event["damage"] == 1
    assert not engine.last_action_event["critical"]
    assert engine.actors["player"]["stamina"] == 5

    # Hover and left-click target selection share the same sprite hitboxes.
    enemy_hitboxes = [
        ("goblin_1", (610, 190, 765, 405)),
        ("goblin_2", (775, 190, 930, 405)),
    ]
    assert _evt005_hit_test_enemy((690, 300), enemy_hitboxes) == "goblin_1"
    assert _evt005_hit_test_enemy((850, 300), enemy_hitboxes) == "goblin_2"
    assert _evt005_hit_test_enemy((770, 300), enemy_hitboxes) is None

    # Берсерк недоступен выше 25% HP и открывает дополнительный ход ниже порога.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.current_actor_id = "player"
    assert not engine.player_berserk()
    engine.actors["player"]["hp"] = 30
    engine.current_actor_id = "player"
    assert engine.player_berserk()
    assert engine.actors["player"]["berserk_attacks_left"] == 2
    assert engine.current_actor_id == "player"

    # Динара может потратить общее зелье на союзника; лечение процентное.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.current_actor_id = "dinara"
    engine.actors["player"]["hp"] = 60
    assert engine.use_potion("player")
    assert engine.actors["player"]["hp"] == 102
    assert engine.potion_count == 0

    # Иммунитет от «Воодушевления» не теряет ход в момент применения.
    engine = EVT005BattleEngine("Тестовый воин")
    engine.random.seed(4)
    engine.current_actor_id = "goblin_1"
    engine.actors["goblin_1"]["hp"] = 20
    engine.actors["goblin_1"]["ready_at"] = engine.clock
    engine.actors["goblin_2"]["ready_at"] = 9000
    engine.actors["player"]["ready_at"] = 9000
    engine.actors["dinara"]["ready_at"] = 9000
    # Форсируем условие и выбор наиболее раненого гоблина.
    engine.random.random = lambda: 0.0
    assert engine.goblin_ai_action("goblin_1")
    assert engine.actors["goblin_1"]["stun_immunity_turns"] == 3
    assert not engine._apply_stun("goblin_1", 2)

    return True


def _evt005_visual_asset_self_test():
