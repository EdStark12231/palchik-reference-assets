    draw_centered_text(
        surface,
        title_font,
        "ВЫБЕРИ СВОЙ ПУТЬ",
        GOLD,
        (WIDTH // 2, 32)
    )

    for index, item in enumerate(CLASSES):
        x, y = CLASS_POSITIONS[index]

        rect = pygame.Rect(x, y, 440, 220)
        is_selected = index == selected

        pygame.draw.rect(
            surface,
            (43, 49, 65) if is_selected else (27, 33, 47),
            rect,
            border_radius=8
        )

        pygame.draw.rect(
            surface,
            GOLD if is_selected else PANEL_INNER_BORDER,
            rect,
            width=3 if is_selected else 1,
            border_radius=8
        )

        title = title_font.render(
            item["name"],
            True,
            GOLD if is_selected else TEXT_COLOR
        )

        surface.blit(title, (x + 15, y + 12))

        image = class_images[index]

        if image is not None:
            image_rect = image.get_rect(
                center=(x + 115, y + 133)
            )
            surface.blit(image, image_rect)
        else:
            draw_centered_text(
                surface,
                font,
                "Нет изображения",
                MUTED_COLOR,
                (x + 115, y + 130)
            )

        draw_wrapped_text(
            surface,
            font,
            item["description"],
            TEXT_COLOR,
            x + 225,
            y + 65,
            195,
            line_gap=4
        )

    draw_centered_text(
        surface,
        font,
        "СТРЕЛКИ — выбор     ENTER — подтвердить     1–4 — быстрый выбор",
        MUTED_COLOR,
        (WIDTH // 2, HEIGHT - 12)
    )


