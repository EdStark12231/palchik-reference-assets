    def award_experience_to_party(amount, reason="награда"):
        """Общий вход для EXP за победу и будущие мини-квесты Динары."""
        amount = max(0, int(amount))
        for character_id in ("player", "dinara"):
            data = progression[character_id]
            data["exp"] += amount
            gained_levels = 0
            while data["exp"] >= data["next_exp"]:
                data["exp"] -= data["next_exp"]
                data["level"] += 1
                data["stat_points"] += PROGRESSION_BALANCE["stat_points_per_level"]
                data["skill_points"] += PROGRESSION_BALANCE["skill_points_per_level"]
                data["next_exp"] = int(round(data["next_exp"] * PROGRESSION_BALANCE["exp_growth"]))
                gained_levels += 1
            if gained_levels:
                levelup_notifications[character_id] = 3.0
                print(f"[EVT005][LEVEL] {character_id}: +{gained_levels} level(s) from {reason}.")

    def award_battle_experience():
        award_experience_to_party(
            PROGRESSION_BALANCE["battle_exp_reward"],
            "победа в бою",
        )

